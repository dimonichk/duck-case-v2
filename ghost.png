05c-.022 1.139-.105 1.826-.436 2.367a2.999 2.999 0 0 1-.99.99c-.542.332-1.23.415-2.368.436l-1.3.007h-.8c-1.841 0-2.82 0-3.529-.364l-.138-.078a2.999 2.999 0 0 1-.894-.842l-.097-.149C.611 13.527.528 12.84.507 11.7L.5 10.4v-.8c0-1.841 0-2.82.364-3.529l.078-.138a3 3 0 0 1 .842-.894l.149-.097c.572-.35 1.31-.422 2.572-.437.014-1.163.075-1.88.36-2.434l.077-.138a3 3 0 0 1 .842-.894l.149-.097C6.654.5 7.636.5 9.6.5h.8zM5.6 5.8c-1.007 0-1.672.002-2.177.05-.486.046-.69.126-.812.2a1.7 1.7 0 0 0-.56.561c-.075.122-.155.326-.201.812-.048.505-.05 1.17-.05 2.177v.8c0 1.007.002 1.672.05 2.177.046.486.126.69.2.812.14.228.333.42.561.56.122.075.326.155.812.201.505.048 1.17.05 2.177.05h.8c1.007 0 1.672-.002 2.177-.05.486-.046.69-.126.812-.2a1.7 1.7 0 0 0 .56-.561c.075-.122.155-.326.201-.812.048-.505.05-1.17.05-2.177v-.8c0-1.007-.002-1.672-.05-2.177-.046-.486-.126-.69-.2-.812a1.7 1.7 0 0 0-.561-.56c-.122-.075-.326-.155-.812-.201-.505-.048-1.17-.05-2.177-.05h-.8zm4-4c-1.007 0-1.672.002-2.177.05-.486.046-.69.126-.812.2a1.7 1.7 0 0 0-.56.561c-.075.122-.155.326-.201.812-.028.293-.039.64-.044 1.077H6.4l1.3.007c1.139.02 1.826.104 2.367.435.404.248.743.587.99.99.443.722.443 1.704.443 3.668v.592a13.38 13.38 0 0 0 1.076-.04c.486-.047.69-.127.812-.202a1.71 1.71 0 0 0 .561-.561c.075-.122.155-.326.201-.812.048-.505.05-1.17.05-2.177v-.8c0-1.007-.002-1.672-.05-2.177-.046-.486-.126-.69-.2-.812a1.7 1.7 0 0 0-.562-.56c-.122-.075-.326-.155-.812-.201-.505-.048-1.17-.05-2.177-.05h-.8z"></path></svg><span class="Button-Text">Копировать</span></button></div></div><div class="CodeBlock-Stopper"></div></div><div class="CodeBlock-Content" data-testid="codeblock-content"><pre class="CodeBlock-ContentPre" data-testid="codeblock-code"><code class="hljs language-python"><span class="hljs-comment"># bot_case.py — Duck Case: панель в мини-окне, баланс на сервере</span>
<span class="hljs-comment"># pip install aiogram</span>
<span class="hljs-keyword">import</span> asyncio, json, os, time

<span class="hljs-keyword">from</span> aiogram <span class="hljs-keyword">import</span> Bot, Dispatcher, F
<span class="hljs-keyword">from</span> aiogram.client.default <span class="hljs-keyword">import</span> DefaultBotProperties
<span class="hljs-keyword">from</span> aiogram.enums <span class="hljs-keyword">import</span> ParseMode
<span class="hljs-keyword">from</span> aiogram.filters <span class="hljs-keyword">import</span> Command, CommandStart
<span class="hljs-keyword">from</span> aiogram.types <span class="hljs-keyword">import</span> (
    Message, ReplyKeyboardMarkup, KeyboardButton,
    InlineKeyboardMarkup, InlineKeyboardButton, WebAppInfo,
)

<span class="hljs-comment"># ============ НАСТРОЙКИ ============</span>
BOT_TOKEN = <span class="hljs-string">"СЮДА_ТОКЕН"</span>
WEB_APP_URL = <span class="hljs-string">"https://dimonichk.github.io/duck-case-v2/?v=14"</span>
ADMIN_ID = <span class="hljs-number">593081823</span>  <span class="hljs-comment"># твой Telegram ID</span>
SUPPORT_URL = <span class="hljs-string">"https://t.me/tsartixc"</span>
USERS_FILE = <span class="hljs-string">"users_db.json"</span>
START_BALANCE = <span class="hljs-number">300</span>
MIN_BET = <span class="hljs-number">10</span>
MAX_WIN_MULT = <span class="hljs-number">15</span>
BONUS_COOLDOWN = <span class="hljs-number">43200</span>  <span class="hljs-comment"># 12 часов</span>

<span class="hljs-comment"># ============ ФАЙЛЫ ============</span>
<span class="hljs-keyword">def</span> <span class="hljs-title function_">load_json</span>(<span class="hljs-params">path, default</span>):
    <span class="hljs-keyword">if</span> <span class="hljs-keyword">not</span> os.path.exists(path):
        <span class="hljs-keyword">with</span> <span class="hljs-built_in">open</span>(path, <span class="hljs-string">"w"</span>, encoding=<span class="hljs-string">"utf-8"</span>) <span class="hljs-keyword">as</span> f:
            json.dump(default, f, ensure_ascii=<span class="hljs-literal">False</span>, indent=<span class="hljs-number">2</span>)
    <span class="hljs-keyword">with</span> <span class="hljs-built_in">open</span>(path, <span class="hljs-string">"r"</span>, encoding=<span class="hljs-string">"utf-8"</span>) <span class="hljs-keyword">as</span> f:
        <span class="hljs-keyword">return</span> json.load(f)

<span class="hljs-keyword">def</span> <span class="hljs-title function_">save_json</span>(<span class="hljs-params">path, data</span>):
    <span class="hljs-keyword">with</span> <span class="hljs-built_in">open</span>(path, <span class="hljs-string">"w"</span>, encoding=<span class="hljs-string">"utf-8"</span>) <span class="hljs-keyword">as</span> f:
        json.dump(data, f, ensure_ascii=<span class="hljs-literal">False</span>, indent=<span class="hljs-number">2</span>)

users = load_json(USERS_FILE, {})

<span class="hljs-keyword">def</span> <span class="hljs-title function_">get_user</span>(<span class="hljs-params">uid: <span class="hljs-built_in">int</span></span>) -&gt; <span class="hljs-built_in">dict</span>:
    u = users.setdefault(<span class="hljs-built_in">str</span>(uid), {})
    u.setdefault(<span class="hljs-string">"balance"</span>, START_BALANCE)
    u.setdefault(<span class="hljs-string">"opened"</span>, <span class="hljs-number">0</span>)
    u.setdefault(<span class="hljs-string">"wins"</span>, <span class="hljs-number">0</span>)
    u.setdefault(<span class="hljs-string">"username"</span>, <span class="hljs-string">""</span>)
    u.setdefault(<span class="hljs-string">"name"</span>, <span class="hljs-string">""</span>)
    u.setdefault(<span class="hljs-string">"last_bonus"</span>, <span class="hljs-number">0</span>)
    <span class="hljs-keyword">return</span> u

<span class="hljs-keyword">def</span> <span class="hljs-title function_">save</span>():
    save_json(USERS_FILE, users)

GAME_NAMES = {
    <span class="hljs-string">"bj"</span>: <span class="hljs-string">"🃏 Блэкджек"</span>, <span class="hljs-string">"mines"</span>: <span class="hljs-string">"💣 Мины"</span>, <span class="hljs-string">"crash"</span>: <span class="hljs-string">"📈 Краш"</span>,
    <span class="hljs-string">"flip"</span>: <span class="hljs-string">"🪙 Орёл/Решка"</span>, <span class="hljs-string">"hl"</span>: <span class="hljs-string">"📊 Больше/Меньше"</span>, <span class="hljs-string">"cards"</span>: <span class="hljs-string">"🂠 Карты"</span>,
    <span class="hljs-string">"rou"</span>: <span class="hljs-string">"🎡 Рулетка"</span>, <span class="hljs-string">"slots"</span>: <span class="hljs-string">"🎰 Слоты"</span>, <span class="hljs-string">"chicken"</span>: <span class="hljs-string">"🐔 Курица-перебежчица"</span>,
    <span class="hljs-string">"darts"</span>: <span class="hljs-string">"🎯 Дартс"</span>, <span class="hljs-string">"dice"</span>: <span class="hljs-string">"🎲 Кубики"</span>, <span class="hljs-string">"cups"</span>: <span class="hljs-string">"🥤 Стаканчики"</span>,
    <span class="hljs-string">"case"</span>: <span class="hljs-string">"🎁 Кейс"</span>,
}

<span class="hljs-comment"># ============ КЛАВИАТУРЫ ============</span>
<span class="hljs-keyword">def</span> <span class="hljs-title function_">main_kb</span>():
    <span class="hljs-keyword">return</span> ReplyKeyboardMarkup(keyboard=[
        [KeyboardButton(text=<span class="hljs-string">"ОТКРЫТЬ 🦆"</span>)],
        [KeyboardButton(text=<span class="hljs-string">"💬 Поддержка"</span>)],
    ], resize_keyboard=<span class="hljs-literal">True</span>)

<span class="hljs-keyword">def</span> <span class="hljs-title function_">panel_inline</span>(<span class="hljs-params">balance: <span class="hljs-built_in">int</span></span>):
    <span class="hljs-keyword">return</span> InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(
            text=<span class="hljs-string">f"🎰 ОТКРЫТЬ панель · <span class="hljs-subst">{balance}</span> 💰"</span>,
            web_app=WebAppInfo(url=<span class="hljs-string">f"<span class="hljs-subst">{WEB_APP_URL}</span>&amp;b=<span class="hljs-subst">{balance}</span>"</span>),
        )
    ]])

<span class="hljs-keyword">def</span> <span class="hljs-title function_">find_by_username</span>(<span class="hljs-params">username: <span class="hljs-built_in">str</span></span>):
    username = username.lstrip(<span class="hljs-string">"@"</span>).lower()
    <span class="hljs-keyword">for</span> uid, u <span class="hljs-keyword">in</span> users.items():
        <span class="hljs-keyword">if</span> u.get(<span class="hljs-string">"username"</span>, <span class="hljs-string">""</span>).lower() == username:
            <span class="hljs-keyword">return</span> <span class="hljs-built_in">int</span>(uid)
    <span class="hljs-keyword">return</span> <span class="hljs-literal">None</span>

bot = Bot(token=BOT_TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
dp = Dispatcher()

<span class="hljs-comment"># ============ ОСНОВНЫЕ КОМАНДЫ ============</span>
<span class="hljs-meta">@dp.message(<span class="hljs-params">CommandStart(<span class="hljs-params"></span>)</span>)</span>
<span class="hljs-keyword">async</span> <span class="hljs-keyword">def</span> <span class="hljs-title function_">cmd_start</span>(<span class="hljs-params">message: Message</span>):
    u = get_user(message.from_user.<span class="hljs-built_in">id</span>)
    u[<span class="hljs-string">"balance"</span>] = <span class="hljs-built_in">max</span>(u[<span class="hljs-string">"balance"</span>], START_BALANCE)
    u[<span class="hljs-string">"username"</span>] = message.from_user.username <span class="hljs-keyword">or</span> <span class="hljs-string">""</span>
    u[<span class="hljs-string">"name"</span>] = message.from_user.first_name
    save()
    <span class="hljs-keyword">await</span> message.answer(
        <span class="hljs-string">f"👋 &lt;b&gt;<span class="hljs-subst">{message.from_user.first_name}</span>&lt;/b&gt;, привет!\n\n"</span>
        <span class="hljs-string">f"💰 Баланс: &lt;b&gt;<span class="hljs-subst">{u[<span class="hljs-string">'balance'</span>]}</span>&lt;/b&gt; монет\n\n"</span>
        <span class="hljs-string">f"Жми &lt;b&gt;ОТКРЫТЬ 🦆&lt;/b&gt; — кейсы с подарками и 12 мини-игр внутри.\n\n"</span>
        <span class="hljs-string">f"🎁 &lt;b&gt;/bonus&lt;/b&gt; — +100 монет каждые 12 часов\n"</span>
        <span class="hljs-string">f"🏆 &lt;b&gt;/top&lt;/b&gt; — топ игроков"</span>,
        reply_markup=main_kb(),
    )

<span class="hljs-meta">@dp.message(<span class="hljs-params">F.text == <span class="hljs-string">"ОТКРЫТЬ 🦆"</span></span>)</span>
<span class="hljs-keyword">async</span> <span class="hljs-keyword">def</span> <span class="hljs-title function_">m_open</span>(<span class="hljs-params">message: Message</span>):
    u = get_user(message.from_user.<span class="hljs-built_in">id</span>)
    <span class="hljs-keyword">await</span> message.answer(<span class="hljs-string">"🎰 Твоя панель:"</span>, reply_markup=panel_inline(u[<span class="hljs-string">"balance"</span>]))

<span class="hljs-meta">@dp.message(<span class="hljs-params">F.text == <span class="hljs-string">"💬 Поддержка"</span></span>)</span>
<span class="hljs-keyword">async</span> <span class="hljs-keyword">def</span> <span class="hljs-title function_">m_support</span>(<span class="hljs-params">message: Message</span>):
    u = get_user(message.from_user.<span class="hljs-built_in">id</span>)
    <span class="hljs-keyword">await</span> message.answer(
        <span class="hljs-string">f"💬 Проблемы с балансом, кейсом или игрой?\n"</span>
        <span class="hljs-string">f"Пиши напрямую: &lt;b&gt;@tsartixc&lt;/b&gt;\n\n<span class="hljs-subst">{SUPPORT_URL}</span>"</span>,
        reply_markup=panel_inline(u[<span class="hljs-string">"balance"</span>]),
    )

<span class="hljs-meta">@dp.message(<span class="hljs-params">Command(<span class="hljs-params"><span class="hljs-string">"profile"</span></span>)</span>)</span>
<span class="hljs-keyword">async</span> <span class="hljs-keyword">def</span> <span class="hljs-title function_">cmd_profile</span>(<span class="hljs-params">message: Message</span>):
    u = get_user(message.from_user.<span class="hljs-built_in">id</span>)
    <span class="hljs-keyword">await</span> message.answer(
        <span class="hljs-string">f"👤 &lt;b&gt;Профиль&lt;/b&gt;\n\n💰 Баланс: &lt;b&gt;<span class="hljs-subst">{u[<span class="hljs-string">'balance'</span>]}</span>&lt;/b&gt;\n"</span>
        <span class="hljs-string">f"📦 Кейсов открыто: &lt;b&gt;<span class="hljs-subst">{u[<span class="hljs-string">'opened'</span>]}</span>&lt;/b&gt;\n🎮 Побед в играх: &lt;b&gt;<span class="hljs-subst">{u[<span class="hljs-string">'wins'</span>]}</span>&lt;/b&gt;"</span>,
        reply_markup=panel_inline(u[<span class="hljs-string">"balance"</span>]),
    )

<span class="hljs-comment"># ============ ДАННЫЕ ИЗ МИНИ-ОКНА ============</span>
<span class="hljs-meta">@dp.message(<span class="hljs-params">F.web_app_data</span>)</span>
<span class="hljs-keyword">async</span> <span class="hljs-keyword">def</span> <span class="hljs-title function_">m_webapp</span>(<span class="hljs-params">message: Message</span>):
    <span class="hljs-keyword">try</span>:
        payload = json.loads(message.web_app_data.data)
    <span class="hljs-keyword">except</span> (json.JSONDecodeError, TypeError):
        <span class="hljs-keyword">return</span>
    uid = message.from_user.<span class="hljs-built_in">id</span>
    u = get_user(uid)
    act = payload.get(<span class="hljs-string">"action"</span>)

    <span class="hljs-keyword">if</span> act == <span class="hljs-string">"settle"</span>:
        <span class="hljs-keyword">try</span>:
            bet = <span class="hljs-built_in">int</span>(payload.get(<span class="hljs-string">"bet"</span>, <span class="hljs-number">0</span>))
            net = <span class="hljs-built_in">int</span>(payload.get(<span class="hljs-string">"net"</span>, <span class="hljs-number">0</span>))
        <span class="hljs-keyword">except</span> (TypeError, ValueError):
            <span class="hljs-keyword">return</span>
        game = GAME_NAMES.get(payload.get(<span class="hljs-string">"game"</span>, <span class="hljs-string">""</span>), <span class="hljs-string">"🎮 Игра"</span>)
        <span class="hljs-keyword">if</span> bet &lt; MIN_BET <span class="hljs-keyword">or</span> net &lt; -bet <span class="hljs-keyword">or</span> net &gt; bet * MAX_WIN_MULT:
            <span class="hljs-keyword">await</span> message.answer(<span class="hljs-string">"⚠️ Подозрительная операция отклонена."</span>)
            <span class="hljs-keyword">return</span>
        u[<span class="hljs-string">"balance"</span>] = <span class="hljs-built_in">max</span>(<span class="hljs-number">0</span>, u[<span class="hljs-string">"balance"</span>] + net)
        <span class="hljs-keyword">if</span> net &gt; <span class="hljs-number">0</span>:
            u[<span class="hljs-string">"wins"</span>] += <span class="hljs-number">1</span>
        save()
        sign = <span class="hljs-string">f"+<span class="hljs-subst">{net}</span>"</span> <span class="hljs-keyword">if</span> net &gt;= <span class="hljs-number">0</span> <span class="hljs-keyword">else</span> <span class="hljs-built_in">str</span>(net)
        gift = payload.get(<span class="hljs-string">"gift"</span>)
        gift_line = <span class="hljs-string">f"🎁 Подарок: &lt;b&gt;<span class="hljs-subst">{gift}</span>&lt;/b&gt;\n"</span> <span class="hljs-keyword">if</span> gift <span class="hljs-keyword">else</span> <span class="hljs-string">""</span>
        <span class="hljs-keyword">await</span> message.answer(
            <span class="hljs-string">f"<span class="hljs-subst">{game}</span>\n<span class="hljs-subst">{gift_line}</span>💸 Ставка: <span class="hljs-subst">{bet}</span> · Результат: &lt;b&gt;<span class="hljs-subst">{sign}</span>&lt;/b&gt;\n💰 Баланс: &lt;b&gt;<span class="hljs-subst">{u[<span class="hljs-string">'balance'</span>]}</span>&lt;/b&gt;"</span>,
            reply_markup=panel_inline(u[<span class="hljs-string">"balance"</span>]),
        )

<span class="hljs-comment"># ============ БОНУС И ТОП ============</span>
<span class="hljs-meta">@dp.message(<span class="hljs-params">Command(<span class="hljs-params"><span class="hljs-string">"bonus"</span></span>)</span>)</span>
<span class="hljs-keyword">async</span> <span class="hljs-keyword">def</span> <span class="hljs-title function_">cmd_bonus</span>(<span class="hljs-params">message: Message</span>):
    u = get_user(message.from_user.<span class="hljs-built_in">id</span>)
    now = time.time()
    last = u.get(<span class="hljs-string">"last_bonus"</span>, <span class="hljs-number">0</span>)
    <span class="hljs-keyword">if</span> now - last &lt; BONUS_COOLDOWN:
        left = <span class="hljs-built_in">int</span>((BONUS_COOLDOWN - (now - last)) // <span class="hljs-number">60</span>)
        <span class="hljs-keyword">await</span> message.answer(
            <span class="hljs-string">f"⏳ Бонус будет доступен через <span class="hljs-subst">{left // <span class="hljs-number">60</span>}</span> ч <span class="hljs-subst">{left % <span class="hljs-number">60</span>}</span> мин."</span>,
            reply_markup=panel_inline(u[<span class="hljs-string">"balance"</span>]))
        <span class="hljs-keyword">return</span>
    u[<span class="hljs-string">"last_bonus"</span>] = now
    u[<span class="hljs-string">"balance"</span>] += <span class="hljs-number">100</span>
    save()
    <span class="hljs-keyword">await</span> message.answer(
        <span class="hljs-string">"🎁 Ежедневный бонус: +100 монет! Возвращайся через 12 часов."</span>,
        reply_markup=panel_inline(u[<span class="hljs-string">"balance"</span>]))

<span class="hljs-meta">@dp.message(<span class="hljs-params">Command(<span class="hljs-params"><span class="hljs-string">"top"</span></span>)</span>)</span>
<span class="hljs-keyword">async</span> <span class="hljs-keyword">def</span> <span class="hljs-title function_">cmd_top</span>(<span class="hljs-params">message: Message</span>):
    top = <span class="hljs-built_in">sorted</span>(users.items(), key=<span class="hljs-keyword">lambda</span> kv: kv[<span class="hljs-number">1</span>].get(<span class="hljs-string">"balance"</span>, <span class="hljs-number">0</span>), reverse=<span class="hljs-literal">True</span>)[:<span class="hljs-number">10</span>]
    lines = []
    <span class="hljs-keyword">for</span> i, (uid, u) <span class="hljs-keyword">in</span> <span class="hljs-built_in">enumerate</span>(top, <span class="hljs-number">1</span>):
        name = u.get(<span class="hljs-string">"username"</span>) <span class="hljs-keyword">or</span> u.get(<span class="hljs-string">"name"</span>) <span class="hljs-keyword">or</span> <span class="hljs-string">f"id<span class="hljs-subst">{uid}</span>"</span>
        medal = [<span class="hljs-string">"🥇"</span>, <span class="hljs-string">"🥈"</span>, <span class="hljs-string">"🥉"</span>][i - <span class="hljs-number">1</span>] <span class="hljs-keyword">if</span> i &lt;= <span class="hljs-number">3</span> <span class="hljs-keyword">else</span> <span class="hljs-string">f"<span class="hljs-subst">{i}</span>."</span>
        lines.append(<span class="hljs-string">f"<span class="hljs-subst">{medal}</span> @<span class="hljs-subst">{name}</span> — <span class="hljs-subst">{u.get(<span class="hljs-string">'balance'</span>, <span class="hljs-number">0</span>)}</span> 💰"</span>)
    <span class="hljs-keyword">await</span> message.answer(<span class="hljs-string">"🏆 &lt;b&gt;Топ игроков&lt;/b&gt;\n\n"</span> + <span class="hljs-string">"\n"</span>.join(lines))

<span class="hljs-comment"># ============ АДМИН-КОМАНДЫ ============</span>
<span class="hljs-meta">@dp.message(<span class="hljs-params">Command(<span class="hljs-params"><span class="hljs-string">"add"</span></span>)</span>)</span>
<span class="hljs-keyword">async</span> <span class="hljs-keyword">def</span> <span class="hljs-title function_">cmd_add</span>(<span class="hljs-params">message: Message</span>):
    <span class="hljs-keyword">if</span> message.from_user.<span class="hljs-built_in">id</span> != ADMIN_ID:
        <span class="hljs-keyword">return</span>
    parts = message.text.split()
    <span class="hljs-keyword">if</span> <span class="hljs-built_in">len</span>(parts) &lt; <span class="hljs-number">2</span> <span class="hljs-keyword">or</span> <span class="hljs-keyword">not</span> parts[<span class="hljs-number">1</span>].lstrip(<span class="hljs-string">"-"</span>).isdigit():
        <span class="hljs-keyword">await</span> message.answer(<span class="hljs-string">"Формат: /add 1000 (можно отрицательное)"</span>)
        <span class="hljs-keyword">return</span>
    u = get_user(message.from_user.<span class="hljs-built_in">id</span>)
    u[<span class="hljs-string">"balance"</span>] += <span class="hljs-built_in">int</span>(parts[<span class="hljs-number">1</span>])
    save()
    <span class="hljs-keyword">await</span> message.answer(<span class="hljs-string">f"💰 Начислено <span class="hljs-subst">{parts[<span class="hljs-number">1</span>]}</span>. Баланс: &lt;b&gt;<span class="hljs-subst">{u[<span class="hljs-string">'balance'</span>]}</span>&lt;/b&gt;"</span>,
                         reply_markup=panel_inline(u[<span class="hljs-string">"balance"</span>]))

<span class="hljs-meta">@dp.message(<span class="hljs-params">Command(<span class="hljs-params"><span class="hljs-string">"give"</span></span>)</span>)</span>
<span class="hljs-keyword">async</span> <span class="hljs-keyword">def</span> <span class="hljs-title function_">cmd_give</span>(<span class="hljs-params">message: Message</span>):
    <span class="hljs-keyword">await</span> cmd_gift(message)

<span class="hljs-meta">@dp.message(<span class="hljs-params">Command(<span class="hljs-params"><span class="hljs-string">"gift"</span></span>)</span>)</span>
<span class="hljs-keyword">async</span> <span class="hljs-keyword">def</span> <span class="hljs-title function_">cmd_gift</span>(<span class="hljs-params">message: Message</span>):
    <span class="hljs-keyword">if</span> message.from_user.<span class="hljs-built_in">id</span> != ADMIN_ID:
        <span class="hljs-keyword">return</span>
    parts = message.text.split()
    <span class="hljs-keyword">if</span> <span class="hljs-built_in">len</span>(parts) &lt; <span class="hljs-number">3</span> <span class="hljs-keyword">or</span> <span class="hljs-keyword">not</span> parts[<span class="hljs-number">2</span>].lstrip(<span class="hljs-string">"-"</span>).isdigit():
        <span class="hljs-keyword">await</span> message.answer(<span class="hljs-string">"Формат: /gift @username 500"</span>)
        <span class="hljs-keyword">return</span>
    target = find_by_username(parts[<span class="hljs-number">1</span>])
    <span class="hljs-keyword">if</span> <span class="hljs-keyword">not</span> target:
        <span class="hljs-keyword">await</span> message.answer(
            <span class="hljs-string">"❌ Игрок не найден. Он должен хотя бы раз написать боту /start — "</span>
            <span class="hljs-string">"тогда его юзернейм сохранится в базе."</span>)
        <span class="hljs-keyword">return</span>
    tu = get_user(target)
    tu[<span class="hljs-string">"balance"</span>] += <span class="hljs-built_in">int</span>(parts[<span class="hljs-number">2</span>])
    save()
    <span class="hljs-keyword">await</span> message.answer(
        <span class="hljs-string">f"✅ Игроку @<span class="hljs-subst">{tu[<span class="hljs-string">'username'</span>]}</span> начислено <span class="hljs-subst">{parts[<span class="hljs-number">2</span>]}</span>. Его баланс: &lt;b&gt;<span class="hljs-subst">{tu[<span class="hljs-string">'balance'</span>]}</span>&lt;/b&gt;"</span>)
    <span class="hljs-keyword">try</span>:
        <span class="hljs-keyword">await</span> bot.send_message(
            target,
            <span class="hljs-string">f"🎁 Админ начислил тебе &lt;b&gt;<span class="hljs-subst">{parts[<span class="hljs-number">2</span>]}</span>&lt;/b&gt; монет!\n💰 Баланс: &lt;b&gt;<span class="hljs-subst">{tu[<span class="hljs-string">'balance'</span>]}</span>&lt;/b&gt;"</span>,
            reply_markup=panel_inline(tu[<span class="hljs-string">"balance"</span>]),
        )
    <span class="hljs-keyword">except</span> Exception:
        <span class="hljs-keyword">pass</span>

<span class="hljs-meta">@dp.message(<span class="hljs-params">F.text</span>)</span>
<span class="hljs-keyword">async</span> <span class="hljs-keyword">def</span> <span class="hljs-title function_">m_text</span>(<span class="hljs-params">message: Message</span>):
    u = get_user(message.from_user.<span class="hljs-built_in">id</span>)
    <span class="hljs-keyword">await</span> message.answer(<span class="hljs-string">"Не понял 🤔 Жми кнопку ОТКРЫТЬ 🦆"</span>, reply_markup=main_kb())

<span class="hljs-comment"># ============ ЗАПУСК ============</span>
<span class="hljs-keyword">async</span> <span class="hljs-keyword">def</span> <span class="hljs-title function_">main</span>():
    <span class="hljs-keyword">await</span> dp.start_polling(bot)

<span class="hljs-keyword">if</span> __name__ == <span class="hljs-string">"__main__"</span>:
    asyncio.run(main())
</code></pre></div></div></pre>
