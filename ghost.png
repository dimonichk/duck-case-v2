05c-.022 1.139-.105 1.826-.436 2.367a2.999 2.999 0 0 1-.99.99c-.542.332-1.23.415-2.368.436l-1.3.007h-.8c-1.841 0-2.82 0-3.529-.364l-.138-.078a2.999 2.999 0 0 1-.894-.842l-.097-.149C.611 13.527.528 12.84.507 11.7L.5 10.4v-.8c0-1.841 0-2.82.364-3.529l.078-.138a3 3 0 0 1 .842-.894l.149-.097c.572-.35 1.31-.422 2.572-.437.014-1.163.075-1.88.36-2.434l.077-.138a3 3 0 0 1 .842-.894l.149-.097C6.654.5 7.636.5 9.6.5h.8zM5.6 5.8c-1.007 0-1.672.002-2.177.05-.486.046-.69.126-.812.2a1.7 1.7 0 0 0-.56.561c-.075.122-.155.326-.201.812-.048.505-.05 1.17-.05 2.177v.8c0 1.007.002 1.672.05 2.177.046.486.126.69.2.812.14.228.333.42.561.56.122.075.326.155.812.201.505.048 1.17.05 2.177.05h.8c1.007 0 1.672-.002 2.177-.05.486-.046.69-.126.812-.2a1.7 1.7 0 0 0 .56-.561c.075-.122.155-.326.201-.812.048-.505.05-1.17.05-2.177v-.8c0-1.007-.002-1.672-.05-2.177-.046-.486-.126-.69-.2-.812a1.7 1.7 0 0 0-.561-.56c-.122-.075-.326-.155-.812-.201-.505-.048-1.17-.05-2.177-.05h-.8zm4-4c-1.007 0-1.672.002-2.177.05-.486.046-.69.126-.812.2a1.7 1.7 0 0 0-.56.561c-.075.122-.155.326-.201.812-.028.293-.039.64-.044 1.077H6.4l1.3.007c1.139.02 1.826.104 2.367.435.404.248.743.587.99.99.443.722.443 1.704.443 3.668v.592a13.38 13.38 0 0 0 1.076-.04c.486-.047.69-.127.812-.202a1.71 1.71 0 0 0 .561-.561c.075-.122.155-.326.201-.812.048-.505.05-1.17.05-2.177v-.8c0-1.007-.002-1.672-.05-2.177-.046-.486-.126-.69-.2-.812a1.7 1.7 0 0 0-.562-.56c-.122-.075-.326-.155-.812-.201-.505-.048-1.17-.05-2.177-.05h-.8z"></path></svg><span class="Button-Text">Копировать</span></button></div></div><div class="CodeBlock-Stopper"></div></div><div class="CodeBlock-Content" data-testid="codeblock-content"><pre class="CodeBlock-ContentPre" data-testid="codeblock-code"><code class="hljs language-python"><span class="hljs-meta">@dp.message(<span class="hljs-params">Command(<span class="hljs-params"><span class="hljs-string">"bonus"</span></span>)</span>)</span>
<span class="hljs-keyword">async</span> <span class="hljs-keyword">def</span> <span class="hljs-title function_">cmd_bonus</span>(<span class="hljs-params">message: Message</span>):
    u = get_user(message.from_user.<span class="hljs-built_in">id</span>)
    now = time.time()
    last = u.get(<span class="hljs-string">"last_bonus"</span>, <span class="hljs-number">0</span>)
    <span class="hljs-keyword">if</span> now - last &lt; <span class="hljs-number">43200</span>:
        left = <span class="hljs-built_in">int</span>((<span class="hljs-number">43200</span> - (now - last)) // <span class="hljs-number">60</span>)
        <span class="hljs-keyword">await</span> message.answer(
            <span class="hljs-string">f"⏳ Бонус будет доступен через <span class="hljs-subst">{left // <span class="hljs-number">60</span>}</span> ч <span class="hljs-subst">{left % <span class="hljs-number">60</span>}</span> мин."</span>,
            reply_markup=panel_inline(u[<span class="hljs-string">"balance"</span>]))
        <span class="hljs-keyword">return</span>
    u[<span class="hljs-string">"last_bonus"</span>] = now
    u[<span class="hljs-string">"balance"</span>] += <span class="hljs-number">100</span>
    save()
    <span class="hljs-keyword">await</span> message.answer(
        <span class="hljs-string">"🎁 Ежедневный бонус: +100 монет! Возвращайся через 12 часов."</span>,
        reply_markup=panel_inline(u[<span class="hljs-string">"balance"</span>]))

<span class="hljs-meta">@dp.message(<span class="hljs-params">Command(<span class="hljs-params"><span class="hljs-string">"top"</span></span>)</span>)</span>
<span class="hljs-keyword">async</span> <span class="hljs-keyword">def</span> <span class="hljs-title function_">cmd_top</span>(<span class="hljs-params">message: Message</span>):
    top = <span class="hljs-built_in">sorted</span>(users.items(), key=<span class="hljs-keyword">lambda</span> kv: kv[<span class="hljs-number">1</span>].get(<span class="hljs-string">"balance"</span>, <span class="hljs-number">0</span>), reverse=<span class="hljs-literal">True</span>)[:<span class="hljs-number">10</span>]
    lines = []
    <span class="hljs-keyword">for</span> i, (uid, u) <span class="hljs-keyword">in</span> <span class="hljs-built_in">enumerate</span>(top, <span class="hljs-number">1</span>):
        name = u.get(<span class="hljs-string">"username"</span>) <span class="hljs-keyword">or</span> u.get(<span class="hljs-string">"name"</span>) <span class="hljs-keyword">or</span> <span class="hljs-string">f"id<span class="hljs-subst">{uid}</span>"</span>
        medal = [<span class="hljs-string">"🥇"</span>, <span class="hljs-string">"🥈"</span>, <span class="hljs-string">"🥉"</span>][i - <span class="hljs-number">1</span>] <span class="hljs-keyword">if</span> i &lt;= <span class="hljs-number">3</span> <span class="hljs-keyword">else</span> <span class="hljs-string">f"<span class="hljs-subst">{i}</span>."</span>
        lines.append(<span class="hljs-string">f"<span class="hljs-subst">{medal}</span> @<span class="hljs-subst">{name}</span> — <span class="hljs-subst">{u.get(<span class="hljs-string">'balance'</span>, <span class="hljs-number">0</span>)}</span> 💰"</span>)
    <span class="hljs-keyword">await</span> message.answer(<span class="hljs-string">"🏆 &lt;b&gt;Топ игроков&lt;/b&gt;\n\n"</span> + <span class="hljs-string">"\n"</span>.join(lines))
</code></pre></div></div></pre>
<h2 class="FuturisMarkdown-Heading">3. Как добавить свои картинки к кейсам</h2>
<p>В панели сейчас показывается эмодзи-иконка кейса (она уже красивая). Если хочешь настоящие картинки:</p>
<ol><li data-value="1." data-shift="1">На GitHub в репозитории создай папку <code class="CodeInlined">images</code>.</li><li data-value="2." data-shift="1">Загрузи туда картинки с именами: <code class="CodeInlined">lucky.png</code>, <code class="CodeInlined">duck.png</code>, <code class="CodeInlined">golden.png</code>, <code class="CodeInlined">ruby.png</code>, <code class="CodeInlined">ghost.png</code>, <code class="CodeInlined">dragon.png</code> (горизонтальные, примерно 400×200).</li><li data-value="3." data-shift="1">Всё — код сам их подхватит. Если файла нет, покажет эмодзи и не сломается.</li></ol>
<p>Картинки можно взять любые тематические: для Lucky — подарок с бантом, для Ghost — призрак-подарок, и так далее. Если хочешь именно иконки реальных подарков ТГ — можешь заскринить нужные подарки из Telegram и залить их в <code class="CodeInlined">images</code> под этими же именами.</p>
<h2 class="FuturisMarkdown-Heading">4. Запуск</h2>
<ol><li data-value="1." data-shift="1">Все правки в <code class="CodeInlined">index.html</code> → Commit changes на GitHub.</li><li data-value="2." data-shift="1"><code class="CodeInlined">bot_case.py</code> → сохранить → Ctrl + C → <code class="CodeInlined">python bot_case.py</code>.</li><li data-value="3." data-shift="1"><code class="CodeInlined">/bonus</code> и <code class="CodeInlined">/top</code> проверь сразу в чате.</li><li data-value="4." data-shift="1"><code class="CodeInlined">/start</code> → «ОТКРЫТЬ 🦆» → свежая кнопка «🎰 ОТКРЫТЬ панель · … 💰».</li></ol>
<p>Открой пару Lucky Case — подарки должны падать почти в каждом открытии (шансы от 40%), а в чате бот напишет, что за подарок выпал. Если карточка кейса поедет или картинка не подхватится — скинь скрин 🙂</p></div></section></div></div></div><span data-testid="message-completion-marker" aria-hidden="true"></span><div class="StandaloneContextMenu-Container" data-testid="standalone-context-menu-container"><div class="StandaloneContextMenu" data-testid="context-menu-container"><div class="StandaloneContextMenu-MenuContainer"><menu class="StandaloneContextMenu-Menu"><li><button class="AliceButton AliceButton_pin_circle AliceButton_iconLeft AliceButton_square AliceButton_size_s AliceButton_view_tertiary StandaloneContextMenu-Button" aria-label="Копировать" data-testid="context-menu-copy-button"><div class="AliceButton-Icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M10.4.5c1.963 0 2.946 0 3.667.442a3 3 0 0 1 .99.99c.443.722.443 1.704.443 3.668v.8l-.007 1.301c-.02 1.139-.104 1.826-.435 2.367l-.097.149c-.236.338-.54.625-.894.842l-.138.078c-.52.267-1.186.338-2.229.357l-.206.001v.205c-.022 1.139-.105 1.826-.436 2.367a2.999 2.999 0 0 1-.99.99c-.542.332-1.23.415-2.368.436l-1.3.007h-.8c-1.841 0-2.82 0-3.529-.364l-.138-.078a2.999 2.999 0 0 1-.894-.842l-.097-.149C.611 13.527.528 12.84.507 11.7L.5 10.4v-.8c0-1.841 0-2.82.364-3.529l.078-.138a3 3 0 0 1 .842-.894l.149-.097c.572-.35 1.31-.422 2.572-.437.014-1.163.075-1.88.36-2.434l.077-.138a3 3 0 0 1 .842-.894l.149-.097C6.654.5 7.636.5 9.6.5h.8zM5.6 5.8c-1.007 0-1.672.002-2.177.05-.486.046-.69.126-.812.2a1.7 1.7 0 0 0-.56.561c-.075.122-.155.326-.201.812-.048.505-.05 1.17-.05 2.177v.8c0 1.007.002 1.672.05 2.177.046.486.126.69.2.812.14.228.333.42.561.56.122.075.326.155.812.201.505.048 1.17.05 2.177.05h.8c1.007 0 1.672-.002 2.177-.05.486-.046.69-.126.812-.2a1.7 1.7 0 0 0 .56-.561c.075-.122.155-.326.201-.812.048-.505.05-1.17.05-2.177v-.8c0-1.007-.002-