<span class="hljs-keyword">function</span> <span class="hljs-title function_">caseVisual</span>(<span class="hljs-params">c</span>){
  <span class="hljs-keyword">if</span>(c.<span class="hljs-property">img</span>){
    <span class="hljs-keyword">return</span> <span class="hljs-string">`&lt;img class="case-img" src="<span class="hljs-subst">${c.img}</span>" alt=""
      onerror="this.style.display='none';this.parentNode.querySelector('.case-fb').style.display='flex';"/&gt;
      &lt;div class="case-fb" style="display:none"&gt;<span class="hljs-subst">${c.emoji}</span>&lt;/div&gt;`</span>;
  }
  <span class="hljs-keyword">return</span> <span class="hljs-string">`&lt;div class="case-fb"&gt;<span class="hljs-subst">${c.emoji}</span>&lt;/div&gt;`</span>;
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">renderCases</span>(<span class="hljs-params"></span>){
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"cases-list"</span>).<span class="hljs-property">innerHTML</span> = cases.<span class="hljs-title function_">map</span>(<span class="hljs-function">(<span class="hljs-params">c,i</span>)=&gt;</span><span class="hljs-string">`
    &lt;div class="card" id="case-<span class="hljs-subst">${i}</span>"&gt;
      <span class="hljs-subst">${caseVisual(c)}</span>
      &lt;h3&gt;<span class="hljs-subst">${c.name}</span>&lt;/h3&gt;&lt;p class="price"&gt;<span class="hljs-subst">${c.price}</span> монет&lt;/p&gt;
      &lt;p class="muted"&gt;Шансы: <span class="hljs-subst">${c.items.map(it=&gt;it[<span class="hljs-number">0</span>]+<span class="hljs-string">" "</span>+it[<span class="hljs-number">1</span>]+<span class="hljs-string">"%"</span>).join(<span class="hljs-string">", "</span>)}</span>&lt;/p&gt;
      &lt;p class="muted"&gt;Подарки: <span class="hljs-subst">${c.gifts.map(gt=&gt;gt[<span class="hljs-number">0</span>]).join(<span class="hljs-string">", "</span>)}</span>&lt;/p&gt;
      &lt;button class="btn" onclick="buyCase(<span class="hljs-subst">${i}</span>)"&gt;Открыть&lt;/button&gt;
    &lt;/div&gt;`</span>).<span class="hljs-title function_">join</span>(<span class="hljs-string">""</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">pickCase</span>(<span class="hljs-params">c</span>){
  <span class="hljs-keyword">let</span> r = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">100</span>, t = <span class="hljs-number">0</span>;
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">const</span> it <span class="hljs-keyword">of</span> c.<span class="hljs-property">items</span>){ t += it[<span class="hljs-number">1</span>]; <span class="hljs-keyword">if</span>(r &lt;= t) <span class="hljs-keyword">return</span> it; }
  <span class="hljs-keyword">return</span> c.<span class="hljs-property">items</span>[c.<span class="hljs-property">items</span>.<span class="hljs-property">length</span>-<span class="hljs-number">1</span>];
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">pickGift</span>(<span class="hljs-params">c</span>){
  <span class="hljs-keyword">let</span> r = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">100</span>, t = <span class="hljs-number">0</span>;
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">const</span> gt <span class="hljs-keyword">of</span> c.<span class="hljs-property">gifts</span>){ t += gt[<span class="hljs-number">1</span>]; <span class="hljs-keyword">if</span>(r &lt;= t) <span class="hljs-keyword">return</span> gt[<span class="hljs-number">0</span>]; }
  <span class="hljs-keyword">return</span> <span class="hljs-literal">null</span>;
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">buyCase</span>(<span class="hljs-params">i</span>){
  <span class="hljs-keyword">const</span> c = cases[i];
  <span class="hljs-keyword">if</span>(stats.<span class="hljs-property">balance</span> &lt; c.<span class="hljs-property">price</span>){ <span class="hljs-title function_">toast</span>(<span class="hljs-string">`Не хватает монет: нужно <span class="hljs-subst">${c.price}</span>, у тебя <span class="hljs-subst">${stats.balance}</span>`</span>); <span class="hljs-keyword">return</span>; }
  stats.<span class="hljs-property">balance</span> -= c.<span class="hljs-property">price</span>;
  stats.<span class="hljs-property">opened</span>++;
  <span class="hljs-title function_">save</span>(); <span class="hljs-title function_">renderBal</span>();
  <span class="hljs-keyword">const</span> card = <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"case-"</span>+i);
  card.<span class="hljs-title function_">querySelector</span>(<span class="hljs-string">"button"</span>).<span class="hljs-property">disabled</span> = <span class="hljs-literal">true</span>;
  card.<span class="hljs-title function_">querySelector</span>(<span class="hljs-string">".price"</span>).<span class="hljs-property">textContent</span> = <span class="hljs-string">"открываем…"</span>;
  <span class="hljs-keyword">let</span> tick = <span class="hljs-number">0</span>;
  <span class="hljs-keyword">const</span> spin = <span class="hljs-built_in">setInterval</span>(<span class="hljs-function">()=&gt;</span>{
    <span class="hljs-keyword">const</span> it = c.<span class="hljs-property">items</span>[<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*c.<span class="hljs-property">items</span>.<span class="hljs-property">length</span>)];
    card.<span class="hljs-title function_">querySelector</span>(<span class="hljs-string">".price"</span>).<span class="hljs-property">textContent</span> = it[<span class="hljs-number">0</span>] + (it[<span class="hljs-number">0</span>].<span class="hljs-title function_">includes</span>(<span class="hljs-string">"ДЖЕКПОТ"</span>) ? <span class="hljs-string">" ✨"</span> : <span class="hljs-string">" …"</span>);
    tick++;
    <span class="hljs-keyword">if</span>(tick &gt; <span class="hljs-number">12</span>){
      <span class="hljs-built_in">clearInterval</span>(spin);
      <span class="hljs-keyword">const</span> item = <span class="hljs-title function_">pickCase</span>(c);
      <span class="hljs-keyword">const</span> giftDrop = <span class="hljs-title function_">pickGift</span>(c);
      <span class="hljs-keyword">if</span>(giftDrop) stats.<span class="hljs-property">gifts</span>[giftDrop] = (stats.<span class="hljs-property">gifts</span>[giftDrop] || <span class="hljs-number">0</span>) + <span class="hljs-number">1</span>;
      stats.<span class="hljs-property">balance</span> += item[<span class="hljs-number">2</span>];
      <span class="hljs-keyword">if</span>(item[<span class="hljs-number">2</span>] &gt; c.<span class="hljs-property">price</span>) stats.<span class="hljs-property">wins</span>++;
      <span class="hljs-title function_">save</span>(); <span class="hljs-title function_">renderBal</span>();
      <span class="hljs-keyword">const</span> jackpot = item[<span class="hljs-number">0</span>].<span class="hljs-title function_">includes</span>(<span class="hljs-string">"ДЖЕКПОТ"</span>);
      <span class="hljs-keyword">const</span> giftLine = giftDrop ? <span class="hljs-string">`&lt;p&gt;🎁 Подарок: &lt;b&gt;<span class="hljs-subst">${giftDrop}</span>&lt;/b&gt;&lt;/p&gt;`</span> : <span class="hljs-string">""</span>;
      card.<span class="hljs-property">innerHTML</span> = <span class="hljs-string">`&lt;h3&gt;<span class="hljs-subst">${c.name}</span>&lt;/h3&gt;
        <span class="hljs-subst">${giftLine}</span>
        &lt;p&gt;<span class="hljs-subst">${jackpot?<span class="hljs-string">"🎊 &lt;span class='jack'&gt;"</span>:<span class="hljs-string">"🎉 &lt;span class='win'&gt;"</span>}</span><span class="hljs-subst">${item[<span class="hljs-number">0</span>]}</span>&lt;/span&gt;&lt;/p&gt;
        &lt;p class="muted"&gt;−<span class="hljs-subst">${c.price}</span> за кейс · +<span class="hljs-subst">${item[<span class="hljs-number">2</span>]}</span> приз · баланс <span class="hljs-subst">${stats.balance}</span> 💰&lt;/p&gt;
        &lt;button class="btn" onclick="renderCases()"&gt;Открыть ещё&lt;/button&gt;`</span>;
      <span class="hljs-title function_">send</span>({<span class="hljs-attr">action</span>:<span class="hljs-string">"settle"</span>, <span class="hljs-attr">game</span>:<span class="hljs-string">"case"</span>, <span class="hljs-attr">bet</span>:c.<span class="hljs-property">price</span>, <span class="hljs-attr">net</span>:item[<span class="hljs-number">2</span>]-c.<span class="hljs-property">price</span>, <span class="hljs-attr">gift</span>:giftDrop});
    }
  }, <span class="hljs-number">100</span>);
}

<span class="hljs-comment">// ---------- ИГРЫ (в столбик) ----------</span>
<span class="hljs-keyword">const</span> games = [
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"bj"</span>,      <span class="hljs-attr">name</span>:<span class="hljs-string">"🃏 Блэкджек"</span>,             <span class="hljs-attr">desc</span>:<span class="hljs-string">"Набери 21 или больше дилера. Блэкджек x2.5, победа x1.9."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"mines"</span>,   <span class="hljs-attr">name</span>:<span class="hljs-string">"💣 Мины"</span>,                <span class="hljs-attr">desc</span>:<span class="hljs-string">"Поле 3×3, 3 мины. Каждый безопасный клик +35%."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"crash"</span>,   <span class="hljs-attr">name</span>:<span class="hljs-string">"📈 Краш"</span>,                <span class="hljs-attr">desc</span>:<span class="hljs-string">"Множитель растёт по +25%. Забирай до краша."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"flip"</span>,    <span class="hljs-attr">name</span>:<span class="hljs-string">"🪙 Орёл/Решка"</span>,          <span class="hljs-attr">desc</span>:<span class="hljs-string">"Угадай сторону монеты — x1.9."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"hl"</span>,      <span class="hljs-attr">name</span>:<span class="hljs-string">"📊 Больше/Меньше"</span>,        <span class="hljs-attr">desc</span>:<span class="hljs-string">"Следующее число больше или меньше? x1.9 за попытку."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"cards"</span>,   <span class="hljs-attr">name</span>:<span class="hljs-string">"🂠 Карты"</span>,               <span class="hljs-attr">desc</span>:<span class="hljs-string">"Угадай цвет карты — x1.95."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"rou"</span>,     <span class="hljs-attr">name</span>:<span class="hljs-string">"🎡 Рулетка"</span>,             <span class="hljs-attr">desc</span>:<span class="hljs-string">"Лента множителей от x0.2 до x10."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"slots"</span>,   <span class="hljs-attr">name</span>:<span class="hljs-string">"🎰 Слоты"</span>,               <span class="hljs-attr">desc</span>:<span class="hljs-string">"Три в ряд — до x10. Пара — x1.5."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"chicken"</span>, <span class="hljs-attr">name</span>:<span class="hljs-string">"🐔 Курица-перебежчица"</span>,   <span class="hljs-attr">desc</span>:<span class="hljs-string">"Веди курицу через дорогу: +30% за шаг."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"darts"</span>,   <span class="hljs-attr">name</span>:<span class="hljs-string">"🎯 Дартс"</span>,               <span class="hljs-attr">desc</span>:<span class="hljs-string">"Один бросок. Шансы жёсткие: промах 70%."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"dice"</span>,    <span class="hljs-attr">name</span>:<span class="hljs-string">"🎲 Кубики"</span>,              <span class="hljs-attr">desc</span>:<span class="hljs-string">"Два кубика против бота. Больше сумма — x1.9."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"cups"</span>,    <span class="hljs-attr">name</span>:<span class="hljs-string">"🥤 Стаканчики"</span>,          <span class="hljs-attr">desc</span>:<span class="hljs-string">"Под каким стаканом монета? Угадал — x2.7."</span>},
];
<span class="hljs-keyword">function</span> <span class="hljs-title function_">renderGames</span>(<span class="hljs-params"></span>){
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"games-list"</span>).<span class="hljs-property">innerHTML</span> = games.<span class="hljs-title function_">map</span>(<span class="hljs-function"><span class="hljs-params">gm</span>=&gt;</span><span class="hljs-string">`
    &lt;div class="card"&gt;
      &lt;h3&gt;<span class="hljs-subst">${gm.name}</span>&lt;/h3&gt;
      &lt;p class="muted"&gt;<span class="hljs-subst">${gm.desc}</span>&lt;/p&gt;
      &lt;button class="btn" onclick="startGame('<span class="hljs-subst">${gm.key}</span>')"&gt;Играть&lt;/button&gt;
    &lt;/div&gt;`</span>).<span class="hljs-title function_">join</span>(<span class="hljs-string">""</span>);
}
<span class="hljs-keyword">let</span> g = <span class="hljs-literal">null</span>;
<span class="hljs-keyword">function</span> <span class="hljs-title function_">startGame</span>(<span class="hljs-params">type</span>){
  g = {type};
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"games-list"</span>).<span class="hljs-property">style</span>.<span class="hljs-property">display</span>=<span class="hljs-string">"none"</span>;
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"game-area"</span>).<span class="hljs-property">style</span>.<span class="hljs-property">display</span>=<span class="hljs-string">"block"</span>;
  <span class="hljs-keyword">const</span> meta = games.<span class="hljs-title function_">find</span>(<span class="hljs-function"><span class="hljs-params">x</span>=&gt;</span>x.<span class="hljs-property">key</span>===type);
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;<span class="hljs-subst">${meta.name}</span>&lt;/h3&gt;&lt;p class="muted"&gt;<span class="hljs-subst">${meta.desc}</span>&lt;/p&gt;`</span>);
  <span class="hljs-title function_">askBet</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">menu</span>(<span class="hljs-params">html</span>){ <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"game-body"</span>).<span class="hljs-property">innerHTML</span> = html; }
<span class="hljs-keyword">function</span> <span class="hljs-title function_">backToMenu</span>(<span class="hljs-params"></span>){
  g = <span class="hljs-literal">null</span>;
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"games-list"</span>).<span class="hljs-property">style</span>.<span class="hljs-property">display</span>=<span class="hljs-string">"block"</span>;
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"game-area"</span>).<span class="hljs-property">style</span>.<span class="hljs-property">display</span>=<span class="hljs-string">"none"</span>;
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">askBet</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> prev = <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"game-body"</span>).<span class="hljs-property">innerHTML</span>;
  <span class="hljs-title function_">menu</span>(prev + <span class="hljs-string">`
    &lt;input class="inp" id="bet" type="number" placeholder="Ставка (от 10)"/&gt;
    &lt;button class="btn" onclick="placeBet()"&gt;Поставить&lt;/button&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">placeBet</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> a = <span class="hljs-built_in">parseInt</span>(<span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"bet"</span>).<span class="hljs-property">value</span>);
  <span class="hljs-keyword">if</span>(<span class="hljs-built_in">isNaN</span>(a) || a &lt; <span class="hljs-number">10</span>){ <span class="hljs-title function_">toast</span>(<span class="hljs-string">"Ставка от 10 монет"</span>); <span class="hljs-keyword">return</span>; }
  <span class="hljs-keyword">if</span>(stats.<span class="hljs-property">balance</span> &lt; a){ <span class="hljs-title function_">toast</span>(<span class="hljs-string">"Не хватает монет"</span>); <span class="hljs-keyword">return</span>; }
  stats.<span class="hljs-property">balance</span> -= a; <span class="hljs-title function_">save</span>(); <span class="hljs-title function_">renderBal</span>();
  g.<span class="hljs-property">bet</span> = a;
  <span class="hljs-keyword">const</span> start = {
    <span class="hljs-attr">bj</span>:bjDeal, <span class="hljs-attr">mines</span>:minesStart, <span class="hljs-attr">crash</span>:crashStart, <span class="hljs-attr">flip</span>:flipUI,
    <span class="hljs-attr">hl</span>:hlStart, <span class="hljs-attr">cards</span>:cardsUI, <span class="hljs-attr">rou</span>:rouStart, <span class="hljs-attr">slots</span>:slotsStart,
    <span class="hljs-attr">chicken</span>:chickenStart, <span class="hljs-attr">darts</span>:dartsStart, <span class="hljs-attr">dice</span>:diceStart, <span class="hljs-attr">cups</span>:cupsStart
  };
  start[g.<span class="hljs-property">type</span>]();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">endGame</span>(<span class="hljs-params">game, prize</span>){
  <span class="hljs-keyword">const</span> bet = g.<span class="hljs-property">bet</span> || <span class="hljs-number">0</span>;
  stats.<span class="hljs-property">balance</span> += prize;
  <span class="hljs-keyword">if</span>(prize &gt; bet) stats.<span class="hljs-property">wins</span>++;
  <span class="hljs-title function_">save</span>(); <span class="hljs-title function_">renderBal</span>();
  <span class="hljs-title function_">send</span>({<span class="hljs-attr">action</span>:<span class="hljs-string">"settle"</span>, game, bet, <span class="hljs-attr">net</span>: prize - bet});
}

<span class="hljs-comment">// --- Блэкджек ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">bjDeal</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> deck = [];
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> v=<span class="hljs-number">2</span>; v&lt;=<span class="hljs-number">10</span>; v++) <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> s=<span class="hljs-number">0</span>;s&lt;<span class="hljs-number">4</span>;s++) deck.<span class="hljs-title function_">push</span>(v);
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> s=<span class="hljs-number">0</span>;s&lt;<span class="hljs-number">12</span>;s++) deck.<span class="hljs-title function_">push</span>(<span class="hljs-number">10</span>);
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> s=<span class="hljs-number">0</span>;s&lt;<span class="hljs-number">4</span>;s++)  deck.<span class="hljs-title function_">push</span>(<span class="hljs-number">11</span>);
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> i=deck.<span class="hljs-property">length</span>-<span class="hljs-number">1</span>;i&gt;<span class="hljs-number">0</span>;i--){ <span class="hljs-keyword">const</span> j=<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*(i+<span class="hljs-number">1</span>)); <span class="hljs-keyword">const</span> tmp=deck[i]; deck[i]=deck[j]; deck[j]=tmp; }
  g.<span class="hljs-property">deck</span> = deck;
  g.<span class="hljs-property">player</span> = [deck.<span class="hljs-title function_">pop</span>(), deck.<span class="hljs-title function_">pop</span>()];
  g.<span class="hljs-property">dealer</span> = [deck.<span class="hljs-title function_">pop</span>(), deck.<span class="hljs-title function_">pop</span>()];
  <span class="hljs-title function_">bjRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">bjVal</span>(<span class="hljs-params">hand</span>){
  <span class="hljs-keyword">let</span> total = hand.<span class="hljs-title function_">reduce</span>(<span class="hljs-function">(<span class="hljs-params">a,b</span>)=&gt;</span>a+b,<span class="hljs-number">0</span>);
  <span class="hljs-keyword">let</span> aces = hand.<span class="hljs-title function_">filter</span>(<span class="hljs-function"><span class="hljs-params">x</span>=&gt;</span>x===<span class="hljs-number">11</span>).<span class="hljs-property">length</span>;
  <span class="hljs-keyword">while</span>(total &gt; <span class="hljs-number">21</span> &amp;&amp; aces &gt; <span class="hljs-number">0</span>){ total -= <span class="hljs-number">10</span>; aces--; }
  <span class="hljs-keyword">return</span> total;
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">bjRender</span>(<span class="hljs-params">msg</span>){
  msg = msg || <span class="hljs-string">""</span>;
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🃏 Блэкджек&lt;/h3&gt;
    &lt;p&gt;Твои карты: &lt;b&gt;<span class="hljs-subst">${g.player.join(<span class="hljs-string">", "</span>)}</span>&lt;/b&gt; (сумма &lt;b&gt;<span class="hljs-subst">${bjVal(g.player)}</span>&lt;/b&gt;)&lt;/p&gt;
    &lt;p class="muted"&gt;Дилер: 🂠 <span class="hljs-subst">${g.dealer[<span class="hljs-number">0</span>]}</span>, скрытая&lt;/p&gt;
    <span class="hljs-subst">${msg?<span class="hljs-string">`&lt;div class="log"&gt;<span class="hljs-subst">${msg}</span>&lt;/div&gt;`</span>:<span class="hljs-string">""</span>}</span>
    &lt;div class="row"&gt;
      &lt;button class="btn" onclick="bjHit()"&gt;🖐 Взять&lt;/button&gt;
      &lt;button class="btn green" onclick="bjStand()"&gt;✋ Хватит&lt;/button&gt;
    &lt;/div&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">bjHit</span>(<span class="hljs-params"></span>){
  g.<span class="hljs-property">player</span>.<span class="hljs-title function_">push</span>(g.<span class="hljs-property">deck</span>.<span class="hljs-title function_">pop</span>());
  <span class="hljs-keyword">if</span>(<span class="hljs-title function_">bjVal</span>(g.<span class="hljs-property">player</span>) &gt; <span class="hljs-number">21</span>){
    <span class="hljs-title function_">menu</span>(<span class="hljs-string">`🃏 Перебор <span class="hljs-subst">${bjVal(g.player)}</span>. Проигрыш <span class="hljs-subst">${g.bet}</span> 💸`</span>);
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"bj"</span>, <span class="hljs-number">0</span>); <span class="hljs-keyword">return</span>;
  }
  <span class="hljs-title function_">bjRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">bjStand</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">while</span>(<span class="hljs-title function_">bjVal</span>(g.<span class="hljs-property">dealer</span>) &lt; <span class="hljs-number">17</span>) g.<span class="hljs-property">dealer</span>.<span class="hljs-title function_">push</span>(g.<span class="hljs-property">deck</span>.<span class="hljs-title function_">pop</span>());
  <span class="hljs-keyword">const</span> p = <span class="hljs-title function_">bjVal</span>(g.<span class="hljs-property">player</span>), d = <span class="hljs-title function_">bjVal</span>(g.<span class="hljs-property">dealer</span>);
  <span class="hljs-keyword">const</span> isBJ = p === <span class="hljs-number">21</span> &amp;&amp; g.<span class="hljs-property">player</span>.<span class="hljs-property">length</span> === <span class="hljs-number">2</span>;
  <span class="hljs-keyword">let</span> prize, msg;
  <span class="hljs-keyword">if</span>(p &gt; <span class="hljs-number">21</span>){ prize = <span class="hljs-number">0</span>; msg = <span class="hljs-string">`Ты <span class="hljs-subst">${p}</span>, дилер <span class="hljs-subst">${d}</span>. Проигрыш <span class="hljs-subst">${g.bet}</span> 💸`</span>; }
  <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span>(isBJ &amp;&amp; d !== <span class="hljs-number">21</span>){ prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*<span class="hljs-number">2.5</span>); msg = <span class="hljs-string">`🃏 БЛЭКДЖЕК! +<span class="hljs-subst">${prize}</span>`</span>; }
  <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span>(d &gt; <span class="hljs-number">21</span> || p &gt; d){ prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*<span class="hljs-number">1.9</span>); msg = <span class="hljs-string">`🎉 Победа! <span class="hljs-subst">${p}</span> против <span class="hljs-subst">${d}</span>. +<span class="hljs-subst">${prize}</span>`</span>; }
  <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span>(p === d){ prize = g.<span class="hljs-property">bet</span>; msg = <span class="hljs-string">`🤝 Ничья — ставка возвращена`</span>; }
  <span class="hljs-keyword">else</span> { prize = <span class="hljs-number">0</span>; msg = <span class="hljs-string">`Ты <span class="hljs-subst">${p}</span>, дилер <span class="hljs-subst">${d}</span>. Проигрыш <span class="hljs-subst">${g.bet}</span> 💸`</span>; }
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`🃏 Ты: <span class="hljs-subst">${p}</span> | Дилер: <span class="hljs-subst">${d}</span>&lt;br&gt;<span class="hljs-subst">${msg}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"bj"</span>, prize);
}

<span class="hljs-comment">// --- Мины ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">minesStart</span>(<span class="hljs-params"></span>){
  g.<span class="hljs-property">bombs</span> = <span class="hljs-keyword">new</span> <span class="hljs-title class_">Set</span>();
  <span class="hljs-keyword">while</span>(g.<span class="hljs-property">bombs</span>.<span class="hljs-property">size</span> &lt; <span class="hljs-number">3</span>) g.<span class="hljs-property">bombs</span>.<span class="hljs-title function_">add</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">9</span>));
  g.<span class="hljs-property">opened</span> = <span class="hljs-keyword">new</span> <span class="hljs-title class_">Set</span>(); g.<span class="hljs-property">mult</span> = <span class="hljs-number">1.0</span>;
  <span class="hljs-title function_">minesRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">minesRender</span>(<span class="hljs-params">msg</span>){
  msg = msg || <span class="hljs-string">""</span>;
  <span class="hljs-keyword">let</span> cells = <span class="hljs-string">""</span>;
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> i=<span class="hljs-number">0</span>;i&lt;<span class="hljs-number">9</span>;i++) cells += <span class="hljs-string">`&lt;button onclick="minesClick(<span class="hljs-subst">${i}</span>)"&gt;<span class="hljs-subst">${g.opened.has(i)?<span class="hljs-string">"💎"</span>:<span class="hljs-string">"⬛"</span>}</span>&lt;/button&gt;`</span>;
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;💣 Мины&lt;/h3&gt;
    &lt;p class="muted"&gt;Открыто <span class="hljs-subst">${g.opened.size}</span>/6 безопасных · множитель x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>&lt;/p&gt;
    &lt;div class="mfield"&gt;<span class="hljs-subst">${cells}</span>&lt;/div&gt;
    <span class="hljs-subst">${msg?<span class="hljs-string">`&lt;div class="log"&gt;<span class="hljs-subst">${msg}</span>&lt;/div&gt;`</span>:<span class="hljs-string">""</span>}</span>
    &lt;div class="row"&gt;&lt;button class="btn green" onclick="minesCash()"&gt;💰 Забрать x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>&lt;/button&gt;&lt;/div&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">minesClick</span>(<span class="hljs-params">i</span>){
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">bombs</span>.<span class="hljs-title function_">has</span>(i)){
    <span class="hljs-title function_">menu</span>(<span class="hljs-string">`💣 &lt;b&gt;БУМ!&lt;/b&gt; Проигрыш <span class="hljs-subst">${g.bet}</span> 💸`</span>);
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"mines"</span>, <span class="hljs-number">0</span>); <span class="hljs-keyword">return</span>;
  }
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">opened</span>.<span class="hljs-title function_">has</span>(i)) <span class="hljs-keyword">return</span>;
  g.<span class="hljs-property">opened</span>.<span class="hljs-title function_">add</span>(i);
  g.<span class="hljs-property">mult</span> = +(g.<span class="hljs-property">mult</span>*<span class="hljs-number">1.35</span>).<span class="hljs-title function_">toFixed</span>(<span class="hljs-number">2</span>);
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">opened</span>.<span class="hljs-property">size</span> === <span class="hljs-number">6</span>){
    <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*g.<span class="hljs-property">mult</span>);
    <span class="hljs-title function_">menu</span>(<span class="hljs-string">`💎 Все безопасные клетки открыты! +<span class="hljs-subst">${prize}</span>`</span>);
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"mines"</span>, prize); <span class="hljs-keyword">return</span>;
  }
  <span class="hljs-title function_">minesRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">minesCash</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">opened</span>.<span class="hljs-property">size</span> === <span class="hljs-number">0</span>){ <span class="hljs-title function_">toast</span>(<span class="hljs-string">"Открой хотя бы одну клетку"</span>); <span class="hljs-keyword">return</span>; }
  <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*g.<span class="hljs-property">mult</span>);
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`💰 Забрал x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>! +<span class="hljs-subst">${prize}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"mines"</span>, prize);
}

<span class="hljs-comment">// --- Краш ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">crashStart</span>(<span class="hljs-params"></span>){
  g.<span class="hljs-property">point</span> = +(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">max</span>(<span class="hljs-number">1.01</span>, <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">min</span>(<span class="hljs-number">10</span>, <span class="hljs-number">0.95</span>/(<span class="hljs-number">1</span>-<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>())))).<span class="hljs-title function_">toFixed</span>(<span class="hljs-number">2</span>);
  g.<span class="hljs-property">mult</span> = <span class="hljs-number">1.0</span>;
  <span class="hljs-title function_">crashRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">crashRender</span>(<span class="hljs-params"></span>){
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;📈 Краш&lt;/h3&gt;
    &lt;p class="big" style="color:var(--accent)"&gt;x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>&lt;/p&gt;
    &lt;p class="muted"&gt;Ставка <span class="hljs-subst">${g.bet}</span>. Точка краша скрыта.&lt;/p&gt;
    &lt;div class="row"&gt;
      &lt;button class="btn" onclick="crashUp()"&gt;📈 Поднять&lt;/button&gt;
      &lt;button class="btn green" onclick="crashCash()"&gt;💰 Забрать&lt;/button&gt;
    &lt;/div&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">crashUp</span>(<span class="hljs-params"></span>){
  g.<span class="hljs-property">mult</span> = +(g.<span class="hljs-property">mult</span>*<span class="hljs-number">1.25</span>).<span class="hljs-title function_">toFixed</span>(<span class="hljs-number">2</span>);
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">mult</span> &gt;= g.<span class="hljs-property">point</span>){
    <span class="hljs-title function_">menu</span>(<span class="hljs-string">`💥 &lt;b&gt;КРАШ на x<span class="hljs-subst">${g.point.toFixed(<span class="hljs-number">2</span>)}</span>!&lt;/b&gt; Проигрыш <span class="hljs-subst">${g.bet}</span> 💸`</span>);
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"crash"</span>, <span class="hljs-number">0</span>); <span class="hljs-keyword">return</span>;
  }
  <span class="hljs-title function_">crashRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">crashCash</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*g.<span class="hljs-property">mult</span>);
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`💰 Забрал на x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>! +<span class="hljs-subst">${prize}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"crash"</span>, prize);
}

<span class="hljs-comment">// --- Орёл/Решка ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">flipUI</span>(<span class="hljs-params"></span>){
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🪙 Орёл или решка&lt;/h3&gt;
    &lt;div class="row"&gt;
      &lt;button class="btn" onclick="flipGo(0)"&gt;🦅 Орёл&lt;/button&gt;
      &lt;button class="btn green" onclick="flipGo(1)"&gt;🥇 Решка&lt;/button&gt;
    &lt;/div&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">flipGo</span>(<span class="hljs-params">choice</span>){
  <span class="hljs-keyword">const</span> res = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>() &lt; <span class="hljs-number">0.5</span> ? <span class="hljs-number">0</span> : <span class="hljs-number">1</span>;
  <span class="hljs-keyword">const</span> names = [<span class="hljs-string">"🦅 Орёл"</span>, <span class="hljs-string">"🥇 Решка"</span>];
  <span class="hljs-keyword">const</span> prize = choice === res ? <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*<span class="hljs-number">1.9</span>) : <span class="hljs-number">0</span>;
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`<span class="hljs-subst">${names[res]}</span>!&lt;br&gt;<span class="hljs-subst">${prize&gt;<span class="hljs-number">0</span> ? <span class="hljs-string">"🎉 +"</span>+prize : <span class="hljs-string">"💸 Проигрыш "</span>+g.bet}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"flip"</span>, prize);
}

<span class="hljs-comment">// --- Больше/Меньше ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">hlStart</span>(<span class="hljs-params"></span>){
  g.<span class="hljs-property">cur</span> = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">100</span>)+<span class="hljs-number">1</span>;
  g.<span class="hljs-property">mult</span> = <span class="hljs-number">1.0</span>;
  <span class="hljs-title function_">hlRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">hlRender</span>(<span class="hljs-params">msg</span>){
  msg = msg || <span class="hljs-string">""</span>;
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;📊 Больше/Меньше&lt;/h3&gt;
    &lt;p class="big"&gt;Число: &lt;b&gt;<span class="hljs-subst">${g.cur}</span>&lt;/b&gt;&lt;/p&gt;
    &lt;p class="muted"&gt;Множитель x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span> · ставка <span class="hljs-subst">${g.bet}</span>&lt;/p&gt;
    <span class="hljs-subst">${msg?<span class="hljs-string">`&lt;div class="log"&gt;<span class="hljs-subst">${msg}</span>&lt;/div&gt;`</span>:<span class="hljs-string">""</span>}</span>
    &lt;div class="row"&gt;
      &lt;button class="btn" onclick="hlGo(1)"&gt;⬆️ Больше&lt;/button&gt;
      &lt;button class="btn" onclick="hlGo(0)"&gt;⬇️ Меньше&lt;/button&gt;
      &lt;button class="btn green" onclick="hlCash()"&gt;💰 Забрать&lt;/button&gt;
    &lt;/div&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">hlGo</span>(<span class="hljs-params">up</span>){
  <span class="hljs-keyword">const</span> n = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">100</span>)+<span class="hljs-number">1</span>;
  <span class="hljs-keyword">const</span> ok = up ? n &gt; g.<span class="hljs-property">cur</span> : n &lt; g.<span class="hljs-property">cur</span>;
  <span class="hljs-keyword">if</span>(ok){
    g.<span class="hljs-property">mult</span> = +(g.<span class="hljs-property">mult</span>*<span class="hljs-number">1.9</span>).<span class="hljs-title function_">toFixed</span>(<span class="hljs-number">2</span>);
    g.<span class="hljs-property">cur</span> = n;
    <span class="hljs-title function_">hlRender</span>(<span class="hljs-string">`✅ Угадал! Следующее <span class="hljs-subst">${n}</span>. Множитель x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>`</span>);
  } <span class="hljs-keyword">else</span> {
    <span class="hljs-title function_">menu</span>(<span class="hljs-string">`❌ Число <span class="hljs-subst">${n}</span>. Проигрыш <span class="hljs-subst">${g.bet}</span> 💸`</span>);
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"hl"</span>, <span class="hljs-number">0</span>);
  }
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">hlCash</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">mult</span> === <span class="hljs-number">1.0</span>){ <span class="hljs-title function_">toast</span>(<span class="hljs-string">"Сначала сделай попытку"</span>); <span class="hljs-keyword">return</span>; }
  <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*g.<span class="hljs-property">mult</span>);
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`💰 Забрал x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>! +<span class="hljs-subst">${prize}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"hl"</span>, prize);
}

<span class="hljs-comment">// --- Карты ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">cardsUI</span>(<span class="hljs-params"></span>){
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🂠 Карты&lt;/h3&gt;
    &lt;div class="row"&gt;
      &lt;button class="btn red" onclick="cardsGo('red')"&gt;🔴 Красная&lt;/button&gt;
      &lt;button class="btn" onclick="cardsGo('black')"&gt;⚫ Чёрная&lt;/button&gt;
    &lt;/div&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">cardsGo</span>(<span class="hljs-params">choice</span>){
  <span class="hljs-keyword">const</span> res = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>() &lt; <span class="hljs-number">0.5</span> ? <span class="hljs-string">"red"</span> : <span class="hljs-string">"black"</span>;
  <span class="hljs-keyword">const</span> prize = choice === res ? <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*<span class="hljs-number">1.95</span>) : <span class="hljs-number">0</span>;
  <span class="hljs-keyword">const</span> laid = res === <span class="hljs-string">"red"</span> ? <span class="hljs-string">"🔴 Красная"</span> : <span class="hljs-string">"⚫ Чёрная"</span>;
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`Лежала: <span class="hljs-subst">${laid}</span>.&lt;br&gt;<span class="hljs-subst">${prize&gt;<span class="hljs-number">0</span> ? <span class="hljs-string">"🎉 +"</span>+prize : <span class="hljs-string">"💸 Проигрыш "</span>+g.bet}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"cards"</span>, prize);
}

<span class="hljs-comment">// --- Рулетка ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">rouStart</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> vals = [[<span class="hljs-number">0.2</span>,<span class="hljs-number">30</span>],[<span class="hljs-number">0.5</span>,<span class="hljs-number">25</span>],[<span class="hljs-number">1</span>,<span class="hljs-number">20</span>],[<span class="hljs-number">1.2</span>,<span class="hljs-number">10</span>],[<span class="hljs-number">2</span>,<span class="hljs-number">8</span>],[<span class="hljs-number">3</span>,<span class="hljs-number">4</span>],[<span class="hljs-number">5</span>,<span class="hljs-number">2</span>],[<span class="hljs-number">10</span>,<span class="hljs-number">1</span>]];
  <span class="hljs-keyword">function</span> <span class="hljs-title function_">pick</span>(<span class="hljs-params"></span>){
    <span class="hljs-keyword">let</span> r = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">100</span>, t = <span class="hljs-number">0</span>;
    <span class="hljs-keyword">for</span>(<span class="hljs-keyword">const</span> vw <span class="hljs-keyword">of</span> vals){ t += vw[<span class="hljs-number">1</span>]; <span class="hljs-keyword">if</span>(r &lt;= t) <span class="hljs-keyword">return</span> vw[<span class="hljs-number">0</span>]; }
    <span class="hljs-keyword">return</span> <span class="hljs-number">0.2</span>;
  }
  g.<span class="hljs-property">win</span> = <span class="hljs-title function_">pick</span>();
  g.<span class="hljs-property">strip</span> = [];
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> i=<span class="hljs-number">0</span>;i&lt;<span class="hljs-number">50</span>;i++) g.<span class="hljs-property">strip</span>.<span class="hljs-title function_">push</span>(<span class="hljs-title function_">pick</span>());
  <span class="hljs-keyword">const</span> <span class="hljs-variable constant_">FIX</span> = <span class="hljs-number">40</span>;
  g.<span class="hljs-property">strip</span>[<span class="hljs-variable constant_">FIX</span>] = g.<span class="hljs-property">win</span>;
  <span class="hljs-keyword">let</span> cells = <span class="hljs-string">""</span>;
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> i=<span class="hljs-number">0</span>;i&lt;g.<span class="hljs-property">strip</span>.<span class="hljs-property">length</span>;i++){
    <span class="hljs-keyword">const</span> v = g.<span class="hljs-property">strip</span>[i];
    <span class="hljs-keyword">const</span> cls = v&gt;=<span class="hljs-number">5</span>?<span class="hljs-string">"cell gold"</span>:v&gt;=<span class="hljs-number">2</span>?<span class="hljs-string">"cell green"</span>:v&gt;=<span class="hljs-number">1</span>?<span class="hljs-string">"cell blue"</span>:<span class="hljs-string">"cell dim"</span>;
    cells += <span class="hljs-string">`&lt;div class="<span class="hljs-subst">${cls}</span>"&gt;x<span class="hljs-subst">${v}</span>&lt;/div&gt;`</span>;
  }
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🎡 Рулетка&lt;/h3&gt;
    &lt;p class="muted"&gt;Ставка <span class="hljs-subst">${g.bet}</span>. Лента останавливается на множителе:&lt;/p&gt;
    &lt;div class="rou-wrap"&gt;&lt;div class="rou-mark"&gt;&lt;/div&gt;&lt;div class="rou-strip" id="roustrip"&gt;<span class="hljs-subst">${cells}</span>&lt;/div&gt;&lt;/div&gt;
    &lt;div id="rou-result"&gt;&lt;/div&gt;`</span>);
  <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">()=&gt;</span>{
    <span class="hljs-keyword">const</span> <span class="hljs-variable constant_">CELL</span> = <span class="hljs-number">62</span>;
    <span class="hljs-keyword">const</span> wrap = <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">querySelector</span>(<span class="hljs-string">".rou-wrap"</span>);
    <span class="hljs-keyword">const</span> offset = <span class="hljs-variable constant_">FIX</span>*<span class="hljs-variable constant_">CELL</span> + <span class="hljs-number">31</span> - wrap.<span class="hljs-property">clientWidth</span>/<span class="hljs-number">2</span>;
    <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"roustrip"</span>).<span class="hljs-property">style</span>.<span class="hljs-property">transform</span> = <span class="hljs-string">`translateX(-<span class="hljs-subst">${offset}</span>px)`</span>;
  }, <span class="hljs-number">50</span>);
  <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">()=&gt;</span>{
    <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span> * g.<span class="hljs-property">win</span>);
    <span class="hljs-keyword">const</span> res = prize &gt; g.<span class="hljs-property">bet</span> ? <span class="hljs-string">` — 🎉 +<span class="hljs-subst">${prize - g.bet}</span>`</span> : (prize === g.<span class="hljs-property">bet</span> ? <span class="hljs-string">` — 🤝 в ноль`</span> : <span class="hljs-string">` — 💸 -<span class="hljs-subst">${g.bet - prize}</span>`</span>);
    <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"rou-result"</span>).<span class="hljs-property">innerHTML</span> = <span class="hljs-string">`&lt;div class="log"&gt;🎡 Выпало &lt;b&gt;x<span class="hljs-subst">${g.win}</span>&lt;/b&gt;<span class="hljs-subst">${res}</span>&lt;/div&gt;`</span>;
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"rou"</span>, prize);
  }, <span class="hljs-number">3300</span>);
}

<span class="hljs-comment">// --- Слоты ---</span>
<span class="hljs-keyword">const</span> <span class="hljs-variable constant_">SLOT_SYMS</span> = [<span class="hljs-string">"🍒"</span>,<span class="hljs-string">"🍋"</span>,<span class="hljs-string">"🍊"</span>,<span class="hljs-string">"💎"</span>,<span class="hljs-string">"7️⃣"</span>];
<span class="hljs-keyword">const</span> <span class="hljs-variable constant_">SLOT_W</span> = [<span class="hljs-number">30</span>,<span class="hljs-number">25</span>,<span class="hljs-number">20</span>,<span class="hljs-number">15</span>,<span class="hljs-number">10</span>];
<span class="hljs-keyword">const</span> <span class="hljs-variable constant_">SLOT_TRIPLE</span> = [<span class="hljs-number">2</span>,<span class="hljs-number">3</span>,<span class="hljs-number">4</span>,<span class="hljs-number">6</span>,<span class="hljs-number">10</span>];
<span class="hljs-keyword">function</span> <span class="hljs-title function_">slotsStart</span>(<span class="hljs-params"></span>){
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🎰 Слоты&lt;/h3&gt;
    &lt;p class="muted"&gt;Ставка <span class="hljs-subst">${g.bet}</span>. Три одинаковых — крупный приз, пара — x1.5.&lt;/p&gt;
    &lt;div class="reels"&gt;
      &lt;div class="reel" id="r0"&gt;🍒&lt;/div&gt;&lt;div class="reel" id="r1"&gt;🍋&lt;/div&gt;&lt;div class="reel" id="r2"&gt;🍊&lt;/div&gt;
    &lt;/div&gt;
    &lt;div id="slot-result"&gt;&lt;/div&gt;`</span>);
  <span class="hljs-keyword">const</span> result = <span class="hljs-variable constant_">SLOT_SYMS</span>.<span class="hljs-title function_">map</span>(<span class="hljs-function">(<span class="hljs-params">_,i</span>)=&gt;</span>{
    <span class="hljs-keyword">let</span> r = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">100</span>, t = <span class="hljs-number">0</span>;
    <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> j=<span class="hljs-number">0</span>;j&lt;<span class="hljs-variable constant_">SLOT_SYMS</span>.<span class="hljs-property">length</span>;j++){ t += <span class="hljs-variable constant_">SLOT_W</span>[j]; <span class="hljs-keyword">if</span>(r &lt;= t) <span class="hljs-keyword">return</span> j; }
    <span class="hljs-keyword">return</span> <span class="hljs-number">0</span>;
  });
  <span class="hljs-keyword">let</span> tick = <span class="hljs-number">0</span>;
  <span class="hljs-keyword">const</span> anim = <span class="hljs-built_in">setInterval</span>(<span class="hljs-function">()=&gt;</span>{
    <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> i=<span class="hljs-number">0</span>;i&lt;<span class="hljs-number">3</span>;i++)
      <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"r"</span>+i).<span class="hljs-property">textContent</span> = <span class="hljs-variable constant_">SLOT_SYMS</span>[<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-variable constant_">SLOT_SYMS</span>.<span class="hljs-property">length</span>)];
    tick++;
    <span class="hljs-keyword">if</span>(tick &gt; <span class="hljs-number">14</span>){
      <span class="hljs-built_in">clearInterval</span>(anim);
      <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> i=<span class="hljs-number">0</span>;i&lt;<span class="hljs-number">3</span>;i++) <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"r"</span>+i).<span class="hljs-property">textContent</span> = <span class="hljs-variable constant_">SLOT_SYMS</span>[result[i]];
      <span class="hljs-keyword">let</span> prize;
      <span class="hljs-keyword">if</span>(result[<span class="hljs-number">0</span>]===result[<span class="hljs-number">1</span>] &amp;&amp; result[<span class="hljs-number">1</span>]===result[<span class="hljs-number">2</span>]){
        prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span> * <span class="hljs-variable constant_">SLOT_TRIPLE</span>[result[<span class="hljs-number">0</span>]]);
        <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"slot-result"</span>).<span class="hljs-property">innerHTML</span> =
          <span class="hljs-string">`&lt;div class="log"&gt;🎰 ТРИ В РЯД! 🎉 +<span class="hljs-subst">${prize}</span>&lt;/div&gt;`</span>;
      } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span>(result[<span class="hljs-number">0</span>]===result[<span class="hljs-number">1</span>] || result[<span class="hljs-number">1</span>]===result[<span class="hljs-number">2</span>] || result[<span class="hljs-number">0</span>]===result[<span class="hljs-number">2</span>]){
        prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span> * <span class="hljs-number">1.5</span>);
        <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"slot-result"</span>).<span class="hljs-property">innerHTML</span> =
          <span class="hljs-string">`&lt;div class="log"&gt;🎰 Пара! 🎉 +<span class="hljs-subst">${prize}</span>&lt;/div&gt;`</span>;
      } <span class="hljs-keyword">else</span> {
        prize = <span class="hljs-number">0</span>;
        <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"slot-result"</span>).<span class="hljs-property">innerHTML</span> =
          <span class="hljs-string">`&lt;div class="log"&gt;🎰 Не сошлось. 💸 Проигрыш <span class="hljs-subst">${g.bet}</span>&lt;/div&gt;`</span>;
      }
      <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"slots"</span>, prize);
    }
  }, <span class="hljs-number">120</span>);
}

<span class="hljs-comment">// --- Курица-перебежчица ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">chickenStart</span>(<span class="hljs-params"></span>){
  g.<span class="hljs-property">step</span> = <span class="hljs-number">0</span>; g.<span class="hljs-property">mult</span> = <span class="hljs-number">1.0</span>;
  <span class="hljs-title function_">chickenRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">chickenRender</span>(<span class="hljs-params">msg</span>){
  msg = msg || <span class="hljs-string">""</span>;
  <span class="hljs-keyword">let</span> road = <span class="hljs-string">""</span>;
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> i=<span class="hljs-number">0</span>;i&lt;=g.<span class="hljs-property">step</span>;i++) road += <span class="hljs-string">"🛣️"</span>;
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🐔 Курица-перебежчица&lt;/h3&gt;
    &lt;p class="big"&gt;🐔<span class="hljs-subst">${road}</span>&lt;/p&gt;
    &lt;p class="muted"&gt;Шагов: <span class="hljs-subst">${g.step}</span>/10 · множитель x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span> · ставка <span class="hljs-subst">${g.bet}</span>&lt;/p&gt;
    <span class="hljs-subst">${msg?<span class="hljs-string">`&lt;div class="log"&gt;<span class="hljs-subst">${msg}</span>&lt;/div&gt;`</span>:<span class="hljs-string">""</span>}</span>
    &lt;div class="row"&gt;
      &lt;button class="btn" onclick="chickenStep()"&gt;🐔 Шаг&lt;/button&gt;
      &lt;button class="btn green" onclick="chickenCash()"&gt;💰 Забрать x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>&lt;/button&gt;
    &lt;/div&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">chickenStep</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">if</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>() &gt; <span class="hljs-number">0.72</span>){
    <span class="hljs-title function_">menu</span>(<span class="hljs-string">`🚗💨 &lt;b&gt;МАШИНА!&lt;/b&gt; Курица не добежала. Проигрыш <span class="hljs-subst">${g.bet}</span> 💸`</span>);
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"chicken"</span>, <span class="hljs-number">0</span>); <span class="hljs-keyword">return</span>;
  }
  g.<span class="hljs-property">step</span>++;
  g.<span class="hljs-property">mult</span> = +(g.<span class="hljs-property">mult</span>*<span class="hljs-number">1.3</span>).<span class="hljs-title function_">toFixed</span>(<span class="hljs-number">2</span>);
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">step</span> &gt;= <span class="hljs-number">10</span>){
    <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*g.<span class="hljs-property">mult</span>);
    <span class="hljs-title function_">menu</span>(<span class="hljs-string">`🐔🏆 Курица перебежала ВСЮ дорогу! +<span class="hljs-subst">${prize}</span>`</span>);
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"chicken"</span>, prize); <span class="hljs-keyword">return</span>;
  }
  <span class="hljs-title function_">chickenRender</span>(<span class="hljs-string">"✅ Успешно!"</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">chickenCash</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">step</span> === <span class="hljs-number">0</span>){ <span class="hljs-title function_">toast</span>(<span class="hljs-string">"Сделай хотя бы один шаг"</span>); <span class="hljs-keyword">return</span>; }
  <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*g.<span class="hljs-property">mult</span>);
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`🐔💨 Забрал на x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>! +<span class="hljs-subst">${prize}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"chicken"</span>, prize);
}

<span class="hljs-comment">// --- Дартс ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">dartsStart</span>(<span class="hljs-params"></span>){
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🎯 Дартс&lt;/h3&gt;
    &lt;p class="muted"&gt;Ставка <span class="hljs-subst">${g.bet}</span>. Один бросок:&lt;/p&gt;
    &lt;p class="big" id="dart-emoji"&gt;🎯&lt;/p&gt;
    &lt;div id="dart-result"&gt;&lt;/div&gt;
    &lt;button class="btn" onclick="dartsGo()"&gt;🎯 Метнуть&lt;/button&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">dartsGo</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> sectors = [
    [<span class="hljs-string">"Промах"</span>, <span class="hljs-number">70</span>, <span class="hljs-number">0</span>],
    [<span class="hljs-string">"Край мишени x1"</span>, <span class="hljs-number">12</span>, <span class="hljs-number">1</span>],
    [<span class="hljs-string">"Двойка x2"</span>, <span class="hljs-number">10</span>, <span class="hljs-number">2</span>],
    [<span class="hljs-string">"Красный x5"</span>, <span class="hljs-number">6</span>, <span class="hljs-number">5</span>],
    [<span class="hljs-string">"БЫК x10"</span>, <span class="hljs-number">2</span>, <span class="hljs-number">10</span>],
  ];
  <span class="hljs-keyword">let</span> r = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">100</span>, t = <span class="hljs-number">0</span>, pick = sectors[<span class="hljs-number">0</span>];
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">const</span> s <span class="hljs-keyword">of</span> sectors){ t += s[<span class="hljs-number">1</span>]; <span class="hljs-keyword">if</span>(r &lt;= t){ pick = s; <span class="hljs-keyword">break</span>; } }
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"dart-emoji"</span>).<span class="hljs-property">textContent</span> = pick[<span class="hljs-number">2</span>]===<span class="hljs-number">0</span> ? <span class="hljs-string">"😵"</span> : (pick[<span class="hljs-number">2</span>]===<span class="hljs-number">10</span> ? <span class="hljs-string">"🤯"</span> : <span class="hljs-string">"🎯"</span>);
  <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span> * pick[<span class="hljs-number">2</span>]);
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"dart-result"</span>).<span class="hljs-property">innerHTML</span> =
    <span class="hljs-string">`&lt;div class="log"&gt;<span class="hljs-subst">${pick[<span class="hljs-number">0</span>]}</span>.<span class="hljs-subst">${prize&gt;<span class="hljs-number">0</span> ? <span class="hljs-string">" 🎉 +"</span>+prize : <span class="hljs-string">" 💸 Проигрыш "</span>+g.bet}</span>&lt;/div&gt;`</span>;
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"darts"</span>, prize);
}

<span class="hljs-comment">// --- Кубики ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">diceStart</span>(<span class="hljs-params"></span>){
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🎲 Кубики&lt;/h3&gt;
    &lt;p class="muted"&gt;Ставка <span class="hljs-subst">${g.bet}</span>. Бросай — сравним с ботом.&lt;/p&gt;
    &lt;p class="big" id="dice-view"&gt;🎲🎲&lt;/p&gt;
    &lt;div id="dice-result"&gt;&lt;/div&gt;
    &lt;button class="btn" onclick="diceGo()"&gt;🎲 Бросить&lt;/button&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">diceGo</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> <span class="hljs-title function_">die</span> = (<span class="hljs-params"></span>) =&gt; <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">6</span>)+<span class="hljs-number">1</span>;
  <span class="hljs-keyword">let</span> tick = <span class="hljs-number">0</span>;
  <span class="hljs-keyword">const</span> anim = <span class="hljs-built_in">setInterval</span>(<span class="hljs-function">()=&gt;</span>{
    <span class="hljs-keyword">const</span> d = [<span class="hljs-string">"⚀"</span>,<span class="hljs-string">"⚁"</span>,<span class="hljs-string">"⚂"</span>,<span class="hljs-string">"⚃"</span>,<span class="hljs-string">"⚄"</span>,<span class="hljs-string">"⚅"</span>];
    <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"dice-view"</span>).<span class="hljs-property">textContent</span> = d[<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">6</span>)] + d[<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">6</span>)];
    tick++;
    <span class="hljs-keyword">if</span>(tick &gt; <span class="hljs-number">12</span>){
      <span class="hljs-built_in">clearInterval</span>(anim);
      <span class="hljs-keyword">const</span> mine = <span class="hljs-title function_">die</span>()+<span class="hljs-title function_">die</span>(), bot = <span class="hljs-title function_">die</span>()+<span class="hljs-title function_">die</span>();
      <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"dice-view"</span>).<span class="hljs-property">textContent</span> = <span class="hljs-string">`Ты <span class="hljs-subst">${mine}</span> : <span class="hljs-subst">${bot}</span> Бот`</span>;
      <span class="hljs-keyword">let</span> prize, msg;
      <span class="hljs-keyword">if</span>(mine &gt; bot){ prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*<span class="hljs-number">1.9</span>); msg = <span class="hljs-string">`🎉 Победа! +<span class="hljs-subst">${prize}</span>`</span>; }
      <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span>(mine === bot){ prize = g.<span class="hljs-property">bet</span>; msg = <span class="hljs-string">`🤝 Ничья — ставка возвращена`</span>; }
      <span class="hljs-keyword">else</span> { prize = <span class="hljs-number">0</span>; msg = <span class="hljs-string">`💸 Проигрыш <span class="hljs-subst">${g.bet}</span>`</span>; }
      <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"dice-result"</span>).<span class="hljs-property">innerHTML</span> = <span class="hljs-string">`&lt;div class="log"&gt;<span class="hljs-subst">${msg}</span>&lt;/div&gt;`</span>;
      <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"dice"</span>, prize);
    }
  }, <span class="hljs-number">90</span>);
}

<span class="hljs-comment">// --- Стаканчики ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">cupsStart</span>(<span class="hljs-params"></span>){
  g.<span class="hljs-property">ball</span> = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">3</span>);
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🥤 Стаканчики&lt;/h3&gt;
    &lt;p class="muted"&gt;Ставка <span class="hljs-subst">${g.bet}</span>. Под одним из трёх стаканов монета 🪙&lt;/p&gt;
    &lt;div class="row" style="justify-content:center"&gt;
      &lt;button class="btn small" onclick="cupsGo(0)"&gt;🥤 1&lt;/button&gt;
      &lt;button class="btn small" onclick="cupsGo(1)"&gt;🥤 2&lt;/button&gt;
      &lt;button class="btn small" onclick="cupsGo(2)"&gt;🥤 3&lt;/button&gt;
    &lt;/div&gt;
    &lt;div id="cups-result"&gt;&lt;/div&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">cupsGo</span>(<span class="hljs-params">choice</span>){
  <span class="hljs-keyword">const</span> hit = choice === g.<span class="hljs-property">ball</span>;
  <span class="hljs-keyword">const</span> prize = hit ? <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*<span class="hljs-number">2.7</span>) : <span class="hljs-number">0</span>;
  <span class="hljs-keyword">const</span> reveal = [<span class="hljs-number">0</span>,<span class="hljs-number">1</span>,<span class="hljs-number">2</span>].<span class="hljs-title function_">map</span>(<span class="hljs-function"><span class="hljs-params">i</span>=&gt;</span> i===g.<span class="hljs-property">ball</span> ? <span class="hljs-string">"🪙"</span> : <span class="hljs-string">"🥤"</span>).<span class="hljs-title function_">join</span>(<span class="hljs-string">" "</span>);
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"cups-result"</span>).<span class="hljs-property">innerHTML</span> =
    <span class="hljs-string">`&lt;div class="log"&gt;Стаканы: <span class="hljs-subst">${reveal}</span>&lt;br&gt;<span class="hljs-subst">${hit ? <span class="hljs-string">"🎉 Угадал! +"</span>+prize : <span class="hljs-string">"💸 Мимо. Проигрыш "</span>+g.bet}</span>&lt;/div&gt;`</span>;
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"cups"</span>, prize);
}

<span class="hljs-comment">// ---------- ПОДАРКИ ----------</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">renderGifts</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> el = <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"gifts-list"</span>);
  <span class="hljs-keyword">const</span> keys = <span class="hljs-title class_">Object</span>.<span class="hljs-title function_">keys</span>(stats.<span class="hljs-property">gifts</span>);
  <span class="hljs-keyword">if</span>(!keys.<span class="hljs-property">length</span>){
    el.<span class="hljs-property">innerHTML</span> = <span class="hljs-string">`&lt;p class="muted"&gt;Пока пусто. Открывай кейсы — подарки будут падать отсюда же.&lt;/p&gt;`</span>;
    <span class="hljs-keyword">return</span>;
  }
  el.<span class="hljs-property">innerHTML</span> = keys.<span class="hljs-title function_">map</span>(<span class="hljs-function"><span class="hljs-params">k</span>=&gt;</span><span class="hljs-string">`&lt;div class="gift-item"&gt;&lt;span&gt;<span class="hljs-subst">${k}</span>&lt;/span&gt;&lt;b&gt;×<span class="hljs-subst">${stats.gifts[k]}</span>&lt;/b&gt;&lt;/div&gt;`</span>).<span class="hljs-title function_">join</span>(<span class="hljs-string">""</span>);
}

<span class="hljs-comment">// ---------- ПОДДЕРЖКА ----------</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">goSupport</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">if</span>(tg.<span class="hljs-property">openTelegramLink</span>) tg.<span class="hljs-title function_">openTelegramLink</span>(<span class="hljs-string">"https://t.me/tsartixc"</span>);
  <span class="hljs-keyword">else</span> <span class="hljs-variable language_">window</span>.<span class="hljs-title function_">open</span>(<span class="hljs-string">"https://t.me/tsartixc"</span>,<span class="hljs-string">"_blank"</span>);
}

<span class="hljs-title function_">renderCases</span>(); <span class="hljs-title function_">renderGames</span>(); <span class="hljs-title function_">renderBal</span>(); <span class="hljs-title function_">renderGifts</span>();
</span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span>&gt;</span>
<span class="hljs-tag">&lt;/<span class="hljs-name">body</span>&gt;</span>
<span class="hljs-tag">&lt;/<span class="hljs-name">html</span>&gt;</span>
</code></pre></div></div></pre>
<h2 class="FuturisMarkdown-Heading">3. Запуск</h2>
<ol><li data-value="1." data-shift="1"><code class="CodeInlined">index.html</code> на GitHub → Commit changes.</li><li data-value="2." data-shift="1">В <code class="CodeInlined">bot_case.py</code> вставь свой токен → сохрани → Ctrl + C → <code class="CodeInlined">python bot_case.py</code>.</li><li data-value="3." data-shift="1">Проверь <code class="CodeInlined">/bonus</code> и <code class="CodeInlined">/top</code> в чате, потом <code class="CodeInlined">/start</code> → «ОТКРЫТЬ 🦆» → свежая кнопка панели.</li></ol>
<h2 class="FuturisMarkdown-Heading">Про картинки кейсов</h2>
<p>Пока у кейсов показываются большие эмодзи (это уже выглядит нормально). Если хочешь настоящие картинки — на GitHub создай папку <code class="CodeInlined">images</code> и залей туда файлы с именами <code class="CodeInlined">lucky.png</code>, <code class="CodeInlined">duck.png</code>, <code class="CodeInlined">golden.png</code>, <code class="CodeInlined">ruby.png</code>, <code class="CodeInlined">ghost.png</code>, <code class="CodeInlined">dragon.png</code> (примерно 400×200). Код подхватит их автоматически, а если файла нет — покажет эмодзи и не сломается.</p>
<p>Открой пару кейсов и глянь вкладку «Подарки» — коллекция должна наполняться. Если что-то поедет, скрин сюда 🙂</p></div></section></div></div></div><span data-testid="message-completion-marker" aria-hidden="true"></span><div class="StandaloneContextMenu-Container" data-testid="standalone-context-menu-container"><div class="StandaloneContextMenu" data-testid="context-menu-container"><div class="StandaloneContextMenu-MenuContainer"><menu class="StandaloneContextMenu-Menu"><li><button class="AliceButton AliceButton_pin_circle AliceButton_iconLeft AliceButton_square AliceButton_size_s AliceButton_view_tertiary StandaloneContextMenu-Button" aria-label="Копировать" data-testid="context-menu-copy-button"><div class="AliceButton-Icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M10.4.5c1.963 0 2.946 0 3.667.442a3 3 0 0 1 .99.99c.443.722.443 1.704.443 3.668v.8l-.007 1.301c-.02 1.139-.104 1.826-.435 2.367l-.097.149c-.236.338-.54.625-.894.842l-.138.078c-.52.267-1.186.338-2.229.357l-.206.001v.205c-.022 1.139-.105 1.826-.436 2.367a2.999 2.999 0 0 1-.99.99c-.542.332-1.23.415-2.368.436l-1.3.007h-.8c-1.841 0-2.82 0-3.529-.364l-.138-.078a2.999 2.999 0 0 1-.894-.842l-.097-.149C.611 13.527.528 12.84.507 11.7L.5 10.4v-.8c0-1.841 0-2.82.364-3.529l.078-.138a3 3 0 0 1 .842-.894l.149-.097c.572-.35 1.31-.422 2.572-.437.014-1.163.075-1.88.36-2.434l.077-.138a3 3 0 0 1 .842-.894l.149-.097C6.654.5 7.636.5 9.6.5h.8zM5.6 5.8c-1.007 0-1.672.002-2.177.05-.486.046-.69.126-.812.2a1.7 1.7 0 0 0-.56.561c-.075.122-.155.326-.201.812-.048.505-.05 1.17-.05 2.177v.8c0 1.007.002 1.672.05 2.177.046.486.126.69.2.812.14.228.333.42.561.56.122.075.326.155.812.201.505.048 1.17.05 2.177.05h.8c1.007 0 1.672-.002 2.177-.05.486-.046.69-.126.812-.2a1.7 1.7 0 0 0 .56-.561c.075-.122.155-.326.201-.812.048-.505.05-1.17.05-2.177v-.8c0-1.007-.002-1.672-.05-2.177-.046-.486-.126-.69-.2-.812a1.7 1.7 0 0 0-.561-.56c-.122-.075-.326-.155-.812-