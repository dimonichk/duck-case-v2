то ты умеешь?","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.33d67a0c94cccd64"}}],"suggestSetId":"household","i18n":{"accessibilityText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.8632eeacac014523","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.8176a27fafd0ba59"}}],"updatedAt":""},"scheduler_test":{"suggests":[{"id":"b2c-cinema-scheduler","canEdit":true,"surfaces":["scheduled-tasks"],"pinned":false,"accessibilityText":"Купить билеты","content":[{"type":"image","image":{"light":"https://avatars.mds.yandex.net/get-dialogs/1525540/57f47f6a-3288-48a1-bd74-14ba5adae4a7/orig","dark":"https://avatars.mds.yandex.net/get-dialogs/998463/c5e293c3-f938-48b1-84ab-7a3da296df10/orig"},"size":16},{"type":"text","text":" Купить билеты","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.e43f313d7d746a5f"}}],"deeplinkText":"Найди рядом кинотеатр и забронируй места в центре зала вечером в субботу на фильм, который я укажу","i18n":{"accessibilityText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.2d130c556a4d4ee1","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.5b6b41b53c9b0ad7"}},{"id":"b2c-car-scheduler","canEdit":true,"surfaces":["scheduled-tasks"],"pinned":false,"accessibilityText":"Заказать пропуск","content":[{"type":"image","image":{"light":"https://avatars.mds.yandex.net/get-dialogs/998463/ce81caf1-43ca-48dc-8908-556b43d7588f/orig","dark":"https://avatars.mds.yandex.net/get-dialogs/1525540/3189ae8a-9fc2-45fc-b13f-b341a6abcec1/orig"},"size":16},{"type":"text","text":" Заказать пропуск","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.cb93339c2d3b4c9e"}}],"deeplinkText":"Позвони консьержу и закажи пропуск на машину","i18n":{"accessibilityText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.7bd093049e232476","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.47b2d456717e059a"}}],"updatedAt":""},"plugin-suggests-slots":{"suggestSlots":{"default":["default:plugin","default:plugin","default","default"],"mail":["mail:plugin","mail:plugin","default:plugin","default"],"mail-context":["mail-context:plugin","mail:plugin","default:plugin","default"]},"suggests":[{"id":"b2c-what-can-you-do-micro","canEdit":true,"pinned":true,"accessibilityText":"Что ты умеешь?","deeplinkText":"Что ты умеешь?","content":[{"type":"text","text":"Что ты умеешь?","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.75fa3f16cb613c29"}}],"surfaces":["default"],"i18n":{"accessibilityText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.9b38c83989a6dbc4","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.62d97de539a08928"}},{"id":"b2b-create-pptx-new","canEdit":true,"pinned":false,"accessibilityText":"Презентация по материалам","deeplinkText":"Создай презентацию на основе моих материалов: понятная структура, заголовки и тезисы. Используй только факты из документа, недостающие данные отметь или уточни у меня. Сначала попроси меня прикрепить файл или дать ссылку и уточни аудиторию, цель и число слайдов. Приступай после моих ответов.","content":[{"type":"text","text":"Презентация по материалам","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.7a731e941c4056e8"}}],"surfaces":["default"],"i18n":{"accessibilityText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.4fe57fe92e15b587","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.a56265124feee0b5"}},{"id":"b2b-check-errors-new","canEdit":true,"pinned":false,"accessibilityText":"Исправить ошибки в тексте","deeplinkText":"Проверь текст на орфографические, пунктуационные, грамматические и стилистические ошибки. Сохрани смысл и тон автора. Сначала попроси меня прикрепить файл или вставить текст и уточни желаемый формат результата (pdf, doc, txt). Приступай после моих ответов и пришли отредактированный файл.","content":[{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1644703/f1a7d737-177c-4bec-99e1-3ca2dc1a81f8/orig","size":16},{"type":"text","text":" Исправить ошибки в тексте","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.143d248c3785a842"}}],"surfaces":["default"],"i18n":{"accessibilityText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.7975f4806d438a4a","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.e407bb36d1249196"}},{"id":"b2b-mail-new","canEdit":true,"pinned":false,"accessibilityText":"Сводка задач из почты","deeplinkText":"Собери краткую сводку по моей переписке в почте за последние 14 дней. Выдели основные темы, принятые решения, открытые вопросы, ответственных и сроки.","content":[{"type":"text","text":"Сводка задач из почты ","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.025bc76741c7fb56"}},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1644703/bd6e8d08-99eb-43ac-a2a9-1f67faccbd89/orig","size":16}],"pluginId":"f907283b-1324-45d6-8057-617283940a1b","surfaces":["mail","mail-context"],"i18n":{"accessibilityText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.8ff051100ef11195","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.1ec0adc5ab1370b3"}},{"id":"b2b-unanswered-new","canEdit":true,"pinned":false,"accessibilityText":"Найди письма без ответа","deeplinkText":"Найди входящие письма, в которых есть вопрос, просьба, задача или срок, но от меня ещё нет ответа. Покажи отправителя, тему, дату, краткую суть и требуемое действие, расставь приоритеты. Исключи рассылки и автоуведомления. Сначала уточни, за какой период искать. Приступай после моего ответа.","content":[{"type":"text","text":"Найди письма ","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.2ceae883f429b665"}},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1644703/bd6e8d08-99eb-43ac-a2a9-1f67faccbd89/orig","size":16},{"type":"text","text":" без ответа","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.3c50ebc81d36a7cf"}}],"pluginId":"f907283b-1324-45d6-8057-617283940a1b","surfaces":["mail","mail-context"],"i18n":{"accessibilityText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.6030cb428737fc00","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.19b037c95275105c"}}]},"plugin-suggests-auto":{"suggests":[{"id":"b2c-what-can-you-do-micro","canEdit":true,"pinned":true,"accessibilityText":"Что ты умеешь?","deeplinkText":"Что ты умеешь?","content":[{"type":"text","text":"Что ты умеешь?","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.2ec16e74d0799667"}}],"surfaces":["default"],"i18n":{"accessibilityText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.450f58ebe6a80db2","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.f99f59723703edbe"}},{"id":"b2b-create-pptx-new","canEdit":true,"pinned":false,"accessibilityText":"Презентация по материалам","deeplinkText":"Создай презентацию на основе моих материалов: понятная структура, заголовки и тезисы. Используй только факты из документа, недостающие данные отметь или уточни у меня. Сначала попроси меня прикрепить файл или дать ссылку и уточни аудиторию, цель и число слайдов. Приступай после моих ответов.","content":[{"type":"text","text":"Презентация по материалам","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.8cf1b099c07223ee"}}],"surfaces":["default"],"i18n":{"accessibilityText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.2106013458d0f71d","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.e0cfa58afa605a3b"}},{"id":"b2b-check-errors-new","canEdit":true,"pinned":false,"accessibilityText":"Исправить ошибки в тексте","deeplinkText":"Проверь текст на орфографические, пунктуационные, грамматические и стилистические ошибки. Сохрани смысл и тон автора. Сначала попроси меня прикрепить файл или вставить текст и уточни желаемый формат результата (pdf, doc, txt). Приступай после моих ответов и пришли отредактированный файл.","content":[{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1644703/f1a7d737-177c-4bec-99e1-3ca2dc1a81f8/orig","size":16},{"type":"text","text":" Исправить ошибки в тексте","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.c04699813a293314"}}],"surfaces":["default"],"i18n":{"accessibilityText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.5be5a357f2534fcc","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.78999d6f659551b0"}},{"id":"b2b-mail-new","canEdit":true,"pinned":false,"accessibilityText":"Сводка задач из почты","deeplinkText":"Собери краткую сводку по моей переписке в почте за последние 14 дней. Выдели основные темы, принятые решения, открытые вопросы, ответственных и сроки.","content":[{"type":"text","text":"Сводка задач из почты ","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.0883f804337ab940"}},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1644703/bd6e8d08-99eb-43ac-a2a9-1f67faccbd89/orig","size":16}],"pluginId":"f907283b-1324-45d6-8057-617283940a1b","surfaces":["mail","mail-context"],"i18n":{"accessibilityText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.50904e9f56a4184f","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.56c429160eac96dd"}},{"id":"b2b-unanswered-new","canEdit":true,"pinned":false,"accessibilityText":"Найди письма без ответа","deeplinkText":"Найди входящие письма, в которых есть вопрос, просьба, задача или срок, но от меня ещё нет ответа. Покажи отправителя, тему, дату, краткую суть и требуемое действие, расставь приоритеты. Исключи рассылки и автоуведомления. Сначала уточни, за какой период искать. Приступай после моего ответа.","content":[{"type":"text","text":"Найди письма ","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.9c8dab7298e6a473"}},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1644703/bd6e8d08-99eb-43ac-a2a9-1f67faccbd89/orig","size":16},{"type":"text","text":" без ответа","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.690ec05c648fec59"}}],"pluginId":"f907283b-1324-45d6-8057-617283940a1b","surfaces":["mail","mail-context"],"i18n":{"accessibilityText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.24336e4ae7afad5e","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.de4d2fe40495d842"}}]},"webalice_12790":{"suggests":[{"id":"webalice-12790-standard-capabilities","canEdit":true,"pinned":true,"text":"Что ты умеешь?","deeplinkText":"Что ты умеешь?","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.0bd35f73c639a17f","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.46fb39bcef2f2add"}},{"id":"webalice-12790-standard-savings","canEdit":true,"text":"Найти на чём сэкономить","deeplinkText":"Проверь письма с чеками, оплатами и продлениями, а также предложениями о скидках и распродажах. Найди конкретные возможности сэкономить и, где возможно, посчитай сумму экономии.","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.8ea97f8c66734f52","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.68d0ae164617e5b0"}},{"id":"webalice-12790-standard-doctor","canEdit":true,"text":"Записать к врачу","deeplinkText":"Найди врача, к которому мне нужно, по моему ДМС рядом с домом на следующей неделе после 18:00. Сравни рейтинг, отзывы, стоимость и доступные окна и покажи три варианта со ссылками на источники. Не звони и не записывай без моего подтверждения; после выбора запиши и добавь визит в календарь.","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.28809c30d8a07bd5","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.d106b631dae2ee3b"}},{"id":"webalice-12790-result-capabilities","canEdit":true,"suggestSetId":"webalice-12790-result","pinned":true,"text":"Что ты умеешь?","deeplinkText":"Что ты умеешь?","i18n":{"text":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.f734c4fe32b3c9b8","deeplinkText":"supernova.fac17aa0-a344-4bf1-9125-59c0ea6e4a9c.e9d66a19178681be"}},{"id":"webalice-12790-grooming-capabilities","canEdit":true,"suggestSetId":"webalice-12790-grooming","pinned":true,"text":"Что ты умеешь?","deeplinkText":"Что ты умеешь?","i18n":{"text":"supernova.f