,"Onboarding":{},"Description":"Пополнение кошелька Steam","TrialRequests":{"UnlimitedWithoutGuarantee":{}},"Model":"","External":false,"ModeInfo":{"preset":"agents_steam_topup_agent","mode":"External"},"Id":"alice-agents-steam-topup","Features":{}},{"MaxInputLength":100000,"Provider":"","Name":"Еком-агент","CategoryId":"agents","Onboarding":{},"Description":"Помогаем пользователю найти нужный товар","TrialRequests":{"UnlimitedWithoutGuarantee":{}},"Model":"","External":false,"ModeInfo":{"preset":"agents_ecom_agent","mode":"External"},"Id":"alice-agents-ecom","Features":{"ExternalOnboarding":true}},{"MaxInputLength":100000,"Provider":"","Name":"Агент регулярных покупок","CategoryId":"agents","Onboarding":{},"Description":"Помогаем пользователю найти лучшее предложение для регулярных покупок","TrialRequests":{"UnlimitedWithoutGuarantee":{}},"Model":"","External":false,"ModeInfo":{"preset":"agents_regular_purchases_agent","mode":"External"},"Id":"alice-agents-regular-purchases","Features":{"ExternalOnboarding":true}},{"MaxInputLength":100000,"Provider":"","Name":"Залипание в Alice Apps","CategoryId":"agents","Onboarding":{},"Description":"Режим работы с выбранным Alice App через @","TrialRequests":{"UnlimitedWithoutGuarantee":{}},"Model":"","External":false,"ModeInfo":{"preset":"dialogovo_alice_apps_sticky","mode":"External"},"Id":"dialogovo-alice-apps-sticky","Features":{"ExternalOnboarding":true,"TextFileUpload":true,"ImageFileUpload":true}},{"MaxInputLength":100000,"Provider":"","Name":"Jeeves","CategoryId":"agents","Onboarding":{},"Description":"Персональный AI-ассистент","TrialRequests":{"UnlimitedWithoutGuarantee":{}},"Model":"","External":false,"ModeInfo":{"preset":"jeeves_agent_mode","mode":"External"},"Id":"jeeves-agent-mode","Features":{"ExternalOnboarding":true,"MultiFileUploadFilesCount":10,"TextFileUpload":true,"ImageFileUpload":true}},{"MaxInputLength":100000,"Provider":"","Name":"Репетитор","CategoryId":"agents","Onboarding":{"Title":"Привет!","Description":"Что по математике?"},"Description":"Поможет с математикой","TrialRequests":{"UnlimitedWithoutGuarantee":{}},"Model":"","External":false,"ModeInfo":{"preset":"agents_education_learn_lm_agent","mode":"External"},"Id":"education-learn-lm-agent","Features":{"TextFileUpload":true,"ImageFileUpload":true,"VideoFileUpload":true}},{"MaxInputLength":100000,"Provider":"","Name":"Expert","CategoryId":"agents","Onboarding":{},"Description":"Агент Expert","TrialRequests":{"UnlimitedWithoutGuarantee":{}},"Model":"","External":false,"ModeInfo":{"preset":"agents_RnServiceAliceExpert","mode":"External"},"Id":"alice-agents-expert","Features":{"ExternalOnboarding":true,"MultiFileUploadFilesCount":5,"TextFileUpload":true,"ImageFileUpload":true,"VideoFileUpload":true}}]},"Proxy360Response":{"subscription_mask":0,"workspace_resolution":{"cookie_action":"WCA_KEEP","business_intent_consumed":false,"kind":"WK_PERSONAL","source":"WS_B2C_SURFACE"},"company_type":"CT_UNKNOWN","feature":"LF_UNKNOWN"},"AliceProState":{"Count":0,"AliceProEnabled":false,"Limit":5,"TimeLimitSec":86400},"FeaturesLimiterCanPassResponses":[{"user_quota":{"requests_limit":3,"min_first_request_timestamp":{"Microseconds":1793020704000000},"user_id":"2239544982","refresh_timestamp_seconds":1798204704,"end_time_seconds":0,"requests_used":0},"request_type":"RT_AVAILABLE","decision":"D_UNKNOWN","user_class":"UC_LOGIN","increment_value":1,"priority":"P_4","feature":"LF_DEEP_RESEARCH_5_MIN_WITH_ADDONS"},{"request_type":"RT_AVAILABLE","decision":"D_UNKNOWN","user_class":"UC_LOGIN","priority":"P_4","feature":"LF_LIFE_PHOTO"},{"user_quota":{"requests_limit":1,"min_first_request_timestamp":{"Microseconds":0},"user_id":"2239544982","end_time_seconds":0,"requests_used":0},"request_type":"RT_FIRST","decision":"D_UNKNOWN","user_class":"UC_LOGIN","increment_value":1,"priority":"P_5","feature":"LF_PICTURE_EDITOR"},{"user_quota":{"requests_limit":1,"min_first_request_timestamp":{"Microseconds":0},"user_id":"2239544982","end_time_seconds":0,"requests_used":0},"request_type":"RT_FIRST","decision":"D_UNKNOWN","user_class":"UC_LOGIN","increment_value":1,"priority":"P_5","feature":"LF_PICTURE_COMBINING"},{"request_type":"RT_UNKNOWN","decision":"D_UNKNOWN","user_class":"UC_LOGIN","priority":"P_UNKNOWN","feature":"LF_LIFE_PHOTO_720P"},{"user_quota":{"requests_limit":20,"min_first_request_timestamp":{"Microseconds":1793020704000000},"user_id":"2239544982","refresh_timestamp_seconds":1798204704,"end_time_seconds":0,"requests_used":0},"request_type":"RT_AVAILABLE","decision":"D_UNKNOWN","user_class":"UC_LOGIN","increment_value":1,"priority":"P_4","feature":"LF_NEUROLEGAL_DAYS"},{"user_quota":{"requests_limit":3,"min_first_request_timestamp":{"Microseconds":1795526304000000},"user_id":"2239544982","refresh_timestamp_seconds":1795699104,"end_time_seconds":0,"requests_used":0},"request_type":"RT_AVAILABLE","decision":"D_UNKNOWN","user_class":"UC_LOGIN","increment_value":1,"priority":"P_1","feature":"LF_PHOTOS_SUBSCRIPTION_SMALL"},{"user_quota":{"requests_limit":5,"min_first_request_timestamp":{"Microseconds":1795526304000000},"user_id":"2239544982","refresh_timestamp_seconds":1795699104,"end_time_seconds":0,"requests_used":0},"request_type":"RT_AVAILABLE","decision":"D_UNKNOWN","user_class":"UC_LOGIN","increment_value":1,"priority":"P_1","feature":"LF_PHOTOS_SUBSCRIPTION_BIG"},{"user_quota":{"requests_limit":30,"min_first_request_timestamp":{"Microseconds":0},"user_id":"2239544982","end_time_seconds":0,"requests_used":0},"request_type":"RT_FIRST","decision":"D_UNKNOWN","user_class":"UC_LOGIN","increment_value":1,"priority":"P_2","feature":"LF_GLM_AGENT"},{"user_quota":{"requests_limit":20,"min_first_request_timestamp":{"Microseconds":1795526304000000},"user_id":"2239544982","refresh_timestamp_seconds":1795699104,"end_time_seconds":0,"requests_used":0},"request_type":"RT_AVAILABLE","decision":"D_UNKNOWN","user_class":"UC_LOGIN","increment_value":1,"priority":"P_4","feature":"LF_GLM_AGENT_CLF_PATH"},{"user_quota":{"requests_limit":15,"min_first_request_timestamp":{"Microseconds":1795526304000000},"user_id":"2239544982","refresh_timestamp_seconds":1795699104,"end_time_seconds":0,"requests_used":0},"request_type":"RT_AVAILABLE","decision":"D_UNKNOWN","user_class":"UC_LOGIN","increment_value":1,"priority":"P_4","feature":"LF_GLM_AGENT_CLF_PATH_X2"}],"TrialsInfo":{"PlusTrialAvailable":true,"AliceProTrialAvailable":true},"DoNotUseUserLogs":false},"isVoiceSharePromoVisible":false,"mainPageConfig":{"widgets":[{"id":"expert","type":"typed","title":"Интеллект","subtitle":"Режим «Эксперт»","isNew":true,"media":{"image":{"light":"https://web-alice-images.s3.yandex.net/main-page-widgets/expert-widget-light3-desktop.webp","dark":"https://web-alice-images.s3.yandex.net/main-page-widgets/expert-widget-dark3-desktop.webp"}},"action":{"type":"deeplink","url":"/?model=alice-agents-expert","focusInput":true},"styles":{"image":{"light":{"position":"static","width":"100%","height":"auto","marginTop":"auto"},"dark":{"position":"static","width":"100%","height":"auto","marginTop":"auto"}},"subtitle":{"light":{"color":"var(--depot-color-text-quaternary)"},"dark":{"color":"var(--depot-color-text-quaternary)"}}},"wide":false,"personalization":false,"authRequired":true},{"id":"studio","type":"custom","component":"studio","personalization":true,"wide":false,"authRequired":false}],"suggests":[{"id":"check-used-car","text":"Что проверить при покупке машины с рук?","deeplinkText":"Хотим купить подержанную машину с рук. Распиши, что проверить при осмотре и тест-драйве, какие документы посмотреть, как проверить историю авто и в каких случаях лучше сразу отказаться от покупки.","start":"","end":"","model":"","aliceApps":""},{"id":"save-on-fuel","text":"Как тратить меньше на бензин?","deeplinkText":"Хочу тратить меньше на бензин, проезжаю около 1500 км в месяц, расход 9 литров на сотню, литр стоит 60 рублей. Дай 10 привычек за рулём и в обслуживании, которые снижают расход, и посчитай, сколько я трачу сейчас и сколько сэкономлю, если расход упадёт на 5 и на 10%.","start":"","end":"","model":"","aliceApps":""},{"id":"grandma-family-stories","text":"Подготовь вопросы бабушке для семейных историй","deeplinkText":"Хочу записать семейные истории со слов бабушки, но не превращать разговор в допрос. Придумай двенадцать открытых вопросов о повседневной жизни, друзьях и смешных случаях, начиная с лёгких. Добавь две мягкие фразы, чтобы сменить тему, если вспоминать не хочется.","start":"","end":"","model":"","aliceApps":""},{"id":"first-date-topics","text":"О чём поговорить на первом свидании?","deeplinkText":"У меня скоро первое свидание в кафе, до этого была только переписка, и пугают неловкие паузы. Предложи 10 вопросов, чтобы узнать человека, и разложи их по ходу вечера: начало, середина, конец. И каких тем лучше не касаться.","start":"","end":"","model":"","aliceApps":""},{"id":"fridge-odor","text":"Убери запах из пустого обесточенного холодильника","deeplinkText":"Холодильник уже пуст и отключён от розетки, продукты хранятся в другом исправном холодильнике. Дай порядок поиска и удаления запаха только на доступных полках, ящиках и внутренних стенках: мягкая ткань, чуть тёплая вода и нейтральное средство для посуды; уплотнитель — только чистой водой. Затем ополаскивание, просушка и проветривание. Дренаж, поддон, панели, проводку и трубки не трогать. Объясни, когда остановиться и вызвать сервис, если запах остался.","start":"","end":"","model":"","aliceApps":""},{"id":"shelf-basket-passage","text":"Проверь, не перекроют ли полка и корзина проход","deeplinkText":"Проверь учебную расстановку в прихожей. Коридор шириной 110 см; у одной стены низкая устойчивая полка глубиной 30 см, обувь не выступает. У другой стены напротив неё хотят поставить корзину глубиной 15 см. Дверь вне этой зоны. Обязательная ширина свободного прохода — минимум 80 см. Дай таблицу: без корзины и с корзиной, формула, ширина, соответствует ли условию. В конце реши, можно ли добавить корзину. Только расчёт и вывод; перестановок, покупок и рекомендаций по хранению не добавляй.","start":"","end":"","model":"","aliceApps":""},{"id":"wallpaper-rolls","text":"Посчитай рулоны обоев на комнату 4×3 с запасом","deeplinkText":"Хочу купить обои на комнату 4 на 3 метра высотой 2,7 метра. Рулон шириной 1,06 метра и длиной 10 метров, рисунок без подгонки; стены считаем целиком, не вычитая дверь и окно. Посчитай полосы и рулоны с объяснением, отдельно укажи запас.","start":"","end":"","model":"","aliceApps":""},{"id":"apartment-check-before-trip","text":"Дай проверку квартиры перед отъездом на две недели","deeplinkText":"Я уезжаю из квартиры на две недели и боюсь забыть что-то дома. Составь короткий порядок проверки воды, электроприборов, продуктов и окон за вечер до отъезда и перед выходом. Учти, что холодильник остаётся включённым, а запасные ключи есть у близкого человека.","start":"","end":"","model":"","aliceApps":""},{"id":"slow-sink-drain","text":"Как прочистить слив раковины без смешивания химии","deeplinkText":"У меня вода в раковине уходит медленно, но слив не перекрыт полностью. Составь безопасный порядок первых действий без смешивания химии: проверить сетку, попробовать вантуз и понять, нужен ли сантехник. Если предлагаешь разбирать сифон, отдельно назови условия, когда самостоятельно этого делать не стоит.","start":"","end":"","model":"","aliceApps":""},{"id":"cleanup-before-guests","text":"Составь план уборки на час перед приходом гостей","deeplinkText":"Через два часа придут гости, а дома беспорядок. Составь план уборки на час: что сделать в первую очередь, что можно быстро спрятать и что спокойно пропустить.","start":"","end":"","model":"","aliceApps":""},{"id":"declutter-wardrobe","text":"Составь план, как разобрать шкаф за один день","deeplinkText":"Мой шкаф забит вещами, половину из которых не ношу. Составь план на один выходной день: в каком порядке разбирать, по каким правилам решать, что оставить, а что отдать, и как разложить, чтобы порядок держался.","start":"","end":"","model":"","aliceApps":""},{"id":"daily-cleaning-schedule","text":"Составь график уборки по 20 минут в день","deeplinkText":"Не хочу тратить на уборку всю субботу. Составь график на неделю по 20 минут в день, чтобы квартира оставалась чистой: что делать в какой день и что достаточно делать раз в месяц.","start":"","end":"","model":"","aliceApps":""},{"id":"streak-free-windows","text":"Расскажи, как мыть окна без разводов подручными средствами","deeplinkText":"После мытья окон у меня остаются разводы. Расскажи по шагам, как вымыть окна без разводов подручными средствами: что взять, в каком порядке мыть и в какую погоду лучше. Без дорогих средств.","start":"","end":"","model":"","aliceApps":""},{"id":"kettle-limescale","text":"Как убрать накипь в чайнике, чтобы она появлялась реже","deeplinkText":"У меня в электрическом чайнике толстый слой накипи. Распиши по шагам, как его очистить подручными средствами, сколько чего брать, как потом промыть и как сделать, чтобы накипь появлялась реже.","start":"","end":"","model":"","aliceApps":""},{"id":"wash-down-jacket","text":"Как постирать пуховик в машинке и расправить сбитый пух","deeplinkText":"Хочу постирать зимний пуховик дома в стиральной машине. Распиши по шагам: как подготовить, какой режим и средство выбрать, как сушить и что делать, если пух всё-таки сбился в комки.","start":"","end":"","model":"","aliceApps":""},{"id":"oversalted-soup","text":"Как спасти пересоленный суп без слива и мифов о картошке","deeplinkText":"У меня пересолен готовый суп, и выливать кастрюлю жалко. Предложи три способа сделать вкус менее солёным без слива и объясни, какой выбрать для густого супа. Не предлагай картофель или рис как способ вытянуть соль: они впитывают бульон вместе с ней.","start":"","end":"","model":"","aliceApps":""},{"id":"runny-pancake-batter","text":"Как исправить жидкое тесто для оладий небольшими шагами","deeplinkText":"У меня тесто для оладий получилось заметно жиже, чем ожидалось, а сковорода уже разогрета. Подскажи, как поправить консистенцию небольшими шагами и как проверить на первой порции, что тесто стало подходящим.","start":"","end":"","model":"","aliceApps":""},{"id":"lunch-boxes-no-reheat","text":"Придумай пять обедов с собой без разогрева и протекания","deeplinkText":"Мне нужно брать обед с собой туда, где нет микроволновки. Предложи пять вариантов, которые удобно есть холодными, не текут в контейнере и собираются из обычных продуктов; добавь короткий список общей подготовки накануне.","start":"","end":"","model":"","aliceApps":""},{"id":"shared-dinner-toppings","text":"Придумай один ужин без мяса и острого с добавками для всех","deeplinkText":"У нас дома одному человеку хочется без острого, другой не ест мясо. Придумай общий ужин, где основа подходит всем, а добавки можно подать отдельно. Нужен простой вариант на плите, список ингредиентов и последовательность готовки.","start":"","end":"","model":"","aliceApps":""},{"id":"leftover-buckwheat-dishes","text":"Придумай три блюда из готовой гречки, овощей и сыра","deeplinkText":"После ужина у меня остались готовая гречка, запеченные овощи и немного сыра. Придумай три способа собрать из них разные блюда на следующий прием пищи, не предлагая докупать редкие продукты и не повторяя вчерашний ужин.","start":"","end":"","model":"","aliceApps":""},{"id":"food-for-eight-guests","text":"Посчитай пасту, салат и закуски на восемь гостей","deeplinkText":"Я собираю дома небольшую компанию из восьми человек и хочу приготовить пасту, салат и закуски. Рассчитай примерное количество продуктов по категориям и покажи, как скорректировать порции, если часть гостей ест мало.","start":"","end":"","model":"","aliceApps":""},{"id":"pie-without-eggs-milk","text":"Дай рецепт пирога без яиц и молока","deeplinkText":"Хочу испечь пирог, но дома нет яиц и молока. Подскажи, чем их заменить, и дай рецепт простого пирога из того, что обычно есть: мука, сахар, растительное масло, яблоки.","start":"","end":"","model":"","aliceApps":""},{"id":"chicken-rice-dinners","text":"Придумай 3 ужина из курицы и риса за 30 минут","deeplinkText":"У меня дома есть куриное филе, рис, лук и морковь. Придумай три варианта ужина, каждый не дольше 30 минут, и распиши пошагово самый простой.","start":"","end":"","model":"","aliceApps":""},{"id":"choose-movie-together","text":"Предложи 5 шагов, как выбирать фильм вдвоём без споров","deeplinkText":"Мы с партнёром каждый вечер тратим полчаса на выбор фильма и в итоге ничего не смотрим. Предложи простую систему выбора из пяти шагов: как договориться о жанре и настроении и что делать, если спор не заканчивается. Названия фильмов не приводи.","start":"","end":"","model":"","aliceApps":""},{"id":"cut-sugar-plan","text":"Составь план на 3 недели и 10 перекусов вместо сладкого","deeplinkText":"Каждый день ем много сладкого: печенье к чаю, шоколадки после обеда. Хочу постепенно сократить, но без жёстких запретов. Составь план на три недели и предложи десять замен для перекусов.","start":"","end":"","model":"","aliceApps":""},{"id":"healthy-weekly-dinners","text":"Составь 7 полезных ужинов по 30 минут и список покупок","deeplinkText":"Хочу ужинать полезнее, но без строгих диет и подсчётов. Составь меню из семи ужинов на неделю из обычных продуктов, каждый не дольше 30 минут от начала до конца, и общий список покупок.","start":"","end":"","model":"","aliceApps":""},{"id":"dry-skin-care","text":"Составь уход за сухой кожей лица до 3000 ₽","deeplinkText":"У меня сухая кожа лица, к вечеру стягивается и шелушится. Составь простой уход утром и вечером: какие средства нужны, в каком порядке наносить и чего избегать. Бюджет на всё до 3000 рублей.","start":"","end":"","model":"","aliceApps":""},{"id":"sleep-schedule-23","text":"Как перейти на отбой в 23:00 без таблеток?","deeplinkText":"Я ложусь после часа ночи и утром еле встаю, хочу перестроить режим. Составь план на две недели, как постепенно сдвинуть отбой на 23:00, и вечерние привычки, которые помогут быстрее засыпать. Без таблеток и добавок.","start":"","end":"","model":"","aliceApps":""},{"id":"ten-thousand-steps","text":"Как за месяц дойти до 10 000 шагов в день?","deeplinkText":"Сейчас я прохожу в день около трёх тысяч шагов, почти всё время сижу. Составь план на четыре недели, как постепенно дойти до 10 000 шагов, и приёмы, как добавить ходьбу в обычный день без спортзала.","start":"","end":"","model":"","aliceApps":""},{"id":"therapist-visit-questions","text":"Составь вопросы терапевту к плановому приёму","deeplinkText":"У меня скоро плановый приём у терапевта, а там всегда всё быстро. Составь восемь вопросов о самочувствии и профилактике и подскажи, как коротко описать жалобы в трёх пунктах: что беспокоит, с какого времени и что помогает.","start":"","end":"","model":"","aliceApps":""},{"id":"resume-education-edit","text":"Отредактируй три учебных пункта резюме без выдумок","deeplinkText":"Отредактируй учебный блок резюме вымышленного человека, сохранив только факты. Черновик: «Я входил в команду, которая собрала списки заявок в общую таблицу. Я согласовал поля таблицы. Я описал порядок обновления таблицы». Пометь вымышленность. Дай три коротких деловых пункта без «я»: первый начинается с «Участвовал», остальные — с активных глаголов. Не добавляй цели, эффекты, улучшения, инструменты и обязанности. Никаких полей или вопросов.","start":"","end":"","model":"","aliceApps":""},{"id":"compare-job-offers","text":"Сравни работу в офисе за 90 тысяч и удалёнку за 80","deeplinkText":"Мне предложили две работы: 90 тысяч в офисе в часе езды от дома и 80 тысяч на удалёнке. Дорога в одну сторону стоит около 150 рублей. Сравни: сколько времени и денег уходит на дорогу за месяц, что ещё учесть кроме зарплаты, и сведи всё в таблицу.","start":"","end":"","model":"","aliceApps":""},{"id":"board-games-six-adults","text":"Посоветуй 5 простых настольных игр на 6 взрослых","deeplinkText":"Мы собираемся вечером компанией из шести взрослых. Посоветуй пять настольных игр, которые можно объяснить за пять минут, и для каждой напиши, кому зайдёт и сколько длится партия.","start":"","end":"","model":"","aliceApps":""},{"id":"coop-games-two-players","text":"Посоветуй 6 игр на двоих за одной приставкой или ПК","deeplinkText":"Мы ищем, во что поиграть вдвоём по вечерам на одной приставке или компьютере. Предложи шесть кооперативных игр разных жанров: для каждой одну фразу о сюжете, сложность и сколько часов она займёт.","start":"","end":"","model":"","aliceApps":""},{"id":"beach-books","text":"Посоветуй 7 лёгких затягивающих книг разных жанров на море","deeplinkText":"Едем на море на неделю, хочу взять пару книг, которые читаются легко и затягивают. Посоветуй семь книг разных жанров: детектив, приключения, лёгкая проза. Для каждой автор, одна фраза о сюжете без спойлеров и почему подойдёт.","start":"","end":"","model":"","aliceApps":""},{"id":"music-listening-game","text":"Придумай игру на 5 минут: вслушаться в музыку","deeplinkText":"Я хочу по-новому послушать музыку, которую уже включу. Придумай короткую игру на пять минут: сначала заметить один повтор, затем один контраст и в конце описать одно настроение; не называй конкретные произведения и не проси прикладывать аудио.","start":"","end":"","model":"","aliceApps":""},{"id":"classical-music-plan","text":"Составь план на 2 недели по 20 минут, как слушать классику","deeplinkText":"Хочу начать слушать классическую музыку, но не знаю, с чего начать и как не заскучать. Дай план на две недели по 20 минут в день: как слушать, на что обращать внимание и как выбрать, что слушать дальше. Композиторов и произведения не называй.","start":"","end":"","model":"","aliceApps":""},{"id":"pack-suitcase-week","text":"Как собрать чемодан на неделю без лишнего?","deeplinkText":"Я еду в отпуск на неделю и каждый раз беру лишнее. Объясни, как собрать чемодан по системе: с чего начать, как выбирать вещи комплектами и что проверить в последний вечер.","start":"","end":"","model":"","aliceApps":""},{"id":"complaint-roof-leak","text":"Напиши жалобу в УК на протекающую крышу","deeplinkText":"У нас протекает крыша над квартирой в сильный дождь и когда тает снег. Составь письменное обращение в управляющую компанию: что случилось, какие обязанности у УК, в какой срок прошу устранить и что сделаем, если не исправят. Вежливо и твёрдо.","start":"","end":"","model":"","aliceApps":""},{"id":"appeal-camera-fine","text":"Как обжаловать штраф с камеры, если он кажется ошибочным?","deeplinkText":"Мне пришёл штраф с камеры, и он, по-моему, ошибочный. Распиши порядок обжалования по шагам: сроки, куда подавать жалобу, какие доказательства собрать, и дай шаблон текста жалобы.","start":"","end":"","model":"","aliceApps":""},{"id":"return-shoes-no-receipt","text":"Как вернуть обувь, если чек не сохранился?","deeplinkText":"Обувь не подошла, с покупки прошла неделя, а чек не сохранился. Хочу её вернуть: объясни по шагам, что сказать продавцу, чем можно подтвердить покупку и что делать, если откажут.","start":"","end":"","model":"","aliceApps":""},{"id":"course-refund","text":"Как вернуть деньги за остаток курса, если он не подошёл","deeplinkText":"Мы оплатили онлайн-курс на полгода, прошли две недели и поняли, что он не подходит. Объясни по шагам, как вернуть деньги за оставшееся время, что написать в заявлении и что делать, если школа отказывает.","start":"","end":"","model":"","aliceApps":""},{"id":"cat-wakes-early","text":"Как отучить кота будить меня в 5 утра?","deeplinkText":"Мой кот каждый день будит меня в пять утра: мяукает и ходит по кровати. Объясни, почему кошки так делают, и составь план на две недели, как мягко отучить его без наказаний и криков.","start":"","end":"","model":"","aliceApps":""},{"id":"kitten-preparation","text":"Что купить и подготовить к появлению котёнка?","deeplinkText":"Через неделю мы забираем домой котёнка, он у нас первый. Составь список, что купить заранее, как подготовить квартиру и как провести первые три дня, чтобы ему было спокойно.","start":"","end":"","model":"","aliceApps":""},{"id":"weekly-review-example","text":"Покажи недельный обзор и заполненную итоговую заметку","deeplinkText":"Мне нужен самодостаточный пример обзора недели за 20 минут. Дай четыре шага: календарь, обязательное, свободные окна и старт понедельника. Затем покажи уже заполненную итоговую заметку для вымышленной недели: встреча во вторник в 12:00, отчёт к четвергу, свободна среда после 15:00. Не проси мой календарь, ничего заполнять или сообщать.","start":"","end":"","model":"","aliceApps":""},{"id":"compare-mobile-plans","text":"Сравни тарифы на 20 и 30 ГБ при разном расходе интернета","deeplinkText":"Учебный расчёт: тариф A — 690 ₽/мес., включено 20 ГБ, сверх лимита 80 ₽ за каждый полный ГБ; B — 890 ₽/мес., 30 ГБ, сверх лимита 40 ₽ за полный ГБ. Для расхода 18, 25 и 33 ГБ составь одну итоговую таблицу: расход, перерасход A, сумма A, перерасход B, сумма B. Покажи формулы расчёта доплаты и полной цены, проверь сложение. Других платежей нет. Без внешнего поиска и выбора тарифа за меня.","start":"","end":"","model":"","aliceApps":""},{"id":"spoon-three-views","text":"Рассмотри ложку глазами инженера, художника и антрополога","deeplinkText":"Мне любопытно, что можно заметить в самой обычной деревянной ложке. Рассмотри её с трёх точек зрения — инженера, художника и антрополога: по два наблюдения и один вопрос от каждого, не выдумывая историю именно этой ложки.","start":"","end":"","model":"","aliceApps":""},{"id":"seasons-lamp-ball","text":"Объясни смену сезонов через сцену с лампой и мячом","deeplinkText":"Хочу понять, почему в течение года меняются сезоны. Объясни через простую сцену с лампой и наклонённым мячом: покажи, как меняется освещение двух полушарий, и отдельно уточни, какую ошибку часто создаёт слишком буквальная аналогия; без школьного конспекта и формул.","start":"","end":"","model":"","aliceApps":""},{"id":"painting-viewing-questions","text":"Дай шесть вопросов для внимательного просмотра картины","deeplinkText":"Дай шпаргалку для спокойного рассматривания живописи без знаний истории искусства: шесть простых вопросов — по два о композиции, цвете и свете, сюжете и впечатлении. Затем покажи применение на одной явно вымышленной картине: коротко опиши её, дай шесть заполненных примерных ответов и заметку из двух предложений. Не приписывай картину реальному художнику или музею. Ответ должен быть законченным: без полей, просьб прислать изображение, вопросов ко мне и предложения продолжить.","start":"","end":"","model":"","aliceApps":""},{"id":"phone-free-walk","text":"Придумай восемь наблюдений на прогулке без телефона","deeplinkText":"Я гуляю по знакомому району и хочу заметить в нём что-то новое, не пользуясь телефоном и не фотографируя прохожих. Придумай восемь заданий на наблюдение за архитектурой, природой и городскими звуками, а в конце предложи способ выбрать одно открытие, о котором хочется рассказать близкому.","start":"","end":"","model":"","aliceApps":""},{"id":"paint-for-room","text":"Посчитай краску на комнату 4×3 в два слоя","deeplinkText":"Хочу покрасить стены в комнате 4 на 3 метра с потолком 2,7 метра, в ней окно 1,5 на 1,5 метра и дверь 0,8 на 2 метра, на банке расход 1 литр на 10 квадратных метров. Посчитай, сколько краски нужно в два слоя, и объясни расчёт, чтобы потом пересчитать для другой комнаты.","start":"","end":"","model":"","aliceApps":""},{"id":"cups-to-grams","text":"Переведи чашки из рецепта в граммы","deeplinkText":"У меня рецепт печенья в американских мерах: 2 чашки муки, 1 чашка сахара и полчашки сливочного масла. Переведи всё в граммы, объясни, как переводить другие продукты, и дай короткую табличку на будущее.","start":"","end":"","model":"","aliceApps":""},{"id":"synonyms-interesting","text":"Подбери замены слову «интересный» для отзыва","deeplinkText":"Я пишу отзыв о книге и постоянно повторяю слово «интересный». Подбери 10 замен для разных случаев: про сюжет, героев, идею и язык, и покажи каждую в готовой фразе для отзыва.","start":"","end":"","model":"","aliceApps":""},{"id":"remember-colleague-names","text":"Как запомнить имена новых коллег?","deeplinkText":"Через неделю выхожу на новую работу, и знакомиться придётся сразу с десятком людей, а имена я забываю через минуту. Дай пять приёмов, как их запомнить, с примером для каждого, и подскажи, что сказать, если имя всё-таки забылось.","start":"","end":"","model":"","aliceApps":""},{"id":"book-a-month","text":"Как читать книгу в месяц по 20 минут в день?","deeplinkText":"Хочу читать хотя бы одну книгу в месяц, но вечно бросаю на середине, свободно у меня минут 20 в день. Составь план на месяц: когда читать, по сколько страниц, что делать, если день выпал, и как выбрать первую книгу, чтобы не бросить.","start":"","end":"","model":"","aliceApps":""},{"id":"coffee-spending-year","text":"Посчитай, сколько я трачу на кофе за год","deeplinkText":"Я покупаю кофе навынос почти каждый рабочий день, в среднем по 250 рублей. Посчитай, сколько это выходит в месяц и за год, сравни с домашним кофе по 40 рублей за чашку и покажи всё в небольшой таблице.","start":"","end":"","model":"","aliceApps":""},{"id":"moving-plan","text":"Распиши по неделям, как подготовиться к переезду","deeplinkText":"Через месяц мы переезжаем в другую квартиру. Распиши по неделям, что и когда сделать, чтобы ничего не забыть: от поиска грузчиков до переоформления интернета и коммуналки. В конце дай короткий список на сам день переезда.","start":"","end":"","model":"","aliceApps":""},{"id":"teen-slang","text":"Объясни 15 слов подросткового сленга с примерами","deeplinkText":"У меня дома подросток, и я не понимаю половину того, что он говорит: «кринж», «вайб», «рофл». Составь словарик из 15 выражений, которые подростки говорят сейчас, с переводом на обычный язык и примером фразы.","start":"","end":"","model":"","aliceApps":""},{"id":"explain-thunder-kid","text":"Объясни гром ребёнку 5 лет без страшилок и предложи игру","deeplinkText":"Мой ребёнок пяти лет боится грозы и спрашивает, откуда гром. Объясни, как рассказать ему об этом простыми словами без страшных подробностей, и предложи одну игру дома, которая покажет, как это работает.","start":"","end":"","model":"","aliceApps":""},{"id":"document-retention","text":"Сколько хранить квитанции ЖКХ, чеки, талоны и договоры","deeplinkText":"У меня дома скопилась куча бумаг: квитанции за коммуналку, чеки, гарантийные талоны, старые договоры. Объясни, сколько обычно хранить каждый вид документов и почему, и сведи всё в короткую таблицу.","start":"","end":"","model":"","aliceApps":""},{"id":"reading-syllables-games","text":"Дай план игр на 2 недели: читать по слогам без экранов","deeplinkText":"Мой сын, ему шесть лет, путает буквы и не любит читать. Составь план из игр на две недели по 10 минут в день, чтобы он научился читать по слогам и не потерял интерес. Без экранов.","start":"","end":"","model":"","aliceApps":""},{"id":"alien-in-cafe","text":"Сыграй роль инопланетного исследователя в обычном кафе","deeplinkText":"Мне любопытно представить, что ты исследователь с другой планеты и впервые наблюдаешь обычное кафе, не зная, зачем люди туда приходят. Дай три забавные, но доброжелательные гипотезы о том, что видишь, а затем объясни человеческий смысл каждой; не превращай это в рассказ с неожиданной развязкой.","start":"","end":"","model":"","aliceApps":""},{"id":"world-music-colors","text":"Составь версию мира, где люди видят музыку как цвет","deeplinkText":"Мне любопытно представить, что люди могут видеть музыку в виде меняющихся цветов, но слышат её как обычно. Опиши три изменения в повседневной жизни, одно новое неудобство и один неожиданный способ общения; не пиши сюжет, а покажи, как устроен этот воображаемый мир.","start":"","end":"","model":"","aliceApps":""},{"id":"museum-of-sounds","text":"Проведи экскурсию по музею забытых звуков","deeplinkText":"Мне хочется прочитать законченную мини-экскурсию по вымышленному музею звуков. Представь три экспоната: треск костра, стук печатной машинки и капли по крыше. Передай каждый звук словами, добавь по необычной детали и объясни, что можно в нём заметить. Заверши экскурсию в этом же ответе. Без аудио, просьб прислушаться к отсутствующей записи, выбора звука и следующего хода.","start":"","end":"","model":"","aliceApps":""},{"id":"home-workout-plan","text":"Собери план тренировок дома","deeplinkText":"Хочу заниматься дома три раза в неделю по 30 минут, инвентаря нет. Составь программу на месяц для новичка: упражнения, подходы, как постепенно усложнять и как понять, что техника правильная.","start":"","end":"","model":"","aliceApps":""},{"id":"follow-up-colleague-ok","text":"Как вежливо переспросить коллегу после «ок»?","deeplinkText":"Коллега на моё подробное сообщение с задачей ответил одним «ок», и непонятно, всё ли ему ясно. Как вежливо уточнить без пассивной агрессии? Дай три варианта сообщения для рабочего чата.","start":"","end":"","model":"","aliceApps":""},{"id":"wedding-anniversary-toast","text":"Напиши тост на 10 лет свадьбы друзей","deeplinkText":"Друзья празднуют 10 лет свадьбы, и мне нужно сказать тост за столом. Напиши короткий тост: с лёгким юмором, тёплыми словами про пару и без пошлости. Дай два варианта: потрогательнее и повеселее.","start":"","end":"","model":"","aliceApps":""},{"id":"grandma-80-birthday","text":"Напиши тёплое поздравление бабушке на 80 лет без штампов","deeplinkText":"У моей бабушки юбилей, 80 лет. Напиши тёплое поздравление, которое можно сказать за столом. Вместо общих пожеланий поблагодари через простые детали: пироги, советы, то, как она всех ждёт в гости. Без фраз «крепкого здоровья» и «наша опора».","start":"","end":"","model":"","aliceApps":""},{"id":"report-delay-status","text":"Напиши статус задержки отчёта с двумя вариантами","deeplinkText":"Мне нужен пример готового статуса для команды. Отчёт нужен к четвергу, но данные соседней команды задерживаются. Напиши короткий текст: что заблокировано, риск срока и два варианта — взять прошлый период с явной пометкой или перенести черновик на пятницу. Не добавляй имён, дат, полей для заполнения и не проси вводные.","start":"","end":"","model":"","aliceApps":""},{"id":"review-done-criteria","text":"Уточни критерии готовности обзора тремя вопросами","deeplinkText":"Мне поручили итоговый обзор, но критерии готовности не указали. Сформулируй три вопроса о составе, формате и сроке результата для рабочего чата.","start":"","end":"","model":"","aliceApps":""},{"id":"materials-deadline-request","text":"Смягчи просьбу присылать материалы за день до срока","deeplinkText":"Перепиши «Ты опять прислал всё в последний момент. Разбирайся сам» в двух готовых вариантах: нейтрально и твёрже, без упрёков и пассивной агрессии. В обоих попроси присылать материалы минимум за день до срока. Единственная граница: при поздней отправке я не обещаю проверить к сроку; за своевременную отправку отвечает отправитель. Не обещай проверку при ранней отправке и не добавляй других причин, санкций или условий. Только два сообщения, без полей и вопросов.","start":"","end":"","model":"","aliceApps":""},{"id":"birthday-invitation","text":"Напиши приглашение друзьям на день рождения","deeplinkText":"В субботу отмечаю день рождения дома и хочу позвать друзей. Напиши короткое приглашение для общего чата: тёплое, с юмором, со временем начала в 18:00 и просьбой ответить, кто придёт.","start":"","end":"","model":"","aliceApps":""},{"id":"hedgehog-fairy-tale","text":"Сочини сказку про ёжика, который боится темноты","deeplinkText":"Мой ребёнок пяти лет боится засыпать без света. Сочини короткую добрую сказку на ночь про ёжика, который тоже боится темноты, а потом с ней подружится. С хорошим концом и простым выводом, что темнота не страшная.","start":"","end":"","model":"","aliceApps":""},{"id":"stroller-sale-ad","text":"Напиши объявление о продаже детской коляски","deeplinkText":"Хочу продать детскую прогулочную коляску: ей два года, складывается одной рукой, колёса и тормоз в порядке, на ручке небольшие потёртости. Напиши объявление для сайта: честно, без восклицательных знаков и лишних обещаний, и с фразой про небольшой торг.","start":"","end":"","model":"","aliceApps":""},{"id":"puppy-names","text":"Придумай 15 имён для щенка","deeplinkText":"Мы взяли домой щенка: девочка, рыжая и очень активная. Придумай 15 имён, коротких, чтобы легко звать на прогулке, и раздели их на смешные, нежные и необычные.","start":"","end":"","model":"","aliceApps":""},{"id":"doctor-thank-you-review","text":"Напиши отзыв с благодарностью терапевту","deeplinkText":"Хочу оставить на сайте клиники отзыв с благодарностью терапевту: на приёме внимательно выслушали, не торопили и понятно объяснили, что делать дальше. Напиши тёплый отзыв на один абзац, без пафоса, с этими деталями.","start":"","end":"","model":"","aliceApps":""},{"id":"decline-collaboration","text":"Напиши отказ от сотрудничества из-за загрузки, не навсегда","deeplinkText":"Нам предложили сотрудничество, но сейчас мы не готовы за него взяться. Напиши короткое вежливое письмо-отказ: поблагодарить, сослаться на загрузку в ближайшие месяцы и оставить возможность вернуться к разговору позже.","start":"","end":"","model":"","aliceApps":""},{"id":"lake-weekend-post","text":"Напиши пост про выходные на озере без пафоса, два варианта","deeplinkText":"Мы с друзьями провели выходные на озере: природа, тишина, очень красиво. Напиши короткий пост для соцсетей от лица «мы»: тёплый, без пафоса, с одним эмодзи в конце. Дай два варианта: посерьёзнее и с юмором.","start":"","end":"","model":"","aliceApps":""},{"id":"free-phone-storage","text":"Как освободить память в телефоне и не потерять фото?","deeplinkText":"У меня телефон на Android, и постоянно заканчивается память. Распиши по шагам, как сначала сохранить фото в облако, а потом почистить встроенными средствами кэш, ненужные приложения и файлы, и как сделать, чтобы место не забивалось снова.","start":"","end":"","model":"","aliceApps":""},{"id":"laptop-under-60k","text":"Какой ноутбук взять для работы и учёбы до 60 тысяч?","deeplinkText":"Мне нужен ноутбук для работы с документами, учёбы, видеозвонков и фильмов, бюджет до 60 тысяч рублей. Объясни, какие характеристики важны: процессор, память, экран, батарея, и на чём можно сэкономить. В конце дай короткий список, что проверить при покупке.","start":"","end":"","model":"","aliceApps":""},{"id":"nursery-humidifier","text":"Какой увлажнитель выбрать в детскую?","deeplinkText":"Зимой в детской очень сухой воздух, хотим купить увлажнитель. Объясни, чем отличаются ультразвуковые, паровые и традиционные, какой безопаснее для ребёнка, на что смотреть при выборе и как ухаживать.","start":"","end":"","model":"","aliceApps":""},{"id":"car-seat-under-15k","text":"Как выбрать автокресло до 15 тысяч для ребёнка около года","deeplinkText":"Моему ребёнку скоро год, нам нужно новое автокресло. Объясни, какие бывают группы кресел, на что смотреть при выборе в первую очередь и почему малышей советуют возить против хода движения. Бюджет до 15 тысяч рублей.","start":"","end":"","model":"","aliceApps":""},{"id":"steamer-vs-multicooker","text":"Сравни пароварку и мультиварку для здоровой готовки","deeplinkText":"Хочу готовить полезнее и выбираю между пароваркой и мультиваркой. Сравни их: что готовят лучше, сколько места занимают, как за ними ухаживать и кому что подойдёт.","start":"","end":"","model":"","aliceApps":""},{"id":"cancel-subscriptions","text":"Как найти и отключить ненужные платные подписки?","deeplinkText":"С моей карты каждый месяц списываются небольшие суммы по 199–599 рублей, и непонятно, за какие подписки. Распиши по шагам, где искать все платные подписки, как отключить ненужные и как не попадать на автопродление после пробного периода.","start":"","end":"","model":"","aliceApps":""},{"id":"vacation-savings","text":"Как накопить 150 тысяч на отпуск за 10 месяцев?","deeplinkText":"Хочу через 10 месяцев поехать в отпуск, нужно примерно 150 тысяч рублей. Посчитай, сколько откладывать в месяц, предложи простую схему, как не потратить эти деньги, и что делать, если в какой-то месяц отложить не получилось. Откладывать буду просто на отдельную карту.","start":"","end":"","model":"","aliceApps":""},{"id":"budget-example-80k","text":"Покажи схему бюджета на примере зарплаты 80 тысяч","deeplinkText":"Хочу понять, куда уходят деньги, и начать откладывать. Предложи простую схему бюджета на месяц: на какие категории делить траты, какую долю обычно откладывают и как вести учёт за пять минут в неделю. Покажи на примере зарплаты 80 тысяч рублей и оформи таблицей.","start":"","end":"","model":"","aliceApps":""},{"id":"work-burnout-recovery","text":"Как вернуть силы, если работа выматывает?","deeplinkText":"Последние месяцы моя работа совсем не радует, к вечеру нет сил ни на что. Составь мягкий план на две недели: небольшие изменения в режиме, отдыхе и работе, которые помогают восстановить силы, и признаки, когда стоит обратиться к специалисту.","start":"","end":"","model":"","aliceApps":""},{"id":"phone-rules-son","text":"Как договориться с сыном 10 лет о телефоне без ссор?","deeplinkText":"Моему сыну десять лет, он сидит в телефоне по пять часов в день, а запреты заканчиваются скандалом. Подскажи, как договориться о правилах без ссор: что сказать в первом разговоре, какие правила предложить и как их соблюдать всей семьёй.","start":"","end":"","model":"","aliceApps":""}],"greetings":[{"key":"technical-phrase","title":"Привет!","description":"Чем помочь сегодня?"}],"folder":{"widgets":[{"id":"education","type":"typed","title":"Для учёбы","subtitle":"Помогу понять, а не списать","isNew":false,"isBeta":true,"media":{"image":{"light":"https://yastatic.net/s3/web-alice-images/main-page-widgets/folder/education-icon-2.webp","dark":"https://yastatic.net/s3/web-alice-images/main-page-widgets/folder/education-icon-2.webp"}},"action":{"type":"screen","screen":"education","focusInput":false,"url":""},"wide":false,"personalization":false,"authRequired":false,"isNda":false,"background":{"light":"","dark":""},"styles":{},"component":""},{"id":"alice-agents-best-price","type":"typed","title":"Найти дешевле","subtitle":"Найду выгодные цены и скидки","media":{"image":{"light":"https://yastatic.net/s3/web-alice-images/main-page-widgets/folder/rubles-light.webp","dark":"https://yastatic.net/s3/web-alice-images/main-page-widgets/folder/rubles-dark.webp"}},"action":{"type":"deeplink","url":"/?model=alice-agents-best-price","focusInput":true,"screen":""},"wide":false,"personalization":false,"isNew":false,"isBeta":true,"authRequired":true,"isNda":false,"background":{"light":"","dark":""},"styles":{},"component":""}]}},"mainPageSurfaceNodes":{"main-page-standalone":{"variants":{"default":{"greetings":[{"key":"technical-phrase","title":"Привет!","description":"Чем помочь сегодня?"}],"suggests":[{"id":"check-used-car","text":"Что проверить при покупке машины с рук?","deeplinkText":"Хотим купить подержанную машину с рук. Распиши, что проверить при осмотре и тест-драйве, какие документы посмотреть, как проверить историю авто и в каких случаях лучше сразу отказаться от покупки."},{"id":"save-on-fuel","text":"Как тратить меньше на бензин?","deeplinkText":"Хочу тратить меньше на бензин, проезжаю около 1500 км в месяц, расход 9 литров на сотню, литр стоит 60 рублей. Дай 10 привычек за рулём и в обслуживании, которые снижают расход, и посчитай, сколько я трачу сейчас и сколько сэкономлю, если расход упадёт на 5 и на 10%."},{"id":"grandma-family-stories","text":"Подготовь вопросы бабушке для семейных историй","deeplinkText":"Хочу записать семейные истории со слов бабушки, но не превращать разговор в допрос. Придумай двенадцать открытых вопросов о повседневной жизни, друзьях и смешных случаях, начиная с лёгких. Добавь две мягкие фразы, чтобы сменить тему, если вспоминать не хочется."},{"id":"first-date-topics","text":"О чём поговорить на первом свидании?","deeplinkText":"У меня скоро первое свидание в кафе, до этого была только переписка, и пугают неловкие паузы. Предложи 10 вопросов, чтобы узнать человека, и разложи их по ходу вечера: начало, середина, конец. И каких тем лучше не касаться."},{"id":"fridge-odor","text":"Убери запах из пустого обесточенного холодильника","deeplinkText":"Холодильник уже пуст и отключён от розетки, продукты хранятся в другом исправном холодильнике. Дай порядок поиска и удаления запаха только на доступных полках, ящиках и внутренних стенках: мягкая ткань, чуть тёплая вода и нейтральное средство для посуды; уплотнитель — только чистой водой. Затем ополаскивание, просушка и проветривание. Дренаж, поддон, панели, проводку и трубки не трогать. Объясни, когда остановиться и вызвать сервис, если запах остался."},{"id":"shelf-basket-passage","text":"Проверь, не перекроют ли полка и корзина проход","deeplinkText":"Проверь учебную расстановку в прихожей. Коридор шириной 110 см; у одной стены низкая устойчивая полка глубиной 30 см, обувь не выступает. У другой стены напротив неё хотят поставить корзину глубиной 15 см. Дверь вне этой зоны. Обязательная ширина свободного прохода — минимум 80 см. Дай таблицу: без корзины и с корзиной, формула, ширина, соответствует ли условию. В конце реши, можно ли добавить корзину. Только расчёт и вывод; перестановок, покупок и рекомендаций по хранению не добавляй."},{"id":"wallpaper-rolls","text":"Посчитай рулоны обоев на комнату 4×3 с запасом","deeplinkText":"Хочу купить обои на комнату 4 на 3 метра высотой 2,7 метра. Рулон шириной 1,06 метра и длиной 10 метров, рисунок без подгонки; стены считаем целиком, не вычитая дверь и окно. Посчитай полосы и рулоны с объяснением, отдельно укажи запас."},{"id":"apartment-check-before-trip","text":"Дай проверку квартиры перед отъездом на две недели","deeplinkText":"Я уезжаю из квартиры на две недели и боюсь забыть что-то дома. Составь короткий порядок проверки воды, электроприборов, продуктов и окон за вечер до отъезда и перед выходом. Учти, что холодильник остаётся включённым, а запасные ключи есть у близкого человека."},{"id":"slow-sink-drain","text":"Как прочистить слив раковины без смешивания химии","deeplinkText":"У меня вода в раковине уходит медленно, но слив не перекрыт полностью. Составь безопасный порядок первых действий без смешивания химии: проверить сетку, попробовать вантуз и понять, нужен ли сантехник. Если предлагаешь разбирать сифон, отдельно назови условия, когда самостоятельно этого делать не стоит."},{"id":"cleanup-before-guests","text":"Составь план уборки на час перед приходом гостей","deeplinkText":"Через два часа придут гости, а дома беспорядок. Составь план уборки на час: что сделать в первую очередь, что можно быстро спрятать и что спокойно пропустить."},{"id":"declutter-wardrobe","text":"Составь план, как разобрать шкаф за один день","deeplinkText":"Мой шкаф забит вещами, половину из которых не ношу. Составь план на один выходной день: в каком порядке разбирать, по каким правилам решать, что оставить, а что отдать, и как разложить, чтобы порядок держался."},{"id":"daily-cleaning-schedule","text":"Составь график уборки по 20 минут в день","deeplinkText":"Не хочу тратить на уборку всю субботу. Составь график на неделю по 20 минут в день, чтобы квартира оставалась чистой: что делать в какой день и что достаточно делать раз в месяц."},{"id":"streak-free-windows","text":"Расскажи, как мыть окна без разводов подручными средствами","deeplinkText":"После мытья окон у меня остаются разводы. Расскажи по шагам, как вымыть окна без разводов подручными средствами: что взять, в каком порядке мыть и в какую погоду лучше. Без дорогих средств."},{"id":"kettle-limescale","text":"Как убрать накипь в чайнике, чтобы она появлялась реже","deeplinkText":"У меня в электрическом чайнике толстый слой накипи. Распиши по шагам, как его очистить подручными средствами, сколько чего брать, как потом промыть и как сделать, чтобы накипь появлялась реже."},{"id":"wash-down-jacket","text":"Как постирать пуховик в машинке и расправить сбитый пух","deeplinkText":"Хочу постирать зимний пуховик дома в стиральной машине. Распиши по шагам: как подготовить, какой режим и средство выбрать, как сушить и что делать, если пух всё-таки сбился в комки."},{"id":"oversalted-soup","text":"Как спасти пересоленный суп без слива и мифов о картошке","deeplinkText":"У меня пересолен готовый суп, и выливать кастрюлю жалко. Предложи три способа сделать вкус менее солёным без слива и объясни, какой выбрать для густого супа. Не предлагай картофель или рис как способ вытянуть соль: они впитывают бульон вместе с ней."},{"id":"runny-pancake-batter","text":"Как исправить жидкое тесто для оладий небольшими шагами","deeplinkText":"У меня тесто для оладий получилось заметно жиже, чем ожидалось, а сковорода уже разогрета. Подскажи, как поправить консистенцию небольшими шагами и как проверить на первой порции, что тесто стало подходящим."},{"id":"lunch-boxes-no-reheat","text":"Придумай пять обедов с собой без разогрева и протекания","deeplinkText":"Мне нужно брать обед с собой туда, где нет микроволновки. Предложи пять вариантов, которые удобно есть холодными, не текут в контейнере и собираются из обычных продуктов; добавь короткий список общей подготовки накануне."},{"id":"shared-dinner-toppings","text":"Придумай один ужин без мяса и острого с добавками для всех","deeplinkText":"У нас дома одному человеку хочется без острого, другой не ест мясо. Придумай общий ужин, где основа подходит всем, а добавки можно подать отдельно. Нужен простой вариант на плите, список ингредиентов и последовательность готовки."},{"id":"leftover-buckwheat-dishes","text":"Придумай три блюда из готовой гречки, овощей и сыра","deeplinkText":"После ужина у меня остались готовая гречка, запеченные овощи и немного сыра. Придумай три способа собрать из них разные блюда на следующий прием пищи, не предлагая докупать редкие продукты и не повторяя вчерашний ужин."},{"id":"food-for-eight-guests","text":"Посчитай пасту, салат и закуски на восемь гостей","deeplinkText":"Я собираю дома небольшую компанию из восьми человек и хочу приготовить пасту, салат и закуски. Рассчитай примерное количество продуктов по категориям и покажи, как скорректировать порции, если часть гостей ест мало."},{"id":"pie-without-eggs-milk","text":"Дай рецепт пирога без яиц и молока","deeplinkText":"Хочу испечь пирог, но дома нет яиц и молока. Подскажи, чем их заменить, и дай рецепт простого пирога из того, что обычно есть: мука, сахар, растительное масло, яблоки."},{"id":"chicken-rice-dinners","text":"Придумай 3 ужина из курицы и риса за 30 минут","deeplinkText":"У меня дома есть куриное филе, рис, лук и морковь. Придумай три варианта ужина, каждый не дольше 30 минут, и распиши пошагово самый простой."},{"id":"choose-movie-together","text":"Предложи 5 шагов, как выбирать фильм вдвоём без споров","deeplinkText":"Мы с партнёром каждый вечер тратим полчаса на выбор фильма и в итоге ничего не смотрим. Предложи простую систему выбора из пяти шагов: как договориться о жанре и настроении и что делать, если спор не заканчивается. Названия фильмов не приводи."},{"id":"cut-sugar-plan","text":"Составь план на 3 недели и 10 перекусов вместо сладкого","deeplinkText":"Каждый день ем много сладкого: печенье к чаю, шоколадки после обеда. Хочу постепенно сократить, но без жёстких запретов. Составь план на три недели и предложи десять замен для перекусов."},{"id":"healthy-weekly-dinners","text":"Составь 7 полезных ужинов по 30 минут и список покупок","deeplinkText":"Хочу ужинать полезнее, но без строгих диет и подсчётов. Составь меню из семи ужинов на неделю из обычных продуктов, каждый не дольше 30 минут от начала до конца, и общий список покупок."},{"id":"dry-skin-care","text":"Составь уход за сухой кожей лица до 3000 ₽","deeplinkText":"У меня сухая кожа лица, к вечеру стягивается и шелушится. Составь простой уход утром и вечером: какие средства нужны, в каком порядке наносить и чего избегать. Бюджет на всё до 3000 рублей."},{"id":"sleep-schedule-23","text":"Как перейти на отбой в 23:00 без таблеток?","deeplinkText":"Я ложусь после часа ночи и утром еле встаю, хочу перестроить режим. Составь план на две недели, как постепенно сдвинуть отбой на 23:00, и вечерние привычки, которые помогут быстрее засыпать. Без таблеток и добавок."},{"id":"ten-thousand-steps","text":"Как за месяц дойти до 10 000 шагов в день?","deeplinkText":"Сейчас я прохожу в день около трёх тысяч шагов, почти всё время сижу. Составь план на четыре недели, как постепенно дойти до 10 000 шагов, и приёмы, как добавить ходьбу в обычный день без спортзала."},{"id":"therapist-visit-questions","text":"Составь вопросы терапевту к плановому приёму","deeplinkText":"У меня скоро плановый приём у терапевта, а там всегда всё быстро. Составь восемь вопросов о самочувствии и профилактике и подскажи, как коротко описать жалобы в трёх пунктах: что беспокоит, с какого времени и что помогает."},{"id":"resume-education-edit","text":"Отредактируй три учебных пункта резюме без выдумок","deeplinkText":"Отредактируй учебный блок резюме вымышленного человека, сохранив только факты. Черновик: «Я входил в команду, которая собрала списки заявок в общую таблицу. Я согласовал поля таблицы. Я описал порядок обновления таблицы». Пометь вымышленность. Дай три коротких деловых пункта без «я»: первый начинается с «Участвовал», остальные — с активных глаголов. Не добавляй цели, эффекты, улучшения, инструменты и обязанности. Никаких полей или вопросов."},{"id":"compare-job-offers","text":"Сравни работу в офисе за 90 тысяч и удалёнку за 80","deeplinkText":"Мне предложили две работы: 90 тысяч в офисе в часе езды от дома и 80 тысяч на удалёнке. Дорога в одну сторону стоит около 150 рублей. Сравни: сколько времени и денег уходит на дорогу за месяц, что ещё учесть кроме зарплаты, и сведи всё в таблицу."},{"id":"board-games-six-adults","text":"Посоветуй 5 простых настольных игр на 6 взрослых","deeplinkText":"Мы собираемся вечером компанией из шести взрослых. Посоветуй пять настольных игр, которые можно объяснить за пять минут, и для каждой напиши, кому зайдёт и сколько длится партия."},{"id":"coop-games-two-players","text":"Посоветуй 6 игр на двоих за одной приставкой или ПК","deeplinkText":"Мы ищем, во что поиграть вдвоём по вечерам на одной приставке или компьютере. Предложи шесть кооперативных игр разных жанров: для каждой одну фразу о сюжете, сложность и сколько часов она займёт."},{"id":"beach-books","text":"Посоветуй 7 лёгких затягивающих книг разных жанров на море","deeplinkText":"Едем на море на неделю, хочу взять пару книг, которые читаются легко и затягивают. Посоветуй семь книг разных жанров: детектив, приключения, лёгкая проза. Для каждой автор, одна фраза о сюжете без спойлеров и почему подойдёт."},{"id":"music-listening-game","text":"Придумай игру на 5 минут: вслушаться в музыку","deeplinkText":"Я хочу по-новому послушать музыку, которую уже включу. Придумай короткую игру на пять минут: сначала заметить один повтор, затем один контраст и в конце описать одно настроение; не называй конкретные произведения и не проси прикладывать аудио."},{"id":"classical-music-plan","text":"Составь план на 2 недели по 20 минут, как слушать классику","deeplinkText":"Хочу начать слушать классическую музыку, но не знаю, с чего начать и как не заскучать. Дай план на две недели по 20 минут в день: как слушать, на что обращать внимание и как выбрать, что слушать дальше. Композиторов и произведения не называй."},{"id":"pack-suitcase-week","text":"Как собрать чемодан на неделю без лишнего?","deeplinkText":"Я еду в отпуск на неделю и каждый раз беру лишнее. Объясни, как собрать чемодан по системе: с чего начать, как выбирать вещи комплектами и что проверить в последний вечер."},{"id":"complaint-roof-leak","text":"Напиши жалобу в УК на протекающую крышу","deeplinkText":"У нас протекает крыша над квартирой в сильный дождь и когда тает снег. Составь письменное обращение в управляющую компанию: что случилось, какие обязанности у УК, в какой срок прошу устранить и что сделаем, если не исправят. Вежливо и твёрдо."},{"id":"appeal-camera-fine","text":"Как обжаловать штраф с камеры, если он кажется ошибочным?","deeplinkText":"Мне пришёл штраф с камеры, и он, по-моему, ошибочный. Распиши порядок обжалования по шагам: сроки, куда подавать жалобу, какие доказательства собрать, и дай шаблон текста жалобы."},{"id":"return-shoes-no-receipt","text":"Как вернуть обувь, если чек не сохранился?","deeplinkText":"Обувь не подошла, с покупки прошла неделя, а чек не сохранился. Хочу её вернуть: объясни по шагам, что сказать продавцу, чем можно подтвердить покупку и что делать, если откажут."},{"id":"course-refund","text":"Как вернуть деньги за остаток курса, если он не подошёл","deeplinkText":"Мы оплатили онлайн-курс на полгода, прошли две недели и поняли, что он не подходит. Объясни по шагам, как вернуть деньги за оставшееся время, что написать в заявлении и что делать, если школа отказывает."},{"id":"cat-wakes-early","text":"Как отучить кота будить меня в 5 утра?","deeplinkText":"Мой кот каждый день будит меня в пять утра: мяукает и ходит по кровати. Объясни, почему кошки так делают, и составь план на две недели, как мягко отучить его без наказаний и криков."},{"id":"kitten-preparation","text":"Что купить и подготовить к появлению котёнка?","deeplinkText":"Через неделю мы забираем домой котёнка, он у нас первый. Составь список, что купить заранее, как подготовить квартиру и как провести первые три дня, чтобы ему было спокойно."},{"id":"weekly-review-example","text":"Покажи недельный обзор и заполненную итоговую заметку","deeplinkText":"Мне нужен самодостаточный пример обзора недели за 20 минут. Дай четыре шага: календарь, обязательное, свободные окна и старт понедельника. Затем покажи уже заполненную итоговую заметку для вымышленной недели: встреча во вторник в 12:00, отчёт к четвергу, свободна среда после 15:00. Не проси мой календарь, ничего заполнять или сообщать."},{"id":"compare-mobile-plans","text":"Сравни тарифы на 20 и 30 ГБ при разном расходе интернета","deeplinkText":"Учебный расчёт: тариф A — 690 ₽/мес., включено 20 ГБ, сверх лимита 80 ₽ за каждый полный ГБ; B — 890 ₽/мес., 30 ГБ, сверх лимита 40 ₽ за полный ГБ. Для расхода 18, 25 и 33 ГБ составь одну итоговую таблицу: расход, перерасход A, сумма A, перерасход B, сумма B. Покажи формулы расчёта доплаты и полной цены, проверь сложение. Других платежей нет. Без внешнего поиска и выбора тарифа за меня."},{"id":"spoon-three-views","text":"Рассмотри ложку глазами инженера, художника и антрополога","deeplinkText":"Мне любопытно, что можно заметить в самой обычной деревянной ложке. Рассмотри её с трёх точек зрения — инженера, художника и антрополога: по два наблюдения и один вопрос от каждого, не выдумывая историю именно этой ложки."},{"id":"seasons-lamp-ball","text":"Объясни смену сезонов через сцену с лампой и мячом","deeplinkText":"Хочу понять, почему в течение года меняются сезоны. Объясни через простую сцену с лампой и наклонённым мячом: покажи, как меняется освещение двух полушарий, и отдельно уточни, какую ошибку часто создаёт слишком буквальная аналогия; без школьного конспекта и формул."},{"id":"painting-viewing-questions","text":"Дай шесть вопросов для внимательного просмотра картины","deeplinkText":"Дай шпаргалку для спокойного рассматривания живописи без знаний истории искусства: шесть простых вопросов — по два о композиции, цвете и свете, сюжете и впечатлении. Затем покажи применение на одной явно вымышленной картине: коротко опиши её, дай шесть заполненных примерных ответов и заметку из двух предложений. Не приписывай картину реальному художнику или музею. Ответ должен быть законченным: без полей, просьб прислать изображение, вопросов ко мне и предложения продолжить."},{"id":"phone-free-walk","text":"Придумай восемь наблюдений на прогулке без телефона","deeplinkText":"Я гуляю по знакомому району и хочу заметить в нём что-то новое, не пользуясь телефоном и не фотографируя прохожих. Придумай восемь заданий на наблюдение за архитектурой, природой и городскими звуками, а в конце предложи способ выбрать одно открытие, о котором хочется рассказать близкому."},{"id":"paint-for-room","text":"Посчитай краску на комнату 4×3 в два слоя","deeplinkText":"Хочу покрасить стены в комнате 4 на 3 метра с потолком 2,7 метра, в ней окно 1,5 на 1,5 метра и дверь 0,8 на 2 метра, на банке расход 1 литр на 10 квадратных метров. Посчитай, сколько краски нужно в два слоя, и объясни расчёт, чтобы потом пересчитать для другой комнаты."},{"id":"cups-to-grams","text":"Переведи чашки из рецепта в граммы","deeplinkText":"У меня рецепт печенья в американских мерах: 2 чашки муки, 1 чашка сахара и полчашки сливочного масла. Переведи всё в граммы, объясни, как переводить другие продукты, и дай короткую табличку на будущее."},{"id":"synonyms-interesting","text":"Подбери замены слову «интересный» для отзыва","deeplinkText":"Я пишу отзыв о книге и постоянно повторяю слово «интересный». Подбери 10 замен для разных случаев: про сюжет, героев, идею и язык, и покажи каждую в готовой фразе для отзыва."},{"id":"remember-colleague-names","text":"Как запомнить имена новых коллег?","deeplinkText":"Через неделю выхожу на новую работу, и знакомиться придётся сразу с десятком людей, а имена я забываю через минуту. Дай пять приёмов, как их запомнить, с примером для каждого, и подскажи, что сказать, если имя всё-таки забылось."},{"id":"book-a-month","text":"Как читать книгу в месяц по 20 минут в день?","deeplinkText":"Хочу читать хотя бы одну книгу в месяц, но вечно бросаю на середине, свободно у меня минут 20 в день. Составь план на месяц: когда читать, по сколько страниц, что делать, если день выпал, и как выбрать первую книгу, чтобы не бросить."},{"id":"coffee-spending-year","text":"Посчитай, сколько я трачу на кофе за год","deeplinkText":"Я покупаю кофе навынос почти каждый рабочий день, в среднем по 250 рублей. Посчитай, сколько это выходит в месяц и за год, сравни с домашним кофе по 40 рублей за чашку и покажи всё в небольшой таблице."},{"id":"moving-plan","text":"Распиши по неделям, как подготовиться к переезду","deeplinkText":"Через месяц мы переезжаем в другую квартиру. Распиши по неделям, что и когда сделать, чтобы ничего не забыть: от поиска грузчиков до переоформления интернета и коммуналки. В конце дай короткий список на сам день переезда."},{"id":"teen-slang","text":"Объясни 15 слов подросткового сленга с примерами","deeplinkText":"У меня дома подросток, и я не понимаю половину того, что он говорит: «кринж», «вайб», «рофл». Составь словарик из 15 выражений, которые подростки говорят сейчас, с переводом на обычный язык и примером фразы."},{"id":"explain-thunder-kid","text":"Объясни гром ребёнку 5 лет без страшилок и предложи игру","deeplinkText":"Мой ребёнок пяти лет боится грозы и спрашивает, откуда гром. Объясни, как рассказать ему об этом простыми словами без страшных подробностей, и предложи одну игру дома, которая покажет, как это работает."},{"id":"document-retention","text":"Сколько хранить квитанции ЖКХ, чеки, талоны и договоры","deeplinkText":"У меня дома скопилась куча бумаг: квитанции за коммуналку, чеки, гарантийные талоны, старые договоры. Объясни, сколько обычно хранить каждый вид документов и почему, и сведи всё в короткую таблицу."},{"id":"reading-syllables-games","text":"Дай план игр на 2 недели: читать по слогам без экранов","deeplinkText":"Мой сын, ему шесть лет, путает буквы и не любит читать. Составь план из игр на две недели по 10 минут в день, чтобы он научился читать по слогам и не потерял интерес. Без экранов."},{"id":"alien-in-cafe","text":"Сыграй роль инопланетного исследователя в обычном кафе","deeplinkText":"Мне любопытно представить, что ты исследователь с другой планеты и впервые наблюдаешь обычное кафе, не зная, зачем люди туда приходят. Дай три забавные, но доброжелательные гипотезы о том, что видишь, а затем объясни человеческий смысл каждой; не превращай это в рассказ с неожиданной развязкой."},{"id":"world-music-colors","text":"Составь версию мира, где люди видят музыку как цвет","deeplinkText":"Мне любопытно представить, что люди могут видеть музыку в виде меняющихся цветов, но слышат её как обычно. Опиши три изменения в повседневной жизни, одно новое неудобство и один неожиданный способ общения; не пиши сюжет, а покажи, как устроен этот воображаемый мир."},{"id":"museum-of-sounds","text":"Проведи экскурсию по музею забытых звуков","deeplinkText":"Мне хочется прочитать законченную мини-экскурсию по вымышленному музею звуков. Представь три экспоната: треск костра, стук печатной машинки и капли по крыше. Передай каждый звук словами, добавь по необычной детали и объясни, что можно в нём заметить. Заверши экскурсию в этом же ответе. Без аудио, просьб прислушаться к отсутствующей записи, выбора звука и следующего хода."},{"id":"home-workout-plan","text":"Составь план домашних тренировок без инвентаря на месяц","deeplinkText":"Хочу заниматься дома три раза в неделю по 30 минут, инвентаря нет. Составь программу на месяц для новичка: упражнения, подходы, как постепенно усложнять и как понять, что техника правильная."},{"id":"follow-up-colleague-ok","text":"Как вежливо переспросить коллегу после «ок»?","deeplinkText":"Коллега на моё подробное сообщение с задачей ответил одним «ок», и непонятно, всё ли ему ясно. Как вежливо уточнить без пассивной агрессии? Дай три варианта сообщения для рабочего чата."},{"id":"wedding-anniversary-toast","text":"Напиши тост на 10 лет свадьбы друзей","deeplinkText":"Друзья празднуют 10 лет свадьбы, и мне нужно сказать тост за столом. Напиши короткий тост: с лёгким юмором, тёплыми словами про пару и без пошлости. Дай два варианта: потрогательнее и повеселее."},{"id":"grandma-80-birthday","text":"Напиши тёплое поздравление бабушке на 80 лет без штампов","deeplinkText":"У моей бабушки юбилей, 80 лет. Напиши тёплое поздравление, которое можно сказать за столом. Вместо общих пожеланий поблагодари через простые детали: пироги, советы, то, как она всех ждёт в гости. Без фраз «крепкого здоровья» и «наша опора»."},{"id":"report-delay-status","text":"Напиши статус задержки отчёта с двумя вариантами","deeplinkText":"Мне нужен пример готового статуса для команды. Отчёт нужен к четвергу, но данные соседней команды задерживаются. Напиши короткий текст: что заблокировано, риск срока и два варианта — взять прошлый период с явной пометкой или перенести черновик на пятницу. Не добавляй имён, дат, полей для заполнения и не проси вводные."},{"id":"review-done-criteria","text":"Уточни критерии готовности обзора тремя вопросами","deeplinkText":"Мне поручили итоговый обзор, но критерии готовности не указали. Сформулируй три вопроса о составе, формате и сроке результата для рабочего чата."},{"id":"materials-deadline-request","text":"Смягчи просьбу присылать материалы за день до срока","deeplinkText":"Перепиши «Ты опять прислал всё в последний момент. Разбирайся сам» в двух готовых вариантах: нейтрально и твёрже, без упрёков и пассивной агрессии. В обоих попроси присылать материалы минимум за день до срока. Единственная граница: при поздней отправке я не обещаю проверить к сроку; за своевременную отправку отвечает отправитель. Не обещай проверку при ранней отправке и не добавляй других причин, санкций или условий. Только два сообщения, без полей и вопросов."},{"id":"birthday-invitation","text":"Напиши приглашение друзьям на день рождения","deeplinkText":"В субботу отмечаю день рождения дома и хочу позвать друзей. Напиши короткое приглашение для общего чата: тёплое, с юмором, со временем начала в 18:00 и просьбой ответить, кто придёт."},{"id":"hedgehog-fairy-tale","text":"Сочини сказку про ёжика, который боится темноты","deeplinkText":"Мой ребёнок пяти лет боится засыпать без света. Сочини короткую добрую сказку на ночь про ёжика, который тоже боится темноты, а потом с ней подружится. С хорошим концом и простым выводом, что темнота не страшная."},{"id":"stroller-sale-ad","text":"Напиши объявление о продаже детской коляски","deeplinkText":"Хочу продать детскую прогулочную коляску: ей два года, складывается одной рукой, колёса и тормоз в порядке, на ручке небольшие потёртости. Напиши объявление для сайта: честно, без восклицательных знаков и лишних обещаний, и с фразой про небольшой торг."},{"id":"puppy-names","text":"Придумай 15 имён для щенка","deeplinkText":"Мы взяли домой щенка: девочка, рыжая и очень активная. Придумай 15 имён, коротких, чтобы легко звать на прогулке, и раздели их на смешные, нежные и необычные."},{"id":"doctor-thank-you-review","text":"Напиши отзыв с благодарностью терапевту","deeplinkText":"Хочу оставить на сайте клиники отзыв с благодарностью терапевту: на приёме внимательно выслушали, не торопили и понятно объяснили, что делать дальше. Напиши тёплый отзыв на один абзац, без пафоса, с этими деталями."},{"id":"decline-collaboration","text":"Напиши отказ от сотрудничества из-за загрузки, не навсегда","deeplinkText":"Нам предложили сотрудничество, но сейчас мы не готовы за него взяться. Напиши короткое вежливое письмо-отказ: поблагодарить, сослаться на загрузку в ближайшие месяцы и оставить возможность вернуться к разговору позже."},{"id":"lake-weekend-post","text":"Напиши пост про выходные на озере без пафоса, два варианта","deeplinkText":"Мы с друзьями провели выходные на озере: природа, тишина, очень красиво. Напиши короткий пост для соцсетей от лица «мы»: тёплый, без пафоса, с одним эмодзи в конце. Дай два варианта: посерьёзнее и с юмором."},{"id":"free-phone-storage","text":"Как освободить память в телефоне и не потерять фото?","deeplinkText":"У меня телефон на Android, и постоянно заканчивается память. Распиши по шагам, как сначала сохранить фото в облако, а потом почистить встроенными средствами кэш, ненужные приложения и файлы, и как сделать, чтобы место не забивалось снова."},{"id":"laptop-under-60k","text":"Какой ноутбук взять для работы и учёбы до 60 тысяч?","deeplinkText":"Мне нужен ноутбук для работы с документами, учёбы, видеозвонков и фильмов, бюджет до 60 тысяч рублей. Объясни, какие характеристики важны: процессор, память, экран, батарея, и на чём можно сэкономить. В конце дай короткий список, что проверить при покупке."},{"id":"nursery-humidifier","text":"Какой увлажнитель выбрать в детскую?","deeplinkText":"Зимой в детской очень сухой воздух, хотим купить увлажнитель. Объясни, чем отличаются ультразвуковые, паровые и традиционные, какой безопаснее для ребёнка, на что смотреть при выборе и как ухаживать."},{"id":"car-seat-under-15k","text":"Как выбрать автокресло до 15 тысяч для ребёнка около года","deeplinkText":"Моему ребёнку скоро год, нам нужно новое автокресло. Объясни, какие бывают группы кресел, на что смотреть при выборе в первую очередь и почему малышей советуют возить против хода движения. Бюджет до 15 тысяч рублей."},{"id":"steamer-vs-multicooker","text":"Сравни пароварку и мультиварку для здоровой готовки","deeplinkText":"Хочу готовить полезнее и выбираю между пароваркой и мультиваркой. Сравни их: что готовят лучше, сколько места занимают, как за ними ухаживать и кому что подойдёт."},{"id":"cancel-subscriptions","text":"Как найти и отключить ненужные платные подписки?","deeplinkText":"С моей карты каждый месяц списываются небольшие суммы по 199–599 рублей, и непонятно, за какие подписки. Распиши по шагам, где искать все платные подписки, как отключить ненужные и как не попадать на автопродление после пробного периода."},{"id":"vacation-savings","text":"Как накопить 150 тысяч на отпуск за 10 месяцев?","deeplinkText":"Хочу через 10 месяцев поехать в отпуск, нужно примерно 150 тысяч рублей. Посчитай, сколько откладывать в месяц, предложи простую схему, как не потратить эти деньги, и что делать, если в какой-то месяц отложить не получилось. Откладывать буду просто на отдельную карту."},{"id":"budget-example-80k","text":"Покажи схему бюджета на примере зарплаты 80 тысяч","deeplinkText":"Хочу понять, куда уходят деньги, и начать откладывать. Предложи простую схему бюджета на месяц: на какие категории делить траты, какую долю обычно откладывают и как вести учёт за пять минут в неделю. Покажи на примере зарплаты 80 тысяч рублей и оформи таблицей."},{"id":"work-burnout-recovery","text":"Как вернуть силы, если работа выматывает?","deeplinkText":"Последние месяцы моя работа совсем не радует, к вечеру нет сил ни на что. Составь мягкий план на две недели: небольшие изменения в режиме, отдыхе и работе, которые помогают восстановить силы, и признаки, когда стоит обратиться к специалисту."},{"id":"phone-rules-son","text":"Как договориться с сыном 10 лет о телефоне без ссор?","deeplinkText":"Моему сыну десять лет, он сидит в телефоне по пять часов в день, а запреты заканчиваются скандалом. Подскажи, как договориться о правилах без ссор: что сказать в первом разговоре, какие правила предложить и как их соблюдать всей семьёй."}],"widgets":{"touch":[{"id":"expert","type":"typed","title":"Интеллект","subtitle":"Режим «Эксперт»","isNew":true,"media":{"image":{"light":"https://yastatic.net/s3/web-alice-images/main-page-widgets/expert-widget-light3.webp","dark":"https://yastatic.net/s3/web-alice-images/main-page-widgets/expert-widget-dark3.webp"}},"action":{"type":"deeplink","url":"/?model=alice-agents-expert","focusInput":true},"styles":{"image":{"light":{"position":"static","width":"90%","height":"auto","marginTop":"auto"},"dark":{"position":"static","width":"80%","height":"auto","marginTop":"auto"}},"subtitle":{"light":{"color":"var(--depot-color-text-quaternary)"},"dark":{"color":"var(--depot-color-text-quaternary)"}}},"wide":false,"personalization":false,"authRequired":true},{"id":"studio","type":"custom","component":"studio","personalization":true,"wide":true,"authRequired":false}],"desktop":[{"id":"expert","type":"typed","title":"Интеллект","subtitle":"Режим «Эксперт»","isNew":true,"media":{"image":{"light":"https://web-alice-images.s3.yandex.net/main-page-widgets/expert-widget-light3-desktop.webp","dark":"https://web-alice-images.s3.yandex.net/main-page-widgets/expert-widget-dark3-desktop.webp"}},"action":{"type":"deeplink","url":"/?model=alice-agents-expert","focusInput":true},"styles":{"image":{"light":{"position":"static","width":"100%","height":"auto","marginTop":"auto"},"dark":{"position":"static","width":"100%","height":"auto","ma