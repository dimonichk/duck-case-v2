=>[{id:"grow-on-windowsill",text:o("Что вырастить на окне?",{context:"Саджест на стартовом экране"}),deeplinkText:o("Составь список из 3 видов зелени, подходящей для домашнего выращивания на подоконнике.",{context:"Текст запроса саджеста на стартовом экране"})},{id:"check-document",text:o("Проверь документ на ошибки",{context:"Саджест на стартовом экране"}),deeplinkText:o("Спроси у меня цель, с которой составлен документ, и проверь текст на ошибки, логичность и оформление, выдай исправленную версию с комментариями к правкам",{context:"Текст запроса саджеста на стартовом экране"})},{id:"choose-sneakers",text:o("Помоги выбрать кроссовки",{context:"Саджест на стартовом экране"}),deeplinkText:o("Попроси меня указать цель покупки кроссовок и бюджет. Предложи 3 модели с кратким описанием плюсов и минусов, ссылками на магазины и указанием цены.",{context:"Текст запроса саджеста на стартовом экране"})},{id:"easy-skill",text:o("Какой навык легко освоить?",{context:"Саджест на стартовом экране"}),deeplinkText:o("Назови 3 навыка, которые можно освоить за 1–2 недели.",{context:"Текст запроса саджеста на стартовом экране"})},{id:"posture-exercises",text:o("Упражнения для осанки",{context:"Саджест на стартовом экране"}),deeplinkText:o("Предложи 2-3 упражнения для улучшения осанки (можно с лёгким инвентарём — эспандер, мяч).",{context:"Текст запроса саджеста на стартовом экране"})},{id:"family-dinner-recipes",text:o("Рецепты ужина для семьи",{context:"Саджест на стартовом экране"}),deeplinkText:o("Предложи 3 рецепта простых ужинов (до 30 минут на приготовление).",{context:"Текст запроса саджеста на стартовом экране"})},{id:"compliment",text:o("Сделай мне комплимент",{context:"Саджест на стартовом экране"})},{id:"daily-inspiration",text:o("Вдохновляющая фраза дня",{context:"Саджест на стартовом экране"}),deeplinkText:o("Сгенерируй 3 короткие мотивационные фразы (до 20 слов каждая) в разных стилях: афоризм, призыв к действию, философская мысль.",{context:"Текст запроса саджеста на стартовом экране"})},{id:"word-of-the-day",text:o("Назови слово дня",{context:"Саджест на стартовом экране"}),deeplinkText:o("Назови слово дня и расскажи его значение (100-150 символов)",{context:"Текст запроса саджеста на стартовом экране"})},{id:"evening-movie",text:o("Фильм или сериал на вечер",{context:"Саджест на стартовом экране"}),deeplinkText:o("Предложи 3 варианта легкого и интересного фильма или сериала с наградами на вечер с коротким описанием (2–3 предложения).",{context:"Текст запроса саджеста на стартовом экране"})},{id:"new-hobby",text:o("Придумай мне новое хобби",{context:"Саджест на стартовом экране"}),deeplinkText:o("Предложи 3 необычных вариантов хобби с коротким пояснением. После чего попроси кратко описать свои интересы и сколько времени я могу уделять хобби.",{context:"Текст запроса саджеста на стартовом экране"})},{id:"book-with-plot",text:o("Книгу с интересным сюжетом",{context:"Саджест на стартовом экране"}),deeplinkText:o("Предложи 3 книги современные с премиями с кратким описанием сюжета (2–3 предложения)",{context:"Текст запроса саджеста на стартовом экране"})},{id:"relaxation-practice",text:o("Практика для расслабления",{context:"Саджест на стартовом экране"}),deeplinkText:o("Предложи практику для расслабления после тяжелого рабочего дня",{context:"Текст запроса саджеста на стартовом экране"})},{id:"avoid-arguments",text:o("Почему люди избегают споров?",{context:"Саджест на стартовом экране"}),deeplinkText:o("Почему люди избегают конфликтов, даже если правы? Кратко объясни 3–4 основные причины такого поведения.",{context:"Текст запроса саджеста на стартовом экране"})},{id:"procrastination",text:o("Почему мы откладываем дела?",{context:"Саджест на стартовом экране"}),deeplinkText:o("Почему люди откладывают дела, хотя знают сроки? Назови 3–4 ключевые причины с кратким научным обоснованием.",{context:"Текст запроса саджеста на стартовом экране"})},{id:"saying-no",text:o("Почему сложно сказать «нет»?",{context:"Саджест на стартовом экране"}),