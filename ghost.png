mages/main-page-widgets/doodles/tolstoy-doodle-pill-light-4x.webp","dark":"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/tolstoy-doodle-pill-dark-4x.webp"},"styles":{"width":40,"height":26,"bottom":"2px"}}],"action":{"type":"deeplink","url":"/?model=alice-agents-expert","focusInput":true},"i18n":{"accessibilityText":"supernova.1b0c4aca-8c4d-4249-b68e-5a8d4ecefc00.1bf8784979d32570"}},{"id":"alice_doodle_bts_2026","theme":"default","accessibilityText":"В учёбе я стала сильнее. Проверим?","content":[{"type":"text","value":"В учёбе","i18n":{"value":"supernova.1b0c4aca-8c4d-4249-b68e-5a8d4ecefc00.d9e402f62eec2630"}},{"type":"image","source":{"light":"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/EducationBts2026Doodle_60_x4.webp","dark":"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/EducationBts2026Doodle_60_x4.webp"},"styles":{"width":60,"height":48,"left":"3px","bottom":"-1px"}},{"type":"text","value":"я стала","i18n":{"value":"supernova.1b0c4aca-8c4d-4249-b68e-5a8d4ecefc00.379370fa93d70b6a"}},{"type":"specialCharacter","value":"lineBreak"},{"type":"text","value":"сильнее. Проверим?","i18n":{"value":"supernova.1b0c4aca-8c4d-4249-b68e-5a8d4ecefc00.13a7781c4078ef24"}}],"i18n":{"accessibilityText":"supernova.1b0c4aca-8c4d-4249-b68e-5a8d4ecefc00.dc3a48f6f659f4f3"}},{"id":"alice_cherry_settings_doodle","theme":"default","accessibilityText":"Настройте Дропс. Откройте все возможности наушников","content":[{"type":"text","value":"Настройте Дропс","i18n":{"value":"supernova.1b0c4aca-8c4d-4249-b68e-5a8d4ecefc00.0073e1d99a946365"}},{"type":"image","source":{"light":"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/CherrySettingsDoodle.webp","dark":"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/CherrySettingsDoodle.webp"},"styles":{"width":60,"height":48}},{"type":"specialCharacter","value":"lineBreak"},{"type":"text","value":"Откройте все возможности наушников","i18n":{"value":"supernova.1b0c4aca-8c4d-4249-b68e-5a8d4ecefc00.d22d75006de8c6e0"}}],"i18n":{"accessibilityText":"supernova.1b0c4aca-8c4d-4249-b68e-5a8d4ecefc00.94ece6a6bae6b946"}}]}}},"main-doodles-b2b":{"variants":{"default":{"doodles":[{"id":"b2b-test-doodle","accessibilityText":"Тестовый дудл","theme":"default","content":[{"type":"text","value":"Тестовый дудл","i18n":{"value":"supernova.c7041a9f-87a0-4009-9459-6117469fbe28.b9a32d1fd50c1491"}}],"action":{"type":"deeplink","screen":"#tasks","url":"/#tasks"},"i18n":{"accessibilityText":"supernova.c7041a9f-87a0-4009-9459-6117469fbe28.29fc74c34a83f902"}}]}}},"main-greetings-b2b":{"variants":{"default":{"phrases":[{"key":"b2b-technical-phrase","title":"Привет!","description":"Чем помочь сегодня?","i18n":{"title":"supernova.cc28f5a6-8980-46f4-91a4-5eaf2db68713.e3139f077e85a49d","description":"supernova.cc28f5a6-8980-46f4-91a4-5eaf2db68713.8e00fdaad5515455"}}]}}}},"jeevesMainPageConfig":{"b2c":{"suggests":[{"id":"b2c-what-can-you-do-micro","canEdit":false,"pinned":true,"accessibilityText":"Что ты умеешь?","deeplinkText":"Что ты умеешь?","content":[{"type":"text","text":"Что ты умеешь?"}]},{"id":"b2c-mail-triage-std","canEdit":true,"pinned":false,"accessibilityText":"Разбирать почту","deeplinkText":"Разбери мою почту за последние три дня. Найди письма, которые ждут моего ответа или действия, и коротко перескажи важное, сгруппировав по срочности. Для главных писем подготовь черновики ответов и отметь рассылки, от которых можно отписаться. Ничего не отправляй, не удаляй и не отписывай без моего подтверждения.","content":[{"type":"text","text":"Разбирать "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1017510/be613ec4-7b60-4cdf-b060-e3f811c18450/orig","size":16},{"type":"text","text":" почту"}]},{"id":"b2c-save-money-std","canEdit":true,"pinned":false,"accessibilityText":"Найти на чём сэкономить","deeplinkText":"Проверь письма с чеками, оплатами и продлениями, а также предложениями о скидках и распродажах. Найди конкретные возможности сэкономить и, где возможно, посчитай сумму экономии.","content":[{"type":"text","text":"Найти на чём "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/9833949/db34deb2-fb9d-47b6-97ed-d6c07c9196a5/orig","size":16},{"type":"text","text":" сэкономить"}]},{"id":"b2c-jobs-std","canEdit":true,"pinned":false,"accessibilityText":"Отслеживать вакансии","deeplinkText":"Помоги найти подходящие вакансии. Сначала уточни должность, город или удалёнку, желаемую зарплату и важные для меня условия. Найди вакансии, опубликованные за последнюю неделю на hh.ru и других сайтах, и покажи до пяти лучших со ссылками: компания, зарплата, требования и почему вакансия мне подходит.","content":[{"type":"text","text":"Отслеживать "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/998463/4cdeb848-ad0c-417c-bfcc-1fbd256c1c5c/orig","size":16},{"type":"text","text":" вакансии"}]},{"id":"b2c-repair-std","canEdit":true,"pinned":false,"accessibilityText":"Сравнить сметы на ремонт","deeplinkText":"Найди пять компаний для косметического ремонта комнаты 18 м² в моем городе. Передай всем одинаковое описание, уточни сроки, полную смету, доплаты и гарантию. Сведи реальные ответы в таблицу и выдели два лучших варианта.","content":[{"type":"text","text":"Сравнить сметы "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/13820439/35f2badc-fe47-4871-826f-1a84c82e7c2c/orig","size":16},{"type":"text","text":" на ремонт"}]},{"id":"b2c-grooming-std","canEdit":true,"pinned":false,"accessibilityText":"Записаться на груминг","deeplinkText":"Найди груминг для собаки рядом с домом с рейтингом от 4,7 и свободным временем утром в пятницу или субботу. Уточни по телефону цену, длительность и что входит в услугу. Покажи варианты, запиши выбранный после подтверждения и добавь запись в календарь.","content":[{"type":"text","text":"Записаться "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/758954/f89cccd4-f492-4e2c-8bf6-6445f8de0a4a/orig","size":16},{"type":"text","text":" на груминг"}]},{"id":"b2c-charges-std","canEdit":true,"pinned":false,"accessibilityText":"Проверить списания","deeplinkText":"Проверь мою банковскую выписку — приложу к запросу, если захочу — и чеки за последние три месяца. Найди возможные двойные или ошибочные списания, объясни, что вызывает подозрение, и подготовь обращения на возврат. Перед отправкой согласуй их со мной.","content":[{"type":"text","text":"Проверить "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/13820439/86e56c6e-39b1-437e-a0dc-ffb5fa2958a1/orig","size":16},{"type":"text","text":" списания"}]},{"id":"b2c-master-std","canEdit":true,"pinned":false,"accessibilityText":"Вызвать мастера","deeplinkText":"Помоги найти подходящего мастера. Сначала уточни, какой специалист мне нужен, что нужно сделать, где и когда, мой бюджет и важные требования. Затем найди и сравни несколько вариантов по рейтингу, отзывам, стоимости и доступному времени. После моего выбора свяжись с мастером и договорись о визите.","content":[{"type":"text","text":"Вызвать "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/758954/d9967cce-dbdf-4627-901e-d2e3cfa3b2d3/orig","size":16},{"type":"text","text":" мастера"}]},{"id":"b2c-groceries-basket-std","canEdit":true,"pinned":false,"accessibilityText":"Собрать корзину продуктов","deeplinkText":"Составь меню на неделю для двух человек по правилу гарвардской тарелки. Проверь продукты в ближайших сервисах доставки, учти то, что уже есть дома, собери корзину в бюджете и оформи заказ после моего подтверждения.","content":[{"type":"text","text":"Собрать корзину "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/5233933/e463ebb4-50b5-4fb0-a82b-facc67792a61/orig","size":16},{"type":"text","text":" продуктов"}]},{"id":"b2c-doctor-std","canEdit":true,"pinned":false,"accessibilityText":"Записать к врачу","deeplinkText":"Найди врача, к которому мне нужно, по моему ДМС рядом с домом на следующей неделе после 18:00. Сравни рейтинг, отзывы, стоимость и доступные окна и покажи три варианта со ссылками на источники. Не звони и не записывай без моего подтверждения; после выбора запиши и добавь визит в календарь.","content":[{"type":"text","text":"Записать "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/758954/6a2e910e-ddbd-4ebe-ac16-d6d5e0a86f05/orig","size":16},{"type":"text","text":" к врачу"}]},{"id":"b2c-salon-std","canEdit":true,"pinned":false,"accessibilityText":"Записаться в салон","deeplinkText":"Помоги записаться в салон. Сначала уточни, какая услуга мне нужна, район, бюджет, подходящие даты и время, а также важные пожелания. Если я не укажу конкретный салон, найди подходящие варианты по рейтингу, отзывам и стоимости. Позвони в лучший подходящий салон и запиши меня на первый доступный из указанных мной слотов. Если записи нет, обратись в следующий подходящий салон. После записи сообщи название и адрес салона, услугу, стоимость, дату и время.","content":[{"type":"text","text":"Записаться "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1027858/a9a4dcac-2fd9-4674-8d95-8e92a7261e6e/orig","size":16},{"type":"text","text":" в салон"}]},{"id":"b2c-birthdays-std","canEdit":true,"pinned":false,"accessibilityText":"Следить за днями рождения","deeplinkText":"Помоги не пропускать дни рождения близких. Спроси, чьи дни рождения для меня важны и когда они, если этих дат нет в моём календаре. Составь список ближайших дат, для трёх ближайших предложи идеи подарков в моём бюджете и черновик поздравления. Ничего не покупай и не отправляй без моего подтверждения.","content":[{"type":"text","text":"Следить за днями "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1525540/44be501d-b7f6-4949-9e39-7da73a07b620/orig","size":16},{"type":"text","text":" рождения"}]},{"id":"b2c-compensation-std","canEdit":true,"pinned":false,"accessibilityText":"Оформить компенсацию за билеты","deeplinkText":"Найди в почте билеты, уведомления об отмене, новые брони и чеки на гостиницу, питание и такси. Восстанови хронологию, рассчитай подтверждённые расходы и подготовь заявление авиакомпании со всеми приложениями.","content":[{"type":"text","text":"Оформить компенсацию "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/998463/cb754975-7ca8-45de-9b48-1e4371172079/orig","size":16},{"type":"text","text":" за билеты"}]},{"id":"b2c-cinema-std","canEdit":true,"pinned":false,"accessibilityText":"Купи билеты в кино","deeplinkText":"Проверь, что идёт в пятницу после 19:00 в кинотеатрах не дальше 30 минут от дома. Учти, что нас двое, исключи ужасы, выбери фильмы со зрительским рейтингом от 7 и свободными местами в середине зала. Покажи три варианта, после подтверждения купи билеты и добавь сеанс в календарь.","content":[{"type":"text","text":"Купи билеты "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/998463/1688e97a-d660-400b-a7d5-0800a99182df/orig","size":16},{"type":"text","text":" в кино"}]},{"id":"b2c-groceries-std","canEdit":true,"pinned":false,"accessibilityText":"Заказать продукты","deeplinkText":"Составь меню на неделю для двух человек по правилу гарвардской тарелки. Проверь продукты в ближайших сервисах доставки, учти то, что уже есть дома, собери корзину в бюджете и оформи заказ после моего подтверждения.","content":[{"type":"text","text":"Заказать "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/5233933/e463ebb4-50b5-4fb0-a82b-facc67792a61/orig","size":16},{"type":"text","text":" продукты"}],"surfaces":[]},{"id":"b2c-trip-std","canEdit":true,"pinned":false,"accessibilityText":"Забронировать билет","deeplinkText":"Подбери билеты по моему маршруту на желаемые даты и удобный отель в центре. Учти время выезда, багаж, расположение и бюджет. Найди варианты с доступным местом у окна и укажи стоимость выбора места. Сравни итоговые цены и возврат, а выбранные варианты забронируй после моего подтверждения.","content":[{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/13447032/a34177c4-737c-4eb6-98d2-737303ffa105/orig","size":16},{"type":"text","text":" Забронировать билет"}],"surfaces":[]},{"id":"b2c-table-std","canEdit":true,"pinned":false,"accessibilityText":"Забронируй столик","deeplinkText":"Помоги забронировать столик в ресторане. Сначала уточни название ресторана, количество гостей и подходящие мне даты и время. Позвони в ресторан и забронируй на первый доступный из указанных мной слотов. Если ни один из них не подходит ресторану, сообщи мне.","content":[{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1535439/644775b2-f020-4178-829c-45bd5aec0ef9/orig","size":16},{"type":"text","text":" Забронируй столик"}],"surfaces":[]},{"id":"b2c-table-move-std","canEdit":true,"pinned":false,"accessibilityText":"Перенести бронь столика","deeplinkText":"Помоги перенести бронирование столика. Сначала уточни название ресторана, данные текущей брони, количество гостей и подходящие мне новые даты и время. Позвони в ресторан и перенеси бронь на первый доступный из указанных мной слотов. Если ни один из них не подходит ресторану, ничего не меняй и сообщи мне. После переноса подтверди новую дату и время бронирования.","content":[{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1535439/644775b2-f020-4178-829c-45bd5aec0ef9/orig","size":16},{"type":"text","text":" Перенести бронь столика"}],"surfaces":[]},{"id":"b2c-what-can-you-do-set-delegate","canEdit":false,"pinned":true,"accessibilityText":"Что ты умеешь?","deeplinkText":"Что ты умеешь?","content":[{"type":"text","text":"Что ты умеешь?"}],"suggestSetId":"delegate"},{"id":"b2c-save-money-set-delegate","canEdit":true,"pinned":false,"suggestSetId":"delegate","accessibilityText":"Найти на чём сэкономить","deeplinkText":"Проверь письма с чеками, оплатами и продлениями, а также предложениями о скидках и распродажах. Найди конкретные возможности сэкономить и, где возможно, посчитай сумму экономии.","content":[{"type":"text","text":"Найти на чём "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/9833949/db34deb2-fb9d-47b6-97ed-d6c07c9196a5/orig","size":16},{"type":"text","text":" сэкономить"}]},{"id":"b2c-groceries-set-delegate","canEdit":true,"pinned":false,"suggestSetId":"delegate","accessibilityText":"Заказать продукты","deeplinkText":"Составь меню на неделю для двух человек по правилу гарвардской тарелки. Проверь продукты в ближайших сервисах доставки, учти то, что уже есть дома, собери корзину в бюджете и оформи заказ после моего подтверждения.","content":[{"type":"text","text":"Заказать "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/5233933/e463ebb4-50b5-4fb0-a82b-facc67792a61/orig","size":16},{"type":"text","text":" продукты"}]},{"id":"b2c-jobs-set-delegate","canEdit":true,"pinned":false,"suggestSetId":"delegate","accessibilityText":"Отслеживать вакансии","deeplinkText":"Помоги найти подходящие вакансии. Сначала уточни должность, город или удалёнку, желаемую зарплату и важные для меня условия. Найди вакансии, опубликованные за последнюю неделю на hh.ru и других сайтах, и покажи до пяти лучших со ссылками: компания, зарплата, требования и почему вакансия мне подходит.","content":[{"type":"text","text":"Отслеживать вакансии"}]},{"id":"b2c-doctor-set-delegate","canEdit":true,"pinned":false,"suggestSetId":"delegate","accessibilityText":"Записать к врачу","deeplinkText":"Найди врача, к которому мне нужно, по моему ДМС рядом с домом на следующей неделе после 18:00. Сравни рейтинг, отзывы, стоимость и доступные окна и покажи три варианта со ссылками на источники. Не звони и не записывай без моего подтверждения; после выбора запиши и добавь визит в календарь.","content":[{"type":"text","text":"Записать к врачу"}]},{"id":"b2c-what-can-you-do-set-take-over","canEdit":false,"pinned":true,"accessibilityText":"Что ты умеешь?","deeplinkText":"Что ты умеешь?","content":[{"type":"text","text":"Что ты умеешь?"}],"suggestSetId":"take-over"},{"id":"b2c-repair-set-take-over","canEdit":true,"pinned":false,"suggestSetId":"take-over","accessibilityText":"Сравнить сметы на ремонт","deeplinkText":"Найди пять компаний для косметического ремонта комнаты 18 м² в моем городе. Передай всем одинаковое описание, уточни сроки, полную смету, доплаты и гарантию. Сведи реальные ответы в таблицу и выдели два лучших варианта.","content":[{"type":"text","text":"Сравнить сметы на ремонт"}]},{"id":"b2c-grooming-set-take-over","canEdit":true,"pinned":false,"suggestSetId":"take-over","accessibilityText":"Записаться на груминг","deeplinkText":"Найди груминг для собаки рядом с домом с рейтингом от 4,7 и свободным временем утром в пятницу или субботу. Уточни по телефону цену, длительность и что входит в услугу. Покажи варианты, запиши выбранный после подтверждения и добавь запись в календарь.","content":[{"type":"text","text":"Записаться "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/758954/f89cccd4-f492-4e2c-8bf6-6445f8de0a4a/orig","size":16},{"type":"text","text":" на груминг"}]},{"id":"b2c-charges-set-take-over","canEdit":true,"pinned":false,"suggestSetId":"take-over","accessibilityText":"Проверить списания","deeplinkText":"Проверь мою банковскую выписку — приложу к запросу, если захочу — и чеки за последние три месяца. Найди возможные двойные или ошибочные списания, объясни, что вызывает подозрение, и подготовь обращения на возврат. Перед отправкой согласуй их со мной.","content":[{"type":"text","text":"Проверить "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/13820439/86e56c6e-39b1-437e-a0dc-ffb5fa2958a1/orig","size":16},{"type":"text","text":" списания"}]},{"id":"b2c-trip-set-take-over","canEdit":true,"pinned":false,"suggestSetId":"take-over","accessibilityText":"Забронировать билет","deeplinkText":"Подбери билеты по моему маршруту на желаемые даты и удобный отель в центре. Учти время выезда, багаж, расположение и бюджет. Найди варианты с доступным местом у окна и укажи стоимость выбора места. Сравни итоговые цены и возврат, а выбранные варианты забронируй после моего подтверждения.","content":[{"type":"text","text":"Забронировать билет"}]},{"id":"b2c-what-can-you-do-set-save-money","canEdit":false,"pinned":true,"accessibilityText":"Что ты умеешь?","deeplinkText":"Что ты умеешь?","content":[{"type":"text","text":"Что ты умеешь?"}],"suggestSetId":"save-money"},{"id":"b2c-compensation-set-save-money","canEdit":true,"pinned":false,"suggestSetId":"save-money","accessibilityText":"Оформить компенсацию за билеты","deeplinkText":"Найди в почте билеты, уведомления об отмене, новые брони и чеки на гостиницу, питание и такси. Восстанови хронологию, рассчитай подтверждённые расходы и подготовь заявление авиакомпании со всеми приложениями.","content":[{"type":"text","text":"Оформить компенсацию за билеты"}]},{"id":"b2c-pay-offers-set-save-money","canEdit":true,"pinned":false,"suggestSetId":"save-money","accessibilityText":"Проверить оплаты и предложения","deeplinkText":"Проверь письма с оплатами, подписками и продлениями за последний месяц, а также предложения о скидках и акциях. Найди, от чего можно отказаться или где заплатить меньше, и посчитай возможную экономию.","content":[{"type":"text","text":"Проверить оплаты и предложения"}]},{"id":"b2c-repair-set-save-money","canEdit":true,"pinned":false,"suggestSetId":"save-money","accessibilityText":"Сравнить сметы на ремонт","deeplinkText":"Найди пять компаний для косметического ремонта комнаты 18 м² в моем городе. Передай всем одинаковое описание, уточни сроки, полную смету, доплаты и гарантию. Сведи реальные ответы в таблицу и выдели два лучших варианта.","content":[{"type":"text","text":"Сравнить сметы "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/13820439/35f2badc-fe47-4871-826f-1a84c82e7c2c/orig","size":16},{"type":"text","text":" на ремонт"}]},{"id":"b2c-charges-set-save-money","canEdit":true,"pinned":false,"suggestSetId":"save-money","accessibilityText":"Проверить списания","deeplinkText":"Проверь мою банковскую выписку — приложу к запросу, если захочу — и чеки за последние три месяца. Найди возможные двойные или ошибочные списания, объясни, что вызывает подозрение, и подготовь обращения на возврат. Перед отправкой согласуй их со мной.","content":[{"type":"text","text":"Проверить списания"}]},{"id":"b2c-what-can-you-do-set-call","canEdit":false,"pinned":true,"accessibilityText":"Что ты умеешь?","deeplinkText":"Что ты умеешь?","content":[{"type":"text","text":"Что ты умеешь?"}],"suggestSetId":"call"},{"id":"b2c-table-move-set-call","canEdit":true,"pinned":false,"suggestSetId":"call","accessibilityText":"Перенести бронь столика","deeplinkText":"Помоги перенести бронирование столика. Сначала уточни название ресторана, данные текущей брони, количество гостей и подходящие мне новые даты и время. Позвони в ресторан и перенеси бронь на первый доступный из указанных мной слотов. Если ни один из них не подходит ресторану, ничего не меняй и сообщи мне. После переноса подтверди новую дату и время бронирования.","content":[{"type":"text","text":"Перенести бронь столика"}]},{"id":"b2c-doctor-set-call","canEdit":true,"pinned":false,"suggestSetId":"call","accessibilityText":"Записать к врачу","deeplinkText":"Найди врача, к которому мне нужно, по моему ДМС рядом с домом на следующей неделе после 18:00. Сравни рейтинг, отзывы, стоимость и доступные окна и покажи три варианта со ссылками на источники. Не звони и не записывай без моего подтверждения; после выбора запиши и добавь визит в календарь.","content":[{"type":"text","text":"Записать "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/758954/6a2e910e-ddbd-4ebe-ac16-d6d5e0a86f05/orig","size":16},{"type":"text","text":" к врачу"}]},{"id":"b2c-master-set-call","canEdit":true,"pinned":false,"suggestSetId":"call","accessibilityText":"Вызвать мастера","deeplinkText":"Помоги найти подходящего мастера. Сначала уточни, какой специалист мне нужен, что нужно сделать, где и когда, мой бюджет и важные требования. Затем найди и сравни несколько вариантов по рейтингу, отзывам, стоимости и доступному времени. После моего выбора свяжись с мастером и договорись о визите.","content":[{"type":"text","text":"Вызвать "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/758954/d9967cce-dbdf-4627-901e-d2e3cfa3b2d3/orig","size":16},{"type":"text","text":" мастера"}]},{"id":"b2c-salon-set-call","canEdit":true,"pinned":false,"suggestSetId":"call","accessibilityText":"Записаться в салон","deeplinkText":"Помоги записаться в салон. Сначала уточни, какая услуга мне нужна, район, бюджет, подходящие даты и время, а также важные пожелания. Если я не укажу конкретный салон, найди подходящие варианты по рейтингу, отзывам и стоимости. Позвони в лучший подходящий салон и запиши меня на первый доступный из указанных мной слотов. Если записи нет, обратись в следующий подходящий салон. После записи сообщи название и адрес салона, услугу, стоимость, дату и время.","content":[{"type":"text","text":"Записаться в салон"}]},{"id":"b2c-what-can-you-do-set-monitor","canEdit":false,"pinned":true,"accessibilityText":"Что ты умеешь?","deeplinkText":"Что ты умеешь?","content":[{"type":"text","text":"Что ты умеешь?"}],"suggestSetId":"monitor"},{"id":"b2c-birthdays-set-monitor","canEdit":true,"pinned":false,"suggestSetId":"monitor","accessibilityText":"Следить за днями рождения","deeplinkText":"Помоги не пропускать дни рождения близких. Спроси, чьи дни рождения для меня важны и когда они, если этих дат нет в моём календаре. Составь список ближайших дат, для трёх ближайших предложи идеи подарков в моём бюджете и черновик поздравления. Ничего не покупай и не отправляй без моего подтверждения.","content":[{"type":"text","text":"Следить за днями "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1525540/44be501d-b7f6-4949-9e39-7da73a07b620/orig","size":16},{"type":"text","text":" рождения"}]},{"id":"b2c-jobs-set-monitor","canEdit":true,"pinned":false,"suggestSetId":"monitor","accessibilityText":"Отслеживать вакансии","deeplinkText":"Помоги найти подходящие вакансии. Сначала уточни должность, город или удалёнку, желаемую зарплату и важные для меня условия. Найди вакансии, опубликованные за последнюю неделю на hh.ru и других сайтах, и покажи до пяти лучших со ссылками: компания, зарплата, требования и почему вакансия мне подходит.","content":[{"type":"text","text":"Отслеживать "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/998463/4cdeb848-ad0c-417c-bfcc-1fbd256c1c5c/orig","size":16},{"type":"text","text":" вакансии"}]},{"id":"b2c-mail-triage-set-monitor","canEdit":true,"pinned":false,"suggestSetId":"monitor","accessibilityText":"Разбирать почту","deeplinkText":"Разбери мою почту за последние три дня. Найди письма, которые ждут моего ответа или действия, и коротко перескажи важное, сгруппировав по срочности. Для главных писем подготовь черновики ответов и отметь рассылки, от которых можно отписаться. Ничего не отправляй, не удаляй и не отписывай без моего подтверждения.","content":[{"type":"text","text":"Разбирать почту"}]},{"id":"b2c-what-can-you-do-set-household","canEdit":false,"pinned":true,"accessibilityText":"Что ты умеешь?","deeplinkText":"Что ты умеешь?","content":[{"type":"text","text":"Что ты умеешь?"}],"suggestSetId":"household"},{"id":"b2c-doctor-move-set-household","canEdit":true,"pinned":false,"suggestSetId":"household","accessibilityText":"Перенести запись к врачу","deeplinkText":"Помоги перенести запись к врачу. Сначала уточни клинику, врача, текущие дату и время записи и подходящие мне новые даты и время. Позвони в клинику и перенеси запись на первый доступный из указанных мной слотов. Если ни один из них не подходит, ничего не меняй и сообщи мне. После переноса подтверди новые дату и время и обнови визит в календаре.","content":[{"type":"text","text":"Перенести запись "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/758954/6a2e910e-ddbd-4ebe-ac16-d6d5e0a86f05/orig","size":16},{"type":"text","text":" к врачу"}]},{"id":"b2c-groceries-basket-set-household","canEdit":true,"pinned":false,"suggestSetId":"household","accessibilityText":"Собрать корзину продуктов","deeplinkText":"Составь меню на неделю для двух человек по правилу гарвардской тарелки. Проверь продукты в ближайших сервисах доставки, учти то, что уже есть дома, собери корзину в бюджете и оформи заказ после моего подтверждения.","content":[{"type":"text","text":"Собрать корзину "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/5233933/e463ebb4-50b5-4fb0-a82b-facc67792a61/orig","size":16},{"type":"text","text":" продуктов"}]},{"id":"b2c-birthdays-set-household","canEdit":true,"pinned":false,"suggestSetId":"household","accessibilityText":"Следить за днями рождения","deeplinkText":"Помоги не пропускать дни рождения близких. Спроси, чьи дни рождения для меня важны и когда они, если этих дат нет в моём календаре. Составь список ближайших дат, для трёх ближайших предложи идеи подарков в моём бюджете и черновик поздравления. Ничего не покупай и не отправляй без моего подтверждения.","content":[{"type":"text","text":"Следить за днями рождения"}]},{"id":"b2c-cinema-set-household","canEdit":true,"pinned":false,"suggestSetId":"household","accessibilityText":"Купи билеты в кино","deeplinkText":"Проверь, что идёт в пятницу после 19:00 в кинотеатрах не дальше 30 минут от дома. Учти, что нас двое, исключи ужасы, выбери фильмы со зрительским рейтингом от 7 и свободными местами в середине зала. Покажи три варианта, после подтверждения купи билеты и добавь сеанс в календарь.","content":[{"type":"text","text":"Купи билеты в кино"}]}]},"b2b":{"suggests":[{"id":"b2b-what-can-you-do-micro","pinned":true,"accessibilityText":"Что ты умеешь?","deeplinkText":"Что ты умеешь?","content":[{"type":"text","text":"Что ты умеешь?"}]},{"id":"b2b-what-can-you-do-micro","pinned":true,"accessibilityText":"Что ты умеешь?","deeplinkText":"Что ты умеешь?","surfaces":["mail-context"],"content":[{"type":"text","text":"Что ты умеешь?"}]},{"id":"b2b-create-pptx-new","pinned":true,"accessibilityText":"Собери презентацию по материалам","deeplinkText":"Создай презентацию на основе моих материалов: понятная структура, заголовки и тезисы. Используй только факты из документа, недостающие данные отметь или уточни у меня. Сначала попроси меня прикрепить файл или дать ссылку и уточни аудиторию, цель и число слайдов. Приступай после моих ответов.","content":[{"type":"text","text":"Собери презентацию по материалам"}]},{"id":"b2b-mail-weekly-slide-new","pinned":false,"accessibilityText":"Обзор писем за неделю в 1 слайде","deeplinkText":"Проанализируй мою почту за неделю и составь хороший обзор писем в виде 1 емкого слайда. Слайд должен быть структурным, логичным, тезисы только на основе фактов, обязательно должны быть рекомендации к действиям.  Отдай мне в виде готового файла html файла, перед выдачей перепроверь, что все сверстано аккуратно.","content":[{"type":"text","text":"Обзор писем "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1644703/bd6e8d08-99eb-43ac-a2a9-1f67faccbd89/orig","size":16},{"type":"text","text":" за неделю в 1 слайде"}]},{"id":"b2b-mail-contacts-new","pinned":false,"accessibilityText":"Составь список контактов из моей почты","deeplinkText":"Проанализируй мою почту и составь таблицу со следующими данными из писем: ФИО контакта, почтовый адрес, номер телефона. Формат: Excel.","content":[{"type":"text","text":"Составь список контактов из моей почты "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1644703/bd6e8d08-99eb-43ac-a2a9-1f67faccbd89/orig","size":16}]},{"id":"b2b-seo-audit-new","pinned":false,"accessibilityText":"Сделай анализ поисковой/SEO выдачи сайта","deeplinkText":"Проведи SEO‑аудит нашего сайта. Сделай краткие выводы о том, на каких позициях по основным запросам в категории находится наш сайт, и дай 5 основных рекомендаций, как улучшить положение и что конкретно сделать. Перед стартом запроси ссылку на сайт. Результат предоставь в формате отчёта, легко читаемого в формате PDF.","content":[{"type":"text","text":"Сделай анализ поисковой/SEO выдачи сайта "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/13447032/ac78cd30-146e-4753-a8a0-292055f7b5b6/orig","size":16}]},{"id":"b2b-brand-mentions-new","pinned":false,"accessibilityText":"Проведи анализ упоминаний о нашем бренде в интернете","deeplinkText":"Собери все упоминания о нашей компании за последние полгода в СМИ и обсуждениях в соцсетях в формате таблицы, а также дополнительно визуализируй графиками положительные и негативные отзывы/цитирования, чтобы понять общий фон. Результат пришли в формате PPTX. Перед стартом работ запроси название бренда.","content":[{"type":"text","text":"Проведи анализ упоминаний о нашем бренде в интернете "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/13447032/ac78cd30-146e-4753-a8a0-292055f7b5b6/orig","size":16}]},{"id":"b2b-promo-mail-new","pinned":false,"accessibilityText":"Разбери рекламные рассылки","deeplinkText":"Пробегись по почте и найди все рекламные рассылки. По итогу составь два файла:\n1. Составь хороший обзор писем в виде 1 емкого слайда. Слайд должен быть структурным, логичным, тезисы только на основе фактов, обязательно должны быть рекомендации к действиям. Отдай мне в виде готового файла pptx.\n2. Полный перечень источников таких писем структурируй в виде эксель-таблицы, с понятными параметрами и колонками. Обязательно дай ссылки как отписаться\nВ конце выдай мне в чат оба файла","content":[{"type":"text","text":"Разбери рекламные рассылки "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1644703/bd6e8d08-99eb-43ac-a2a9-1f67faccbd89/orig","size":16}]},{"id":"b2b-legal-digest-new","pinned":false,"accessibilityText":"Собери сводку юридических изменений в отрасли","deeplinkText":"Дай сводку ключевых юридических изменений за последний месяц для конкретной отрасли. Не начинай пока не уточнишь отрасль или вид деятельности.\nДля каждого изменения (не больше 7 пунктов) кратко напиши:\nЧто изменилось — 1–2 простыми предложениями.\nИсточник (закон/постановление, номер и дата).\nВлияние на бизнес в этой отрасли — конкретно, без общих фраз.\nПрактический шаг на первую неделю — 1 чёткое действие.\nПриоритет по светофору: 🔴 красный (срочно), 🟡 жёлтый (важно), 🟢 зелёный (на заметку).\nВ конце — топ‑3 приоритета и список подразделений, которых это касается (бухгалтерия, юристы и т.п.). Стиль — для менеджера без юр. образования.","content":[{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1535439/f5d30e7c-e682-4820-9c39-9847b3c46093/orig","size":16},{"type":"text","text":" Собери сводку юридических изменений в отрасли"}]},{"id":"b2b-pdf-to-doc-new","pinned":false,"accessibilityText":"Сконвертируй PDF в документ","deeplinkText":"Сконвертируй PDF в документ DOC, перед началом работы запроси у меня документ.","content":[{"type":"text","text":"Сконвертируй PDF в документ"}]},{"id":"b2b-pdf-to-pptx-new","pinned":false,"accessibilityText":"Сконвертируй PDF в презентацию","deeplinkText":"Сконвертируй PDF в презентацию PPTX, перед началом работы запроси у меня документ.","content":[{"type":"text","text":"Сконвертируй PDF в презентацию"}]},{"id":"b2b-pdf-to-xls-new","pinned":false,"accessibilityText":"Сконвертируй PDF в таблицу","deeplinkText":"Сконвертируй PDF в таблицу XLS, перед началом работы запроси у меня документ.","content":[{"type":"text","text":"Сконвертируй PDF в таблицу"}]},{"id":"b2b-polite-mail-new","pinned":false,"accessibilityText":"Перепиши письмо вежливее","deeplinkText":"Перепиши текст письма в более вежливом и деликатном тоне.\n\nПравила:\nСохрани смысл и все ключевые факты, ничего не добавляй от себя.\nОбращение — на «вы».\nЗамени категоричные формулировки («срочно», «вы должны», «не выполнено») на мягкие и уважительные.\nНачни письмо с краткого приветствия, а закончи вежливой просьбой ответить и подписью.\nПиши на русском языке, объём — примерно как в исходном письме.\n\nПеред началом работы запроси у меня текст письма или как его найти в Почте.","content":[{"type":"text","text":"Перепиши письмо "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1644703/bd6e8d08-99eb-43ac-a2a9-1f67faccbd89/orig","size":16},{"type":"text","text":" вежливее"}]},{"id":"b2b-contract-clause-new","pinned":false,"accessibilityText":"Объясни пункт договора простыми словами","deeplinkText":"Прочитай приложенный документ и объясни конкретный пункт простыми и понятными словами, подсвети риски, если они есть. Перед стартом работы запроси у меня документ и уточни на какой пункт требуется обратить особое внимание.","content":[{"type":"text","text":"Объясни пункт договора простыми словами"}]},{"id":"b2b-vacation-handover-new","pinned":false,"accessibilityText":"Подготовь передачу дел на время отпуска","deeplinkText":"Собери документ передачи дел на время моего отпуска, проверь актуальные задачи в Почте, Трекере, Календаре, Вики. Также проверь план встреч, укажи списком на которых я не смогу участвовать и мне нужно их перенести или переназначить на заменяющего.","content":[{"type":"text","text":"Подготовь передачу дел на время отпуска"}]},{"id":"b2b-disk-summary-new","pinned":false,"accessibilityText":"Сделай сводку по файлам на Диске","deeplinkText":"Проанализируй файлы на нашем корпоративном Яндекс Диске. Составь отчёт:\n\nОбзор: сколько всего файлов и папок, по каким типам они распределены (документы, таблицы, презентации, картинки, архивы), в каких папках сосредоточен основной объём.\nСвежесть: для каждого файла (или сводно по папкам) — дата добавления и дата последнего изменения.\n«Спящие» файлы: перечисли файлы, которые не менялись дольше 6 месяцев и не открывались дольше 3 месяцев. Отдельно отметь крупные файлы (больше 100 МБ), которые давно не использовались.\nВыводы: какие файлы явно актуальные, какие можно перенести в архив или удалить (с указанием потенциально освобождаемого места).\nРезультат подай таблицей + коротким резюме в начале: главные цифры и 3–5 рекомендаций.","content":[{"type":"text","text":"Сделай сводку по файлам на Диске "},{"type":"image","image":"https://avatars.mds.yandex.net/get-appstore/11501616/d56a8d7d-837a-4958-807a-b3ecd22a8b2b/360x360","size":16}]},{"id":"b2b-news-digest-new","pinned":false,"accessibilityText":"Собери дайджест новостей по теме","deeplinkText":"Напиши новости из интересующей меня темы за сегодня в виде короткого дайджеста — не больше 5 пунктов, и главное — по сути. Перед стартом запроси, какая именно тема меня интересует.","content":[{"type":"text","text":"Собери дайджест новостей по теме"}]},{"id":"mail-widget-summary","text":"Сводка задач из почты","deeplinkText":"Собери краткую сводку по моей переписке в почте за последние 14 дней. Выдели основные темы, принятые решения, открытые вопросы, ответственных и сроки.","surfaces":["mail"]},{"id":"mail-widget-reminder","text":"Напомни ответить на письма","deeplinkText":"Найди важные письма, которые ждут моего ответа, и создай напоминание в Календаре на завтра. Добавь в напоминание отправителей, темы, сроки и ссылки на письма. Приоритет — письма с вопросами, просьбами, обязательствами или близкими сроками. Сначала уточни, на какое время создать напоминание и за какой период искать письма. Приступай только после моего ответа. Если писем не найдено — сообщи мне и не создавай пустое напоминание.","surfaces":["mail"]},{"id":"mail-widget-unanswered","text":"Найди письма без ответа","deeplinkText":"Найди входящие письма, в которых есть вопрос, просьба, задача или срок, но от меня ещё нет ответа. Покажи отправителя, тему, дату, краткую суть и требуемое действие, расставь приоритеты. Исключи рассылки и автоуведомления. Сначала уточни, за какой период искать. Приступай после моего ответа.","surfaces":["mail"]},{"id":"mail-widget-weekly-slide","pinned":false,"accessibilityText":"Обзор писем за неделю в 1 слайде","deeplinkText":"Проанализируй мою почту за неделю и составь хороший обзор писем в виде 1 емкого слайда. Слайд должен быть структурным, логичным, тезисы только на основе фактов, обязательно должны быть рекомендации к действиям. Отдай мне в виде готового html файла, перед выдачей перепроверь, что все сверстано аккуратно.","content":[{"type":"text","text":"Обзор писем "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1644703/bd6e8d08-99eb-43ac-a2a9-1f67faccbd89/orig","size":16},{"type":"text","text":" за неделю в 1 слайде"}],"surfaces":["mail"]},{"id":"mail-widget-new-tasks","pinned":false,"accessibilityText":"Собери задачи из новых писем","deeplinkText":"Проанализируй новые письма и составь список задач. Для каждой укажи, что нужно сделать, кто ответственный, срок и ссылку на письмо. Отдельно отметь задачи без срока или ответственного.","content":[{"type":"text","text":"Собери задачи из новых писем"}],"surfaces":["mail"]},{"id":"mail-widget-awaiting-reply","pinned":false,"accessibilityText":"Покажи письма, где ждут ответа","deeplinkText":"Найди письма за последние 14 дней, где от меня ждут ответа. Покажи отправителя, тему, дату, что нужно ответить и насколько срочно. Сначала выведи самые важные.","content":[{"type":"text","text":"Покажи письма, где ждут ответа"}],"surfaces":["mail"]},{"id":"mail-widget-morning-brief","pinned":false,"accessibilityText":"Сделай утренний бриф по почте","deeplinkText":"Подготовь утренний бриф по почте: новые и важные письма, задачи, встречи, решения и риски. Сгруппируй по срочности и добавь ссылки на письма.","content":[{"type":"text","text":"Сделай утренний бриф по почте"}],"surfaces":["mail"]},{"id":"mail-widget-what-can-you-do-mail","pinned":false,"accessibilityText":"Что ты умеешь с почтой?","deeplinkText":"Кратко расскажи, какие задачи ты умеешь решать с моей почтой. Сгруппируй возможности по поиску, сводкам, ответам и контролю задач и приведи 5 примеров запросов.","content":[{"type":"text","text":"Что ты умеешь с почтой "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1644703/bd6e8d08-99eb-43ac-a2a9-1f67faccbd89/orig","size":16},{"type":"text","text":"?"}],"surfaces":["mail"]},{"id":"mail-widget-reply-last","pinned":false,"accessibilityText":"Составь ответ на последнее письмо","deeplinkText":"Составь черновик ответа на последнее письмо в моей Почте.","content":[{"type":"text","text":"Составь ответ на последнее письмо"}],"surfaces":["mail"]},{"id":"mail-widget-deep-analysis","pinned":false,"accessibilityText":"Проведи глубокий анализ по теме","deeplinkText":"Проведи глубокий анализ темы: сопоставь актуальные данные и разные точки зрения, выдели ключевые факты, причины, риски и тенденции. Сформулируй аргументированные выводы со ссылками на источники. Сначала спроси меня, какую тему анализировать и какие аспекты важны. Приступай после моих ответов.","content":[{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/1535439/f5d30e7c-e682-4820-9c39-9847b3c46093/orig","size":16},{"type":"text","text":" Проведи глубокий анализ по теме"}],"surfaces":["mail"]},{"id":"mail-widget-internet-analysis","pinned":false,"accessibilityText":"Проведи анализ нашего бизнеса в интернете","deeplinkText":"Оцени наш сайт и отзывы клиентов о компании, дай рекомендации по улучшению и привлечению клиентов. Результат — презентация из 5–7 слайдов. Сначала попроси меня указать адрес сайта и название бренда — без них не приступай.","content":[{"type":"text","text":"Проведи анализ нашего бизнеса в интернете "},{"type":"image","image":"https://avatars.mds.yandex.net/get-dialogs/13447032/ac78cd30-146e-4753-a8a0-292055f7b5b6/orig","size":16}],"surfaces":["mail"]},{"id":"mail-widget-create-pptx","pinned":false,"accessibilityText":"Собери презентацию по материалам","deeplinkText":"Создай презентацию на основе моих материалов: понятная структура, заголовки и тезисы. Используй только факты из документа, недостающие данные отметь или уточни у меня. Сначала попроси меня прикрепить файл или дать ссылку и уточни аудиторию, цель и число слайдов. Приступай после моих ответов.","content":[{"type":"text","text":"Собери презентацию по материалам"}],"surfaces":["mail"]},{"id":"mail-widget-contacts","pinned":false,"accessibilityText":"Составь список контактов из почты","deeplinkText":"Проанализируй мою почту и составь таблицу со следующими данными из писем: ФИО контакта, почтовый адрес, номер телефона. Формат: Excel.","content":[{"type":"text","text":"Составь список контактов из почты"}],"surfaces":["mail"]},{"id":"b2b-rtl-04","pinned":false,"accessibilityText":"Собери заказ из письма в таблицу","deeplinkText":"По открытому письму и вложениям собери заказ покупателя в таблицу: товар, артикул, вариант, количество, единица, цена и валюта, если указаны. Отдельно выпиши клиента, адрес доставки, желаемую дату и способ оплаты. Не смешивай штуки и упаковки. Если письмо и вложение противоречат друг другу, покажи оба значения. Пропуски пометь «не указано». Верни XLSX и короткий ответ клиенту с подтверждением того, как ты поняла заявку, и вопросами по недостающим данным. Не подтверждай наличие и отгрузку и ничего не отправляй.","content":[{"type":"text","text":"Собери заказ из письма в таблицу"}],"surfaces":["mail"]},{"id":"b2b-rtl-05","pinned":false,"accessibilityText":"Ответь покупателю по заказу","deeplinkText":"По открытому письму покупателя подготовь короткий доброжелательный ответ на вопросы о доставке, возврате или замене. Сначала выдели все вопросы и ответь на те, для которых есть подтверждённые сведения. Если ответа нет, задай только необходимые уточнения: например, номер заказа или что именно произошло; не спрашивай уже указанные данные. Не выдумывай статус доставки, правила возврата и сроки компенсации. Верни готовый текст ответа и отдельно список фактов, которые мне нужно проверить перед отправкой. Ничего не отправляй.","content":[{"type":"text","text":"Ответь покупателю по заказу"}],"surfaces":["mail"]},{"id":"b2b-srv-02","pinned":false,"accessibilityText":"Собери обещания клиентам на неделю","deeplinkText":"Посмотри мою переписку с клиентами за последние 30 дней и собери договорённости со сроком на ближайшие семь дней, включая сегодня. Для каждой укажи клиента, обещанный результат, дату, явно названного ответственного и ссылку на письмо. Отдели подтверждённые обязательства от предложений и пожеланий. Если в переписке есть изменения объёма или срока, покажи их отдельно. Статус выполнения указывай только при наличии подтверждения. Подготовь Excel с приоритетом по близости срока и тексты уточнений для договорённостей без конкретной даты или ответственного. Сообщения не отправляй.","content":[{"type":"text","text":"Собери обещания клиентам на неделю"}],"surfaces":["mail"]},{"id":"b2b-srv-04","pinned":false,"accessibilityText":"Ответь на новый запрос клиента","deeplinkText":"По этому письму потенциального клиента подготовь первый ответ о нашей услуге. В двух предложениях покажи, что поняла задачу. Собери не больше пяти вопросов, без которых нельзя уточнить объём работ: ожидаемый результат, сроки, исходные материалы и бюджет, если он нужен для оценки. Не повторяй вопросы, на которые клиент уже ответил. Предложи следующий шаг без выдуманной даты, цены и обещаний выполнить работу. Верни готовый короткий текст письма и отдельно краткую карточку запроса. Ничего не отправляй.","content":[{"type":"text","text":"Ответь на новый запрос клиента"}],"surfaces":["mail"]},{"id":"b2b-srv-07","pinned":false,"accessibilityText":"Сделай бриф для нового клиента","deeplinkText":"Сделай многоразовый бриф для новых клиентов моей услуги. Сначала уточни услугу, тип клиента и какой результат ему нужен. Подготовь DOCX с 10–12 понятными вопросами о цели, объёме работ, исходных материалах, сроках, бюджете и критериях приёмки; отдели обязательные вопросы от дополнительных. Для сложных вопросов дай пример ответа. Добавь одностраничный шаблон итогов первого разговора: что входит в работу, что не входит, открытые вопросы и следующий шаг. Проверь, что бриф помогает оценить задачу и не запрашивает лишние персональные данные. Условия моей компании не придумывай.","content":[{"type":"text","text":"Сделай бриф для нового клиента"}],"surfaces":["mail"]},{"id":"b2b-mfg-03","pinned":false,"accessibilityText":"Собери рекламации по продукции","deeplinkText":"Найди в моей почте за последние 90 дней рекламации по нашей продукции. Объедини письма одного случая и собери Excel: изделие, партия или заказ, описанный дефект, дата, клиент, заявленное количество, текущий подтверждённый статус и ссылка на источник. Сгруппируй повторяющиеся дефекты и посчитай отдельные случаи. Не рассчитывай процент брака без объёма выпуска и не называй предположения установленной причиной. Подготовь краткую сводку для службы качества: какие случаи повторяются, какие данные нужно запросить и какие вопросы проверить в первую очередь. Если партия не указана, отметь её отсутствие.","content":[{"type":"text","text":"Собери рекламации по продукции"}],"surfaces":["mail"]},{"id":"b2b-mfg-04","pinned":false,"accessibilityText":"Собери карточку заказа из письма","deeplinkText":"По открытому письму заказчика и вложениям собери карточку заказа: изделие или артикул, материал, размеры и допуски из текста, количество, единица измерения, версия спецификации, желаемый срок и место поставки. Для разных изделий сделай отдельные строки. Не выводи размеры из масштаба чертежа и не подменяй отсутствующие параметры типовыми. Покажи противоречия между письмом и спецификацией, затем составь короткий список вопросов заказчику. Верни XLSX и текст уточнения. Не подтверждай техническую выполнимость, цену или принятие в производство.","content":[{"type":"text","text":"Собери карточку заказа из письма"}],"surfaces":["mail"]},{"id":"b2b-it-01","pinned":false,"accessibilityText":"Собери требования из переписки","deeplinkText":"Собери требования к проекту из моей почты за последние 30 дней. Сначала уточни проект или клиента, если они не указаны. Подготовь DOCX: цель, пользователи, сценарии, функциональные требования, ограничения, критерии приёмки, открытые вопросы и явно согласованные сроки. Для каждого требования укажи письмо-источник и дату. Отдели договорённости от идей, пожеланий и собственных предположений; противоречия вынеси в отдельный список. Не добавляй функции и оценки трудозатрат от себя. В конце подготовь короткий текст письма клиенту для согласования открытых вопросов без отправки.","content":[{"type":"text","text":"Собери требования из переписки"}],"surfaces":["mail"]},{"id":"b2b-it-03","pinned":false,"accessibilityText":"Найди повторяющиеся проблемы клиентов","deeplinkText":"Проанализируй обращения клиентов в моей почте за последние 30 дней и найди повторяющиеся проблемы с нашим продуктом. Сначала уточни продукт, если их несколько. Объедини письма одного обращения, сгруппируй случаи по симптомам, укажи число отдельных обращений и затронутых клиентов, если их можно надёжно различить. Отдели ошибки от пожеланий и вопросов об использовании. Подготовь Excel с группами, примерами и ссылками, а также черновики описаний пяти задач: проблема, влияние со слов клиентов, шаги воспроизведения, если они есть, и недостающие данные. Не придумывай техническую причину или приоритет и не создавай задачи во внешней системе.","content":[{"type":"text","text":"Найди повторяющиеся проблемы клиентов"}],"surfaces":["mail"]},{"id":"b2b-it-05","pinned":false,"accessibilityText":"Ответь на обращение в поддержку","deeplinkText":"Подготовь первый ответ на обращение в поддержку из открытого письма. Кратко покажи, как поняла проблему, и уточни не более трёх недостающих фактов, необходимых для следующего шага: действие пользователя, точный текст ошибки, окружение или время возникновения. Не проси повторять уже описанные действия и не запрашивай пароли, токены или лишние персональные данные. Не выдумывай инструкции по продукту, срок исправления и факт регистрации обращения. Верни доброжелательный ответ до 120 слов и отдельное резюме для специалиста. Ничего не отправляй.","content":[{"type":"text","text":"Ответь на обращение в поддержку"}],"surfaces":["mail"]},{"id":"b2b-it-06","pinned":false,"accessibilityText":"Разбей запрос клиента на задачи","deeplinkText":"Разбери запрос на изменения из открытого письма клиента и вложений. Сделай список небольших задач: название, требуемое изменение, пользовательский результат и явно указанный критерий приёмки. Отдели обязательные требования от примеров и пожеланий. Если критерий не сформулирован, отметь это и предложи вопрос клиенту вместо выдуманного условия. Выпиши противоречия и зависимости, которые прямо следуют из доступных материалов. Не придумывай архитектуру, сроки, оценки трудозатрат и исполнителей. Верни список для копирования в трекер и короткий текст уточнения; задачи не создавай и ничего не отправляй.","content":[{"type":"text","text":"Разбей запрос клиента на задачи"}],"surfaces":["mail"]},{"id":"mail-widget-context-tasks","text":"Выпиши задачи из письма","deeplinkText":"Выпиши задачи из письма","surfaces":["mail-context"]},{"id":"mail-widget-context-reply","text":"Предложи ответ на письмо","deeplinkText":"Предложи ответ на письмо","surfaces":["mail-context"]},{"id":"b2b-mail-monitoring-scheduler","surfaces":["scheduled-tasks"],"text":"✉️  Мониторинг почты","deeplinkText":"Проверяй мои письма и сообщай, если что-то требует внимания: письмо от человека (не рассылка), просьба ответить или подтвердить, дедлайн, счёт на оплату, изменение брони или встречи. Рассылки, уведомления сервисов и рекламу пропускай. Когда находишь такое письмо, пришли отправителя, тему, суть в одну фразу и что от меня требуется. Если ничего важного нет — не пиши. Присылай одним сообщением каждый день в 8:00."},{"id":"b2b-competitors-scheduler","surfaces":["scheduled-tasks"],"text":"📈  Отслеживание конкурентов","deeplinkText":"Раз в неделю анализируй сайты конкурентов компании (спроси меня, какой) и собирай изменения в продуктах, ценах и предложениях. Присылай одним сообщением каждый понедельник в 8:00."},{"id":"b2b-crm-deals-scheduler","surfaces":["scheduled-tasks"],"text":"🤝  Контроль сделок","deeplinkText":"Каждый день в 8:00 анализируй движение клиентов в CRM, находи сделки без активности, с просроченными задачами или другими признаками зависания и присылай мне те, которые требуют моего внимания."},{"id":"b2b-tracker-tasks-scheduler","surfaces":["scheduled-tasks"],"text":"📋  Контроль задач в Трекере","deeplinkText":"Каждое утро в 8:00 проверяй задачи в Трекере и собирай просроченные и заблокированные задачи, которые требуют моего внимания."}]}},"deeplinkAttachImages":{"pi_boost":"https://web-alice-images.s3.yandex.net/paywall/pi_boost_img.png","receipt":"https://web-alice-images.s3.yandex.net/deeplink-attachments/receipt.jpg","integral":"https://web-alice-images.s3.yandex.net/deeplink-attachments/integral.jpg","error":"https://web-alice-images.s3.yandex.net/deeplink-attachments/error.jpg","face_cream":"https://web-alice-images.s3.yandex.net/deeplink-attachments/face-cream.jpg","flower":"https://web-alice-images.s3.yandex.net/deeplink-attachments/flower.jpg","contract":"https://web-alice-images.s3.yandex.net/deeplink-attachments/contract.jpg","electricity_bill":"https://web-alice-images.s3.yandex.net/deeplink-attachments/electricity-bill.jpg","triangle_angle":"https://web-alice-images.s3.yandex.net/deeplink-attachments/triangle-angle.jpg"},"reqid":"1795612704530966-15004055313294407627-gita6jayn6cyeetk-BAL","onboardingCards":{"onboarding_response":{"Status":"Ok","Context":{"App":"ru.yandex.webstandalone.desktop","Features":[],"CustomFeatures":{},"Language":"rus"},"RecommendationInfo":{"AppliedLogicExp":"","SelectedLogicExp":"start_chat_card","FallbackLogicExp":"start_chat_card","AppliedDataExp":""},"ExtendedAnalytics":"","ItemType":21,"OnboardingItems":[{"Id":"alice_ecom_agent_onboarding","ItemType":"OT_StartChatCard","Locale":"LOCALE_RU_RU","Tags":["alice_ecom_modeboarding"],"NoPromo":false,"ViewSettings":{"PriorScore":0,"NewbiePriorScore":0,"Condition":{"Id":"","ExpFlags":[],"App":"","UserGroups":[],"RequiredPre