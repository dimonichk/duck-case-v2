-.304l-.098-.005Z"></path></svg></div><span class="A11yHidden">Плохой ответ</span></button></li></menu></div></div></div></div></div></div><div class="AliceChat-MessagePair"><div class="AliceChat-Message" data-testid="alice-chat-message"><div id="01a21308-7f92-4e74-bc45-e273b9e099c6" class="Message Message_from_user" data-message-role="user" data-request-id="01a21308-7f92-4e74-bc45-e273b9e099c6" style="z-index: 21;"><h1 class="A11yHidden">Я</h1><div class="MessageBubble-Container MessageBubble-Container_type_text MessageBubble-Container_from-user MessageBubble-Container_marginTop" data-testid="message-bubble-container-from-user"><div class="MessageBubble" data-testid="message-bubble" data-bubble-id="01a22289-eeaf-4e74-b94c-88dc2251a16b"><div class="FuturisChatMessage FuturisChatMessage_align_end MessageBubble-UserRequest"><div class="FuturisMessage FuturisChatMessage-Bubble MessageBubble-UserText"><div data-testid="collapser-wrapper" class="MessageBubble-CollapserWrapper"><div class="FewLines FewLines_lines_5 MessageBubble-Collapser"><div class="AliceTextBubble AliceTextBubble_from_user" data-testid="alice-text-bubble">В ГИД ПИШИ</div></div></div></div><div class="FuturisChatMessage-Actions"></div></div></div></div><div class="StandaloneContextMenu-Container StandaloneContextMenu-Container_user" data-testid="standalone-context-menu-container-user"><div class="StandaloneContextMenu" data-testid="context-menu-container-user"><div class="StandaloneContextMenu-MenuContainer"><menu class="StandaloneContextMenu-Menu"><li><button class="AliceButton AliceButton_pin_circle AliceButton_iconLeft AliceButton_square AliceButton_size_s AliceButton_view_tertiary StandaloneContextMenu-Button" aria-label="Копировать" data-testid="context-menu-copy-button"><div class="AliceButton-Icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M10.4.5c1.963 0 2.946 0 3.667.442a3 3 0 0 1 .99.99c.443.722.443 1.704.443 3.668v.8l-.007 1.301c-.02 1.139-.104 1.826-.435 2.367l-.097.149c-.236.338-.54.625-.894.842l-.138.078c-.52.267-1.186.338-2.229.357l-.206.001v.205c-.022 1.139-.105 1.826-.436 2.367a2.999 2.999 0 0 1-.99.99c-.542.332-1.23.415-2.368.436l-1.3.007h-.8c-1.841 0-2.82 0-3.529-.364l-.138-.078a2.999 2.999 0 0 1-.894-.842l-.097-.149C.611 13.527.528 12.84.507 11.7L.5 10.4v-.8c0-1.841 0-2.82.364-3.529l.078-.138a3 3 0 0 1 .842-.894l.149-.097c.572-.35 1.31-.422 2.572-.437.014-1.163.075-1.88.36-2.434l.077-.138a3 3 0 0 1 .842-.894l.149-.097C6.654.5 7.636.5 9.6.5h.8zM5.6 5.8c-1.007 0-1.672.002-2.177.05-.486.046-.69.126-.812.2a1.7 1.7 0 0 0-.56.561c-.075.122-.155.326-.201.812-.048.505-.05 1.17-.05 2.177v.8c0 1.007.002 1.672.05 2.177.046.486.126.69.2.812.14.228.333.42.561.56.122.075.326.155.812.201.505.048 1.17.05 2.177.05h.8c1.007 0 1.672-.002 2.177-.05.486-.046.69-.126.812-.2a1.7 1.7 0 0 0 .56-.561c.075-.122.155-.326.201-.812.048-.505.05-1.17.05-2.177v-.8c0-1.007-.002-1.672-.05-2.177-.046-.486-.126-.69-.2-.812a1.7 1.7 0 0 0-.561-.56c-.122-.075-.326-.155-.812-.201-.505-.048-1.17-.05-2.177-.05h-.8zm4-4c-1.007 0-1.672.002-2.177.05-.486.046-.69.126-.812.2a1.7 1.7 0 0 0-.56.561c-.075.122-.155.326-.201.812-.028.293-.039.64-.044 1.077H6.4l1.3.007c1.139.02 1.826.104 2.367.435.404.248.743.587.99.99.443.722.443 1.704.443 3.668v.592a13.38 13.38 0 0 0 1.076-.04c.486-.047.69-.127.812-.202a1.71 1.71 0 0 0 .561-.561c.075-.122.155-.326.201-.812.048-.505.05-1.17.05-2.177v-.8c0-1.007-.002-1.672-.05-2.177-.046-.486-.126-.69-.2-.812a1.7 1.7 0 0 0-.562-.56c-.122-.075-.326-.155-.812-.201-.505-.048-1.17-.05-2.177-.05h-.8z"></path></svg></div></button></li></menu></div></div></div></div></div><div class="AliceChat-Message" data-testid="alice-chat-message"><div id="893b7ecc-8d533a4a-b101c544-7d168be3" class="Message" data-message-role="alice" data-request-id="01a21308-7f92-4e74-bc45-e273b9e099c6" style="z-index: 20;"><h1 class="A11yHidden">Алиса</h1><div class="MessageBubble-Container MessageBubble-Container_type_neuraljson MessageBubble-Container_marginTop" data-testid="message-bubble-container"><div class="MessageBubble" data-testid="message-bubble" data-bubble-id="futuris_status_artifact"><div class="FuturisCard-Renderer"><section class="FuturisContentSection FuturisRSRContent-CompositionBlock" data-log-node="fcnyw01-0-18t"><span class="A11yHidden"><div role="status" aria-live="polite"></div></span><div class="FuturisMarkdown FuturisProgressiveMarkdown MarkdownText FuturisMarkdown_katex" translate="no"><div aria-live="polite" role="status" aria-label="Отправлено пользователем Нейро: Вот оба файла целиком с исправленными шансами (версия `?v=11`).

---

### 1. `bot_case.py` — замени файл целиком

```python
# bot_case.py — Duck Case: панель в мини-окне, баланс на сервере
# pip install aiogram
import asyncio, json, os, random

from aiogram import Bot, Dispatcher, F
from aiogram.client.default import DefaultBotProperties
from aiogram.enums import ParseMode
from aiogram.filters import Command, CommandStart
from aiogram.types import (
    Message, ReplyKeyboardMarkup, KeyboardButton,
    InlineKeyboardMarkup, InlineKeyboardButton, WebAppInfo,
)

# ============ НАСТРОЙКИ ============
BOT_TOKEN = &quot;СЮДА_ТОКЕН&quot;
WEB_APP_URL = &quot;https://dimonichk.github.io/duck-case-v2/?v=11&quot;
ADMIN_ID = 593081823  # твой Telegram ID
SUPPORT_URL = &quot;https://t.me/tsartixc&quot;
USERS_FILE = &quot;users_db.json&quot;
START_BALANCE = 300
MIN_BET = 10
MAX_WIN_MULT = 15

# ============ ФАЙЛЫ ============
def load_json(path, default):
    if not os.path.exists(path):
        with open(path, &quot;w&quot;, encoding=&quot;utf-8&quot;) as f:
            json.dump(default, f, ensure_ascii=False, indent=2)
    with open(path, &quot;r&quot;, encoding=&quot;utf-8&quot;) as f:
        return json.load(f)

def save_json(path, data):
    with open(path, &quot;w&quot;, encoding=&quot;utf-8&quot;) as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

users = load_json(USERS_FILE, {})

def get_user(uid: int) -&gt; dict:
    u = users.setdefault(str(uid), {})
    u.setdefault(&quot;balance&quot;, START_BALANCE)
    u.setdefault(&quot;opened&quot;, 0)
    u.setdefault(&quot;wins&quot;, 0)
    u.setdefault(&quot;username&quot;, &quot;&quot;)
    u.setdefault(&quot;name&quot;, &quot;&quot;)
    return u

def save():
    save_json(USERS_FILE, users)

GAME_NAMES = {
    &quot;bj&quot;: &quot;🃏 Блэкджек&quot;, &quot;mines&quot;: &quot;💣 Мины&quot;, &quot;crash&quot;: &quot;📈 Краш&quot;,
    &quot;flip&quot;: &quot;🪙 Орёл/Решка&quot;, &quot;hl&quot;: &quot;📊 Больше/Меньше&quot;, &quot;cards&quot;: &quot;🂠 Карты&quot;,
    &quot;rou&quot;: &quot;🎡 Рулетка&quot;, &quot;slots&quot;: &quot;🎰 Слоты&quot;, &quot;chicken&quot;: &quot;🐔 Курица-перебежчица&quot;,
    &quot;darts&quot;: &quot;🎯 Дартс&quot;, &quot;dice&quot;: &quot;🎲 Кубики&quot;, &quot;cups&quot;: &quot;🥤 Стаканчики&quot;,
    &quot;case&quot;: &quot;🎁 Кейс&quot;,
}

# ============ КЛАВИАТУРЫ ============
def main_kb():
    return ReplyKeyboardMarkup(keyboard=[
        [KeyboardButton(text=&quot;ОТКРЫТЬ 🦆&quot;)],
        [KeyboardButton(text=&quot;💬 Поддержка&quot;)],
    ], resize_keyboard=True)

def panel_inline(balance: int):
    return InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(
            text=f&quot;🎰 ОТКРЫТЬ панель · {balance} 💰&quot;,
            web_app=WebAppInfo(url=f&quot;{WEB_APP_URL}&amp;b={balance}&quot;),
        )
    ]])

def find_by_username(username: str):
    username = username.lstrip(&quot;@&quot;).lower()
    for uid, u in users.items():
        if u.get(&quot;username&quot;, &quot;&quot;).lower() == username:
            return int(uid)
    return None

bot = Bot(token=BOT_TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
dp = Dispatcher()

# ============ ОСНОВНЫЕ КОМАНДЫ ============
@dp.message(CommandStart())
async def cmd_start(message: Message):
    u = get_user(message.from_user.id)
    u[&quot;balance&quot;] = max(u[&quot;balance&quot;], START_BALANCE)
    u[&quot;username&quot;] = message.from_user.username or &quot;&quot;
    u[&quot;name&quot;] = message.from_user.first_name
    save()
    await message.answer(
        f&quot;👋 &lt;b&gt;{message.from_user.first_name}&lt;/b&gt;, привет!\n\n&quot;
        f&quot;💰 Баланс: &lt;b&gt;{u['balance']}&lt;/b&gt; монет\n\n&quot;
        f&quot;Жми &lt;b&gt;ОТКРЫТЬ 🦆&lt;/b&gt; — кейсы и 12 мини-игр внутри.&quot;,
        reply_markup=main_kb(),
    )

@dp.message(F.text == &quot;ОТКРЫТЬ 🦆&quot;)
async def m_open(message: Message):
    u = get_user(message.from_user.id)
    await message.answer(&quot;🎰 Твоя панель:&quot;, reply_markup=panel_inline(u[&quot;balance&quot;]))

@dp.message(F.text == &quot;💬 Поддержка&quot;)
async def m_support(message: Message):
    u = get_user(message.from_user.id)
    await message.answer(
        f&quot;💬 Проблемы с балансом, кейсом или игрой?\n&quot;
        f&quot;Пиши напрямую: &lt;b&gt;@tsartixc&lt;/b&gt;\n\n{SUPPORT_URL}&quot;,
        reply_markup=panel_inline(u[&quot;balance&quot;]),
    )

@dp.message(Command(&quot;profile&quot;))
async def cmd_profile(message: Message):
    u = get_user(message.from_user.id)
    await message.answer(
        f&quot;👤 &lt;b&gt;Профиль&lt;/b&gt;\n\n💰 Баланс: &lt;b&gt;{u['balance']}&lt;/b&gt;\n&quot;
        f&quot;📦 Кейсов открыто: &lt;b&gt;{u['opened']}&lt;/b&gt;\n🎮 Побед в играх: &lt;b&gt;{u['wins']}&lt;/b&gt;&quot;,
        reply_markup=panel_inline(u[&quot;balance&quot;]),
    )

# ============ ДАННЫЕ ИЗ МИНИ-ОКНА ============
@dp.message(F.web_app_data)
async def m_webapp(message: Message):
    try:
        payload = json.loads(message.web_app_data.data)
    except (json.JSONDecodeError, TypeError):
        return
    uid = message.from_user.id
    u = get_user(uid)
    act = payload.get(&quot;action&quot;)

    if act == &quot;settle&quot;:
        try:
            bet = int(payload.get(&quot;bet&quot;, 0))
            net = int(payload.get(&quot;net&quot;, 0))
        except (TypeError, ValueError):
            return
        game = GAME_NAMES.get(payload.get(&quot;game&quot;, &quot;&quot;), &quot;🎮 Игра&quot;)
        if bet &lt; MIN_BET or net &lt; -bet or net &gt; bet  MAX_WIN_MULT:
            await message.answer(&quot;⚠️ Подозрительная операция отклонена.&quot;)
            return
        u[&quot;balance&quot;] = max(0, u[&quot;balance&quot;] + net)
        if net &gt; 0:
            u[&quot;wins&quot;] += 1
        save()
        sign = f&quot;+{net}&quot; if net &gt;= 0 else str(net)
        await message.answer(
            f&quot;{game}\n💸 Ставка: {bet} · Результат: &lt;b&gt;{sign}&lt;/b&gt;\n💰 Баланс: &lt;b&gt;{u['balance']}&lt;/b&gt;&quot;,
            reply_markup=panel_inline(u[&quot;balance&quot;]),
        )

# ============ АДМИН-КОМАНДЫ ============
@dp.message(Command(&quot;add&quot;))
async def cmd_add(message: Message):
    if message.from_user.id != ADMIN_ID:
        return
    parts = message.text.split()
    if len(parts) &lt; 2 or not parts.lstrip(&quot;-&quot;).isdigit():
        await message.answer(&quot;Формат: /add 1000 (можно отрицательное)&quot;)
        return
    u = get_user(message.from_user.id)
    u[&quot;balance&quot;] += int(parts)
    save()
    await message.answer(f&quot;💰 Начислено {parts}. Баланс: &lt;b&gt;{u['balance']}&lt;/b&gt;&quot;,
                         reply_markup=panel_inline(u[&quot;balance&quot;]))

@dp.message(Command(&quot;give&quot;))
async def cmd_give(message: Message):
    await cmd_gift(message)

@dp.message(Command(&quot;gift&quot;))
async def cmd_gift(message: Message):
    if message.from_user.id != ADMIN_ID:
        return
    parts = message.text.split()
    if len(parts) &lt; 3 or not parts.lstrip(&quot;-&quot;).isdigit():
        await message.answer(&quot;Формат: /gift @username 500&quot;)
        return
    target = find_by_username(parts)
    if not target:
        await message.answer(
            &quot;❌ Игрок не найден. Он должен хотя бы раз написать боту /start — &quot;
            &quot;тогда его юзернейм сохранится в базе.&quot;)
        return
    tu = get_user(target)
    tu[&quot;balance&quot;] += int(parts)
    save()
    await message.answer(
        f&quot;✅ Игроку @{tu['username']} начислено {parts}. Его баланс: &lt;b&gt;{tu['balance']}&lt;/b&gt;&quot;)
    try:
        await bot.send_message(
            target,
            f&quot;🎁 Админ начислил тебе &lt;b&gt;{parts}&lt;/b&gt; монет!\n💰 Баланс: &lt;b&gt;{tu['balance']}&lt;/b&gt;&quot;,
            reply_markup=panel_inline(tu[&quot;balance&quot;]),
        )
    except Exception:
        pass

@dp.message(F.text)
async def m_text(message: Message):
    u = get_user(message.from_user.id)
    await message.answer(&quot;Не понял 🤔 Жми кнопку ОТКРЫТЬ 🦆&quot;, reply_markup=main_kb())

# ============ ЗАПУСК ============
async def main():
    await dp.start_polling(bot)

if __name__ == &quot;__main__&quot;:
    asyncio.run(main())
```

