      <span class="hljs-tag">&lt;<span class="hljs-name">p</span>&gt;</span>Кейсов открыто: <span class="hljs-tag">&lt;<span class="hljs-name">b</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"p-opened"</span>&gt;</span>0<span class="hljs-tag">&lt;/<span class="hljs-name">b</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">p</span>&gt;</span>Побед в играх: <span class="hljs-tag">&lt;<span class="hljs-name">b</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"p-wins"</span>&gt;</span>0<span class="hljs-tag">&lt;/<span class="hljs-name">b</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span>&gt;</span>
    <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
    <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"card"</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">h3</span>&gt;</span>🛠 Админ<span class="hljs-tag">&lt;/<span class="hljs-name">h3</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">p</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"muted"</span>&gt;</span>Начисление — командами в чате бота:<span class="hljs-tag">&lt;<span class="hljs-name">br</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">b</span>&gt;</span>/add 1000<span class="hljs-tag">&lt;/<span class="hljs-name">b</span>&gt;</span> — себе<span class="hljs-tag">&lt;<span class="hljs-name">br</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">b</span>&gt;</span>/gift @username 500<span class="hljs-tag">&lt;/<span class="hljs-name">b</span>&gt;</span> — игроку<span class="hljs-tag">&lt;<span class="hljs-name">br</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">b</span>&gt;</span>/profile<span class="hljs-tag">&lt;/<span class="hljs-name">b</span>&gt;</span> — точный баланс<span class="hljs-tag">&lt;/<span class="hljs-name">p</span>&gt;</span>
    <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
  <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>

  <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"tab"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"tab-support"</span>&gt;</span>
    <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"card"</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">h3</span>&gt;</span>💬 Поддержка<span class="hljs-tag">&lt;/<span class="hljs-name">h3</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">p</span>&gt;</span>Проблемы с балансом, кейсом или игрой? Напиши нам — ответим быстро.<span class="hljs-tag">&lt;/<span class="hljs-name">p</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"btn"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"goSupport()"</span>&gt;</span>Написать в поддержку<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">p</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"muted"</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"margin-top:10px"</span>&gt;</span>Или прямо в Telegram: @tsartixc<span class="hljs-tag">&lt;/<span class="hljs-name">p</span>&gt;</span>
    <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
  <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>

<span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
<span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"nav"</span>&gt;</span>
  <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">data-tab</span>=<span class="hljs-string">"cases"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"active"</span>&gt;</span><span class="hljs-tag">&lt;<span class="hljs-name">span</span>&gt;</span>🎁<span class="hljs-tag">&lt;/<span class="hljs-name">span</span>&gt;</span>Кейсы<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
  <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">data-tab</span>=<span class="hljs-string">"games"</span>&gt;</span><span class="hljs-tag">&lt;<span class="hljs-name">span</span>&gt;</span>🎮<span class="hljs-tag">&lt;/<span class="hljs-name">span</span>&gt;</span>Игры<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
  <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">data-tab</span>=<span class="hljs-string">"profile"</span>&gt;</span><span class="hljs-tag">&lt;<span class="hljs-name">span</span>&gt;</span>👤<span class="hljs-tag">&lt;/<span class="hljs-name">span</span>&gt;</span>Профиль<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
  <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">data-tab</span>=<span class="hljs-string">"support"</span>&gt;</span><span class="hljs-tag">&lt;<span class="hljs-name">span</span>&gt;</span>💬<span class="hljs-tag">&lt;/<span class="hljs-name">span</span>&gt;</span>Поддержка<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
<span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>

<span class="hljs-tag">&lt;<span class="hljs-name">script</span>&gt;</span><span class="language-javascript">
<span class="hljs-keyword">const</span> tg = <span class="hljs-variable language_">window</span>.<span class="hljs-property">Telegram</span>.<span class="hljs-property">WebApp</span>;
tg.<span class="hljs-title function_">ready</span>(); tg.<span class="hljs-title function_">expand</span>();

<span class="hljs-keyword">const</span> <span class="hljs-variable constant_">START_BALANCE</span> = <span class="hljs-number">300</span>;
<span class="hljs-keyword">let</span> stats = <span class="hljs-title class_">JSON</span>.<span class="hljs-title function_">parse</span>(<span class="hljs-variable language_">localStorage</span>.<span class="hljs-title function_">getItem</span>(<span class="hljs-string">"duck_stats"</span>) || <span class="hljs-string">"null"</span>)
  || {<span class="hljs-attr">balance</span>: <span class="hljs-variable constant_">START_BALANCE</span>, <span class="hljs-attr">opened</span>: <span class="hljs-number">0</span>, <span class="hljs-attr">wins</span>: <span class="hljs-number">0</span>};

<span class="hljs-keyword">const</span> q = <span class="hljs-keyword">new</span> <span class="hljs-title class_">URLSearchParams</span>(location.<span class="hljs-property">search</span>);
<span class="hljs-keyword">if</span> (q.<span class="hljs-title function_">has</span>(<span class="hljs-string">"b"</span>)) { <span class="hljs-keyword">const</span> b = <span class="hljs-built_in">parseInt</span>(q.<span class="hljs-title function_">get</span>(<span class="hljs-string">"b"</span>)); <span class="hljs-keyword">if</span> (!<span class="hljs-built_in">isNaN</span>(b)) stats.<span class="hljs-property">balance</span> = b; }

<span class="hljs-keyword">function</span> <span class="hljs-title function_">save</span>(<span class="hljs-params"></span>){ <span class="hljs-variable language_">localStorage</span>.<span class="hljs-title function_">setItem</span>(<span class="hljs-string">"duck_stats"</span>, <span class="hljs-title class_">JSON</span>.<span class="hljs-title function_">stringify</span>(stats)); }
<span class="hljs-keyword">function</span> <span class="hljs-title function_">renderBal</span>(<span class="hljs-params"></span>){
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"balance"</span>).<span class="hljs-property">textContent</span> = stats.<span class="hljs-property">balance</span>;
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"p-balance"</span>).<span class="hljs-property">textContent</span> = stats.<span class="hljs-property">balance</span>;
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"p-opened"</span>).<span class="hljs-property">textContent</span> = stats.<span class="hljs-property">opened</span>;
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"p-wins"</span>).<span class="hljs-property">textContent</span> = stats.<span class="hljs-property">wins</span>;
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">send</span>(<span class="hljs-params">data</span>){ <span class="hljs-keyword">try</span>{ tg.<span class="hljs-title function_">sendData</span>(<span class="hljs-title class_">JSON</span>.<span class="hljs-title function_">stringify</span>(data)); }<span class="hljs-keyword">catch</span>(e){} }
<span class="hljs-keyword">function</span> <span class="hljs-title function_">toast</span>(<span class="hljs-params">text</span>){ tg.<span class="hljs-property">showAlert</span> ? tg.<span class="hljs-title function_">showAlert</span>(text) : <span class="hljs-title function_">alert</span>(text); }

<span class="hljs-keyword">function</span> <span class="hljs-title function_">show</span>(<span class="hljs-params">tab</span>){
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">querySelectorAll</span>(<span class="hljs-string">'.tab'</span>).<span class="hljs-title function_">forEach</span>(<span class="hljs-function"><span class="hljs-params">t</span>=&gt;</span>t.<span class="hljs-property">classList</span>.<span class="hljs-title function_">remove</span>(<span class="hljs-string">'active'</span>));
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">'tab-'</span>+tab).<span class="hljs-property">classList</span>.<span class="hljs-title function_">add</span>(<span class="hljs-string">'active'</span>);
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">querySelectorAll</span>(<span class="hljs-string">'.nav button'</span>).<span class="hljs-title function_">forEach</span>(<span class="hljs-function"><span class="hljs-params">b</span>=&gt;</span>b.<span class="hljs-property">classList</span>.<span class="hljs-title function_">toggle</span>(<span class="hljs-string">'active'</span>,b.<span class="hljs-property">dataset</span>.<span class="hljs-property">tab</span>===tab));
}
<span class="hljs-variable language_">document</span>.<span class="hljs-title function_">querySelectorAll</span>(<span class="hljs-string">'.nav button'</span>).<span class="hljs-title function_">forEach</span>(<span class="hljs-function"><span class="hljs-params">b</span>=&gt;</span>b.<span class="hljs-property">onclick</span>=<span class="hljs-function">()=&gt;</span><span class="hljs-title function_">show</span>(b.<span class="hljs-property">dataset</span>.<span class="hljs-property">tab</span>));

<span class="hljs-comment">// ---------- КЕЙСЫ (ИСПРАВЛЕННЫЕ ШАНСЫ) ----------</span>
<span class="hljs-keyword">const</span> cases = [
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"lucky"</span>,  <span class="hljs-attr">name</span>:<span class="hljs-string">"🍀 Lucky Case"</span>,  <span class="hljs-attr">price</span>:<span class="hljs-number">50</span>,
   <span class="hljs-attr">items</span>:[[<span class="hljs-string">"15 монет"</span>,<span class="hljs-number">60</span>,<span class="hljs-number">15</span>],[<span class="hljs-string">"40 монет"</span>,<span class="hljs-number">30</span>,<span class="hljs-number">40</span>],[<span class="hljs-string">"ДЖЕКПОТ 250"</span>,<span class="hljs-number">10</span>,<span class="hljs-number">250</span>]]},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"duck"</span>,   <span class="hljs-attr">name</span>:<span class="hljs-string">"🦆 Duck Case"</span>,   <span class="hljs-attr">price</span>:<span class="hljs-number">100</span>,
   <span class="hljs-attr">items</span>:[[<span class="hljs-string">"30 монет"</span>,<span class="hljs-number">55</span>,<span class="hljs-number">30</span>],[<span class="hljs-string">"100 монет"</span>,<span class="hljs-number">35</span>,<span class="hljs-number">100</span>],[<span class="hljs-string">"ДЖЕКПОТ 400"</span>,<span class="hljs-number">10</span>,<span class="hljs-number">400</span>]]},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"golden"</span>, <span class="hljs-attr">name</span>:<span class="hljs-string">"👑 Golden Case"</span>, <span class="hljs-attr">price</span>:<span class="hljs-number">300</span>,
   <span class="hljs-attr">items</span>:[[<span class="hljs-string">"80 монет"</span>,<span class="hljs-number">55</span>,<span class="hljs-number">80</span>],[<span class="hljs-string">"300 монет"</span>,<span class="hljs-number">35</span>,<span class="hljs-number">300</span>],[<span class="hljs-string">"ДЖЕКПОТ 1200"</span>,<span class="hljs-number">10</span>,<span class="hljs-number">1200</span>]]},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"ruby"</span>,   <span class="hljs-attr">name</span>:<span class="hljs-string">"💎 Ruby Case"</span>,   <span class="hljs-attr">price</span>:<span class="hljs-number">700</span>,
   <span class="hljs-attr">items</span>:[[<span class="hljs-string">"220 монет"</span>,<span class="hljs-number">55</span>,<span class="hljs-number">220</span>],[<span class="hljs-string">"700 монет"</span>,<span class="hljs-number">35</span>,<span class="hljs-number">700</span>],[<span class="hljs-string">"ДЖЕКПОТ 2800"</span>,<span class="hljs-number">10</span>,<span class="hljs-number">2800</span>]]},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"ghost"</span>,  <span class="hljs-attr">name</span>:<span class="hljs-string">"👻 Ghost Case"</span>,  <span class="hljs-attr">price</span>:<span class="hljs-number">1500</span>,
   <span class="hljs-attr">items</span>:[[<span class="hljs-string">"450 монет"</span>,<span class="hljs-number">55</span>,<span class="hljs-number">450</span>],[<span class="hljs-string">"1600 монет"</span>,<span class="hljs-number">35</span>,<span class="hljs-number">1600</span>],[<span class="hljs-string">"ДЖЕКПОТ 6000"</span>,<span class="hljs-number">10</span>,<span class="hljs-number">6000</span>]]},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"dragon"</span>, <span class="hljs-attr">name</span>:<span class="hljs-string">"🐲 Dragon Case"</span>, <span class="hljs-attr">price</span>:<span class="hljs-number">3000</span>,
   <span class="hljs-attr">items</span>:[[<span class="hljs-string">"900 монет"</span>,<span class="hljs-number">55</span>,<span class="hljs-number">900</span>],[<span class="hljs-string">"3200 монет"</span>,<span class="hljs-number">35</span>,<span class="hljs-number">3200</span>],[<span class="hljs-string">"ДЖЕКПОТ 12000"</span>,<span class="hljs-number">10</span>,<span class="hljs-number">12000</span>]]},
];
<span class="hljs-keyword">function</span> <span class="hljs-title function_">renderCases</span>(<span class="hljs-params"></span>){
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"cases-list"</span>).<span class="hljs-property">innerHTML</span> = cases.<span class="hljs-title function_">map</span>(<span class="hljs-function">(<span class="hljs-params">c,i</span>)=&gt;</span><span class="hljs-string">`
    &lt;div class="card" id="case-\${i}"&gt;
      &lt;h3&gt;<span class="hljs-subst">${c.name}</span>&lt;/h3&gt;&lt;p class="price"&gt;<span class="hljs-subst">${c.price}</span> монет&lt;/p&gt;
      &lt;p class="muted"&gt;Шансы: \${c.items.map(it=&gt;it+" "+it+"%").join(", ")}&lt;/p&gt;
      &lt;button class="btn" onclick="buyCase(\${i})"&gt;Открыть&lt;/button&gt;
    &lt;/div&gt;`</span>).<span class="hljs-title function_">join</span>(<span class="hljs-string">""</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">pickCase</span>(<span class="hljs-params">c</span>){
  <span class="hljs-keyword">let</span> r = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">100</span>, t = <span class="hljs-number">0</span>;
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">const</span> it <span class="hljs-keyword">of</span> c.<span class="hljs-property">items</span>){ t += it; <span class="hljs-keyword">if</span>(r &lt;= t) <span class="hljs-keyword">return</span> it; }
  <span class="hljs-keyword">return</span> c.<span class="hljs-property">items</span>[c.<span class="hljs-property">items</span>.<span class="hljs-property">length</span>-<span class="hljs-number">1</span>];
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">buyCase</span>(<span class="hljs-params">i</span>){
  <span class="hljs-keyword">const</span> c = cases[i];
  <span class="hljs-keyword">if</span>(stats.<span class="hljs-property">balance</span> &lt; c.<span class="hljs-property">price</span>){ <span class="hljs-title function_">toast</span>(<span class="hljs-string">`Не хватает монет: нужно <span class="hljs-subst">${c.price}</span>, у тебя <span class="hljs-subst">${stats.balance}</span>`</span>); <span class="hljs-keyword">return</span>; }
  stats.<span class="hljs-property">balance</span> -= c.<span class="hljs-property">price</span>;
  stats.<span class="hljs-property">opened</span>++;
  <span class="hljs-title function_">save</span>(); <span class="hljs-title function_">renderBal</span>();
  <span class="hljs-keyword">const</span> card = <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"case-"</span>+i);
  card.<span class="hljs-title function_">querySelector</span>(<span class="hljs-string">"button"</span>).<span class="hljs-property">disabled</span> = <span class="hljs-literal">true</span>;
  card.<span class="hljs-title function_">querySelector</span>(<span class="hljs-string">".price"</span>).<span class="hljs-property">textContent</span> = <span class="hljs-string">"открываем…"</span>;
  <span class="hljs-keyword">let</span> tick = <span class="hljs-number">0</span>;
  <span class="hljs-keyword">const</span> spin = <span class="hljs-built_in">setInterval</span>(<span class="hljs-function">()=&gt;</span>{
    <span class="hljs-keyword">const</span> it = c.<span class="hljs-property">items</span>[<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*c.<span class="hljs-property">items</span>.<span class="hljs-property">length</span>)];
    card.<span class="hljs-title function_">querySelector</span>(<span class="hljs-string">".price"</span>).<span class="hljs-property">textContent</span> = it + (it.<span class="hljs-title function_">includes</span>(<span class="hljs-string">"ДЖЕКПОТ"</span>) ? <span class="hljs-string">" ✨"</span> : <span class="hljs-string">" …"</span>);
    tick++;
    <span class="hljs-keyword">if</span>(tick &gt; <span class="hljs-number">12</span>){
      <span class="hljs-built_in">clearInterval</span>(spin);
      <span class="hljs-keyword">const</span> item = <span class="hljs-title function_">pickCase</span>(c);
      stats.<span class="hljs-property">balance</span> += item;
      <span class="hljs-keyword">if</span>(item &gt; c.<span class="hljs-property">price</span>) stats.<span class="hljs-property">wins</span>++;
      <span class="hljs-title function_">save</span>(); <span class="hljs-title function_">renderBal</span>();
      <span class="hljs-keyword">const</span> jackpot = item.<span class="hljs-title function_">includes</span>(<span class="hljs-string">"ДЖЕКПОТ"</span>);
      card.<span class="hljs-property">innerHTML</span> = <span class="hljs-string">`&lt;h3&gt;\${c.name}&lt;/h3&gt;
        &lt;p&gt;<span class="hljs-subst">${jackpot?<span class="hljs-string">"🎊 &lt;span class='jack'&gt;"</span>:<span class="hljs-string">"🎉 &lt;span class='win'&gt;"</span>}</span><span class="hljs-subst">${item}</span>&lt;/span&gt;&lt;/p&gt;
        &lt;p class="muted"&gt;−<span class="hljs-subst">${c.price}</span> за кейс · +<span class="hljs-subst">${item}</span> приз · баланс \${stats.balance} 💰&lt;/p&gt;
        &lt;button class="btn" onclick="renderCases()"&gt;Открыть ещё&lt;/button&gt;`</span>;
      <span class="hljs-title function_">send</span>({<span class="hljs-attr">action</span>:<span class="hljs-string">"settle"</span>, <span class="hljs-attr">game</span>:<span class="hljs-string">"case"</span>, <span class="hljs-attr">bet</span>:c.<span class="hljs-property">price</span>, <span class="hljs-attr">net</span>:item-c.<span class="hljs-property">price</span>});
    }
  }, <span class="hljs-number">100</span>);
}

<span class="hljs-comment">// ---------- ИГРЫ (в столбик) ----------</span>
<span class="hljs-keyword">const</span> games = [
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"bj"</span>,      <span class="hljs-attr">name</span>:<span class="hljs-string">"🃏 Блэкджек"</span>,             <span class="hljs-attr">desc</span>:<span class="hljs-string">"Набери 21 или больше дилера. Блэкджек x2.5, победа x1.9."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"mines"</span>,   <span class="hljs-attr">name</span>:<span class="hljs-string">"💣 Мины"</span>,                <span class="hljs-attr">desc</span>:<span class="hljs-string">"Поле 3×3, 3 мины. Каждый безопасный клик +35%."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"crash"</span>,   <span class="hljs-attr">name</span>:<span class="hljs-string">"📈 Краш"</span>,                <span class="hljs-attr">desc</span>:<span class="hljs-string">"Множитель растёт по +25%. Забирай до краша."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"flip"</span>,    <span class="hljs-attr">name</span>:<span class="hljs-string">"🪙 Орёл/Решка"</span>,          <span class="hljs-attr">desc</span>:<span class="hljs-string">"Угадай сторону монеты — x1.9."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"hl"</span>,      <span class="hljs-attr">name</span>:<span class="hljs-string">"📊 Больше/Меньше"</span>,        <span class="hljs-attr">desc</span>:<span class="hljs-string">"Следующее число больше или меньше? x1.9 за попытку."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"cards"</span>,   <span class="hljs-attr">name</span>:<span class="hljs-string">"🂠 Карты"</span>,               <span class="hljs-attr">desc</span>:<span class="hljs-string">"Угадай цвет карты — x1.95."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"rou"</span>,     <span class="hljs-attr">name</span>:<span class="hljs-string">"🎡 Рулетка"</span>,             <span class="hljs-attr">desc</span>:<span class="hljs-string">"Лента множителей от x0.2 до x10."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"slots"</span>,   <span class="hljs-attr">name</span>:<span class="hljs-string">"🎰 Слоты"</span>,               <span class="hljs-attr">desc</span>:<span class="hljs-string">"Три в ряд — до x10. Пара — x1.5."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"chicken"</span>, <span class="hljs-attr">name</span>:<span class="hljs-string">"🐔 Курица-перебежчица"</span>,   <span class="hljs-attr">desc</span>:<span class="hljs-string">"Веди курицу через дорогу: +30% за шаг, но можно под машину попасть."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"darts"</span>,   <span class="hljs-attr">name</span>:<span class="hljs-string">"🎯 Дартс"</span>,               <span class="hljs-attr">desc</span>:<span class="hljs-string">"Метни дротик: до x10 за точный бросок."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"dice"</span>,    <span class="hljs-attr">name</span>:<span class="hljs-string">"🎲 Кубики"</span>,              <span class="hljs-attr">desc</span>:<span class="hljs-string">"Два кубика против бота. Больше сумма — x1.9."</span>},
  {<span class="hljs-attr">key</span>:<span class="hljs-string">"cups"</span>,    <span class="hljs-attr">name</span>:<span class="hljs-string">"🥤 Стаканчики"</span>,          <span class="hljs-attr">desc</span>:<span class="hljs-string">"Под каким стаканом монета? Угадал — x2.7."</span>},
];
<span class="hljs-keyword">function</span> <span class="hljs-title function_">renderGames</span>(<span class="hljs-params"></span>){
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"games-list"</span>).<span class="hljs-property">innerHTML</span> = games.<span class="hljs-title function_">map</span>(<span class="hljs-function"><span class="hljs-params">g</span>=&gt;</span><span class="hljs-string">`
    &lt;div class="card"&gt;
      &lt;h3&gt;\${g.name}&lt;/h3&gt;
      &lt;p class="muted"&gt;\${g.desc}&lt;/p&gt;
      &lt;button class="btn" onclick="startGame('\${g.key}')"&gt;Играть&lt;/button&gt;
    &lt;/div&gt;`</span>).<span class="hljs-title function_">join</span>(<span class="hljs-string">""</span>);
}
<span class="hljs-keyword">let</span> g = <span class="hljs-literal">null</span>;
<span class="hljs-keyword">function</span> <span class="hljs-title function_">startGame</span>(<span class="hljs-params">type</span>){
  g = {type};
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"games-list"</span>).<span class="hljs-property">style</span>.<span class="hljs-property">display</span>=<span class="hljs-string">"none"</span>;
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"game-area"</span>).<span class="hljs-property">style</span>.<span class="hljs-property">display</span>=<span class="hljs-string">"block"</span>;
  <span class="hljs-keyword">const</span> meta = games.<span class="hljs-title function_">find</span>(<span class="hljs-function"><span class="hljs-params">x</span>=&gt;</span>x.<span class="hljs-property">key</span>===type);
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;<span class="hljs-subst">${meta.name}</span>&lt;/h3&gt;&lt;p class="muted"&gt;<span class="hljs-subst">${meta.desc}</span>&lt;/p&gt;`</span>);
  <span class="hljs-title function_">askBet</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">menu</span>(<span class="hljs-params">html</span>){ <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"game-body"</span>).<span class="hljs-property">innerHTML</span> = html; }
<span class="hljs-keyword">function</span> <span class="hljs-title function_">backToMenu</span>(<span class="hljs-params"></span>){
  g = <span class="hljs-literal">null</span>;
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"games-list"</span>).<span class="hljs-property">style</span>.<span class="hljs-property">display</span>=<span class="hljs-string">"block"</span>;
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"game-area"</span>).<span class="hljs-property">style</span>.<span class="hljs-property">display</span>=<span class="hljs-string">"none"</span>;
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">askBet</span>(<span class="hljs-params"></span>){
  <span class="hljs-title function_">menu</span>(<span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"game-body"</span>).<span class="hljs-property">innerHTML</span> + <span class="hljs-string">`
    &lt;input class="inp" id="bet" type="number" placeholder="Ставка (от 10)"/&gt;
    &lt;button class="btn" onclick="placeBet()"&gt;Поставить&lt;/button&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">placeBet</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> a = <span class="hljs-built_in">parseInt</span>(<span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"bet"</span>).<span class="hljs-property">value</span>);
  <span class="hljs-keyword">if</span>(<span class="hljs-built_in">isNaN</span>(a) || a &lt; <span class="hljs-number">10</span>){ <span class="hljs-title function_">toast</span>(<span class="hljs-string">"Ставка от 10 монет"</span>); <span class="hljs-keyword">return</span>; }
  <span class="hljs-keyword">if</span>(stats.<span class="hljs-property">balance</span> &lt; a){ <span class="hljs-title function_">toast</span>(<span class="hljs-string">"Не хватает монет"</span>); <span class="hljs-keyword">return</span>; }
  stats.<span class="hljs-property">balance</span> -= a; <span class="hljs-title function_">save</span>(); <span class="hljs-title function_">renderBal</span>();
  g.<span class="hljs-property">bet</span> = a;
  <span class="hljs-keyword">const</span> start = {
    <span class="hljs-attr">bj</span>:bjDeal, <span class="hljs-attr">mines</span>:minesStart, <span class="hljs-attr">crash</span>:crashStart, <span class="hljs-attr">flip</span>:flipUI,
    <span class="hljs-attr">hl</span>:hlStart, <span class="hljs-attr">cards</span>:cardsUI, <span class="hljs-attr">rou</span>:rouStart, <span class="hljs-attr">slots</span>:slotsStart,
    <span class="hljs-attr">chicken</span>:chickenStart, <span class="hljs-attr">darts</span>:dartsStart, <span class="hljs-attr">dice</span>:diceStart, <span class="hljs-attr">cups</span>:cupsStart
  };
  start[g.<span class="hljs-property">type</span>]();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">endGame</span>(<span class="hljs-params">game, prize</span>){
  <span class="hljs-keyword">const</span> bet = g.<span class="hljs-property">bet</span> || <span class="hljs-number">0</span>;
  stats.<span class="hljs-property">balance</span> += prize;
  <span class="hljs-keyword">if</span>(prize &gt; bet) stats.<span class="hljs-property">wins</span>++;
  <span class="hljs-title function_">save</span>(); <span class="hljs-title function_">renderBal</span>();
  <span class="hljs-title function_">send</span>({<span class="hljs-attr">action</span>:<span class="hljs-string">"settle"</span>, game, bet, <span class="hljs-attr">net</span>: prize - bet});
}

<span class="hljs-comment">// --- Блэкджек ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">bjDeal</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> deck = ;
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> v=<span class="hljs-number">2</span>; v&lt;=<span class="hljs-number">10</span>; v++) <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> s=<span class="hljs-number">0</span>;s&lt;<span class="hljs-number">4</span>;s++) deck.<span class="hljs-title function_">push</span>(v);
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> s=<span class="hljs-number">0</span>;s&lt;<span class="hljs-number">12</span>;s++) deck.<span class="hljs-title function_">push</span>(<span class="hljs-number">10</span>);
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> s=<span class="hljs-number">0</span>;s&lt;<span class="hljs-number">4</span>;s++)  deck.<span class="hljs-title function_">push</span>(<span class="hljs-number">11</span>);
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> i=deck.<span class="hljs-property">length</span>-<span class="hljs-number">1</span>;i&gt;<span class="hljs-number">0</span>;i--){ <span class="hljs-keyword">const</span> j=<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*(i+<span class="hljs-number">1</span>)); [deck[i],deck[j]]=[deck[j],deck[i]]; }
  g.<span class="hljs-property">deck</span> = deck;
  g.<span class="hljs-property">player</span> = [deck.<span class="hljs-title function_">pop</span>(), deck.<span class="hljs-title function_">pop</span>()];
  g.<span class="hljs-property">dealer</span> = [deck.<span class="hljs-title function_">pop</span>(), deck.<span class="hljs-title function_">pop</span>()];
  <span class="hljs-title function_">bjRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">bjVal</span>(<span class="hljs-params">hand</span>){
  <span class="hljs-keyword">let</span> total = hand.<span class="hljs-title function_">reduce</span>(<span class="hljs-function">(<span class="hljs-params">a,b</span>)=&gt;</span>a+b,<span class="hljs-number">0</span>), aces = hand.<span class="hljs-title function_">filter</span>(<span class="hljs-function"><span class="hljs-params">x</span>=&gt;</span>x===<span class="hljs-number">11</span>).<span class="hljs-property">length</span>;
  <span class="hljs-keyword">while</span>(total &gt; <span class="hljs-number">21</span> &amp;&amp; aces &gt; <span class="hljs-number">0</span>){ total -= <span class="hljs-number">10</span>; aces--; }
  <span class="hljs-keyword">return</span> total;
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">bjRender</span>(<span class="hljs-params">msg=<span class="hljs-string">""</span></span>){
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🃏 Блэкджек&lt;/h3&gt;
    &lt;p&gt;Твои карты: &lt;b&gt;<span class="hljs-subst">${g.player.join(<span class="hljs-string">", "</span>)}</span>&lt;/b&gt; (сумма &lt;b&gt;<span class="hljs-subst">${bjVal(g.player)}</span>&lt;/b&gt;)&lt;/p&gt;
    &lt;p class="muted"&gt;Дилер: 🂠 \${g.dealer}, скрытая&lt;/p&gt;
    <span class="hljs-subst">${msg?<span class="hljs-string">`&lt;div class="log"&gt;<span class="hljs-subst">${msg}</span>&lt;/div&gt;`</span>:<span class="hljs-string">""</span>}</span>
    &lt;div class="row"&gt;
      &lt;button class="btn" onclick="bjHit()"&gt;🖐 Взять&lt;/button&gt;
      &lt;button class="btn green" onclick="bjStand()"&gt;✋ Хватит&lt;/button&gt;
    &lt;/div&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">bjHit</span>(<span class="hljs-params"></span>){
  g.<span class="hljs-property">player</span>.<span class="hljs-title function_">push</span>(g.<span class="hljs-property">deck</span>.<span class="hljs-title function_">pop</span>());
  <span class="hljs-keyword">if</span>(<span class="hljs-title function_">bjVal</span>(g.<span class="hljs-property">player</span>) &gt; <span class="hljs-number">21</span>){
    <span class="hljs-title function_">menu</span>(<span class="hljs-string">`🃏 Перебор <span class="hljs-subst">${bjVal(g.player)}</span>. Проигрыш <span class="hljs-subst">${g.bet}</span> 💸`</span>);
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"bj"</span>, <span class="hljs-number">0</span>); <span class="hljs-keyword">return</span>;
  }
  <span class="hljs-title function_">bjRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">bjStand</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">while</span>(<span class="hljs-title function_">bjVal</span>(g.<span class="hljs-property">dealer</span>) &lt; <span class="hljs-number">17</span>) g.<span class="hljs-property">dealer</span>.<span class="hljs-title function_">push</span>(g.<span class="hljs-property">deck</span>.<span class="hljs-title function_">pop</span>());
  <span class="hljs-keyword">const</span> p = <span class="hljs-title function_">bjVal</span>(g.<span class="hljs-property">player</span>), d = <span class="hljs-title function_">bjVal</span>(g.<span class="hljs-property">dealer</span>);
  <span class="hljs-keyword">const</span> isBJ = p === <span class="hljs-number">21</span> &amp;&amp; g.<span class="hljs-property">player</span>.<span class="hljs-property">length</span> === <span class="hljs-number">2</span>;
  <span class="hljs-keyword">let</span> prize, msg;
  <span class="hljs-keyword">if</span>(p &gt; <span class="hljs-number">21</span>){ prize = <span class="hljs-number">0</span>; msg = <span class="hljs-string">`Ты <span class="hljs-subst">${p}</span>, дилер <span class="hljs-subst">${d}</span>. Проигрыш \${g.bet} 💸`</span>; }
  <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span>(isBJ &amp;&amp; d !== <span class="hljs-number">21</span>){ prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*<span class="hljs-number">2.5</span>); msg = <span class="hljs-string">`🃏 БЛЭКДЖЕК! +\${prize}`</span>; }
  <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span>(d &gt; <span class="hljs-number">21</span> || p &gt; d){ prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*<span class="hljs-number">1.9</span>); msg = <span class="hljs-string">`🎉 Победа! <span class="hljs-subst">${p}</span> против <span class="hljs-subst">${d}</span>. +\${prize}`</span>; }
  <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span>(p === d){ prize = g.<span class="hljs-property">bet</span>; msg = <span class="hljs-string">`🤝 Ничья — ставка возвращена`</span>; }
  <span class="hljs-keyword">else</span> { prize = <span class="hljs-number">0</span>; msg = <span class="hljs-string">`Ты <span class="hljs-subst">${p}</span>, дилер <span class="hljs-subst">${d}</span>. Проигрыш \${g.bet} 💸`</span>; }
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`🃏 Ты: <span class="hljs-subst">${p}</span> | Дилер: <span class="hljs-subst">${d}</span>&lt;br&gt;\${msg}`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"bj"</span>, prize);
}

<span class="hljs-comment">// --- Мины ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">minesStart</span>(<span class="hljs-params"></span>){
  g.<span class="hljs-property">bombs</span> = <span class="hljs-keyword">new</span> <span class="hljs-title class_">Set</span>();
  <span class="hljs-keyword">while</span>(g.<span class="hljs-property">bombs</span>.<span class="hljs-property">size</span> &lt; <span class="hljs-number">3</span>) g.<span class="hljs-property">bombs</span>.<span class="hljs-title function_">add</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">9</span>));
  g.<span class="hljs-property">opened</span> = <span class="hljs-keyword">new</span> <span class="hljs-title class_">Set</span>(); g.<span class="hljs-property">mult</span> = <span class="hljs-number">1.0</span>;
  <span class="hljs-title function_">minesRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">minesRender</span>(<span class="hljs-params">msg=<span class="hljs-string">""</span></span>){
  <span class="hljs-keyword">let</span> cells = <span class="hljs-string">""</span>;
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> i=<span class="hljs-number">0</span>;i&lt;<span class="hljs-number">9</span>;i++) cells += <span class="hljs-string">`&lt;button onclick="minesClick(<span class="hljs-subst">${i}</span>)"&gt;<span class="hljs-subst">${g.opened.has(i)?<span class="hljs-string">"💎"</span>:<span class="hljs-string">"⬛"</span>}</span>&lt;/button&gt;`</span>;
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;💣 Мины&lt;/h3&gt;
    &lt;p class="muted"&gt;Открыто <span class="hljs-subst">${g.opened.size}</span>/6 безопасных · множитель x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>&lt;/p&gt;
    &lt;div class="mfield"&gt;\${cells}&lt;/div&gt;
    <span class="hljs-subst">${msg?<span class="hljs-string">`&lt;div class="log"&gt;<span class="hljs-subst">${msg}</span>&lt;/div&gt;`</span>:<span class="hljs-string">""</span>}</span>
    &lt;div class="row"&gt;&lt;button class="btn green" onclick="minesCash()"&gt;💰 Забрать x\${g.mult.toFixed(2)}&lt;/button&gt;&lt;/div&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">minesClick</span>(<span class="hljs-params">i</span>){
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">bombs</span>.<span class="hljs-title function_">has</span>(i)){
    <span class="hljs-title function_">menu</span>(<span class="hljs-string">`💣 &lt;b&gt;БУМ!&lt;/b&gt; Проигрыш \${g.bet} 💸`</span>);
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"mines"</span>, <span class="hljs-number">0</span>); <span class="hljs-keyword">return</span>;
  }
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">opened</span>.<span class="hljs-title function_">has</span>(i)) <span class="hljs-keyword">return</span>;
  g.<span class="hljs-property">opened</span>.<span class="hljs-title function_">add</span>(i); g.<span class="hljs-property">mult</span> = +(g.<span class="hljs-property">mult</span>*<span class="hljs-number">1.35</span>).<span class="hljs-title function_">toFixed</span>(<span class="hljs-number">2</span>);
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">opened</span>.<span class="hljs-property">size</span> === <span class="hljs-number">6</span>){
    <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*g.<span class="hljs-property">mult</span>);
    <span class="hljs-title function_">menu</span>(<span class="hljs-string">`💎 Все безопасные клетки открыты! +\${prize}`</span>);
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"mines"</span>, prize); <span class="hljs-keyword">return</span>;
  }
  <span class="hljs-title function_">minesRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">minesCash</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">opened</span>.<span class="hljs-property">size</span> === <span class="hljs-number">0</span>){ <span class="hljs-title function_">toast</span>(<span class="hljs-string">"Открой хотя бы одну клетку"</span>); <span class="hljs-keyword">return</span>; }
  <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*g.<span class="hljs-property">mult</span>);
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`💰 Забрал x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>! +<span class="hljs-subst">${prize}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"mines"</span>, prize);
}

<span class="hljs-comment">// --- Краш (ИСПРАВЛЕНО) ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">crashStart</span>(<span class="hljs-params"></span>){
  g.<span class="hljs-property">point</span> = +(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">max</span>(<span class="hljs-number">1.01</span>, <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">min</span>(<span class="hljs-number">10</span>, <span class="hljs-number">0.95</span>/(<span class="hljs-number">1</span>-<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>())))).<span class="hljs-title function_">toFixed</span>(<span class="hljs-number">2</span>);
  g.<span class="hljs-property">mult</span> = <span class="hljs-number">1.0</span>;
  <span class="hljs-title function_">crashRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">crashRender</span>(<span class="hljs-params"></span>){
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;📈 Краш&lt;/h3&gt;
    &lt;p class="big" style="color:var(--accent)"&gt;x\${g.mult.toFixed(2)}&lt;/p&gt;
    &lt;p class="muted"&gt;Ставка \${g.bet}. Точка краша скрыта.&lt;/p&gt;
    &lt;div class="row"&gt;
      &lt;button class="btn" onclick="crashUp()"&gt;📈 Поднять&lt;/button&gt;
      &lt;button class="btn green" onclick="crashCash()"&gt;💰 Забрать&lt;/button&gt;
    &lt;/div&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">crashUp</span>(<span class="hljs-params"></span>){
  g.<span class="hljs-property">mult</span> = +(g.<span class="hljs-property">mult</span>*<span class="hljs-number">1.25</span>).<span class="hljs-title function_">toFixed</span>(<span class="hljs-number">2</span>);
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">mult</span> &gt;= g.<span class="hljs-property">point</span>){
    <span class="hljs-title function_">menu</span>(<span class="hljs-string">`💥 &lt;b&gt;КРАШ на x<span class="hljs-subst">${g.point.toFixed(<span class="hljs-number">2</span>)}</span>!&lt;/b&gt; Проигрыш <span class="hljs-subst">${g.bet}</span> 💸`</span>);
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"crash"</span>, <span class="hljs-number">0</span>); <span class="hljs-keyword">return</span>;
  }
  <span class="hljs-title function_">crashRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">crashCash</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*g.<span class="hljs-property">mult</span>);
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`💰 Забрал на x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>! +<span class="hljs-subst">${prize}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"crash"</span>, prize);
}

<span class="hljs-comment">// --- Орёл/Решка ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">flipUI</span>(<span class="hljs-params"></span>){
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🪙 Орёл или решка&lt;/h3&gt;
    &lt;div class="row"&gt;
      &lt;button class="btn" onclick="flipGo(0)"&gt;🦅 Орёл&lt;/button&gt;
      &lt;button class="btn green" onclick="flipGo(1)"&gt;🥇 Решка&lt;/button&gt;
    &lt;/div&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">flipGo</span>(<span class="hljs-params">choice</span>){
  <span class="hljs-keyword">const</span> res = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>() &lt; <span class="hljs-number">0.5</span> ? <span class="hljs-number">0</span> : <span class="hljs-number">1</span>;
  <span class="hljs-keyword">const</span> names = [<span class="hljs-string">"🦅 Орёл"</span>, <span class="hljs-string">"🥇 Решка"</span>];
  <span class="hljs-keyword">const</span> prize = choice === res ? <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*<span class="hljs-number">1.9</span>) : <span class="hljs-number">0</span>;
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`<span class="hljs-subst">${names[res]}</span>!&lt;br&gt;<span class="hljs-subst">${prize&gt;<span class="hljs-number">0</span> ? <span class="hljs-string">"🎉 +"</span>+prize : <span class="hljs-string">"💸 Проигрыш "</span>+g.bet}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"flip"</span>, prize);
}

<span class="hljs-comment">// --- Больше/Меньше ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">hlStart</span>(<span class="hljs-params"></span>){
  g.<span class="hljs-property">cur</span> = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">100</span>)+<span class="hljs-number">1</span>;
  g.<span class="hljs-property">mult</span> = <span class="hljs-number">1.0</span>;
  <span class="hljs-title function_">hlRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">hlRender</span>(<span class="hljs-params">msg=<span class="hljs-string">""</span></span>){
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;📊 Больше/Меньше&lt;/h3&gt;
    &lt;p class="big"&gt;Число: &lt;b&gt;\${g.cur}&lt;/b&gt;&lt;/p&gt;
    &lt;p class="muted"&gt;Множитель x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span> · ставка <span class="hljs-subst">${g.bet}</span>&lt;/p&gt;
    <span class="hljs-subst">${msg?<span class="hljs-string">`&lt;div class="log"&gt;<span class="hljs-subst">${msg}</span>&lt;/div&gt;`</span>:<span class="hljs-string">""</span>}</span>
    &lt;div class="row"&gt;
      &lt;button class="btn" onclick="hlGo(1)"&gt;⬆️ Больше&lt;/button&gt;
      &lt;button class="btn" onclick="hlGo(0)"&gt;⬇️ Меньше&lt;/button&gt;
      &lt;button class="btn green" onclick="hlCash()"&gt;💰 Забрать&lt;/button&gt;
    &lt;/div&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">hlGo</span>(<span class="hljs-params">up</span>){
  <span class="hljs-keyword">const</span> n = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">100</span>)+<span class="hljs-number">1</span>;
  <span class="hljs-keyword">const</span> ok = up ? n &gt; g.<span class="hljs-property">cur</span> : n &lt; g.<span class="hljs-property">cur</span>;
  <span class="hljs-keyword">if</span>(ok){
    g.<span class="hljs-property">mult</span> = +(g.<span class="hljs-property">mult</span>*<span class="hljs-number">1.9</span>).<span class="hljs-title function_">toFixed</span>(<span class="hljs-number">2</span>);
    g.<span class="hljs-property">cur</span> = n;
    <span class="hljs-title function_">hlRender</span>(<span class="hljs-string">`✅ Угадал! Следующее <span class="hljs-subst">${n}</span>. Множитель x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>`</span>);
  } <span class="hljs-keyword">else</span> {
    <span class="hljs-title function_">menu</span>(<span class="hljs-string">`❌ Число <span class="hljs-subst">${n}</span>. Проигрыш <span class="hljs-subst">${g.bet}</span> 💸`</span>);
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"hl"</span>, <span class="hljs-number">0</span>);
  }
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">hlCash</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">mult</span> === <span class="hljs-number">1.0</span>){ <span class="hljs-title function_">toast</span>(<span class="hljs-string">"Сначала сделай попытку"</span>); <span class="hljs-keyword">return</span>; }
  <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*g.<span class="hljs-property">mult</span>);
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`💰 Забрал x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>! +<span class="hljs-subst">${prize}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"hl"</span>, prize);
}

<span class="hljs-comment">// --- Карты ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">cardsUI</span>(<span class="hljs-params"></span>){
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🂠 Карты&lt;/h3&gt;
    &lt;div class="row"&gt;
      &lt;button class="btn red" onclick="cardsGo('red')"&gt;🔴 Красная&lt;/button&gt;
      &lt;button class="btn" onclick="cardsGo('black')"&gt;⚫ Чёрная&lt;/button&gt;
    &lt;/div&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">cardsGo</span>(<span class="hljs-params">choice</span>){
  <span class="hljs-keyword">const</span> res = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>() &lt; <span class="hljs-number">0.5</span> ? <span class="hljs-string">"red"</span> : <span class="hljs-string">"black"</span>;
  <span class="hljs-keyword">const</span> prize = choice === res ? <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*<span class="hljs-number">1.95</span>) : <span class="hljs-number">0</span>;
  <span class="hljs-keyword">const</span> laid = res === <span class="hljs-string">"red"</span> ? <span class="hljs-string">"🔴 Красная"</span> : <span class="hljs-string">"⚫ Чёрная"</span>;
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`Лежала: <span class="hljs-subst">${laid}</span>.&lt;br&gt;<span class="hljs-subst">${prize&gt;<span class="hljs-number">0</span> ? <span class="hljs-string">"🎉 +"</span>+prize : <span class="hljs-string">"💸 Проигрыш "</span>+g.bet}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"cards"</span>, prize);
}

<span class="hljs-comment">// --- Рулетка (ИСПРАВЛЕНО) ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">rouStart</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> vals = [[<span class="hljs-number">0.2</span>,<span class="hljs-number">30</span>],[<span class="hljs-number">0.5</span>,<span class="hljs-number">25</span>],[<span class="hljs-number">1</span>,<span class="hljs-number">20</span>],[<span class="hljs-number">1.2</span>,<span class="hljs-number">10</span>],[<span class="hljs-number">2</span>,<span class="hljs-number">8</span>],[<span class="hljs-number">3</span>,<span class="hljs-number">4</span>],[<span class="hljs-number">5</span>,<span class="hljs-number">2</span>],[<span class="hljs-number">10</span>,<span class="hljs-number">1</span>]];
  <span class="hljs-keyword">function</span> <span class="hljs-title function_">pick</span>(<span class="hljs-params"></span>){
    <span class="hljs-keyword">let</span> r = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">100</span>, t = <span class="hljs-number">0</span>;
    <span class="hljs-keyword">for</span>(<span class="hljs-keyword">const</span> [v,w] <span class="hljs-keyword">of</span> vals){ t += w; <span class="hljs-keyword">if</span>(r &lt;= t) <span class="hljs-keyword">return</span> v; }
    <span class="hljs-keyword">return</span> <span class="hljs-number">0.2</span>;
  }
  g.<span class="hljs-property">win</span> = <span class="hljs-title function_">pick</span>();
  g.<span class="hljs-property">strip</span> = ;
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> i=<span class="hljs-number">0</span>;i&lt;<span class="hljs-number">50</span>;i++) g.<span class="hljs-property">strip</span>.<span class="hljs-title function_">push</span>(<span class="hljs-title function_">pick</span>());
  <span class="hljs-keyword">const</span> <span class="hljs-variable constant_">FIX</span> = <span class="hljs-number">40</span>;
  g.<span class="hljs-property">strip</span>[<span class="hljs-variable constant_">FIX</span>] = g.<span class="hljs-property">win</span>;
  <span class="hljs-keyword">let</span> cells = <span class="hljs-string">""</span>;
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">let</span> i=<span class="hljs-number">0</span>;i&lt;g.<span class="hljs-property">strip</span>.<span class="hljs-property">length</span>;i++){
    <span class="hljs-keyword">const</span> v = g.<span class="hljs-property">strip</span>[i];
    <span class="hljs-keyword">const</span> cls = v&gt;=<span class="hljs-number">5</span>?<span class="hljs-string">"cell gold"</span>:v&gt;=<span class="hljs-number">2</span>?<span class="hljs-string">"cell green"</span>:v&gt;=<span class="hljs-number">1</span>?<span class="hljs-string">"cell blue"</span>:<span class="hljs-string">"cell dim"</span>;
    cells += <span class="hljs-string">`&lt;div class="<span class="hljs-subst">${cls}</span>"&gt;x<span class="hljs-subst">${v}</span>&lt;/div&gt;`</span>;
  }
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🎡 Рулетка&lt;/h3&gt;
    &lt;p class="muted"&gt;Лента множителей. Останови в нужный момент.&lt;/p&gt;
    &lt;div class="rou-wrap"&gt;
      &lt;div class="rou-mark"&gt;&lt;/div&gt;
      &lt;div class="rou-strip" style="transform:translateX(-<span class="hljs-subst">${FIX*<span class="hljs-number">62</span>}</span>px)"&gt;<span class="hljs-subst">${cells}</span>&lt;/div&gt;
    &lt;/div&gt;
    &lt;div class="row"&gt;
      &lt;button class="btn green" onclick="rouStop()"&gt;🛑 Стоп&lt;/button&gt;
      &lt;button class="btn red" onclick="rouReset()"&gt;🔄 Сброс&lt;/button&gt;
    &lt;/div&gt;`</span>);
  g.<span class="hljs-property">stopped</span> = <span class="hljs-literal">false</span>;
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">rouStop</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">stopped</span>) <span class="hljs-keyword">return</span>;
  g.<span class="hljs-property">stopped</span> = <span class="hljs-literal">true</span>;
  <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*g.<span class="hljs-property">win</span>);
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`🎡 Выпало x<span class="hljs-subst">${g.win}</span>! +<span class="hljs-subst">${prize}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"rou"</span>, prize);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">rouReset</span>(<span class="hljs-params"></span>){
  <span class="hljs-title function_">rouStart</span>();
}

<span class="hljs-comment">// --- Слоты ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">slotsStart</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> icons = [<span class="hljs-string">"🍒"</span>,<span class="hljs-string">"🍋"</span>,<span class="hljs-string">"🍇"</span>,<span class="hljs-string">"🍉"</span>,<span class="hljs-string">"💎"</span>,<span class="hljs-string">"7️⃣"</span>];
  g.<span class="hljs-property">reels</span> = [<span class="hljs-number">0</span>,<span class="hljs-number">0</span>,<span class="hljs-number">0</span>];
  g.<span class="hljs-property">spinning</span> = <span class="hljs-literal">false</span>;
  <span class="hljs-title function_">slotsRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">slotsRender</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> reels = g.<span class="hljs-property">reels</span>.<span class="hljs-title function_">map</span>(<span class="hljs-function"><span class="hljs-params">i</span>=&gt;</span><span class="hljs-string">`&lt;div class="reel"&gt;\${icons[i]}&lt;/div&gt;`</span>).<span class="hljs-title function_">join</span>(<span class="hljs-string">""</span>);
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🎰 Слоты&lt;/h3&gt;
    &lt;div class="reels"&gt;\${reels}&lt;/div&gt;
    &lt;div class="row"&gt;
      &lt;button class="btn" onclick="slotsSpin()" \${g.spinning?"disabled":""}&gt;🎰 Крутить&lt;/button&gt;
    &lt;/div&gt;`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">slotsSpin</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">spinning</span>) <span class="hljs-keyword">return</span>;
  g.<span class="hljs-property">spinning</span> = <span class="hljs-literal">true</span>;
  <span class="hljs-keyword">let</span> tick = <span class="hljs-number">0</span>;
  <span class="hljs-keyword">const</span> spin = <span class="hljs-built_in">setInterval</span>(<span class="hljs-function">()=&gt;</span>{
    g.<span class="hljs-property">reels</span> = g.<span class="hljs-property">reels</span>.<span class="hljs-title function_">map</span>(<span class="hljs-function"><span class="hljs-params">i</span>=&gt;</span><span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*icons.<span class="hljs-property">length</span>));
    <span class="hljs-title function_">slotsRender</span>();
    tick++;
    <span class="hljs-keyword">if</span>(tick &gt; <span class="hljs-number">15</span>){
      <span class="hljs-built_in">clearInterval</span>(spin);
      g.<span class="hljs-property">spinning</span> = <span class="hljs-literal">false</span>;
      <span class="hljs-keyword">let</span> prize = <span class="hljs-number">0</span>;
      <span class="hljs-keyword">if</span>(g.<span class="hljs-property">reels</span>===g.<span class="hljs-property">reels</span> &amp;&amp; g.<span class="hljs-property">reels</span>===g.<span class="hljs-property">reels</span>) prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*<span class="hljs-number">10</span>);
      <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span>(g.<span class="hljs-property">reels</span>===g.<span class="hljs-property">reels</span> || g.<span class="hljs-property">reels</span>===g.<span class="hljs-property">reels</span> || g.<span class="hljs-property">reels</span>===g.<span class="hljs-property">reels</span>) prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*<span class="hljs-number">1.5</span>);
      <span class="hljs-keyword">if</span>(prize &gt; <span class="hljs-number">0</span>) <span class="hljs-title function_">menu</span>(<span class="hljs-string">`🎰 ДЖЕКПОТ! +\${prize}`</span>);
      <span class="hljs-keyword">else</span> <span class="hljs-title function_">menu</span>(<span class="hljs-string">`🎰 Пусто. Проигрыш \${g.bet} 💸`</span>);
      <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"slots"</span>, prize);
    }
  }, <span class="hljs-number">100</span>);
}

<span class="hljs-comment">// --- Курица ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">chickenStart</span>(<span class="hljs-params"></span>){
  g.<span class="hljs-property">step</span> = <span class="hljs-number">0</span>;
  g.<span class="hljs-property">mult</span> = <span class="hljs-number">1.0</span>;
  <span class="hljs-title function_">chickenRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">chickenRender</span>(<span class="hljs-params">msg=<span class="hljs-string">""</span></span>){
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🐔 Курица-перебежчица&lt;/h3&gt;
    &lt;p class="muted"&gt;Шаг <span class="hljs-subst">${g.step}</span>/5. Множитель x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>&lt;/p&gt;
    &lt;div class="row"&gt;
      &lt;button class="btn" onclick="chickenGo()"&gt;🐔 Перейти&lt;/button&gt;
      &lt;button class="btn green" onclick="chickenCash()"&gt;💰 Забрать&lt;/button&gt;
    &lt;/div&gt;
    <span class="hljs-subst">${msg?<span class="hljs-string">`&lt;div class="log"&gt;<span class="hljs-subst">${msg}</span>&lt;/div&gt;`</span>:<span class="hljs-string">""</span>}</span>`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">chickenGo</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">if</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>() &lt; <span class="hljs-number">0.3</span>){
    <span class="hljs-title function_">menu</span>(<span class="hljs-string">`🐔 &lt;b&gt;Сбила машина!&lt;/b&gt; Проигрыш \${g.bet} 💸`</span>);
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"chicken"</span>, <span class="hljs-number">0</span>); <span class="hljs-keyword">return</span>;
  }
  g.<span class="hljs-property">step</span>++;
  g.<span class="hljs-property">mult</span> = +(g.<span class="hljs-property">mult</span>*<span class="hljs-number">1.3</span>).<span class="hljs-title function_">toFixed</span>(<span class="hljs-number">2</span>);
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">step</span> &gt;= <span class="hljs-number">5</span>){
    <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*g.<span class="hljs-property">mult</span>);
    <span class="hljs-title function_">menu</span>(<span class="hljs-string">`🐔 Перешла все полосы! +\${prize}`</span>);
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"chicken"</span>, prize); <span class="hljs-keyword">return</span>;
  }
  <span class="hljs-title function_">chickenRender</span>(<span class="hljs-string">`✅ Успешно!`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">chickenCash</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">mult</span> === <span class="hljs-number">1.0</span>){ <span class="hljs-title function_">toast</span>(<span class="hljs-string">"Сначала сделай шаг"</span>); <span class="hljs-keyword">return</span>; }
  <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*g.<span class="hljs-property">mult</span>);
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`💰 Забрал x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>! +<span class="hljs-subst">${prize}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"chicken"</span>, prize);
}

<span class="hljs-comment">// --- Дартс (ИСПРАВЛЕНО) ---</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">dartsStart</span>(<span class="hljs-params"></span>){
  g.<span class="hljs-property">mult</span> = <span class="hljs-number">1.0</span>;
  <span class="hljs-title function_">dartsRender</span>();
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">dartsRender</span>(<span class="hljs-params">msg=<span class="hljs-string">""</span></span>){
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🎯 Дартс&lt;/h3&gt;
    &lt;p class="muted"&gt;Бросок стоит ставку. Шансы на попадание низкие.&lt;/p&gt;
    &lt;div class="row"&gt;
      &lt;button class="btn" onclick="dartsGo()"&gt;🎯 Метнуть&lt;/button&gt;
      &lt;button class="btn green" onclick="dartsCash()"&gt;💰 Забрать&lt;/button&gt;
    &lt;/div&gt;
    <span class="hljs-subst">${msg?<span class="hljs-string">`&lt;div class="log"&gt;<span class="hljs-subst">${msg}</span>&lt;/div&gt;`</span>:<span class="hljs-string">""</span>}</span>`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">dartsGo</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> sectors = [
    [<span class="hljs-string">"Промах"</span>, <span class="hljs-number">70</span>, <span class="hljs-number">0</span>],[<span class="hljs-string">"Край мишени x1"</span>, <span class="hljs-number">12</span>, <span class="hljs-number">1</span>],[<span class="hljs-string">"Двойка x2"</span>, <span class="hljs-number">10</span>, <span class="hljs-number">2</span>],
    [<span class="hljs-string">"Красный x5"</span>, <span class="hljs-number">6</span>, <span class="hljs-number">5</span>],[<span class="hljs-string">"БЫК x10"</span>, <span class="hljs-number">2</span>, <span class="hljs-number">10</span>],
  ];
  <span class="hljs-keyword">let</span> r = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">100</span>, t = <span class="hljs-number">0</span>;
  <span class="hljs-keyword">let</span> res = sectors[sectors.<span class="hljs-property">length</span>-<span class="hljs-number">1</span>];
  <span class="hljs-keyword">for</span>(<span class="hljs-keyword">const</span> s <span class="hljs-keyword">of</span> sectors){ t += s; <span class="hljs-keyword">if</span>(r &lt;= t){ res = s; <span class="hljs-keyword">break</span>; } }
  <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*res);
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`🎯 <span class="hljs-subst">${res}</span>! +<span class="hljs-subst">${prize}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"darts"</span>, prize);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">dartsCash</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">if</span>(g.<span class="hljs-property">mult</span> === <span class="hljs-number">1.0</span>){ <span class="hljs-title function_">toast</span>(<span class="hljs-string">"Сначала метни дротик"</span>); <span class="hljs-keyword">return</span>; }
  <span class="hljs-keyword">const</span> prize = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*g.<span class="hljs-property">mult</span>);
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`💰 Забрал x<span class="hljs-subst">${g.mult.toFixed(<span class="hljs-number">2</span>)}</span>! +<span class="hljs-subst">${prize}</span>`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"darts"</span>, prize);
}

