   <span class="hljs-attr">items</span>:[[<span class="hljs-string">"40 монет"</span>,<span class="hljs-number">55</span>,<span class="hljs-number">40</span>],[<span class="hljs-string">"150 монет"</span>,<span class="hljs-number">35</span>,<span class="hljs-number">150</span>],[<span class="hljs-string">"ДЖЕКПОТ 1000"</span>,<span class="hljs-number">10</span>,<span class="hljs-number">1000</span>]]},
