hRequired\":false},{\"id\":\"memory\",\"type\":\"typed\",\"title\":\"Моя память\",\"media\":{\"image\":{\"light\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/memory-light-wide.webp\",\"dark\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/memory-dark-wide.webp\"}},\"action\":{\"type\":\"screen\",\"screen\":\"notes\",\"focusInput\":false},\"wide\":false,\"personalization\":false,\"authRequired\":true},{\"id\":\"folder\",\"type\":\"custom\",\"component\":\"folder\",\"wide\":false,\"personalization\":false,\"authRequired\":false}]}},\"expert-2widgets\":{\"widgets\":{\"touch\":[{\"id\":\"studio\",\"type\":\"custom\",\"component\":\"studio\",\"wide\":true,\"personalization\":true,\"authRequired\":false},{\"id\":\"folder\",\"type\":\"custom\",\"component\":\"folder\",\"wide\":false,\"personalization\":false}],\"desktop\":[{\"id\":\"studio\",\"type\":\"custom\",\"component\":\"studio\",\"wide\":false,\"personalization\":true,\"authRequired\":false},{\"id\":\"folder\",\"type\":\"custom\",\"component\":\"folder\",\"wide\":false,\"personalization\":false}]}},\"expert-prod-doodle\":{\"widgets\":{\"touch\":[{\"id\":\"studio\",\"type\":\"custom\",\"component\":\"studio\",\"wide\":true,\"personalization\":true,\"authRequired\":false},{\"id\":\"folder\",\"type\":\"custom\",\"component\":\"folder\",\"wide\":false,\"personalization\":false,\"authRequired\":false}]},\"doodles\":[{\"id\":\"alice_smart_model_doodle\",\"theme\":\"default\",\"accessibilityText\":\"Режим Эксперт — повышенный интеллект для сложных задач\",\"content\":[{\"type\":\"image\",\"source\":{\"light\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/smart-flash.webp\",\"dark\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/smart-flash.webp\"},\"styles\":{\"width\":32,\"height\":32,\"bottom\":\"2px\"}},{\"type\":\"specialCharacter\",\"value\":\"nonBreakingSpace\"},{\"type\":\"text\",\"value\":\"Режим Эксперт — повышенный \"},{\"type\":\"text\",\"value\":\"интеллект\"},{\"type\":\"specialCharacter\",\"value\":\"nonBreakingSpace\"},{\"type\":\"image\",\"source\":{\"light\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/smart-molecule.webp\",\"dark\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/smart-molecule.webp\"},\"styles\":{\"width\":32,\"height\":32,\"bottom\":\"2px\"}},{\"type\":\"text\",\"value\":\" для сложных задач\"},{\"type\":\"image\",\"source\":{\"light\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/tolstoy-doodle-pill-light-4x.webp\",\"dark\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/tolstoy-doodle-pill-dark-4x.webp\"},\"styles\":{\"width\":40,\"height\":26,\"bottom\":\"2px\"}}],\"action\":{\"type\":\"deeplink\",\"url\":\"/?model=alice-agents-expert\",\"focusInput\":true}}]},\"smart\":{\"suggests\":[{\"id\":\"apartment-tax-deduction\",\"text\":\"Объясни, что изменилось в правилах получения налогового вычета за квартиру. Проверь актуальные условия, приведи примеры расчёта\"},{\"id\":\"istanbul-four-days\",\"text\":\"Спланируй поездку в Стамбул на 4 дня в октябре. Бюджет — 120 тыс. руб. на двоих. Подбери район, отель, основные места, рестораны и удобный маршрут на каждый день\"},{\"id\":\"robot-vacuum-comparison\",\"text\":\"Подбери робот-пылесос до 40000 рублей с учетом ковров и кошки. Сравни по цене, качеству уборки, надёжности и стоимости расходников\"},{\"id\":\"butovo-mytishchi-comparison\",\"text\":\"Сравни Бутово и Мытищи для семьи: дорога до центра, школы, воздух и аренда\"},{\"id\":\"voykovskaya-schools\",\"text\":\"Сравни школы рядом с Войковской: результаты, кружки, отзывы и время в пути утром\"},{\"id\":\"hybrid-car-payback\",\"text\":\"Посчитай, окупится ли гибрид при моих маршрутах, расходе топлива и пробеге\"},{\"id\":\"university-admission-deadlines\",\"text\":\"Собери дедлайны пяти вузов и покажи, где этапы поступления пересекаются\"},{\"id\":\"contract-version-comparison\",\"text\":\"Сравни две версии договора и покажи, какие условия изменились не в мою пользу. Файлы прикреплю\"},{\"id\":\"expense-categories\",\"text\":\"Загружу таблицу с расходами. Раздели траты по категориям, найди, куда уходит больше всего денег\"},{\"id\":\"forgotten-subscriptions\",\"text\":\"По выписке банка найди забытые подписки и посчитай, сколько они стоят за год\"},{\"id\":\"vacation-pay-calculation\",\"text\":\"Вот расчётный лист за август, я был в отпуске десять дней. Посчитай, правильно ли начислили отпускные и почему на руки вышло меньше, чем в июле\"},{\"id\":\"school-laboratory-kit\",\"text\":\"Дочь в 8 классе переходит в химбио профиль. Собери лабораторный набор: халат, защитные очки поверх обычных очков, пара термостойких перчаток и блокнот в химически стойкой обложке. Бюджет 4000\"},{\"id\":\"laptop-refund-claim\",\"text\":\"Купила ноутбук, через две недели перестал включаться, магазин отказал. Приложу переписку и чек — составь претензию со ссылками на закон и сроком ответа\"},{\"id\":\"utility-bills-guide\",\"text\":\"Объясни маме по шагам, как оплатить жкх через приложение\"},{\"id\":\"family-saturday-plan\",\"text\":\"Хочется в субботу просто побыть вместе с ребёнком, ему 6 лет. Свободны с 10 до 20, на машине готовы ехать не больше 2 часов в одну сторону. Подскажи классный план на хорошую погоду, и запасной вариант, если пойдёт дождь\"},{\"id\":\"back-pain-doctor\",\"text\":\"Месяц болит поясница и отдает в правую ногу, работа сидячая, мази не помогают. К какому врачу с этим идти и про что еще важно сказать на приеме\"},{\"id\":\"darkened-front-tooth\",\"text\":\"Потемнел передний зуб после лечения каналов. Иду к стоматологу завтра - какие обычно предлагают варианты, из чего складывается цена и что уточнить, чтобы не переплатить\"},{\"id\":\"root-canal-insurance\",\"text\":\"Стоматолог сказал надо прочистить каналы, но в платной дорого. Это входит в ОМС и в чем разница? Разбери, что покрывает полис при лечении зуба и как записаться\"},{\"id\":\"treatment-education-tax-deductions\",\"text\":\"В этом году платила за лечение и за курсы ребёнка. Объясни, какие вычеты я могу получить за 2026 и что собрать, чтобы подать\"},{\"id\":\"sick-leave-payment\",\"text\":\"Болел четыре дня, два из них выходные. Посчитай, сколько должны оплатить при стаже 6 лет и зарплате 90 тысяч, и когда придут деньги\"},{\"id\":\"maternity-budget\",\"text\":\"Ухожу в декрет в ноябре, доход семьи снизится с 260 до 165 тысяч. До родов нужно купить всё для ребёнка и оставить подушку. Собери бюджет по месяцам до мая и покажи, где дефицит\"},{\"id\":\"car-ownership-comparison\",\"text\":\"Сравни две машины: первая новая за 2,4 миллиона, вторая трёхлетняя за 1,8. Езжу 18 тысяч километров в год. Посчитай владение на три года: топливо, ОСАГО, КАСКО, ТО и потерю стоимости\"},{\"id\":\"debt-repayment-plan\",\"text\":\"У меня общий долг 123 тысячи в трёх местах: в Сбере плачу 3600 в месяц, в Т-Банке 1200, в Яндекс Сплите 582. По Сплиту осталось 8275 рублей, ставка 58%, могу вносить ещё 3000 рублей в месяц. Предложи порядок погашения, четкий план\"},{\"id\":\"education-loan-transfer\",\"text\":\"Я оформил образовательный кредит, но в первый вуз не зачислили, зато прошёл в другой. Можно ли перевести кредит на новый вуз, в каком порядке действовать, чтобы банк не начислил лишние проценты или не отменил льготные условия?\"}],\"doodles\":[{\"id\":\"alice_smart_model_doodle\",\"theme\":\"default\",\"accessibilityText\":\"Режим Эксперт — повышенный интеллект для сложных задач\",\"content\":[{\"type\":\"image\",\"source\":{\"light\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/smart-flash.webp\",\"dark\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/smart-flash.webp\"},\"styles\":{\"width\":32,\"height\":32,\"bottom\":\"2px\"}},{\"type\":\"specialCharacter\",\"value\":\"nonBreakingSpace\"},{\"type\":\"text\",\"value\":\"Режим Эксперт — повышенный \"},{\"type\":\"text\",\"value\":\"интеллект\"},{\"type\":\"specialCharacter\",\"value\":\"nonBreakingSpace\"},{\"type\":\"image\",\"source\":{\"light\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/smart-molecule.webp\",\"dark\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/smart-molecule.webp\"},\"styles\":{\"width\":32,\"height\":32,\"bottom\":\"2px\"}},{\"type\":\"text\",\"value\":\" для сложных задач\"},{\"type\":\"image\",\"source\":{\"light\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/tolstoy-doodle-pill-light-4x.webp\",\"dark\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/tolstoy-doodle-pill-dark-4x.webp\"},\"styles\":{\"width\":40,\"height\":26,\"bottom\":\"2px\"}}],\"action\":{\"type\":\"deeplink\",\"url\":\"/?model=alice-agents-expert\",\"focusInput\":true}}]},\"bts2026\":{\"suggests\":[{\"id\":\"zero-power\",\"text\":\"Два в нулевой степени?\",\"deeplinkText\":\"Почему любое число в нулевой степени равно 1? Объясни просто и приведи 3 примера\"},{\"id\":\"compare-fractions\",\"text\":\"Как понять, какая дробь больше: 10/12 или 11/14?\",\"deeplinkText\":\"Как понять, какая дробь больше: 10/12 или 11/14? Объясни способ и покажи на примере\"},{\"id\":\"divide-by-zero\",\"text\":\"Почему нельзя делить на ноль?\",\"deeplinkText\":\"Почему нельзя делить на ноль? Объясни простыми словами и приведи пример\"},{\"id\":\"discriminant-negative\",\"text\":\"Что делать, если D < 0 в уравнении с параметром?\",\"deeplinkText\":\"Что делать, если в уравнении с параметром отрицательный дискриминант? Объясни на примере\"},{\"id\":\"zeros-in-factorial\",\"text\":\"Сколько нулей в 300 факториал?\",\"deeplinkText\":\"Сколько нулей в конце числа 300 факториал? Объясни, как это посчитать, по шагам\"},{\"id\":\"combination-vs-arrangement\",\"text\":\"Сочетание или размещение в теории вероятностей\",\"deeplinkText\":\"Чем отличается сочетание от размещения в теории вероятностей? Приведи пример\"},{\"id\":\"what-is-probability\",\"text\":\"Как найти вероятность события простыми словами?\",\"deeplinkText\":\"Как найти вероятность события простыми словами? Приведи понятный пример\"},{\"id\":\"negative-power\",\"text\":\"Что такое отрицательная степень и как её считать?\",\"deeplinkText\":\"Что такое отрицательная степень и как её считать? Объясни на примере\"},{\"id\":\"double-angle-formula\",\"text\":\"Какая формула двойного угла в тригонометрии?\",\"deeplinkText\":\"Какая формула двойного угла в тригонометрии? Объясни и приведи пример\"},{\"id\":\"function-domain\",\"text\":\"Что такое область определения функции?\",\"deeplinkText\":\"Что такое область определения функции? Объясни просто и на примере\"},{\"id\":\"root-ros-rast\",\"text\":\"Корень рос или раст?\",\"deeplinkText\":\"Как пишется корень рос/раст? Объясни правило и приведи 5 примеров слов\"},{\"id\":\"participle-phrase-commas\",\"text\":\"Когда причастный оборот обособляется запятыми?\",\"deeplinkText\":\"В каких случаях причастный оборот выделяется запятыми, а в каких нет?\"},{\"id\":\"determine-case\",\"text\":\"Как быстро определить падеж? Объясни на примерах\",\"deeplinkText\":\"Как быстро определить падеж существительного? Дай способ и 3 примера\"},{\"id\":\"gerund-phrase\",\"text\":\"Как обособлять деепричастный оборот? Объясни на примерах\",\"deeplinkText\":\"Что такое обособление деепричастного оборота? Объясни просто, с примерами\"},{\"id\":\"metaphor-vs-simile\",\"text\":\"Чем метафора отличается от сравнения? Покажи на примерах\",\"deeplinkText\":\"Чем метафора отличается от сравнения? Приведи по 2 примера каждого\"},{\"id\":\"russian-6-8-review\",\"text\":\"Как повторить русский с 6 по 8 класс за короткое время?\",\"deeplinkText\":\"Как самостоятельно повторить весь русский с 6 по 8 класс за короткое время?\"},{\"id\":\"generalizing-words\",\"text\":\"Что такое обобщающие слова? Объясни правило на примерах\",\"deeplinkText\":\"Что такое обобщающие слова в предложении? Объясни правило и приведи примеры\"},{\"id\":\"grammatical-base\",\"text\":\"Как найти грамматическую основу предложения? Покажи шаги\",\"deeplinkText\":\"Как определить грамматическую основу предложения? Объясни по шагам с примером\"},{\"id\":\"conjunction-vs-relative\",\"text\":\"Как отличить союз от союзного слова? Объясни на примерах\",\"deeplinkText\":\"Как отличить союз от союзного слова? Объясни просто и приведи 3 примера\"},{\"id\":\"periphrasis\",\"text\":\"Что такое перифраз? Чем он отличается от метафоры?\",\"deeplinkText\":\"Что такое перифраз? Приведи 3 примера и объясни, чем он отличается от метафоры\"},{\"id\":\"syntax-parsing\",\"text\":\"Как сделать синтаксический разбор предложения по шагам?\",\"deeplinkText\":\"Как сделать синтаксический разбор предложения? Объясни по шагам с примером\"}],\"doodles\":[{\"id\":\"alice_doodle_bts_2026\",\"theme\":\"default\",\"accessibilityText\":\"В учёбе я стала сильнее. Проверим?\",\"content\":[{\"type\":\"text\",\"value\":\"В учёбе\"},{\"type\":\"image\",\"source\":{\"light\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/EducationBts2026Doodle_60_x4.webp\",\"dark\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/EducationBts2026Doodle_60_x4.webp\"},\"styles\":{\"width\":60,\"height\":48,\"left\":\"3px\",\"bottom\":\"-1px\"}},{\"type\":\"text\",\"value\":\"я стала\"},{\"type\":\"specialCharacter\",\"value\":\"lineBreak\"},{\"type\":\"text\",\"value\":\"сильнее. Проверим?\"}]}]},\"tolstoy\":{\"doodles\":[{\"id\":\"alice_tolstoy_birthday_doodle\",\"theme\":\"default\",\"accessibilityText\":\"День рождения Льва Толстого\",\"content\":[{\"type\":\"image\",\"source\":{\"light\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/tolstoy-inline-avatar.webp\",\"dark\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/tolstoy-inline-avatar.webp\"},\"styles\":{\"width\":48,\"height\":38,\"left\":\"-4px\",\"bottom\":\"0px\"}},{\"type\":\"text\",\"value\":\"День рождения\"},{\"type\":\"specialCharacter\",\"value\":\"lineBreak\"},{\"type\":\"text\",\"value\":\"Льва Толстого\"},{\"type\":\"image\",\"source\":{\"light\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/tolstoy-doodle-pill-light-4x.webp\",\"dark\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/tolstoy-doodle-pill-dark-4x.webp\"},\"styles\":{\"width\":40,\"height\":26,\"left\":\"2px\",\"bottom\":\"50%\",\"transform\":\"translateY(50%)\"}}],\"action\":{\"type\":\"screen\",\"screen\":\"characters\"}}]},\"cherry\":{\"doodles\":[{\"id\":\"alice_cherry_settings_doodle\",\"theme\":\"default\",\"accessibilityText\":\"Настройте Дропс. Откройте все возможности наушников\",\"conditions\":{\"operator\":\"all\",\"conditions\":[{\"source\":\"context\",\"path\":[\"isMobile\"],\"operator\":\"equals\",\"value\":true},{\"source\":\"expFlag\",\"path\":[\"isEnableCherrySettingsDoodle\"],\"operator\":\"equals\",\"value\":true},{\"source\":\"cookie\",\"path\":[\"alice.satellitePairingStatus\"],\"operator\":\"equals\",\"value\":\"multidevices.types.cherry:done\"}]},\"content\":[{\"type\":\"text\",\"value\":\"Настройте Дропс\"},{\"type\":\"image\",\"source\":{\"light\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/CherrySettingsDoodle.webp\",\"dark\":\"https://yastatic.net/s3/web-alice-images/main-page-widgets/doodles/CherrySettingsDoodle.webp\"},\"styles\":{\"width\":60,\"height\":48}},{\"type\":\"specialCharacter\",\"value\":\"lineBreak\"},{\"type\":\"text\",\"value\":\"Откройте все возможности наушников\"}]}]},\"alice_main_page_personal_name\":{\"greetings\":[{\"key\":\"main.greeting.lets_start\",\"title\":\"Привет,\",\"description\":\"Давайте начнём!\"},{\"key\":\"main.greeting.welcome_back\",\"title\":\"Привет,\",\"description\":\"С возвращением!\"},{\"key\":\"main.greeting.looking_for_ideas\",\"title\":\"Привет,\",\"description\":\"Ищете идеи?\"},{\"key\":\"main.greeting.what_to_talk\",\"title\":\"Привет,\",\"description\":\"О чём поговорим?\"},{\"key\":\"main.greeting.hello_help\",\"title\":\"Привет,\",\"description\":\"Чем помочь сегодня?\"},{\"key\":\"main.greeting.which_idea\",\"title\":\"Привет,\",\"description\":\"Какую идею обсудим?\"},{\"key\":\"main.greeting.where_to_start\",\"title\":\"Привет,\",\"description\":\"С чего начнём?\"},{\"key\":\"main.greeting.how_is_day\",\"title\":\"Привет,\",\"description\":\"Как проходит день?\"},{\"key\":\"main.greeting.how_can_help\",\"title\":\"Привет,\",\"description\":\"Чем могу помочь?\"}]},\"exp\":{\"suggests\":[{\"id\":\"plants-window-light\",\"text\":\"Подбери растение на подоконник\",\"deeplinkText\":\"Подбери растения для моего подоконника. Задай мне 3 коротких вопроса с вариантами ответа: на какую сторону выходит окно, сколько там света зимой, сколько времени я готов тратить на уход. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом дай 3–4 варианта: почему подходит именно мне, что купить на старте, план ухода на первый месяц.\"},{\"id\":\"rewrite-email-convincing\",\"text\":\"Сделай письмо убедительнее\",\"deeplinkText\":\"Помоги переписать письмо так, чтобы на него ответили. Спроси, кому оно и какого действия я жду, и попроси прислать текст. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом дай переписанный вариант, разбери по пунктам, что было не так, и предложи две версии — мягче и жёстче.\"},{\"id\":\"sneakers-budget\",\"text\":\"Подбери кроссовки под бюджет\",\"deeplinkText\":\"Помоги выбрать кроссовки. Задай мне 3 коротких вопроса с вариантами ответа: бюджет, для чего (бег, зал, город), что носил раньше и что не понравилось. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом предложи 3 модели с актуальными ценами, объясни, чем они отличаются, и скажи, на чём здесь не стоит экономить.\"},{\"id\":\"new-skill-30-days\",\"text\":\"Научи навыку за 30 дней\",\"deeplinkText\":\"Собери план освоения навыка за 30 дней. Задай 3 коротких вопроса с вариантами ответа: какой навык, сколько часов в неделю есть, какой уровень сейчас. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом дай план по неделям: что делать, на чём проверять прогресс, где обычно бросают и как это обойти.\"},{\"id\":\"posture-week-plan\",\"text\":\"План упражнений для осанки\",\"deeplinkText\":\"Составь недельный план упражнений для осанки. Задай 3 коротких вопроса с вариантами ответа: сколько я сижу в день, есть ли боли или ограничения, сколько минут готов уделять. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом дай план по дням с описанием техники и признаками, что я делаю упражнение неправильно.\"},{\"id\":\"dinner-from-fridge\",\"text\":\"Собери ужин из того, что есть\",\"deeplinkText\":\"Придумай ужин из того, что у меня есть. Спроси, что в холодильнике, на сколько человек готовим и сколько есть времени. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом предложи 2–3 варианта с пошаговым рецептом и скажи, чем заменить продукты, которых не хватает.\"},{\"id\":\"unpack-my-day\",\"text\":\"Разбери мой день по полкам\",\"deeplinkText\":\"Помоги разобрать мой день. Спроси, как он прошёл и что сейчас больше всего занимает голову. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом разложи услышанное: что получилось, что забирает энергию, что можно снять с себя завтра — и задай один вопрос, который поможет копнуть глубже.\"},{\"id\":\"whats-new-my-topic\",\"text\":\"Собери новости по моей теме\",\"deeplinkText\":\"Расскажи, что нового по интересной мне теме. Спроси, какая тема и за какой период, предложив на выбор направления: технологии, наука, культура, моя индустрия. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом дай 3–5 свежих событий с датами и источниками, объясни, почему каждое важно, и предложи, во что углубиться.\"},{\"id\":\"explain-simply\",\"text\":\"Объясни сложное на пальцах\",\"deeplinkText\":\"Объясни мне сложную тему простыми словами. Спроси, что именно объяснить и на каком я уровне: новичок, что-то слышал, разбираюсь. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом объясни через аналогию из обычной жизни, отдельно разбери, где эта аналогия перестаёт работать, и проверь меня одним вопросом.\"},{\"id\":\"movie-for-my-taste\",\"text\":\"Подбери кино по вкусу\",\"deeplinkText\":\"Подбери, что посмотреть вечером. Задай 3 коротких вопроса с вариантами ответа: что понравилось из последнего, сколько есть времени, какое настроение. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом предложи 3 варианта с указанием, где смотреть, объясни, почему выбрал именно их под мой вкус, и добавь один неочевидный.\"},{\"id\":\"hobby-for-schedule\",\"text\":\"Подбери хобби под мой график\",\"deeplinkText\":\"Подбери мне хобби под мой образ жизни. Задай 3 коротких вопроса с вариантами ответа: сколько свободного времени и как оно распределено, бюджет, что уже пробовал и бросил. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом дай 3–4 варианта: почему ложится на мой график, что нужно на старте, первое конкретное действие на ближайшие выходные.\"},{\"id\":\"book-i-wont-drop\",\"text\":\"Помоги выбрать книгу\",\"deeplinkText\":\"Помоги выбрать книгу, которую я дочитаю. Спроси, что зашло, что бросил на середине и сколько времени на чтение в день. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом предложи 3 книги, для каждой — почему она под меня, чего ждать на первых 30 страницах и в каком случае лучше не начинать.\"},{\"id\":\"argue-without-fighting\",\"text\":\"Как спорить и не ссориться\",\"deeplinkText\":\"Научи меня спорить, не сваливаясь в конфликт. Спроси, с кем и о чём я чаще всего спорю и чем обычно всё заканчивается. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом разбери мою ситуацию: что запускает эскалацию, какие фразы работают вместо привычных — с конкретными формулировками — и что делать, когда уже завелись.\"},{\"id\":\"why-i-procrastinate\",\"text\":\"Разбери мою прокрастинацию\",\"deeplinkText\":\"Помоги понять, почему я откладываю. Спроси, какое дело откладываю дольше всего и что чувствую, когда собираюсь за него взяться. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом назови вероятную причину именно в моём случае, объясни механику и дай одно действие на ближайший час — не общий совет.\"},{\"id\":\"say-no-without-guilt\",\"text\":\"Как сказать нет без вины\",\"deeplinkText\":\"Помоги научиться отказывать. Спроси, кому тяжелее всего сказать нет и какая ситуация сейчас на повестке. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом дай 2–3 готовые формулировки под мой случай — от мягкой до твёрдой, разбери, что делать, если начнут давить, и объясни, откуда берётся чувство вины.\"},{\"id\":\"which-is-cheaper\",\"text\":\"Посчитай, что мне выгоднее\",\"deeplinkText\":\"Помоги посчитать, какой вариант выгоднее. Спроси, что сравниваем, и попроси нужные цифры; если каких-то данных не хватает, прямо скажи каких. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Потом посчитай по шагам, покажи формулу, назови точку, в которой выгода переворачивается, и что осталось за рамками расчёта. Если я не назову срок — считай точку безубыточности, не переспрашивай.\"},{\"id\":\"postcard-with-text\",\"text\":\"Сделай открытку с текстом\",\"deeplinkText\":\"Сделай открытку с надписью. Задай 3 коротких вопроса с вариантами ответа: какой текст, для кого и по какому поводу, в каком стиле. Остановись после вопросов и дождись моего ответа — рекомендаций в этом сообщении не давай. Пот