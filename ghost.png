  <span class="hljs-keyword">if</span>(c.<span class="hljs-property">img</span>){
    <span class="hljs-keyword">return</span> <span class="hljs-string">`&lt;img class="case-img" src="<span class="hljs-subst">${c.img}</span>" alt=""
      onerror="this.style.display='none';this.parentNode.querySelector('.case-fb').style.display='flex';"/&gt;
      &lt;div class="case-fb" style="display:none"&gt;<span class="hljs-subst">${c.emoji}</span>&lt;/div&gt;`</span>;
  }
  <span class="hljs-keyword">return</span> <span class="hljs-string">`&lt;div class="case-fb"&gt;<span class="hljs-subst">${c.emoji}</span>&lt;/div&gt;`</span>;
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">renderCases</span>(<span class="hljs-params"></span>){
  <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"cases-list"</span>).<span class="hljs-property">innerHTML</span> = cases.<span class="hljs-title function_">map</span>(<span class="hljs-function">(<span class="hljs-params">c,i</span>)=&gt;</span><span class="hljs-string">`
    &lt;div class="card" id="case-<span class="hljs-subst">${i}</span>"&gt;
      <span class="hljs-subst">${caseVisual(c)}</span>
      &lt;h3&gt;<span class="hljs-subst">${c.name}</span>&lt;/h3&gt;&lt;p class="price"&gt;<span class="hljs-subst">${c.price}</span> монет&lt;/p&gt;
      &lt;p class="muted"&gt;Шансы: <span class="hljs-subst">${c.items.map(it=&gt;it[<span class="hljs-number">0</span>]+<span class="hljs-string">" "</span>+it[<span class="hljs-number">1</span>]+<span class="hljs-string">"%"</span>).join(<span class="hljs-string">", "</span>)}</span>&lt;/p&gt;
      &lt;p class="muted"&gt;Подарки: <span class="hljs-subst">${c.gifts.map(gt=&gt;gt[<span class="hljs-number">0</span>]).join(<span class="hljs-string">", "</span>)}</span>&lt;/p&gt;
      &lt;button class="btn" onclick="buyCase(<span class="hljs-subst">${i}</span>)"&gt;Открыть&lt;/button&gt;
    &lt;/div&gt;`</span>).<span class="hljs-title function_">join</span>(<span class="hljs-string">""</span>);
}
</code></pre></div></div></pre>
<p><strong class="FuturisMarkdown-Strong">Г. Функцию <code class="CodeInlined">buyCase</code> замени целиком</strong> (внутри — выбор подарка и его отправка боту):</p>
<pre class="FuturisMarkdown-Pre"><div data-testid="codeblock" class="CodeBlock CodeBlock_overflow_visible CodeBlock_highlight"><div class="CodeBlock-StickyWrapper"><div class="CodeBlock-Header" data-testid="codeblock-header"><div class="CodeBlock-HeaderTitle" data-testid="codeblock-language">javascript</div><div class="CodeBlock-HeaderActions"><button type="button" class="Button Button_view_blankPrimary Button_size_m CodeBlock-HeaderAction CodeBlock-HeaderAction_text" autocomplete="off" data-testid="codeblock-action-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M12.187 7.35c2.489 0 3.878 2.875 2.33 4.825a2.977 2.977 0 0 1-2.33 1.126H11.16l.781.722-.441.478-.441.476-2.479-2.292 2.444-2.627.476.443.476.442-.984 1.058h1.194c.511 0 .995-.234 1.313-.634.844-1.063.136-2.616-1.183-2.713l-.13-.004H1v-1.3h11.187ZM7 13.3H1v-1.299h6v1.3Zm8-9.299H1V2.699h14v1.302Z"></path></svg><span class="Button-Text">Переносить</span></button><button type="button" class="Button Button_view_blankPrimary Button_size_m CodeBlock-HeaderAction CodeBlock-HeaderAction_text" autocomplete="off" data-testid="codeblock-action-collapse"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M7.15 15h-1.3v-3.93l-3.54 3.54-.92-.92 3.54-3.54H1v-1.3h6.15V15Zm3-10.07 3.74-3.74.46.46.46.46-3.74 3.74H15v1.3H8.85V1h1.3v3.93Z"></path></svg><span class="Button-Text">Свернуть</span></button><button type="button" class="Button Button_view_blankPrimary Button_size_m CodeBlock-HeaderAction CodeBlock-HeaderAction_text" autocomplete="off" data-testid="codeblock-action-copy"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M10.4.5c1.963 0 2.946 0 3.667.442a3 3 0 0 1 .99.99c.443.722.443 1.704.443 3.668v.8l-.007 1.301c-.02 1.139-.104 1.826-.435 2.367l-.097.149c-.236.338-.54.625-.894.842l-.138.078c-.52.267-1.186.338-2.229.357l-.206.001v.205c-.022 1.139-.105 1.826-.436 2.367a2.999 2.999 0 0 1-.99.99c-.542.332-1.23.415-2.368.436l-1.3.007h-.8c-1.841 0-2.82 0-3.529-.364l-.138-.078a2.999 2.999 0 0 1-.894-.842l-.097-.149C.611 13.527.528 12.84.507 11.7L.5 10.4v-.8c0-1.841 0-2.82.364-3.529l.078-.138a3 3 0 0 1 .842-.894l.149-.097c.572-.35 1.31-.422 2.572-.437.014-1.163.075-1.88.36-2.434l.077-.138a3 3 0 0 1 .842-.894l.149-.097C6.654.5 7.636.5 9.6.5h.8zM5.6 5.8c-1.007 0-1.672.002-2.177.05-.486.046-.69.126-.812.2a1.7 1.7 0 0 0-.56.561c-.075.122-.155.326-.201.812-.048.505-.05 1.17-.05 2.177v.8c0 1.007.002 1.672.05 2.177.046.486.126.69.2.812.14.228.333.42.561.56.122.075.326.155.812.201.505.048 1.17.05 2.177.05h.8c1.007 0 1.672-.002 2.177-.05.486-.046.69-.126.812-.2a1.7 1.7 0 0 0 .56-.561c.075-.122.155-.326.201-.812.048-.505.05-1.17.05-2.177v-.8c0-1.007-.002-1.672-.05-2.177-.046-.486-.126-.69-.2-.812a1.7 1.7 0 0 0-.561-.56c-.122-.075-.326-.155-.812-.201-.505-.048-1.17-.05-2.177-.05h-.8zm4-4c-1.007 0-1.672.002-2.177.05-.486.046-.69.126-.812.2a1.7 1.7 0 0 0-.56.561c-.075.122-.155.326-.201.812-.028.293-.039.64-.044 1.077H6.4l1.3.007c1.139.02 1.826.104 2.367.435.404.248.743.587.99.99.443.722.443 1.704.443 3.668v.592a13.38 13.38 0 0 0 1.076-.04c.486-.047.69-.127.812-.202a1.71 1.71 0 0 0 .561-.561c.075-.122.155-.326.201-.812.048-.505.05-1.17.05-2.177v-.8c0-1.007-.002-1.672-.05-2.177-.046-.486-.126-.69-.2-.812a1.7 1.7 0 0 0-.562-.56c-.122-.075-.326-.155-.812-.201-.505-.048-1.17-.05-2.177-.05h-.8z"></path></svg><span class="Button-Text">Копировать</span></button></div></div><div class="CodeBlock-Stopper"></div></div><div class="CodeBlock-Content" data-testid="codeblock-content"><pre class="CodeBlock-ContentPre" data-testid="codeblock-code"><code class="hljs language-javascript"><span class="hljs-keyword">function</span> <span class="hljs-title function_">buyCase</span>(<span class="hljs-params">i</span>){
  <span class="hljs-keyword">const</span> c = cases[i];
  <span class="hljs-keyword">if</span>(stats.<span class="hljs-property">balance</span> &lt; c.<span class="hljs-property">price</span>){ <span class="hljs-title function_">toast</span>(<span class="hljs-string">`Не хватает монет: нужно <span class="hljs-subst">${c.price}</span>, у тебя <span class="hljs-subst">${stats.balance}</span>`</span>); <span class="hljs-keyword">return</span>; }
  stats.<span class="hljs-property">balance</span> -= c.<span class="hljs-property">price</span>;
  stats.<span class="hljs-property">opened</span>++;
  <span class="hljs-title function_">save</span>(); <span class="hljs-title function_">renderBal</span>();
  <span class="hljs-keyword">const</span> card = <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">"case-"</span>+i);
  card.<span class="hljs-title function_">querySelector</span>(<span class="hljs-string">"button"</span>).<span class="hljs-property">disabled</span> = <span class="hljs-literal">true</span>;
  card.<span class="hljs-title function_">querySelector</span>(<span class="hljs-string">".price"</span>).<span class="hljs-property">textContent</span> = <span class="hljs-string">"открываем…"</span>;
  <span class="hljs-keyword">let</span> tick = <span class="hljs-number">0</span>;
  <span class="hljs-keyword">const</span> spin = <span class="hljs-built_in">setInterval</span>(<span class="hljs-function">()=&gt;</span>{
    <span class="hljs-keyword">const</span> it = c.<span class="hljs-property">items</span>[<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*c.<span class="hljs-property">items</span>.<span class="hljs-property">length</span>)];
    card.<span class="hljs-title function_">querySelector</span>(<span class="hljs-string">".price"</span>).<span class="hljs-property">textContent</span> = it[<span class="hljs-number">0</span>] + (it[<span class="hljs-number">0</span>].<span class="hljs-title function_">includes</span>(<span class="hljs-string">"ДЖЕКПОТ"</span>) ? <span class="hljs-string">" ✨"</span> : <span class="hljs-string">" …"</span>);
    tick++;
    <span class="hljs-keyword">if</span>(tick &gt; <span class="hljs-number">12</span>){
      <span class="hljs-built_in">clearInterval</span>(spin);
      <span class="hljs-keyword">const</span> item = <span class="hljs-title function_">pickCase</span>(c);
      <span class="hljs-keyword">let</span> giftDrop = <span class="hljs-literal">null</span>;
      <span class="hljs-keyword">let</span> r = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">100</span>, gt = <span class="hljs-number">0</span>;
      <span class="hljs-keyword">for</span>(<span class="hljs-keyword">const</span> gft <span class="hljs-keyword">of</span> c.<span class="hljs-property">gifts</span>){ gt += gft[<span class="hljs-number">1</span>]; <span class="hljs-keyword">if</span>(r &lt;= gt){ giftDrop = gft[<span class="hljs-number">0</span>]; <span class="hljs-keyword">break</span>; } }
      <span class="hljs-keyword">if</span>(giftDrop) stats.<span class="hljs-property">gifts</span>[giftDrop] = (stats.<span class="hljs-property">gifts</span>[giftDrop] || <span class="hljs-number">0</span>) + <span class="hljs-number">1</span>;
      stats.<span class="hljs-property">balance</span> += item[<span class="hljs-number">2</span>];
      <span class="hljs-keyword">if</span>(item[<span class="hljs-number">2</span>] &gt; c.<span class="hljs-property">price</span>) stats.<span class="hljs-property">wins</span>++;
      <span class="hljs-title function_">save</span>(); <span class="hljs-title function_">renderBal</span>(); <span class="hljs-keyword">if</span>(giftDrop) <span class="hljs-title function_">renderGifts</span>();
      <span class="hljs-keyword">const</span> jackpot = item[<span class="hljs-number">0</span>].<span class="hljs-title function_">includes</span>(<span class="hljs-string">"ДЖЕКПОТ"</span>);
      <span class="hljs-keyword">const</span> giftLine = giftDrop ? <span class="hljs-string">`&lt;p&gt;🎁 Подарок: &lt;b&gt;<span class="hljs-subst">${giftDrop}</span>&lt;/b&gt;&lt;/p&gt;`</span> : <span class="hljs-string">""</span>;
      card.<span class="hljs-property">innerHTML</span> = <span class="hljs-string">`&lt;h3&gt;<span class="hljs-subst">${c.name}</span>&lt;/h3&gt;
        <span class="hljs-subst">${giftLine}</span>
        &lt;p&gt;<span class="hljs-subst">${jackpot?<span class="hljs-string">"🎊 &lt;span class='jack'&gt;"</span>:<span class="hljs-string">"🎉 &lt;span class='win'&gt;"</span>}</span><span class="hljs-subst">${item[<span class="hljs-number">0</span>]}</span>&lt;/span&gt;&lt;/p&gt;
        &lt;p class="muted"&gt;−<span class="hljs-subst">${c.price}</span> за кейс · +<span class="hljs-subst">${item[<span class="hljs-number">2</span>]}</span> приз · баланс <span class="hljs-subst">${stats.balance}</span> 💰&lt;/p&gt;
        &lt;button class="btn" onclick="renderCases()"&gt;Открыть ещё&lt;/button&gt;`</span>;
      <span class="hljs-title function_">send</span>({<span class="hljs-attr">action</span>:<span class="hljs-string">"settle"</span>, <span class="hljs-attr">game</span>:<span class="hljs-string">"case"</span>, <span class="hljs-attr">bet</span>:c.<span class="hljs-property">price</span>, <span class="hljs-attr">net</span>:item[<span class="hljs-number">2</span>]-c.<span class="hljs-property">price</span>, <span class="hljs-attr">gift</span>:giftDrop});
    }
  }, <span class="hljs-number">100</span>);
}
</code></pre></div></div></pre>
<p><strong class="FuturisMarkdown-Strong">Д. Новый раздел «Подарки».</strong> В блоке <code class="CodeInlined">&lt;div class="nav"&gt;</code> после кнопки «Игры» вставь:</p>
<pre class="FuturisMarkdown-Pre"><div data-testid="codeblock" class="CodeBlock CodeBlock_overflow_visible CodeBlock_highlight"><div class="CodeBlock-StickyWrapper"><div class="CodeBlock-Header" data-testid="codeblock-header"><div class="CodeBlock-HeaderTitle" data-testid="codeblock-language">html</div><div class="CodeBlock-HeaderActions"><button type="button" class="Button Button_view_blankPrimary Button_size_m CodeBlock-HeaderAction CodeBlock-HeaderAction_text" autocomplete="off" data-testid="codeblock-action-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M12.187 7.35c2.489 0 3.878 2.875 2.33 4.825a2.977 2.977 0 0 1-2.33 1.126H11.16l.781.722-.441.478-.441.476-2.479-2.292 2.444-2.627.476.443.476.442-.984 1.058h1.194c.511 0 .995-.234 1.313-.634.844-1.063.136-2.616-1.183-2.713l-.13-.004H1v-1.3h11.187ZM7 13.3H1v-1.299h6v1.3Zm8-9.299H1V2.699h14v1.302Z"></path></svg><span class="Button-Text">Переносить</span></button><button type="button" class="Button Button_view_blankPrimary Button_size_m CodeBlock-HeaderAction CodeBlock-HeaderAction_text" autocomplete="off" data-testid="codeblock-action-collapse"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M7.15 15h-1.3v-3.93l-3.54 3.54-.92-.92 3.54-3.54H1v-1.3h6.15V15Zm3-10.07 3.74-3.74.46.46.46.46-3.74 3.74H15v1.3H8.85V1h1.3v3.93Z"></path></svg><span class="Button-Text">Свернуть</span></button><button type="button" class="Button Button_view_blankPrimary Button_size_m CodeBlock-HeaderAction CodeBlock-HeaderAction_text" autocomplete="off" data-testid="codeblock-action-copy"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M10.4.5c1.963 0 2.946 0 3.667.442a3 3 0 0 1 .99.99c.443.722.443 1.704.443 3.668v.8l-.007 1.301c-.02 1.139-.104 1.826-.435 2.367l-.097.149c-.236.338-.54.625-.894.842l-.138.078c-.52.267-1.186.338-2.229.357l-.206.001v.205