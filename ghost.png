   <span class="hljs-attr">items</span>:[[<span class="hljs-string">"20 монет"</span>,<span class="hljs-number">60</span>,<span class="hljs-number">20</span>],[<span class="hljs-string">"60 монет"</span>,<span class="hljs-number">30</span>,<span class="hljs-number">60</span>],[<span class="hljs-string">"ДЖЕКПОТ 500"</span>,<span class="hljs-number">10</span>,<span class="hljs-number">500</span>]]},
