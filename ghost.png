"wide":false,"title":"Плагины","subtitle":"Для задач в сервисах","pluginId":"f907283b-1324-45d6-8057-617283940a1b","allPluginsLabel":"все","i18n":{"title":"supernova.4c1f918e-355d-4e60-95a5-c7dd0e22fb8d.02d7fc867b8db7a5","subtitle":"supernova.4c1f918e-355d-4e60-95a5-c7dd0e22fb8d.c3c4173d32d0c935"}},{"id":"jeeves-mail-b2c-all-plugins","type":"custom","component":"plugins","surfaces":["mail-b2c"],"wide":false,"title":"Плагины","subtitle":"Для задач в сервисах","i18n":{"title":"supernova.4c1f918e-355d-4e60-95a5-c7dd0e22fb8d.992df254ce453076","subtitle":"supernova.4c1f918e-355d-4e60-95a5-c7dd0e22fb8d.a5937017449c0904"}},{"id":"jeeves-mail-b2c-plugin-mail","type":"custom","component":"plugin","surfaces":["mail-b2c"],"wide":false,"title":"Плагины","subtitle":"Для задач в сервисах","pluginId":"f907283b-1324-45d6-8057-617283940a1b","allPluginsLabel":"все","i18n":{"title":"supernova.4c1f918e-355d-4e60-95a5-c7dd0e22fb8d.ff808fb32d728ce3","subtitle":"supernova.4c1f918e-355d-4e60-95a5-c7dd0e22fb8d.475cd2fef0af4a7f"}}]}}},"main-suggests":{"variants":{"default":{"suggests":[{"id":"check-used-car","text":"Что проверить при покупке машины с рук?","deeplinkText":"Хотим купить подержанную машину с рук. Распиши, что проверить при осмотре и тест-драйве, какие документы посмотреть, как проверить историю авто и в каких случаях лучше сразу отказаться от покупки.","i18n":{"text":"supernova.85606e3b-c4cf-45b4-b88e-aef98d53fe92.c1851e71f19b522b","deeplinkText":"supernova.85606e3b-c4cf-45b4-b88e-aef98d53fe92.2450ee7ead30c971"}},{"id":"save-on-fuel","text":"Как тратить меньше на бензин?","deeplinkText":"Хочу тратить меньше на бензин, проезжаю около 1500 км в месяц, расход 9 литров на сотню, литр стоит 60 рублей. Дай 10 привычек за рулём и в обслуживании, которые снижают расход, и посчитай, сколько я трачу сейчас и сколько сэкономлю, если расход упадёт на 5 и на 10%.","i18n":{"text":"supernova.85606e3b-c4cf-45b4-b88e-aef98d53fe92.4cde36345ecc558e","deeplinkText":"supernova.85606e3b-c4cf-45b4-b88e-aef98d53fe92.8ae273ee6e3a6694"}}],"updatedAt":""}}},"main-greetings":{"variants":{"default":{"phrases":[{"key":"technical-phrase","title":"Привет!","description":"Чем помочь сегодня?","i18n":{"title":"supernova.d995174f-e1fd-4f6c-a67c-07d1abc70790.0ac5ca19bb9d9e1b","description":"supernova.d995174f-e1fd-4f6c-a67c-07d1abc70790.73e7b314efa96ddf"}}],"updatedAt":""},"alice_main_page_personal_name":{"phrases":[{"key":"main.greeting.lets_start","title":"Привет,","description":"Давайте начнём!","i18n":{"title":"supernova.d995174f-e1fd-4f6c-a67c-07d1abc70790.4445bce7231c04f9","description":"supernova.d995174f-e1fd-4f6c-a67c-07d1abc70790.968bd7a24b8ff539"}},{"key":"main.greeting.welcome_back","title":"Привет,","description":"С возвращением!","i18n":{"title":"supernova.d995174f-e1fd-4f6c-a67c-07d1abc70790.bc5bf80397fb606a","description":"supernova.d995174f-e1fd-4f6c-a67c-07d1abc70790.7071f995393af2e6"}},{"key":"main.greeting.looking_for_ideas","title":"Привет,","description":"Ищете идеи?","i18n":{"title":"supernova.d995174f-e1fd-4f6c-a67c-07d1abc70790.2ea9e5a2df22e573","description":"supernova.d995174f-e1fd-4f6c-a67c-07d1abc70790.4100f89d460ff617"}},{"key":"main.greeting.what_to_talk","title":"Привет,","description":"О чём поговорим?","i18n":{"title":"supernova.d995174f-e1fd-4f6c-a67c-07d1abc70790.a25303d3c985558c","description":"supernova.d995174f-e1fd-4f6c-a67c-07d1abc70790.c935ba136f2324fc"}},{"key":"main.greeting.hello_help","title":"Привет,","description":"Чем помочь сегодня?","i18n":{"title":"supernova.d995174f-e1fd-4f6c-a67c-07d1abc70790.0e4e665d215f597d","description":"supernova.d995174f-e1fd-4f6c-a67c-07d1abc70790.b63770c0776c5a35"}},{"key":"main.greeting.which_idea","title":"Привет,","description":"Какую идею обсудим?","i18n":{"title":"supernova.d995174f-e1fd-4f6c-a67c-07d1abc70790.69729c5e30a369ee","description":"supernova.d995174f-e1fd-4f6c-a67c-07d1abc70790.33964444049b9a62"}},{"key":"main.greeting.where_to_start","title":"Привет,","description":"С чего начнём