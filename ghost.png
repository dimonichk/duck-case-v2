### 1. `index.html` — замени на GitHub целиком (этот файл рабочий)

```html
&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;ru&quot;&gt;
&lt;head&gt;
&lt;meta charset=&quot;UTF-8&quot;/&gt;
&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no&quot;/&gt;
&lt;title&gt;Duck Case&lt;/title&gt;
&lt;script src=&quot;https://telegram.org/js/telegram-web-app.js&quot;&gt;&lt;/script&gt;
&lt;style&gt;
:root{--bg:#0f0f13;--card:#1b1b22;--primary:#6c5ce7;--accent:#00d1a0;--danger:#ef4444;--text:#fff;--sec:#9a9aa8;--border:#2a2a33;}
{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
body{background:var(--bg);color:var(--text);font-family:-apple-system,'Segoe UI',Roboto,sans-serif;height:100vh;display:flex;flex-direction:column;overflow:hidden;}
.header{padding:14px 16px;display:flex;align-items:center;justify-content:space-between;background:var(--card);border-bottom:1px solid var(--border);}
.header h1{font-size:17px;}
.balance{display:flex;align-items:center;gap:6px;font-weight:700;font-size:16px;}
.coin{width:14px;height:14px;border-radius:50%;background:linear-gradient(135deg,#ffd66b,#f5a623);}
.content{flex:1;overflow-y:auto;padding:16px;padding-bottom:80px;}
.tab{display:none;}
.tab.active{display:block;}
.card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:14px;margin-bottom:12px;}
.card h3{margin-bottom:6px;}
.price{color:var(--accent);font-weight:700;}
.btn{display:block;width:100%;padding:11px;border:none;border-radius:10px;background:var(--primary);color:#fff;font-weight:700;font-size:14px;cursor:pointer;margin-top:10px;}
.btn.green{background:var(--accent);color:#04241c;}
.btn.red{background:var(--danger);}
.btn.small{width:auto;padding:8px 16px;margin:6px 4px 0 0;}
.row{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;}
.row .btn{margin-top:0;}
input.inp{width:100%;padding:10px;border:1px solid var(--border);border-radius:10px;background:#12121a;color:#fff;font-size:14px;margin-top:10px;}
.muted{color:var(--sec);font-size:13px;}
.log{margin-top:10px;padding:10px;border-radius:10px;background:#12121a;font-size:14px;}
.jack{color:#ffd66b;font-weight:800;}
.win{color:var(--accent);font-weight:800;}
.nav{position:fixed;bottom:0;left:0;right:0;display:flex;background:var(--card);border-top:1px solid var(--border);padding:6px 0 12px;}
.nav button{flex:1;background:none;border:none;color:var(--sec);font-size:11px;padding:6px 0;cursor:pointer;}
.nav button span{display:block;font-size:18px;margin-bottom:3px;}
.nav button.active{color:var(--primary);font-weight:700;}
.mfield{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px;}
.mfield button{height:52px;font-size:20px;border:none;border-radius:10px;background:#12121a;color:#fff;cursor:pointer;}
.rou-wrap{position:relative;overflow:hidden;border-radius:10px;background:#12121a;margin-top:10px;height:56px;}
.rou-mark{position:absolute;left:50%;top:0;bottom:0;width:2px;background:var(--accent);z-index:2;transform:translateX(-50%);}
.rou-strip{display:flex;gap:2px;padding-left:100px;transition:transform 3s cubic-bezier(.1,.7,.2,1);}
.cell{flex:0 0 60px;height:56px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;border-radius:6px;}
.cell.gold{background:#f5a623;color:#241a02;}
.cell.green{background:#00b894;color:#04241c;}
.cell.blue{background:#3b4a8c;}
.cell.dim{background:#2a2a33;color:#777;}
.reels{display:flex;gap:8px;justify-content:center;margin-top:12px;}
.reel{flex:1;max-width:80px;height:70px;background:#12121a;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:32px;}
.big{text-align:center;font-size:24px;font-weight:800;margin-top:10px;}
&lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;div class=&quot;header&quot;&gt;
  &lt;h1&gt;Duck Case&lt;/h1&gt;
  &lt;div class=&quot;balance&quot;&gt;&lt;div class=&quot;coin&quot;&gt;&lt;/div&gt;&lt;span id=&quot;balance&quot;&gt;0&lt;/span&gt;&lt;/div&gt;
&lt;/div&gt;
&lt;div class=&quot;content&quot;&gt;

  &lt;div class=&quot;tab active&quot; id=&quot;tab-cases&quot;&gt;
    &lt;div id=&quot;cases-list&quot;&gt;&lt;/div&gt;
  &lt;/div&gt;

  &lt;div class=&quot;tab&quot; id=&quot;tab-games&quot;&gt;
    &lt;div id=&quot;games-list&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;card&quot; id=&quot;game-area&quot; style=&quot;display:none&quot;&gt;
      &lt;div id=&quot;game-body&quot;&gt;&lt;/div&gt;
      &lt;button class=&quot;btn small&quot; onclick=&quot;backToMenu()&quot;&gt;← К играм&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;

  &lt;div class=&quot;tab&quot; id=&quot;tab-profile&quot;&gt;
    &lt;div class=&quot;card&quot;&gt;
      &lt;h3&gt;👤 Профиль&lt;/h3&gt;
      &lt;p&gt;Баланс: &lt;b id=&quot;p-balance&quot;&gt;0&lt;/b&gt; монет&lt;/p&gt;
      &lt;p&gt;Кейсов открыто: &lt;b id=&quot;p-opened&quot;&gt;0&lt;/b&gt;&lt;/p&gt;
      &lt;p&gt;Побед в играх: &lt;b id=&quot;p-wins&quot;&gt;0&lt;/b&gt;&lt;/p&gt;
    &lt;/div&gt;
    &lt;div class=&quot;card&quot;&gt;
      &lt;h3&gt;🛠 Админ&lt;/h3&gt;
      &lt;p class=&quot;muted&quot;&gt;Начисление — командами в чате бота:&lt;br&gt;
      &lt;b&gt;/add 1000&lt;/b&gt; — себе&lt;br&gt;
      &lt;b&gt;/gift @username 500&lt;/b&gt; — игроку&lt;br&gt;
      &lt;b&gt;/profile&lt;/b&gt; — точный баланс&lt;/p&gt;
    &lt;/div&gt;
  &lt;/div&gt;

  &lt;div class=&quot;tab&quot; id=&quot;tab-support&quot;&gt;
    &lt;div class=&quot;card&quot;&gt;
      &lt;h3&gt;💬 Поддержка&lt;/h3&gt;
      &lt;p&gt;Проблемы с балансом, кейсом или игрой? Напиши нам — ответим быстро.&lt;/p&gt;
      &lt;button class=&quot;btn&quot; onclick=&quot;goSupport()&quot;&gt;Написать в поддержку&lt;/button&gt;
      &lt;p class=&quot;muted&quot; style=&quot;margin-top:10px&quot;&gt;Или прямо в Telegram: @tsartixc&lt;/p&gt;
    &lt;/div&gt;
  &lt;/div&gt;

&lt;/div&gt;
&lt;div class=&quot;nav&quot;&gt;
  &lt;button data-tab=&quot;cases&quot; class=&quot;active&quot;&gt;&lt;span&gt;🎁&lt;/span&gt;Кейсы&lt;/button&gt;
  &lt;button data-tab=&quot;games&quot;&gt;&lt;span&gt;🎮&lt;/span&gt;Игры&lt;/button&gt;
  &lt;button data-tab=&quot;profile&quot;&gt;&lt;span&gt;👤&lt;/span&gt;Профиль&lt;/button&gt;
  &lt;button data-tab=&quot;support&quot;&gt;&lt;span&gt;💬&lt;/span&gt;Поддержка&lt;/button&gt;
&lt;/div&gt;

&lt;script&gt;
const tg = window.Telegram.WebApp;
tg.ready(); tg.expand();

const START_BALANCE = 300;
let stats = JSON.parse(localStorage.getItem(&quot;duck_stats&quot;) || &quot;null&quot;)
  || {balance: START_BALANCE, opened: 0, wins: 0};

const q = new URLSearchParams(location.search);
if (q.has(&quot;b&quot;)) { const b = parseInt(q.get(&quot;b&quot;)); if (!isNaN(b)) stats.balance = b; }

function save(){ localStorage.setItem(&quot;duck_stats&quot;, JSON.stringify(stats)); }
function renderBal(){
  document.getElementById(&quot;balance&quot;).textContent = stats.balance;
  document.getElementById(&quot;p-balance&quot;).textContent = stats.balance;
  document.getElementById(&quot;p-opened&quot;).textContent = stats.opened;
  document.getElementById(&quot;p-wins&quot;).textContent = stats.wins;
}
function send(data){ try{ tg.sendData(JSON.stringify(data)); }catch(e){} }
function toast(text){ tg.showAlert ? tg.showAlert(text) : alert(text); }

function show(tab){
  document.querySelectorAll('.tab').forEach(t=&gt;t.classList.remove('active'));
  document.getElementById('tab-'+tab).classList.add('active');
  document.querySelectorAll('.nav button').forEach(b=&gt;b.classList.toggle('active',b.dataset.tab===tab));
}
document.querySelectorAll('.nav button').forEach(b=&gt;b.onclick=()=&gt;show(b.dataset.tab));

// ---------- КЕЙСЫ (шансы ужесточены, возврат ~90%) ----------
const cases = [
  {key:&quot;lucky&quot;,  name:&quot;🍀 Lucky Case&quot;,  price:50,
   items:[[&quot;15 монет&quot;,60,15],[&quot;40 монет&quot;,30,40],[&quot;ДЖЕКПОТ 250&quot;,10,250]]},
  {key:&quot;duck&quot;,   name:&quot;🦆 Duck Case&quot;,   price:100,
   items:[[&quot;30 монет&quot;,55,30],[&quot;100 монет&quot;,35,100],[&quot;ДЖЕКПОТ 400&quot;,10,400]]},
  {key:&quot;golden&quot;, name:&quot;👑 Golden Case&quot;, price:300,
   items:[[&quot;80 монет&quot;,55,80],[&quot;300 монет&quot;,35,300],[&quot;ДЖЕКПОТ 1200&quot;,10,1200]]},
  {key:&quot;ruby&quot;,   name:&quot;💎 Ruby Case&quot;,   price:700,
   items:[[&quot;220 монет&quot;,55,220],[&quot;700 монет&quot;,35,700],[&quot;ДЖЕКПОТ 2800&quot;,10,2800]]},
  {key:&quot;ghost&quot;,  name:&quot;👻 Ghost Case&quot;,  price:1500,
   items:[[&quot;450 монет&quot;,55,450],[&quot;1600 монет&quot;,35,1600],[&quot;ДЖЕКПОТ 6000&quot;,10,6000]]},
  {key:&quot;dragon&quot;, name:&quot;🐲 Dragon Case&quot;, price:3000,
   items:[[&quot;900 монет&quot;,55,900],[&quot;3200 монет&quot;,35,3200],[&quot;ДЖЕКПОТ 12000&quot;,10,12000]]},
];
function renderCases(){
  document.getElementById(&quot;cases-list&quot;).innerHTML = cases.map((c,i)=&gt;`
    &lt;div class=&quot;card&quot; id=&quot;case-${i}&quot;&gt;
      &lt;h3&gt;${c.name}&lt;/h3&gt;&lt;p class=&quot;price&quot;&gt;${c.price} монет&lt;/p&gt;
      &lt;p class=&quot;muted&quot;&gt;Шансы: ${c.items.map(it=&gt;it[0]+&quot; &quot;+it[1]+&quot;%&quot;).join(&quot;, &quot;)}&lt;/p&gt;
      &lt;button class=&quot;btn&quot; onclick=&quot;buyCase(${i})&quot;&gt;Открыть&lt;/button&gt;
    &lt;/div&gt;`).join(&quot;&quot;);
}
function pickCase(c){
  let r = Math.random()100, t = 0;
  for(const it of c.items){ t += it[1]; if(r &lt;= t) return it; }
  return c.items[c.items.length-1];
}
function buyCase(i){
  const c = cases[i];
  if(stats.balance &lt; c.price){ toast(`Не хватает монет: нужно ${c.price}, у тебя ${stats.balance}`); return; }
  stats.balance -= c.price;
  stats.opened++;
  save(); renderBal();
  const card = document.getElementById(&quot;case-&quot;+i);
  card.querySelector(&quot;button&quot;).disabled = true;
  card.querySelector(&quot;.price&quot;).textContent = &quot;открываем…&quot;;
  let tick = 0;
  const spin = setInterval(()=&gt;{
    const it = c.items[Math.floor(Math.random()c.items.length)];
    card.querySelector(&quot;.price&quot;).textContent = it[0] + (it[0].includes(&quot;ДЖЕКПОТ&quot;) ? &quot; ✨&quot; : &quot; …&quot;);
    tick++;
    if(tick &gt; 12){
      clearInterval(spin);
      const item = pickCase(c);
      stats.balance += item[2];
      if(item[2] &gt; c.price) stats.wins++;
      save(); renderBal();
      const jackpot = item[0].includes(&quot;ДЖЕКПОТ&quot;);
      card.innerHTML = `&lt;h3&gt;${c.name}&lt;/h3&gt;
        &lt;p&gt;${jackpot?&quot;🎊 &lt;span class='jack'&gt;&quot;:&quot;🎉 &lt;span class='win'&gt;&quot;}${item[0]}&lt;/span&gt;&lt;/p&gt;
        &lt;p class=&quot;muted&quot;&gt;−${c.price} за кейс · +${item[2]} приз · баланс ${stats.balance} 💰&lt;/p&gt;
        &lt;button class=&quot;btn&quot; onclick=&quot;renderCases()&quot;&gt;Открыть ещё&lt;/button&gt;`;
      send({action:&quot;settle&quot;, game:&quot;case&quot;, bet:c.price, net:item[2]-c.price});
    }
  }, 100);
}

// ---------- ИГРЫ (в столбик) ----------
const games = [
  {key:&quot;bj&quot;,      name:&quot;🃏 Блэкджек&quot;,             desc:&quot;Набери 21 или больше дилера. Блэкджек x2.5, победа x1.9.&quot;},
  {key:&quot;mines&quot;,   name:&quot;💣 Мины&quot;,                desc:&quot;Поле 3×3, 3 мины. Каждый безопасный клик +35%.&quot;},
  {key:&quot;crash&quot;,   name:&quot;📈 Краш&quot;,                desc:&quot;Множитель растёт по +25%. Забирай до краша.&quot;},
  {key:&quot;flip&quot;,    name:&quot;🪙 Орёл/Решка&quot;,          desc:&quot;Угадай сторону монеты — x1.9.&quot;},
  {key:&quot;hl&quot;,      name:&quot;📊 Больше/Меньше&quot;,        desc:&quot;Следующее число больше или меньше? x1.9 за попытку.&quot;},
  {key:&quot;cards&quot;,   name:&quot;🂠 Карты&quot;,               desc:&quot;Угадай цвет карты — x1.95.&quot;},
  {key:&quot;rou&quot;,     name:&quot;🎡 Рулетка&quot;,             desc:&quot;Лента множителей от x0.2 до x10.&quot;},
  {key:&quot;slots&quot;,   name:&quot;🎰 Слоты&quot;,               desc:&quot;Три в ряд — до x10. Пара — x1.5.&quot;},
  {key:&quot;chicken&quot;, name:&quot;🐔 Курица-перебежчица&quot;,   desc:&quot;Веди курицу через дорогу: +30% за шаг.&quot;},
  {key:&quot;darts&quot;,   name:&quot;🎯 Дартс&quot;,               desc:&quot;Один бросок. Шансы жёсткие: промах 70%.&quot;},
  {key:&quot;dice&quot;,    name:&quot;🎲 Кубики&quot;,              desc:&quot;Два кубика против бота. Больше сумма — x1.9.&quot;},
  {key:&quot;cups&quot;,    name:&quot;🥤 Стаканчики&quot;,          desc:&quot;Под каким стаканом монета? Угадал — x2.7.&quot;},
];
function renderGames(){
  document.getElementById(&quot;games-list&quot;).innerHTML = games.map(gm=&gt;`
    &lt;div class=&quot;card&quot;&gt;
      &lt;h3&gt;${gm.name}&lt;/h3&gt;
      &lt;p class=&quot;muted&quot;&gt;${gm.desc}&lt;/p&gt;
      &lt;button class=&quot;btn&quot; onclick=&quot;startGame('${gm.key}')&quot;&gt;Играть&lt;/button&gt;
    &lt;/div&gt;`).join(&quot;&quot;);
}
let g = null;
function startGame(type){
  g = {type};
  document.getElementById(&quot;games-list&quot;).style.display=&quot;none&quot;;
  document.getElementById(&quot;game-area&quot;).style.display=&quot;block&quot;;
  const meta = games.find(x=&gt;x.key===type);
  menu(`&lt;h3&gt;${meta.name}&lt;/h3&gt;&lt;p class=&quot;muted&quot;&gt;${meta.desc}&lt;/p&gt;`);
  askBet();
}
function menu(html){ document.getElementById(&quot;game-body&quot;).innerHTML = html; }
function backToMenu(){
  g = null;
  document.getElementById(&quot;games-list&quot;).style.display=&quot;block&quot;;
  document.getElementById(&quot;game-area&quot;).style.display=&quot;none&quot;;
}
function askBet(){
  const prev = document.getElementById(&quot;game-body&quot;).innerHTML;
  menu(prev + `
    &lt;input class=&quot;inp&quot; id=&quot;bet&quot; type=&quot;number&quot; placeholder=&quot;Ставка (от 10)&quot;/&gt;
    &lt;button class=&quot;btn&quot; onclick=&quot;placeBet()&quot;&gt;Поставить&lt;/button&gt;`);
}
function placeBet(){
  const a = parseInt(document.getElementById(&quot;bet&quot;).value);
  if(isNaN(a) || a &lt; 10){ toast(&quot;Ставка от 10 монет&quot;); return; }
  if(stats.balance &lt; a){ toast(&quot;Не хватает монет&quot;); return; }
  stats.balance -= a; save(); renderBal();
  g.bet = a;
  const start = {
    bj:bjDeal, mines:minesStart, crash:crashStart, flip:flipUI,
    hl:hlStart, cards:cardsUI, rou:rouStart, slots:slotsStart,
    chicken:chickenStart, darts:dartsStart, dice:diceStart, cups:cupsStart
  };
  start[g.type]();
}
function endGame(game, prize){
  const bet = g.bet || 0;
  stats.balance += prize;
  if(prize &gt; bet) stats.wins++;
  save(); renderBal();
  send({action:&quot;settle&quot;, game, bet, net: prize - bet});
}

// --- Блэкджек ---
function bjDeal(){
  const deck = [];
  for(let v=2; v&lt;=10; v++) for(let s=0;s&lt;4;s++) deck.push(v);
  for(let s=0;s&lt;12;s++) deck.push(10);
  for(let s=0;s&lt;4;s++)  deck.push(11);
  for(let i=deck.length-1;i&gt;0;i--){ const j=Math.floor(Math.random()(i+1)); const tmp=deck[i]; deck[i]=deck[j]; deck[j]=tmp; }
  g.deck = deck;
  g.player = [deck.pop(), deck.pop()];
  g.dealer = [deck.pop(), deck.pop()];
  bjRender();
}
function bjVal(hand){
  let total = hand.reduce((a,b)=&gt;a+b,0);
  let aces = hand.filter(x=&gt;x===11).length;
  while(total &gt; 21 &amp;&amp; aces &gt; 0){ total -= 10; aces--; }
  return total;
}
function bjRender(msg){
  msg = msg || &quot;&quot;;
  menu(`&lt;h3&gt;🃏 Блэкджек&lt;/h3&gt;
    &lt;p&gt;Твои карты: &lt;b&gt;${g.player.join(&quot;, &quot;)}&lt;/b&gt; (сумма &lt;b&gt;${bjVal(g.player)}&lt;/b&gt;)&lt;/p&gt;
    &lt;p class=&quot;muted&quot;&gt;Дилер: 🂠 ${g.dealer[0]}, скрытая&lt;/p&gt;
    ${msg?`&lt;div class=&quot;log&quot;&gt;${msg}&lt;/div&gt;`:&quot;&quot;}
    &lt;div class=&quot;row&quot;&gt;
      &lt;button class=&quot;btn&quot; onclick=&quot;bjHit()&quot;&gt;🖐 Взять&lt;/button&gt;
      &lt;button class=&quot;btn green&quot; onclick=&quot;bjStand()&quot;&gt;✋ Хватит&lt;/button&gt;
    &lt;/div&gt;`);
}
function bjHit(){
  g.player.push(g.deck.pop());
  if(bjVal(g.player) &gt; 21){
    menu(`🃏 Перебор ${bjVal(g.player)}. Проигрыш ${g.bet} 💸`);
    endGame(&quot;bj&quot;, 0); return;
  }
  bjRender();
}
function bjStand(){
  while(bjVal(g.dealer) &lt; 17) g.dealer.push(g.deck.pop());
  const p = bjVal(g.player), d = bjVal(g.dealer);
  const isBJ = p === 21 &amp;&amp; g.player.length === 2;
  let prize, msg;
  if(p &gt; 21){ prize = 0; msg = `Ты ${p}, дилер ${d}. Проигрыш ${g.bet} 💸`; }
  else if(isBJ &amp;&amp; d !== 21){ prize = Math.floor(g.bet2.5); msg = `🃏 БЛЭКДЖЕК! +${prize}`; }
  else if(d &gt; 21 || p &gt; d){ prize = Math.floor(g.bet1.9); msg = `🎉 Победа! ${p} против ${d}. +${prize}`; }
  else if(p === d){ prize = g.bet; msg = `🤝 Ничья — ставка возвращена`; }
  else { prize = 0; msg = `Ты ${p}, дилер ${d}. Проигрыш ${g.bet} 💸`; }
  menu(`🃏 Ты: ${p} | Дилер: ${d}&lt;br&gt;${msg}`);
  endGame(&quot;bj&quot;, prize);
}

// --- Мины ---
function minesStart(){
  g.bombs = new Set();
  while(g.bombs.size &lt; 3) g.bombs.add(Math.floor(Math.random()9));
  g.opened = new Set(); g.mult = 1.0;
  minesRender();
}
function minesRender(msg){
  msg = msg || &quot;&quot;;
  let cells = &quot;&quot;;
  for(let i=0;i&lt;9;i++) cells += `&lt;button onclick=&quot;minesClick(${i})&quot;&gt;${g.opened.has(i)?&quot;💎&quot;:&quot;⬛&quot;}&lt;/button&gt;`;
  menu(`&lt;h3&gt;💣 Мины&lt;/h3&gt;
    &lt;p class=&quot;muted&quot;&gt;Открыто ${g.opened.size}/6 безопасных · множитель x${g.mult.toFixed(2)}&lt;/p&gt;
    &lt;div class=&quot;mfield&quot;&gt;${cells}&lt;/div&gt;
    ${msg?`&lt;div class=&quot;log&quot;&gt;${msg}&lt;/div&gt;`:&quot;&quot;}
    &lt;div class=&quot;row&quot;&gt;&lt;button class=&quot;btn green&quot; onclick=&quot;minesCash()&quot;&gt;💰 Забрать x${g.mult.toFixed(2)}&lt;/button&gt;&lt;/div&gt;`);
}
function minesClick(i){
  if(g.bombs.has(i)){
    menu(`💣 &lt;b&gt;БУМ!&lt;/b&gt; Проигрыш ${g.bet} 💸`);
    endGame(&quot;mines&quot;, 0); return;
  }
  if(g.opened.has(i)) return;
  g.opened.add(i);
  g.mult = +(g.mult1.35).toFixed(2);
  if(g.opened.size === 6){
    const prize = Math.floor(g.betg.mult);
    menu(`💎 Все безопасные клетки открыты! +${prize}`);
    endGame(&quot;mines&quot;, prize); return;
  }
  minesRender();
}
function minesCash(){
  if(g.opened.size === 0){ toast(&quot;Открой хотя бы одну клетку&quot;); return; }
  const prize = Math.floor(g.betg.mult);
  menu(`💰 Забрал x${g.mult.toFixed(2)}! +${prize}`);
  endGame(&quot;mines&quot;, prize);
}

// --- Краш (шанс ужесточён) ---
function crashStart(){
  g.point = +(Math.max(1.01, Math.min(10, 0.95/(1-Math.random())))).toFixed(2);
  g.mult = 1.0;
  crashRender();
}
function crashRender(){
  menu(`&lt;h3&gt;📈 Краш&lt;/h3&gt;
    &lt;p class=&quot;big&quot; style=&quot;color:var(--accent)&quot;&gt;x${g.mult.toFixed(2)}&lt;/p&gt;
    &lt;p class=&quot;muted&quot;&gt;Ставка ${g.bet}. Точка краша скрыта.&lt;/p&gt;
    &lt;div class=&quot;row&quot;&gt;
      &lt;button class=&quot;btn&quot; onclick=&quot;crashUp()&quot;&gt;📈 Поднять&lt;/button&gt;
      &lt;button class=&quot;btn green&quot; onclick=&quot;crashCash()&quot;&gt;💰 Забрать&lt;/button&gt;
    &lt;/div&gt;`);
}
function crashUp(){
  g.mult = +(g.mult1.25).toFixed(2);
  if(g.mult &gt;= g.point){
    menu(`💥 &lt;b&gt;КРАШ на x${g.point.toFixed(2)}!&lt;/b&gt; Проигрыш ${g.bet} 💸`);
    endGame(&quot;crash&quot;, 0); return;
  }
  crashRender();
}
function crashCash(){
  const prize = Math.floor(g.betg.mult);
  menu(`💰 Забрал на x${g.mult.toFixed(2)}! +${prize}`);
  endGame(&quot;crash&quot;, prize);
}

// --- Орёл/Решка ---
function flipUI(){
  menu(`&lt;h3&gt;🪙 Орёл или решка&lt;/h3&gt;
    &lt;div class=&quot;row&quot;&gt;
      &lt;button class=&quot;btn&quot; onclick=&quot;flipGo(0)&quot;&gt;🦅 Орёл&lt;/button&gt;
      &lt;button class=&quot;btn green&quot; onclick=&quot;flipGo(1)&quot;&gt;🥇 Решка&lt;/button&gt;
    &lt;/div&gt;`);
}
function flipGo(choice){
  const res = Math.random() &lt; 0.5 ? 0 : 1;
  const names = [&quot;🦅 Орёл&quot;, &quot;🥇 Решка&quot;];
  const prize = choice === res ? Math.floor(g.bet1.9) : 0;
  menu(`${names[res]}!&lt;br&gt;${prize&gt;0 ? &quot;🎉 +&quot;+prize : &quot;💸 Проигрыш &quot;+g.bet}`);
  endGame(&quot;flip&quot;, prize);
}

// --- Больше/Меньше ---
function hlStart(){
  g.cur = Math.floor(Math.random()100)+1;
  g.mult = 1.0;
  hlRender();
}
function hlRender(msg){
  msg = msg || &quot;&quot;;
  menu(`&lt;h3&gt;📊 Больше/Меньше&lt;/h3&gt;
    &lt;p class=&quot;big&quot;&gt;Число: &lt;b&gt;${g.cur}&lt;/b&gt;&lt;/p&gt;
    &lt;p class=&quot;muted&quot;&gt;Множитель x${g.mult.toFixed(2)} · ставка ${g.bet}&lt;/p&gt;
    ${msg?`&lt;div class=&quot;log&quot;&gt;${msg}&lt;/div&gt;`:&quot;&quot;}
    &lt;div class=&quot;row&quot;&gt;
      &lt;button class=&quot;btn&quot; onclick=&quot;hlGo(1)&quot;&gt;⬆️ Больше&lt;/button&gt;
      &lt;button class=&quot;btn&quot; onclick=&quot;hlGo(0)&quot;&gt;⬇️ Меньше&lt;/button&gt;
      &lt;button class=&quot;btn green&quot; onclick=&quot;hlCash()&quot;&gt;💰 Забрать&lt;/button&gt;
    &lt;/div&gt;`);
}
function hlGo(up){
  const n = Math.floor(Math.random()100)+1;
  const ok = up ? n &gt; g.cur : n &lt; g.cur;
  if(ok){
    g.mult = +(g.mult1.9).toFixed(2);
    g.cur = n;
    hlRender(`✅ Угадал! Следующее ${n}. Множитель x${g.mult.toFixed(2)}`);
  } else {
    menu(`❌ Число ${n}. Проигрыш ${g.bet} 💸`);
    endGame(&quot;hl&quot;, 0);
  }
}
function hlCash(){
  if(g.mult === 1.0){ toast(&quot;Сначала сделай попытку&quot;); return; }
  const prize = Math.floor(g.betg.mult);
  menu(`💰 Забрал x${g.mult.toFixed(2)}! +${prize}`);
  endGame(&quot;hl&quot;, prize);
}

// --- Карты ---
function cardsUI(){
  menu(`&lt;h3&gt;🂠 Карты&lt;/h3&gt;
    &lt;div class=&quot;row&quot;&gt;
      &lt;button class=&quot;btn red&quot; onclick=&quot;cardsGo('red')&quot;&gt;🔴 Красная&lt;/button&gt;
      &lt;button class=&quot;btn&quot; onclick=&quot;cardsGo('black')&quot;&gt;⚫ Чёрная&lt;/button&gt;
    &lt;/div&gt;`);
}
function cardsGo(choice){
  const res = Math.random() &lt; 0.5 ? &quot;red&quot; : &quot;black&quot;;
  const prize = choice === res ? Math.floor(g.bet1.95) : 0;
  const laid = res === &quot;red&quot; ? &quot;🔴 Красная&quot; : &quot;⚫ Чёрная&quot;;
  menu(`Лежала: ${laid}.&lt;br&gt;${prize&gt;0 ? &quot;🎉 +&quot;+prize : &quot;💸 Проигрыш &quot;+g.bet}`);
  endGame(&quot;cards&quot;, prize);
}

// --- Рулетка (шанс ужесточён) ---
function rouStart(){
  const vals = [[0.2,30],[0.5,25],[1,20],[1.2,10],[2,8],[3,4],[5,2],[10,1]];
  function pick(){
    let r = Math.random()100, t = 0;
    for(const vw of vals){ t += vw[1]; if(r &lt;= t) return vw[0]; }
    return 0.2;
  }
  g.win = pick();
  g.strip = [];
  for(let i=0;i&lt;50;i++) g.strip.push(pick());
  const FIX = 40;
  g.strip[FIX] = g.win;
  let cells = &quot;&quot;;
  for(let i=0;i&lt;g.strip.length;i++){
    const v = g.strip[i];
    const cls = v&gt;=5?&quot;cell gold&quot;:v&gt;=2?&quot;cell green&quot;:v&gt;=1?&quot;cell blue&quot;:&quot;cell dim&quot;;
    cells += `&lt;div class=&quot;${cls}&quot;&gt;x${v}&lt;/div&gt;`;
  }
  menu(`&lt;h3&gt;🎡 Рулетка&lt;/h3&gt;
    &lt;p class=&quot;muted&quot;&gt;Ставка ${g.bet}. Лента останавливается на множителе:&lt;/p&gt;
    &lt;div class=&quot;rou-wrap&quot;&gt;&lt;div class=&quot;rou-mark&quot;&gt;&lt;/div&gt;&lt;div class=&quot;rou-strip&quot; id=&quot;roustrip&quot;&gt;${cells}&lt;/div&gt;&lt;/div&gt;
    &lt;div id=&quot;rou-result&quot;&gt;&lt;/div&gt;`);
  setTimeout(()=&gt;{
    const CELL = 62;
    const wrap = document.querySelector(&quot;.rou-wrap&quot;);
    const offset = FIXCELL + 31 - wrap.clientWidth/2;
    document.getElementById(&quot;roustrip&quot;).style.transform = `translateX(-${offset}px)`;
  }, 50);
  setTimeout(()=&gt;{
    const prize = Math.floor(g.bet  g.win);
    const res = prize &gt; g.bet ? ` — 🎉 +${prize - g.bet}` : (prize === g.bet ? ` — 🤝 в ноль` : ` — 💸 -${g.bet - prize}`);
    document.getElementById(&quot;rou-result&quot;).innerHTML = `&lt;div class=&quot;log&quot;&gt;🎡 Выпало &lt;b&gt;x${g.win}&lt;/b&gt;${res}&lt;/div&gt;`;
    endGame(&quot;rou&quot;, prize);
  }, 3300);
}

// --- Слоты ---
const SLOT_SYMS = [&quot;🍒&quot;,&quot;🍋&quot;,&quot;🍊&quot;,&quot;💎&quot;,&quot;7️⃣&quot;];
const SLOT_W = [30,25,20,15,10];
const SLOT_TRIPLE = [2,3,4,6,10];
function slotsStart(){
  menu(`&lt;h3&gt;🎰 Слоты&lt;/h3&gt;
    &lt;p class=&quot;muted&quot;&gt;Ставка ${g.bet}. Три одинаковых — крупный приз, пара — x1.5.&lt;/p&gt;
    &lt;div class=&quot;reels&quot;&gt;
      &lt;div class=&quot;reel&quot; id=&quot;r0&quot;&gt;🍒&lt;/div&gt;&lt;div class=&quot;reel&quot; id=&quot;r1&quot;&gt;🍋&lt;/div&gt;&lt;div class=&quot;reel&quot; id=&quot;r2&quot;&gt;🍊&lt;/div&gt;
    &lt;/div&gt;
    &lt;div id=&quot;slot-result&quot;&gt;&lt;/div&gt;`);
  const result = SLOT_SYMS.map((_,i)=&gt;{
    let r = Math.random()100, t = 0;
    for(let j=0;j&lt;SLOT_SYMS.length;j++){ t += SLOT_W[j]; if(r &lt;= t) return j; }
    return 0;
  });
  let tick = 0;
  const anim = setInterval(()=&gt;{
    for(let i=0;i&lt;3;i++)
      document.getElementById(&quot;r&quot;+i).textContent = SLOT_SYMS[Math.floor(Math.random()SLOT_SYMS.length)];
    tick++;
    if(tick &gt; 14){
      clearInterval(anim);
      for(let i=0;i&lt;3;i++) document.getElementById(&quot;r&quot;+i).textContent = SLOT_SYMS[result[i]];
      let prize;
      if(result[0]===result[1] &amp;&amp; result[1]===result[2]){
        prize = Math.floor(g.bet  SLOT_TRIPLE[result[0]]);
        document.getElementById(&quot;slot-result&quot;).innerHTML =
          `&lt;div class=&quot;log&quot;&gt;🎰 ТРИ В РЯД! 🎉 +${prize}&lt;/div&gt;`;
      } else if(result[0]===result[1] || result[1]===result[2] || result[0]===result[2]){
        prize = Math.floor(g.bet  1.5);
        document.getElementById(&quot;slot-result&quot;).innerHTML =
          `&lt;div class=&quot;log&quot;&gt;🎰 Пара! 🎉 +${prize}&lt;/div&gt;`;
      } else {
        prize = 0;
        document.getElementById(&quot;slot-result&quot;).innerHTML =
          `&lt;div class=&quot;log&quot;&gt;🎰 Не сошлось. 💸 Проигрыш ${g.bet}&lt;/div&gt;`;
      }
      endGame(&quot;slots&quot;, prize);
    }
  }, 120);
}

// --- Курица-перебежчица ---
function chickenStart(){
  g.step = 0; g.mult = 1.0;
  chickenRender();
}
function chickenRender(msg){
  msg = msg || &quot;&quot;;
  let road = &quot;&quot;;
  for(let i=0;i&lt;=g.step;i++) road += &quot;🛣️&quot;;
  menu(`&lt;h3&gt;🐔 Курица-перебежчица&lt;/h3&gt;
    &lt;p class=&quot;big&quot;&gt;🐔${road}&lt;/p&gt;
    &lt;p class=&quot;muted&quot;&gt;Шагов: ${g.step}/10 · множитель x${g.mult.toFixed(2)} · ставка ${g.bet}&lt;/p&gt;
    ${msg?`&lt;div class=&quot;log&quot;&gt;${msg}&lt;/div&gt;`:&quot;&quot;}
    &lt;div class=&quot;row&quot;&gt;
      &lt;button class=&quot;btn&quot; onclick=&quot;chickenStep()&quot;&gt;🐔 Шаг&lt;/button&gt;
      &lt;button class=&quot;btn green&quot; onclick=&quot;chickenCash()&quot;&gt;💰 Забрать x${g.mult.toFixed(2)}&lt;/button&gt;
    &lt;/div&gt;`);
}
function chickenStep(){
  if(Math.random() &gt; 0.72){
    menu(`🚗💨 &lt;b&gt;МАШИНА!&lt;/b&gt; Курица не добежала. Проигрыш ${g.bet} 💸`);
    endGame(&quot;chicken&quot;, 0); return;
  }
  g.step++;
  g.mult = +(g.mult1.3).toFixed(2);
  if(g.step &gt;= 10){
    const prize = Math.floor(g.betg.mult);
    menu(`🐔🏆 Курица перебежала ВСЮ дорогу! +${prize}`);
    endGame(&quot;chicken&quot;, prize); return;
  }
  chickenRender(&quot;✅ Успешно!&quot;);
}
function chickenCash(){
  if(g.step === 0){ toast(&quot;Сделай хотя бы один шаг&quot;); return; }
  const prize = Math.floor(g.betg.mult);
  menu(`🐔💨 Забрал на x${g.mult.toFixed(2)}! +${prize}`);
  endGame(&quot;chicken&quot;, prize);
}

// --- Дартс (шанс ужесточён: промах 70%) ---
function dartsStart(){
  menu(`&lt;h3&gt;🎯 Дартс&lt;/h3&gt;
    &lt;p class=&quot;muted&quot;&gt;Ставка ${g.bet}. Один бросок:&lt;/p&gt;
    &lt;p class=&quot;big&quot; id=&quot;dart-emoji&quot;&gt;🎯&lt;/p&gt;
    &lt;div id=&quot;dart-result&quot;&gt;&lt;/div&gt;
    &lt;button class=&quot;btn&quot; onclick=&quot;dartsGo()&quot;&gt;🎯 Метнуть&lt;/button&gt;`);
}
function dartsGo(){
  const sectors = [
    [&quot;Промах&quot;, 70, 0],
    [&quot;Край мишени x1&quot;, 12, 1],
    [&quot;Двойка x2&quot;, 10, 2],
    [&quot;Красный x5&quot;, 6, 5],
    [&quot;БЫК x10&quot;, 2, 10],
  ];
  let r = Math.random()100, t = 0, pick = sectors[0];
  for(const s of sectors){ t += s[1]; if(r &lt;= t){ pick = s; break; } }
  document.getElementById(&quot;dart-emoji&quot;).textContent = pick[2]===0 ? &quot;😵&quot; : (pick[2]===10 ? &quot;🤯&quot; : &quot;🎯&quot;);
  const prize = Math.floor(g.bet  pick[2]);
  document.getElementById(&quot;dart-result&quot;).innerHTML =
    `&lt;div class=&quot;log&quot;&gt;${pick[0]}.${prize&gt;0 ? &quot; 🎉 +&quot;+prize : &quot; 💸 Проигрыш &quot;+g.bet}&lt;/div&gt;`;
  endGame(&quot;darts&quot;, prize);
}

// --- Кубики ---
function diceStart(){
  menu(`&lt;h3&gt;🎲 Кубики&lt;/h3&gt;
    &lt;p class=&quot;muted&quot;&gt;Ставка ${g.bet}. Бросай — сравним с ботом.&lt;/p&gt;
    &lt;p class=&quot;big&quot; id=&quot;dice-view&quot;&gt;🎲🎲&lt;/p&gt;
    &lt;div id=&quot;dice-result&quot;&gt;&lt;/div&gt;
    &lt;button class=&quot;btn&quot; onclick=&quot;diceGo()&quot;&gt;🎲 Бросить&lt;/button&gt;`);
}
function diceGo(){
  const die = () =&gt; Math.floor(Math.random()6)+1;
  let tick = 0;
  const anim = setInterval(()=&gt;{
    const d = [&quot;⚀&quot;,&quot;⚁&quot;,&quot;⚂&quot;,&quot;⚃&quot;,&quot;⚄&quot;,&quot;⚅&quot;];
    document.getElementById(&quot;dice-view&quot;).textContent = d[Math.floor(Math.random()6)] + d[Math.floor(Math.random()6)];
    tick++;
    if(tick &gt; 12){
      clearInterval(anim);
      const mine = die()+die(), bot = die()+die();
      document.getElementById(&quot;dice-view&quot;).textContent = `Ты ${mine} : ${bot} Бот`;
      let prize, msg;
      if(mine &gt; bot){ prize = Math.floor(g.bet1.9); msg = `🎉 Победа! +${prize}`; }
      else if(mine === bot){ prize = g.bet; msg = `🤝 Ничья — ставка возвращена`; }
      else { prize = 0; msg = `💸 Проигрыш ${g.bet}`; }
      document.getElementById(&quot;dice-result&quot;).innerHTML = `&lt;div class=&quot;log&quot;&gt;${msg}&lt;/div&gt;`;
      endGame(&quot;dice&quot;, prize);
    }
  }, 90);
}

// --- Стаканчики ---
function cupsStart(){
  g.ball = Math.floor(Math.random()3);
  menu(`&lt;h3&gt;🥤 Стаканчики&lt;/h3&gt;
    &lt;p class=&quot;muted&quot;&gt;Ставка ${g.bet}. Под одним из трёх стаканов монета 🪙&lt;/p&gt;
    &lt;div class=&quot;row&quot; style=&quot;justify-content:center&quot;&gt;
      &lt;button class=&quot;btn small&quot; onclick=&quot;cupsGo(0)&quot;&gt;🥤 1&lt;/button&gt;
      &lt;button class=&quot;btn small&quot; onclick=&quot;cupsGo(1)&quot;&gt;🥤 2&lt;/button&gt;
      &lt;button class=&quot;btn small&quot; onclick=&quot;cupsGo(2)&quot;&gt;🥤 3&lt;/button&gt;
    &lt;/div&gt;
    &lt;div id=&quot;cups-result&quot;&gt;&lt;/div&gt;`);
}
function cupsGo(choice){
  const hit = choice === g.ball;
  const prize = hit ? Math.floor(g.bet2.7) : 0;
  const reveal = [0,1,2].map(i=&gt; i===g.ball ? &quot;🪙&quot; : &quot;🥤&quot;).join(&quot; &quot;);
  document.getElementById(&quot;cups-result&quot;).innerHTML =
    `&lt;div class=&quot;log&quot;&gt;Стаканы: ${reveal}&lt;br&gt;${hit ? &quot;🎉 Угадал! +&quot;+prize : &quot;💸 Мимо. Проигрыш &quot;+g.bet}&lt;/div&gt;`;
  endGame(&quot;cups&quot;, prize);
}

// ---------- ПОДДЕРЖКА ----------
function goSupport(){
  if(tg.openTelegramLink) tg.openTelegramLink(&quot;https://t.me/tsartixc&quot;);
  else window.open(&quot;https://t.me/tsartixc&quot;,&quot;_blank&quot;);
}

renderCases(); renderGames(); renderBal();
&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;
```

### 2. `bot_case.py` — не переписывай целиком

У тебя уже стоит рабочая версия. Меняй только одну строку:

```python
WEB_APP_URL = &quot;https://dimonichk.github.io/duck-case-v2/?v=12&quot;
```

### 3. Запуск

1. `index.html` на GitHub → Commit changes (проверь счётчик: должно быть ~460 строк).
2. `bot_case.py` → сохранить → Ctrl + C → `python bot_case.py`.
3. `/start` → «ОТКРЫТЬ 🦆» → свежая кнопка панели.

Что по шансам после фикса: дартс теперь в среднем возвращает 82% ставки (промах 70%, «яблочко» просто возвращает ставку), рулетка 98%, кейсы 90–94%. Поиграй в дартс двадцать раз — баланс пополз вниз, как в нормальном казино 😄 Если снова чёрный экран — значит, при вставке что-то съелось: открой сайт в браузере в инкогнито и пришли мне, сколько строк в файле."></div><div data-end-streaming-block="true"></div><p>Виноват — чёрный экран случился из-за меня: в прошлом сообщении код <code class="CodeInlined">index.html</code> уехал с поломанными скриптами (слетели кавычки и скобки в середине), браузер падает на первой ошибке JavaScript и не рисует ничего. Ниже — чистый полный файл, я его выверил построчно. Бот из прошлой рабочей версии не трогай, только смени версию ссылки.</p>
