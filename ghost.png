isCallAgentRichUiEnabled":"1","isOperatorCacheMenuEnabled":"1","jeevesSectionNameB2C":"{\"ru\":\"Действуй!\",\"en\":\"Do It!\"}","isJeevesMainPageEnabled":"1","isJeevesMainPageV2Enabled":"1","jeevesSkillsEmptyContent":"{\"ru\":{\"title\":\"Научите Алису AI делать по-вашему\",\"description\":\"Расскажите один раз, как вы привыкли, — дальше Алиса AI будет делать так же\",\"createLabel\":\"Создать навык\",\"suggests\":[{\"text\":\"Разбор почты\",\"prompt\":\"Создай навык «Разбор почты»: каждое утро показывай, какие письма требуют ответа или действия сегодня, остальное одной строкой. Сначала спроси, какие отправители и темы для меня важны. Ничего не отправляй и не удаляй без моего «да».\"},{\"text\":\"Документ простыми словами\",\"prompt\":\"Создай навык «Документ простыми словами»: объясняй суть документа, что от меня требуется, сроки, суммы и рискованные пункты. Сначала спроси, какие документы я читаю чаще и что мне важно. Если чего-то в тексте нет, так и скажи, не додумывай.\"},{\"text\":\"Подготовка к встрече\",\"prompt\":\"Создай навык «Подготовка к встрече»: по календарю и переписке собирай, с кем встреча, о чём договаривались раньше и что нужно решить. Сначала спроси, к каким встречам готовить и за сколько времени. Отвечай кратко, списком до 5 пунктов.\"},{\"text\":\"План на сегодня\",\"prompt\":\"Создай навык «План на сегодня»: каждое утро собирай из календаря, почты и задач список дел на день по приоритету, отмечай, что горит и что можно перенести. Сначала спроси, во сколько присылать и сколько дел в день для меня реально.\"},{\"text\":\"Ответ в моём стиле\",\"prompt\":\"Создай навык «Ответ в моём стиле»: готовь черновики ответов на письма и сообщения так, как написал бы я. Сначала попроси 2–3 примера моих писем и спроси, с кем я на «ты», а с кем на «вы». Показывай черновик, сам ничего не отправляй.\"}]}}","isJeevesMainPageGreetingRotationEnabled":"1","isJeevesMainPageWidgetsEnabled":"1","jeevesBduiB2CGreetings":"default_new","jeevesBduiB2CSuggests":"default_ne