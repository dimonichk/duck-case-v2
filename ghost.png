      <span class="hljs-tag">&lt;<span class="hljs-name">p</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"muted"</span>&gt;</span>Начисление — командами в чате бота:<span class="hljs-tag">&lt;<span class="hljs-name">br</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">b</span>&gt;</span>/add 1000<span class="hljs-tag">&lt;/<span class="hljs-name">b</span>&gt;</span> — себе<span class="hljs-tag">&lt;<span class="hljs-name">br</span>&gt;</span>
