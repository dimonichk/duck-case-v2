ть текст лучше?":"Как сделать текст лучше?","Какой навык легко освоить?":"Какой навык легко освоить?","Книгу с интересным сюжетом":"Книгу с интересным сюжетом","Назови 3 навыка, которые можно освоить за 1–2 недели.":"Назови 3 навыка, которые можно освоить за 1–2 недели.","Назови слово дня":"Назови слово дня","Назови слово дня и расскажи его значение (100-150 символов)":"Назови слово дня и расскажи его значение (100-150 символов)","Помоги выбрать кроссовки":"Помоги выбрать кроссовки","Попроси меня отправить текст и предложи 3–5 конкретных улучшений.":"Попроси меня отправить текст и предложи 3–5 конкретных улучшений.","Попроси меня указать цель покупки кроссовок и бюджет. Предложи 3 модели с кратким описанием плюсов и минусов, ссылками на магазины и указанием цены.":"Попроси меня указать цель покупки кроссовок и бюджет. Предложи 3 модели с кратким описанием плюсов и минусов, ссылками на магазины и указанием цены.","Почему люди избегают конфликтов, даже если правы? Кратко объясни 3–4 основные причины такого поведения.":"Почему люди избегают конфликтов, даже если правы? Кратко объясни 3–4 основные причины такого поведения.","Почему люди избегают споров?":"Почему люди избегают споров?","Почему люди откладывают дела, хотя знают сроки? Назови 3–4 ключевые причины с кратким научным обоснованием.":"Почему люди откладывают дела, хотя знают сроки? Назови 3–4 ключевые причины с кратким научным обоснованием.","Почему людям сложно сказать «нет»? Опиши 3–4 фактора, мешающих уверенно отказывать.":"Почему людям сложно сказать «нет»? Опиши 3–4 фактора, мешающих уверенно отказывать.","Почему мы откладываем дела?":"Почему мы откладываем дела?","Почему сложно сказать «нет»?":"Почему сложно сказать «нет»?","Практика для расслабления":"Практика для расслабления","Предложи 2-3 упражнения для улучшения осанки (можно с лёгким инвентарём — эспандер, мяч).":"Предложи 2-3 упражнения для улучшения осанки (можно с лёгким инвентарём — эспандер, мяч).","Предложи 3 варианта легкого и интересного фильма или сериала с наградами на вечер с коротким описанием (2–3 предложения).":"Предложи 3 варианта легкого и интересного фильма или сериала с наградами на вечер с коротким описанием (2–3 предложения).","Предложи 3 книги современные с премиями с кратким описанием сюжета (2–3 предложения)":"Предложи 3 книги современные с премиями с кратким описанием сюжета (2–3 предложения)","Предложи 3 необычных вариантов хобби с коротким пояснением. После чего попроси кратко описать свои интересы и сколько времени я могу уделять хобби.":"Предложи 3 необычных вариантов хобби с коротким пояснением. После чего попроси кратко описать свои интересы и сколько времени я могу уделять хобби.","Предложи 3 рецепта простых ужинов (до 30 минут на приготовление).":"Предложи 3 рецепта простых ужинов (до 30 минут на приготовление).","Предложи практику для расслабления после тяжелого рабочего дня":"Предложи практику для расслабления после тяжелого рабочего дня","Придумай мне новое хобби":"Придумай мне новое хобби","Проверь документ на ошибки":"Проверь документ на ошибки","Разбери для меня Present Perfect простыми словами":"Разбери для меня Present Perfect простыми словами","Рецепты ужина для семьи":"Рецепты ужина для семьи","Сгенерируй 3 короткие мотивационные фразы (до 20 слов каждая) в разных стилях: афоризм, призыв к действию, философская мысль.":"Сгенерируй 3 короткие мотивационные фразы (до 20 слов каждая) в разных стилях: афоризм, призыв к действию, философская мысль.","Сгенерируй картинку кота, который держит табличку с надписью \"Привет\".":"Сгенерируй картинку кота, который держит табличку с надписью \"Привет\".","Сгенерируй картинку с текстом":"Сгенерируй картинку с текстом","Сделай мне комплимент":"Сделай мне комплимент","Составь список из 3 видов зелени, подходящей для домашнего выращивания на подоконнике.":"Составь список из 3 видов зелени, подходящей для домашнего выращивания на подоконнике.","Спроси у меня цель, с которой составлен документ, и проверь текст на ошибки, логичность и оформление, выдай исправленную версию с комментариями к правкам":"Спроси у меня цель, с которой составлен документ, и проверь текст на ошибки, логичность и оформление, выдай исправленную версию с комментариями к правкам","Упражнения для осанки":"Упражнения для осанки","Фильм или сериал на вечер":"Фильм или сериал на вечер","Что вырастить на окне?":"Что вырастить на окне?","Что значит \"I’m down\"?":"Что значит \"I’m down\"?"}},56065(e,t,s){var a=s(400468),i=s(41594);s.d(t,{},{J:({isVisible:e,hasBeenVisible:t,animationDisabled:s=!1})=>{let n=null==window.matchMedia?void 0:window.matchMedia.call(window,"(prefers-reduced-motion: reduce)").matches,o=!!(!e&&t&&(n||s)),[r,d]=(0,i.useState)({isVisible:e,hasExited:!1}),h=e!==r.isVisible,c=o&&!r.hasExited;(h||c)&&d({isVisible:e,hasExited:o});let l=r.hasExited||o,m=(0,i.useCallback)(()=>{d(e=>e.isVisible||e.hasExited?e:(0,a._)({},e,{hasExited:!0}))},[]);return(0,i.useEffect)(()=>{if(e||!t||l)return;let s=window.setTimeout(m,250);return()=>window.clearTimeout(s)},[m,t,l,e]),{hasExited:l,handleTransitionEnd:(0,i.useCallback)(t=>{t.target!==t.currentTarget||e||m()},[m,e])}}})}}]);"use strict";(self.serpWebpackJsonp=self.serpWebpackJsonp||[]).push([[95689],{275120(e,t,i){i.r(t),i.d(t,{Onboarding:()=>q});var a=i(226419),l=i(683256),n=i(41594),r=i(519018),s=i(927853),o=i(703863),c=i(335404),d=i(855179),u=i(442526),m=i(95209),p=i(53356),h=i(528664),g=i(314976),v=i(393347),f=i(293148),b=i(739977),C=i(572599),E=i(230312),A=i(919904),S=i(838319),I=i(762183),w=i(339312),y=i(387885),M=i(268730),k=i(124339),F=i(160980),O=i(160087),V=i(400468),R=i(358560),N=i(177047),_=i(335733),j=i(428713),x=i(226083),P=i(759122),B=i(477663),T=i(913143),U=i(281226),D=i(296737),W=i(602250),G=i(229119),L=i(563758);let Z={left:!1,right:!1};var J=i(899904);let z=(0,s.Ay)(E),q=(0,a.Ai)({desktop:({visible:e,vertical:t})=>{let i,{highlight:a}=(0,o.O)(),s=(()=>{let{flags:e,onboardingStore:t,companiesStore:i,isMailSourceAvailableStore:a}=(0,p.ZI)(),{items:l,doodleTyp