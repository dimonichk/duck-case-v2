4f39c0e3d52151363fed05c6ec3d8560919649","description":"supernova.691d7797-487a-4c2d-a62b-73e3ece3d7e3.2e80eb09bfd4f3ba24c4584d346cd4cc1b83dbcf"}}],"suggests":[{"id":"check-used-car","text":"Что проверить при покупке машины с рук?","deeplinkText":"Хотим купить подержанную машину с рук. Распиши, что проверить при осмотре и тест-драйве, какие документы посмотреть, как проверить историю авто и в каких случаях лучше сразу отказаться от покупки.","i18n":{"text":"supernova.691d7797-487a-4c2d-a62b-73e3ece3d7e3.44aaf94b40b1e31b82c3a9bfaba8626bd27535a2","deeplinkText":"supernova.691d7797-487a-4c2d-a62b-73e3ece3d7e3.370be3ec281338030796b93014b364eefb8ca375"}},{"id":"save-on-fuel","text":"Как тратить меньше на бензин?","deeplinkText":"Хочу тратить меньше на бензин, проезжаю около 1500 км в месяц, расход 9 литров на сотню, литр стоит 60 рублей. Дай 10 привычек за рулём и в обслуживании, которые снижают расход, и посчитай, сколько я трачу сейчас и сколько сэкономлю, если расход упадёт на 5 и на 10%.","i18n":{"text":"supernova.691d7797-487a-4c2d-a62b-73e3ece3d7e3.dc70ecd364584d08b2735c149e8862d631127bb5","deeplinkText":"supernova.691d7797-487a-4c2d-a62b-73e3ece3d7e3.d4a5b83c8029bb7284316d3bdf20313afafb8b1d"}}],"widgets":{"desktop":[{"id":"expert","type":"typed","title":"Интеллект","subtitle":"Эксперт","isNew":true,"media":{"image":{"light":"https://web-alice-images.s3.yandex.net/main-page-widgets/expert-widget-light3-desktop.webp","dark":"https://web-alice-images.s3.yandex.net/main-page-widgets/expert-widget-dark3-desktop.webp"}},"action":{"type":"deeplink","url":"/?model=alice-agents-expert","focusInput":true},"styles":{"image":{"light":{"position":"static","width":"100%","height":"auto","marginTop":"auto"},"dark":{"position":"static","width":"100%","height":"auto","marginTop":"auto"}},"subtitle":{"light":{"color":"var(--depot-color-text-quaternary)"},"dark":{"color":"var(--depot-color-text-quaternary)"}}},"wide":false,"personalization":false,"authRequired":true,"i18n":{"title":"