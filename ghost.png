    <span class="hljs-title function_">menu</span>(<span class="hljs-string">`💎 Все безопасные клетки открыты! +<span class="hljs-subst">${prize}</span>`</span>);
    <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"mines"</span>, prize); <span class="hljs-keyword">return</span>;
  }
  <span class="hljs-title function_">minesRender</span>();
}
