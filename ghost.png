<span class="hljs-keyword">function</span> <span class="hljs-title function_">diceRender</span>(<span class="hljs-params">msg=<span class="hljs-string">""</span></span>){
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`&lt;h3&gt;🎲 Кубики&lt;/h3&gt;
    &lt;p class="muted"&gt;Брось кубики. Сумма больше дилера — победа x1.9.&lt;/p&gt;
    &lt;div class="row"&gt;
      &lt;button class="btn" onclick="diceGo()"&gt;🎲 Бросить&lt;/button&gt;
    &lt;/div&gt;
    <span class="hljs-subst">${msg?<span class="hljs-string">`&lt;div class="log"&gt;<span class="hljs-subst">${msg}</span>&lt;/div&gt;`</span>:<span class="hljs-string">""</span>}</span>`</span>);
}
<span class="hljs-keyword">function</span> <span class="hljs-title function_">diceGo</span>(<span class="hljs-params"></span>){
  <span class="hljs-keyword">const</span> p = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">6</span>)+<span class="hljs-number">1</span> + <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">6</span>)+<span class="hljs-number">1</span>;
  <span class="hljs-keyword">const</span> d = <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">6</span>)+<span class="hljs-number">1</span> + <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(<span class="hljs-title class_">Math</span>.<span class="hljs-title function_">random</span>()*<span class="hljs-number">6</span>)+<span class="hljs-number">1</span>;
  <span class="hljs-keyword">const</span> win = p &gt; d;
  <span class="hljs-keyword">const</span> prize = win ? <span class="hljs-title class_">Math</span>.<span class="hljs-title function_">floor</span>(g.<span class="hljs-property">bet</span>*<span class="hljs-number">1.9</span>) : <span class="hljs-number">0</span>;
  <span class="hljs-title function_">menu</span>(<span class="hljs-string">`🎲 Ты: <span class="hljs-subst">${p}</span> | Дилер: <span class="hljs-subst">${d}</span>&lt;br&gt;\${win ? "🎉 Победа! +"+prize : "💸 Проигрыш "+g.bet}`</span>);
  <span class="hljs-title function_">endGame</span>(<span class="hljs-string">"dice"</span>, prize);
}

